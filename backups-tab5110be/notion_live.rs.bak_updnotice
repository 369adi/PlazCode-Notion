const PS_FILE_CMDS: &[&str] = &["set-content", "add-content", "out-file", "new-item", "remove-item", "clear-content", "copy-item", "move-item", "rename-item", "tee-object"];
const PS_VALUE_FLAGS: &[&str] = &["-value", "-encoding", "-itemtype", "-newname", "-filter", "-include", "-exclude", "-width", "-inputobject", "-type"];
const PS_STRONG: &[&str] = &["set-content", "add-content", "out-file", "new-item", "remove-item", "move-item", "copy-item", "rename-item", "clear-content", "tee-object", "writealltext", "writeallbytes", "writealllines", "appendalltext", "git checkout", "git reset", "git restore", "git apply", "git stash", "git clean", "git merge", "git rebase", "git pull"];
static IOFILE_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r#"::(?:writealltext|writeallbytes|writealllines|appendalltext|appendalllines)\(\s*['"]([^'"]+)['"]"#).unwrap());

fn ps_tokens(seg: &str) -> Vec<String> {
    let mut v = Vec::new();
    let mut cur = String::new();
    let mut q: Option<char> = None;
    for c in seg.chars() {
        match q {
            Some(x) if c == x => q = None,
            Some(_) => cur.push(c),
            None if c == '\'' || c == '"' => q = Some(c),
            None if c.is_whitespace() => { if !cur.is_empty() { v.push(std::mem::take(&mut cur)); } }
            None => cur.push(c),
        }
    }
    if !cur.is_empty() { v.push(cur); }
    v
}

fn ps_add(out: &mut Vec<String>, p: &str) {
    let p = p.trim().trim_matches(|c: char| c == '(' || c == ')' || c == ',' || c == '{' || c == '}').trim_start_matches("./");
    if p.is_empty() || p.starts_with('$') || p.starts_with('&') || p.starts_with('-') || p == "null" || p == "nul" || !p.chars().any(|c| c.is_ascii_alphabetic()) { return; }
    let s = p.to_string();
    if !out.contains(&s) { out.push(s); }
}

/// Zieldateien eines PowerShell-Befehls (klein, mit /). Leer = keine sicher erkennbar.
pub(crate) fn ps_targets(cmd: &str) -> Vec<String> {
    let low = cmd.replace('\\', "/").to_ascii_lowercase();
    let mut out = Vec::new();
    for seg in low.split(|c: char| c == ';' || c == '|' || c == '\n') {
        let tk = ps_tokens(seg);
        for (i, t) in tk.iter().enumerate() {
            if !PS_FILE_CMDS.contains(&t.as_str()) { continue; }
            let max = if t == "copy-item" || t == "move-item" { 2 } else { 1 };
            let (mut j, mut pos) = (i + 1, 0);
            while j < tk.len() {
                let a = tk[j].as_str();
                if PS_FILE_CMDS.contains(&a) { break; }
                if matches!(a, "-path" | "-literalpath" | "-filepath" | "-destination") { if let Some(p) = tk.get(j + 1) { ps_add(&mut out, p); pos += 1; } j += 2; continue; }
                if PS_VALUE_FLAGS.contains(&a) { j += 2; continue; }
                if a.starts_with('-') { j += 1; continue; }
                if pos < max { ps_add(&mut out, a); pos += 1; }
                j += 1;
            }
        }
        for (i, t) in tk.iter().enumerate() {
            let r = t.trim_start_matches(|c: char| c.is_ascii_digit() || c == '*');
            if r == ">" || r == ">>" { if let Some(p) = tk.get(i + 1) { ps_add(&mut out, p); } }
            else if r.starts_with('>') && !r.starts_with(">&") && !r.starts_with(">>&") { ps_add(&mut out, r.trim_start_matches('>')); }
        }
    }
    for m in IOFILE_RE.captures_iter(&low) { ps_add(&mut out, &m[1]); }
    out
}

/// Aendert der PowerShell-Befehl Dateien? Nur echte Schreib-Befehle, nicht "-replace" oder "2>&1".
pub(crate) fn ps_is_write(cmd: &str) -> bool {
    let low = cmd.to_ascii_lowercase();
    !ps_targets(cmd).is_empty() || PS_STRONG.iter().any(|w| low.contains(w))
}

/// Wer ruft? Explizites agent-Argument, sonst die Co-Work-Zuordnung der Session. Leer = unbekannt.
fn ident(session: &str, args: &Value) -> String {
    let a = arg(args, "agent");
    if !a.is_empty() { return a; }
    crate::notion_cowork::agent_of_session(session).unwrap_or_default()
}

/// Vom Tab-Monitor: Tab des Agents generiert gerade (true) oder ist fertig (false).
pub(crate) fn set_generating(agent: &str, on: bool) {
    if agent.is_empty() { return; }
    let mut g = GEN.lock().unwrap_or_else(|e| e.into_inner());
    let was = g.get(agent).map(|ts| now() - *ts < GEN_BEAT).unwrap_or(false);
    if on { g.insert(agent.to_string(), now()); } else { g.remove(agent); }
    drop(g);
    if was != on {
        bus().agents.entry(agent.to_string()).or_default().generating = on;
        emit(agent, "gen", "", if on { "arbeitet (generiert)".to_string() } else { "Chat fertig".to_string() });
    }
}

fn generating(agent: &str) -> bool {
    GEN.lock().unwrap_or_else(|e| e.into_inner()).get(agent).map(|ts| now() - *ts < GEN_BEAT).unwrap_or(false)
}

/// Co-Work: generiert der Tab dieses Agents gerade? (fuer die Namens-Zuordnung beim Join)
pub(crate) fn is_generating(agent: &str) -> bool { generating(agent) }
/// Arbeitet der Agent gerade live? (laufender Co-Work-Task, Tab generiert oder Tool-Aufruf laeuft)
fn holds(busy: &[String], agent: &str) -> bool { busy.iter().any(|b| b == agent) || generating(agent) || inflight(agent) }

/// Neues Ereignis ins zentrale Log. to = Empfaenger bei msg (leer = alle).
pub(crate) fn emit(agent: &str, kind: &'static str, to: &str, text: String) -> u64 {
    let seq = {
        let b = &mut *bus();
        b.seq += 1;
        let seq = b.seq;
        b.evs.push_back(Ev { seq, ts: now(), agent: agent.to_string(), kind, to: to.to_string(), text: cut(&text, if kind == "msg" { 600 } else { 120 }) });
        while b.evs.len() > MAX_EVENTS { b.evs.pop_front(); }
        seq
    };
    EVENTS.notify_waiters();
    seq
}

pub(crate) fn last_seq() -> u64 { bus().seq }

/// Alle Ereignisse nach seq (aelteste zuerst).
pub(crate) fn events_since(seq: u64) -> Vec<Ev> { bus().evs.iter().filter(|e| e.seq > seq).cloned().collect() }

/// Kompakte Neuigkeiten fuer agent seit seinem letzten Abruf: nur fremde Aenderungen und
/// Nachrichten an ihn, max. 3 Zeilen. Erster Abruf setzt nur den Cursor (kein Rueckstau).
pub(crate) fn delta_for(agent: &str) -> Option<String> {
    if agent.is_empty() { return None; }
    let b = &mut *bus();
    let cur = b.seq;
    let Some(from) = b.cursor.insert(agent.to_string(), cur) else { return if cfg!(test) { None } else { intro(b, agent) }; };
    let mut msgs: Vec<String> = Vec::new();
    let mut latest: BTreeMap<&str, &Ev> = BTreeMap::new();
    for e in b.evs.iter().filter(|e| e.seq > from && e.agent != agent && e.kind != "tool_end") {
        if e.kind == "msg" {
            if e.to.is_empty() || e.to == agent { msgs.push(format!("{}\u{2192}dich: {}", e.agent, e.text)); }
            continue;
        }
        latest.insert(e.agent.as_str(), e);
    }
    let keep = msgs.len().saturating_sub(2);
    let mut lines: Vec<String> = msgs.split_off(keep);
    if !latest.is_empty() {
        let s: Vec<String> = latest.values().map(|e| {
            let task = b.agents.get(&e.agent).filter(|a| a.task > 0).map(|a| format!(" (#{})", a.task)).unwrap_or_default();
            format!("{}: {}{task}", e.agent, e.text)
        }).collect();
        lines.insert(0, s.join(" \u{b7} "));
    }
    if lines.is_empty() { return None; }
    Some(format!("[Live] {}", lines.join("\n[Live] ")))
}

/// Erster Kontakt eines Chats mit der Live-Bridge: wer sonst offen ist, wie man sich abstimmt und
/// Nachrichten, die schon auf ihn warten (gilt fuer alle Chats, auch ohne Co-Work-Projekt).
fn intro(b: &Bus, agent: &str) -> Option<String> {
    let t = now();
    let others: Vec<String> = b.agents.iter()
        .filter(|(n, _)| n.as_str() != agent && b.evs.iter().rev().any(|e| &e.agent == *n && t - e.ts < ACTIVE_SECS))
        .map(|(n, a)| if a.generating || a.inflight > 0 {
            format!("{n} (arbeitet{})", if a.tool.is_empty() { String::new() } else { format!(": {}", cut(&a.tool, 60)) })
        } else { n.clone() })
        .collect();
    let msgs: Vec<String> = b.evs.iter().filter(|e| e.kind == "msg" && e.to == agent && t - e.ts < 86_400)
        .map(|e| format!("{}\u{2192}dich: {}", e.agent, e.text)).collect();
    if others.is_empty() && msgs.is_empty() { return None; }
    let mut s = format!(
        "[Live-Bridge] Du bist {agent}. Offene Chats: {}. Alle Chats sind immer verbunden, auch ohne Co-Work: abstimmen mit cowork_message (agent: {agent}, to: <Name>, text: ...), freie Tabs werden dabei geweckt. Dateien, die ein anderer Chat gerade schreibt, sind automatisch gesperrt. Releases: jeder Chat darf ohne Nutzer-OK veroeffentlichen - erst cowork_release action=join/ready (anhaengen), dann action=publish (wartet max. 10 min auf Tabs, die noch anhaengen), danach work\\rel.ps1 + pub.ps1 und action=done.",
        if others.is_empty() { "keine".to_string() } else { others.join(", ") });
    for m in msgs.iter().rev().take(3).rev() { s.push_str(&format!("\n[Live] {m}")); }
    Some(s)
}

/// Alle Agents, die die Live-Bridge schon gesehen hat.
pub(crate) fn known_agents() -> Vec<String> { bus().agents.keys().cloned().collect() }

/// Tool-Aufruf beginnt (inflight + Live-Status). Leerer Agent = unbekannt, wird ignoriert.
pub(crate) fn tool_started(agent: &str, name: &str, args: &Value) {
    if agent.is_empty() { return; }
    let text = describe(name, args);
    {
        let b = &mut *bus();
        let a = b.agents.entry(agent.to_string()).or_default();
        a.inflight += 1;
        a.tool = text.clone();
        a.since = now();
    }
    if !matches!(name, "cowork_wait" | "cowork_board") { emit(agent, "tool_start", "", text); }
}

/// Tool-Aufruf ist fertig (auch bei Fehler aufrufen).
pub(crate) fn tool_finished(agent: &str, _name: &str) {
    if agent.is_empty() { return; }
    let b = &mut *bus();
    if let Some(a) = b.agents.get_mut(agent) {
        a.inflight = a.inflight.saturating_sub(1);
        if a.inflight == 0 { a.tool.clear(); }
    }
}

/// Laeuft fuer den Agent gerade ein Tool-Aufruf? (z. B. cargo build -> Tab nicht stoppen)
pub(crate) fn inflight(agent: &str) -> bool {
    bus().agents.get(agent).map(|a| a.inflight > 0 && now() - a.since < INFLIGHT_MAX).unwrap_or(false)
}

/// Co-Work meldet Task-Wechsel (status: claimed, done, changes, blocked, open).
pub(crate) fn note_task(agent: &str, task: u64, status: &str, title: &str, files: &[String]) {
    if agent.is_empty() { return; }
    {
        let b = &mut *bus();
        let a = b.agents.entry(agent.to_string()).or_default();
        if status == "claimed" { a.task = task; a.files = files.to_vec(); }
        else { if a.task == task { a.task = 0; a.files.clear(); } a.last_result = cut(title, 120); }
    }
    emit(agent, "task", "", format!("#{task} {status}: {}", cut(title, 80)));
}

/// Nachricht an einen Agent (leer = alle) ins Live-Log.
pub(crate) fn note_msg(from: &str, to: &str, text: &str) { emit(from, "msg", to, text.to_string()); }

/// Live-Status aller Agents (fuer Feed/UI).
pub(crate) fn agents_json() -> Value {
    let t = now();
    Value::Array(bus().agents.iter().map(|(n, a)| json!({
        "agent": n, "generating": a.generating, "tool": a.tool,
        "tool_secs": if a.inflight > 0 { t - a.since } else { 0 }, "inflight": a.inflight,
        "task": a.task, "files": a.files, "last_result": a.last_result,
    })).collect())
}

/// Rohes Kommando/Pfad fuer die Live-Anzeige (max. 400 Zeichen).
fn detail_of(args: &Value) -> String {
    let s = ["command", "code", "path", "query", "pattern", "url"].iter()
        .find_map(|k| args.get(*k).and_then(|v| v.as_str()).map(str::trim).filter(|v| !v.is_empty())).unwrap_or("");
    let mut out: String = s.chars().take(400).collect();
    if s.chars().count() > 400 { out.push('\u{2026}'); }
    out
}

/// Jeder Tool-Aufruf: Chat merken und Klartext in den Live-Feed schreiben.
pub(crate) fn record(session: &str, name: &str, args: &Value) {
    let text = describe(name, args);
    let detail = detail_of(args);
    let who = ident(session, args);
    let busy = crate::notion_cowork::busy_agents();
    let t = now();
    let l = &mut *live();
    l.locks.retain(|_, (o, _)| holds(&busy, o));
    l.busy = busy;
    let (key, label) = if who.is_empty() { ("?".to_string(), "Chat ohne Namen".to_string()) } else { (who.clone(), who) };
    let x = l.tabs.entry(key).or_insert(TabInfo { label: label.clone(), seen: t, last: String::new() });
    x.seen = t;
    x.last = text.clone();
    l.next += 1;
    let id = l.next;
    l.feed.push_back(Entry { id, ts: t, tab: label, tool: name.to_string(), text, detail });
    while l.feed.len() > MAX_FEED { l.feed.pop_front(); }
    l.tabs.retain(|_, x| t - x.seen < 86_400);
}

/// Immer aktive Bridge: blockiert Schreibzugriffe auf Dateien, an denen ein anderer Chat gerade
/// live arbeitet, und reserviert freie Dateien fuer den schreibenden Chat, solange er live arbeitet.
pub(crate) fn guard(session: &str, name: &str, args: &Value) -> Option<String> {
    if name.starts_with("cowork_") { return None; }
    let who = ident(session, args);
    if who.is_empty() { return None; }
    let busy = crate::notion_cowork::busy_agents();
    let t = now();
    let l = &mut *live();
    l.locks.retain(|_, (o, _)| holds(&busy, o));
    let mine = holds(&busy, &who);
    l.busy = busy;
    let ps_t = if name == "pc_PowerShell" { ps_targets(&arg(args, "command")) } else { Vec::new() };
    let hit: Option<(String, String, i64)> = if name == "pc_PowerShell" && ps_t.is_empty() {
        let cmd = arg(args, "command").to_ascii_lowercase().replace('\\', "/");
        if !ps_is_write(&cmd) { return None; }
        l.locks.iter()
            .find(|(k, (o, _))| {
                let ks = k.as_str();
                let f = ks.rsplit('/').next().unwrap_or(ks);
                o.as_str() != who.as_str() && (cmd.contains(ks) || (f.len() >= 4 && cmd.contains(f)))
            })
            .map(|(k, (o, ts))| (k.clone(), o.clone(), *ts))
    } else {
        let targets = if ps_t.is_empty() { crate::notion_cowork::live_write_paths(name, args)? } else { ps_t.clone() };
        let hit = targets.iter().find_map(|tg| {
            l.locks.iter()
                .find(|(k, (o, _))| o.as_str() != who.as_str() && crate::notion_cowork::live_same(tg, k.as_str()))
                .map(|(k, (o, ts))| (k.clone(), o.clone(), *ts))
        });
        if hit.is_none() && mine {
            for tg in targets {
                if !l.locks.contains_key(&tg) { emit(&who, "lock", "", format!("reserviert {}", file_name(&tg))); }
                l.locks.entry(tg).or_insert((who.clone(), t));
            }
        }
        hit
    };
    let (path, owner, ts) = hit?;
    emit(&who, "msg", &owner, format!("wollte {} ändern und wurde blockiert", file_name(&path)));
    l.next += 1;
    let id = l.next;
    l.feed.push_back(Entry { id, ts: t, tab: who.clone(), tool: name.to_string(), detail: String::new(), text: format!("Blockiert: wollte {} ändern, aber {owner} arbeitet gerade daran", file_name(&path)) });
    while l.feed.len() > MAX_FEED { l.feed.pop_front(); }
    Some(format!(
        "[AdiCode Live-Bridge] {path} wird gerade live von {owner} bearbeitet (seit {} s). Nicht ändern, sonst geht dessen Arbeit kaputt. Eine andere Aufgabe machen oder per cowork_message abstimmen. Die Datei wird automatisch frei, sobald {owner} die Aufgabe abschliesst bzw. der Chat fertig ist.",
        t - ts
    ))
}

/// Text fuer cowork_board: welche Chats gerade aktiv sind, was sie tun und welche Dateien live belegt sind.
pub(crate) fn tabs_text() -> String {
    let t = now();
    let l = live();
    let act: Vec<&TabInfo> = l.tabs.values().filter(|x| t - x.seen < ACTIVE_SECS).collect();
    if act.is_empty() { return String::new(); }
    let mut s = String::from("\n\nLive-Bridge (immer an) - aktive Chats:");
    for x in act { s.push_str(&format!("\n- {}: {} (vor {} s)", x.label, x.last, t - x.seen)); }
    for (k, (o, ts)) in l.locks.iter().filter(|(_, (o, _))| holds(&l.busy, o)) {
        s.push_str(&format!("\n  Datei {k} live belegt von {o} (seit {} s)", t - ts));
    }
    s
}

pub(crate) fn feed(since: u64) -> Value {
    let t = now();
    let l = live();
    let mut items: Vec<Value> = l.feed.iter().rev().take_while(|e| e.id > since).take(40)
        .map(|e| json!({"id": e.id, "ts": e.ts, "tab": e.tab, "tool": e.tool, "text": e.text, "detail": e.detail}))
        .collect();
    items.reverse();
    let tabs: Vec<Value> = l.tabs.values().filter(|x| t - x.seen < ACTIVE_SECS)
        .map(|x| json!({"tab": x.label, "ago": t - x.seen, "text": x.last}))
        .collect();
    let lock_list: Vec<Value> = l.locks.iter().filter(|(_, (o, _))| holds(&l.busy, o))
        .map(|(k, (o, ts))| json!({"file": file_name(k), "path": k, "owner": o, "since": t - ts}))
        .collect();
    let locks = lock_list.len();
    json!({"ok": true, "now": t, "last": l.next, "items": items, "tabs": tabs, "locks": locks, "lock_list": lock_list, "agents": agents_json(), "seq": last_seq()})
}

#[derive(Deserialize)]
pub struct FeedQuery { since: Option<u64> }

