//! Live-Bridge (immer an): Alle Notion-AI-Tabs sehen sich gegenseitig - auch ohne
//! "Co-Work starten". Jeder Tool-Aufruf landet mit deutscher Klartext-Beschreibung im Live-Feed,
//! den der AdiCode-Chat live anzeigt. Eine Datei ist fuer einen Chat genau so lange reserviert,
//! wie er live daran arbeitet: solange sein Co-Work-Task "claimed" ist oder sein Tab gerade
//! generiert (Stopp-Knopf sichtbar). Kein Timer. Chats ohne Namen werden nie geraten/gesperrt.
use axum::{extract::Query, response::IntoResponse, Json};
use once_cell::sync::Lazy;
use regex::Regex;
use serde::Deserialize;
use serde_json::{json, Value};
use std::{collections::{BTreeMap, VecDeque}, sync::Mutex};

const MAX_FEED: usize = 300;
/// Herzschlag des Tab-Monitors (prueft alle 4 s). Kommt so lange kein Signal, gilt der Tab als fertig.
const GEN_BEAT: i64 = 15;
/// Chats ohne Aufruf seit dieser Zeit werden in der Uebersicht nicht mehr gezeigt.
const ACTIVE_SECS: i64 = 900;

#[derive(Clone)]
struct Entry { id: u64, ts: i64, tab: String, tool: String, text: String, detail: String }

struct TabInfo { label: String, seen: i64, last: String }

#[derive(Default)]
struct Live {
    next: u64,
    feed: VecDeque<Entry>,
    tabs: BTreeMap<String, TabInfo>,
    /// Datei -> (Agent, seit)
    locks: BTreeMap<String, (String, i64)>,
    /// Agents mit laufendem (claimed) Co-Work-Task, beim letzten Aufruf.
    busy: Vec<String>,
}

static LIVE: Lazy<Mutex<Live>> = Lazy::new(|| Mutex::new(Live::default()));
/// Agent -> letzter Zeitpunkt, an dem sein Tab sichtbar generiert hat (vom Tab-Monitor).
static GEN: Lazy<Mutex<BTreeMap<String, i64>>> = Lazy::new(|| Mutex::new(BTreeMap::new()));

/// Max. Ereignisse im zentralen Live-Log.
const MAX_EVENTS: usize = 500;
/// Laufende Tool-Aufrufe gelten nach dieser Zeit als verwaist (Schutz gegen haengende Zaehler).
const INFLIGHT_MAX: i64 = 1800;

/// Ein Ereignis im zentralen Live-Log (fortlaufende seq). kind: tool_start, tool_end, task, lock, gen, msg.
#[derive(Clone, Debug)]
pub(crate) struct Ev { pub seq: u64, pub ts: i64, pub agent: String, pub kind: &'static str, pub to: String, pub text: String }

/// Live-Status eines Agents (eine Quelle fuer Feed, Delta und Tab-Monitor).
#[derive(Clone, Debug, Default)]
pub(crate) struct AgentState { pub generating: bool, pub tool: String, pub since: i64, pub inflight: u32, pub task: u64, pub files: Vec<String>, pub last_result: String }

#[derive(Default)]
struct Bus { seq: u64, evs: VecDeque<Ev>, cursor: BTreeMap<String, u64>, agents: BTreeMap<String, AgentState> }

static BUS: Lazy<Mutex<Bus>> = Lazy::new(|| Mutex::new(Bus::default()));
/// Weckt Wartende (z. B. cowork_wait), sobald ein neues Ereignis da ist.
pub(crate) static EVENTS: Lazy<tokio::sync::Notify> = Lazy::new(tokio::sync::Notify::new);
/// Lock-Reihenfolge: LIVE -> BUS (nie umgekehrt).
fn bus() -> std::sync::MutexGuard<'static, Bus> { BUS.lock().unwrap_or_else(|e| e.into_inner()) }
static FILE_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"([A-Za-z0-9_\-][A-Za-z0-9_.\-]*\.(?:rs|html|md|ps1|json|log|toml|lua|luau|js|ts|py|txt|patch|css|bak\d*))\b").unwrap());
static PAT_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r#"(?i)-pattern\s+['"]([^'"]{1,80})['"]"#).unwrap());
static SLEEP_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"(?i)start-sleep\s+(?:-s(?:econds)?\s+)?(\d+)").unwrap());

fn live() -> std::sync::MutexGuard<'static, Live> { LIVE.lock().unwrap_or_else(|e| e.into_inner()) }
fn now() -> i64 { chrono::Utc::now().timestamp() }
fn arg(a: &Value, k: &str) -> String { a[k].as_str().unwrap_or("").trim().to_string() }
fn file_name(p: &str) -> String {
    let p = p.trim().trim_matches(|c: char| c == '"' || c == '\'');
    p.rsplit(|c: char| c == '\\' || c == '/').find(|x| !x.is_empty()).unwrap_or(p).to_string()
}
fn cut(s: &str, n: usize) -> String {
    let s: String = s.chars().map(|c| if c.is_control() { ' ' } else { c }).collect();
    let s = s.trim();
    if s.chars().count() > n { format!("{}\u{2026}", s.chars().take(n).collect::<String>()) } else { s.to_string() }
}
fn push(parts: &mut Vec<String>, s: String) { if !parts.contains(&s) && parts.len() < 4 { parts.push(s); } }
fn upper_first(s: &str) -> String {
    let mut c = s.chars();
    match c.next() { Some(f) => f.to_uppercase().collect::<String>() + c.as_str(), None => String::new() }
}
fn tidy(name: &str, prefix: &str) -> String { name.trim_start_matches(prefix).replace('_', " ") }

/// Uebersetzt einen PowerShell-Befehl in einen kurzen deutschen Satz.
pub(crate) fn describe_ps(cmd: &str) -> String {
    let l = cmd.to_ascii_lowercase();
    let mut files: Vec<String> = Vec::new();
    for c in FILE_RE.captures_iter(cmd) {
        let f = c[1].to_string();
        if !files.contains(&f) && files.len() < 3 { files.push(f); }
    }
    let fl = if files.is_empty() { String::new() } else { format!(" ({})", files.join(", ")) };
    let mut parts: Vec<String> = Vec::new();
    if l.contains("cargo test") { push(&mut parts, "führt die automatischen Tests aus".into()); }
    if l.contains("cargo build") { push(&mut parts, "baut (kompiliert) die App".into()); }
    if l.contains("git fetch") || l.contains("git pull") { push(&mut parts, "holt den neuesten Stand von GitHub".into()); }
    if ["git status", "git diff", "git log", "git show"].iter().any(|w| l.contains(w)) { push(&mut parts, "schaut sich den Git-Stand an".into()); }
    if l.contains("git commit") { push(&mut parts, "speichert die Änderungen als Git-Commit".into()); }
    if l.contains("git push") { push(&mut parts, "lädt die Änderungen zu GitHub hoch".into()); }
    if let Some(c) = PAT_RE.captures(cmd) { push(&mut parts, format!("durchsucht Dateien nach „{}“", cut(&c[1], 40))); }
    else if l.contains("select-string") { push(&mut parts, format!("durchsucht Dateien{fl}")); }
    if l.contains("get-content") || l.contains("readalltext") { push(&mut parts, format!("liest Datei-Inhalt{fl}")); }
    if ["set-content", "add-content", "out-file", "writealltext", "writeallbytes", "writealllines", "appendalltext"].iter().any(|w| l.contains(w)) {
        push(&mut parts, format!("schreibt/ändert Dateien{fl}"));
    }
    if l.contains("copy-item") { push(&mut parts, "legt eine Kopie/Backup an".into()); }
    if l.contains("remove-item") { push(&mut parts, "löscht Dateien".into()); }
    if l.contains("get-childitem") { push(&mut parts, "listet Dateien im Ordner auf".into()); }
    if l.contains("websocket") || l.contains("runtime.evaluate") { push(&mut parts, "schaut live in die Notion-Fenster (Browser-Steuerung)".into()); }
    else if l.contains("invoke-restmethod") || l.contains("invoke-webrequest") { push(&mut parts, "fragt einen lokalen Dienst ab".into()); }
    if l.contains("start-process") { push(&mut parts, "startet ein Skript/Programm im Hintergrund".into()); }
    if l.contains("get-process") || l.contains("get-nettcpconnection") { push(&mut parts, "prüft laufende Programme und Ports".into()); }
    if let Some(c) = SLEEP_RE.captures(&l) { push(&mut parts, format!("wartet {} Sekunden", &c[1])); }
    if parts.is_empty() {
        return format!("Führt einen PowerShell-Befehl aus: {}", cut(cmd.lines().next().unwrap_or(""), 70));
    }
    upper_first(&parts.join(", dann "))
}

