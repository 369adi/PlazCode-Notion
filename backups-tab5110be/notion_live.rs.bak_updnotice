// ---- Update-Hinweis an alle verbundenen Notion-Tabs (auch ohne Co-Work) ----
struct Notice { text: String, until: i64, seen: std::collections::BTreeSet<String> }
static NOTICE: Lazy<Mutex<Option<Notice>>> = Lazy::new(|| Mutex::new(None));

/// Setzt einen Hinweis, den jeder Tab genau einmal mit seinem naechsten Tool-Ergebnis bekommt.
pub(crate) fn set_notice(text: &str, secs: i64) {
    *NOTICE.lock().unwrap_or_else(|e| e.into_inner()) = Some(Notice { text: text.to_string(), until: now() + secs, seen: Default::default() });
}

/// Hinweis fuer diesen Tab (key = Session oder Agent). Leerer key = jedes Mal anhaengen.
pub(crate) fn notice_for(key: &str) -> Option<String> {
    let mut g = NOTICE.lock().unwrap_or_else(|e| e.into_inner());
    let expired = matches!(&*g, Some(n) if now() > n.until);
    if expired { *g = None; }
    let n = g.as_mut()?;
    if !key.is_empty() && !n.seen.insert(key.to_string()) { return None; }
    Some(format!("[AdiCode-Hinweis] {}", n.text))
}

fn release_file() -> std::path::PathBuf { crate::platform::installation_root().join("logs").join("release-status.json") }

/// Release-Status (geschrieben von work\release-status.ps1 aus rel.ps1/pub.ps1). Null, wenn nichts Aktuelles.
pub(crate) fn release_status() -> serde_json::Value {
    let v: serde_json::Value = std::fs::read_to_string(release_file()).ok()
        .and_then(|s| serde_json::from_str(s.trim_start_matches('\u{feff}')).ok())
        .unwrap_or(serde_json::Value::Null);
    if !v.is_object() { return serde_json::Value::Null; }
    let age = now() - v["updated"].as_i64().unwrap_or(0);
    let busy = matches!(v["state"].as_str(), Some("building" | "built" | "publishing"));
    if age < if busy { 3 * 3600 } else { 30 * 60 } { v } else { serde_json::Value::Null }
}

static RELEASE_SEEN: Lazy<Mutex<std::collections::HashSet<String>>> = Lazy::new(|| Mutex::new(std::collections::HashSet::new()));
// Notion oeffnet oft pro Tool-Aufruf eine neue MCP-Session -> der Session-Key wechselt staendig.
// Nicht-kritische Release-Hinweise (published/failed) deshalb zusaetzlich global drosseln (Token-Diaet).
static RELEASE_LAST: Lazy<Mutex<std::collections::HashMap<String, i64>>> = Lazy::new(|| Mutex::new(std::collections::HashMap::new()));
const RELEASE_QUIET_SECS: i64 = 600;

fn release_throttled(ver: &str, state: &str, t: i64) -> bool {
    if matches!(state, "building" | "built" | "publishing") { return false; }
    let mut last = RELEASE_LAST.lock().unwrap_or_else(|e| e.into_inner());
    let k = format!("{ver}|{state}");
    if last.get(&k).is_some_and(|&p| t - p < RELEASE_QUIET_SECS) { return true; }
    last.insert(k, t);
    false
}

/// Jeder Chat (auch ohne Co-Work) bekommt einmal pro Release-Zustand einen Hinweis an sein naechstes Tool-Ergebnis.
pub(crate) fn release_notice(key: &str) -> Option<String> {
    if key.is_empty() { return None; }
    let v = release_status();
    if v.is_null() { return None; }
    let ver = v["version"].as_str().unwrap_or("?");
    let state = v["state"].as_str().unwrap_or("?");
    let by = v["by"].as_str().unwrap_or("ein Chat");
    if !RELEASE_SEEN.lock().unwrap_or_else(|e| e.into_inner()).insert(format!("{key}|{ver}|{state}")) { return None; }
    if release_throttled(ver, state, now()) { return None; }
    let what = match state {
        "building" => "wird gerade gebaut",
        "built" => "ist gebaut und wird gleich veroeffentlicht",
        "publishing" => "wird gerade veroeffentlicht",
        "published" => "ist veroeffentlicht (in AdiCode auf Aktualisieren klicken)",
        "failed" => "ist fehlgeschlagen",
        _ => state,
    };
    let warn = if matches!(state, "building" | "built" | "publishing") { " Nicht parallel releasen; uncommittete Aenderungen in build-src landen sonst im naechsten Patch. Details: adicode_status -> release." } else { "" };
    Some(format!("[AdiCode-Release] Version {ver} {what} (von {by}).{warn}"))
}
fn notice_marker() -> std::path::PathBuf { crate::platform::installation_root().join("logs").join("update-notice.txt") }

/// Vor dem Update-Neustart: alle Tabs warnen und ihnen kurz Zeit geben, den Hinweis abzuholen.
pub(crate) async fn announce_update(version: &str) {
    set_notice(&format!("AdiCode wird jetzt auf Version {version} aktualisiert. Die Verbindung ist ca. 10 Sekunden weg. Bitte kurz warten und einen fehlgeschlagenen Tool-Aufruf danach einfach wiederholen."), 120);
    let marker = notice_marker();
    if let Some(dir) = marker.parent() { let _ = std::fs::create_dir_all(dir); }
    let _ = std::fs::write(&marker, format!("{}\n{version}", now()));
    let wait = if crate::updater::bridge_busy() { 20 } else { 8 };
    tokio::time::sleep(std::time::Duration::from_secs(wait)).await;
}

/// Nach dem Neustart: einmal pro Tab melden, dass das Update fertig ist.
pub(crate) fn startup_notice() {
    let marker = notice_marker();
    let Ok(s) = std::fs::read_to_string(&marker) else { return };
    let _ = std::fs::remove_file(&marker);
    let mut l = s.lines();
    let ts: i64 = l.next().and_then(|t| t.trim().parse().ok()).unwrap_or(0);
    let v = l.next().unwrap_or("").trim().to_string();
    if now() - ts < 900 {
        set_notice(&format!("Update auf AdiCode {v} ist fertig, die Verbindung steht wieder. Falls ein Tool-Aufruf waehrend des Updates fehlgeschlagen ist, bitte einmal wiederholen."), 600);
    }
}

