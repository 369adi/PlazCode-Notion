//! AdiCode Co-Work 2.0: four isolated Notion profiles with automatic roles and CDP kickoff.
use axum::{response::IntoResponse, Json};
use futures::{SinkExt, StreamExt};
use once_cell::sync::Lazy;
use serde::{Deserialize, Serialize};
use serde_json::{json, Value};
use std::{collections::{BTreeMap, HashSet}, path::PathBuf, sync::{atomic::{AtomicBool, Ordering}, Mutex}, time::Duration};

pub(crate) const NOTION_URL: &str = "https://www.notion.so/ai";
const MAX_TABS: u32 = 8;
static ACCOUNT: Lazy<Mutex<BTreeMap<u32, Value>>> = Lazy::new(|| Mutex::new(BTreeMap::new()));
static COWORK_STATUS: Lazy<Mutex<String>> = Lazy::new(|| Mutex::new("Bereit.".into()));
static KEEPER_STARTED: AtomicBool = AtomicBool::new(false);
static NUDGER_STARTED: AtomicBool = AtomicBool::new(false);
static USAGE_STARTED: AtomicBool = AtomicBool::new(false);
static AUTO_MCP_STARTED: AtomicBool = AtomicBool::new(false);
/// Tabs, die der Nutzer selbst bedient ("Selbst schreiben"): kein Nudger, kein Watchdog.
static PAUSED: Lazy<Mutex<HashSet<u32>>> = Lazy::new(|| Mutex::new(HashSet::new()));
fn auto_mcp_file() -> PathBuf { base().join("auto-mcp") }
pub(crate) fn auto_mcp_on() -> bool { auto_mcp_file().exists() }
pub(crate) fn is_paused(id: u32) -> bool { lock(&PAUSED).contains(&id) || skipped(id) }
fn skip_file()->PathBuf{base().join("skip-tabs")}
/// Ausgesetzte Tabs (Datei profiles/skip-tabs): kein Check, kein Start, keine Prompts, Fenster wird nie versteckt.
pub(crate) fn skipped(id:u32)->bool{std::fs::read_to_string(skip_file()).map(|s|s.split(|c:char|!c.is_ascii_digit()).any(|x|x==id.to_string())).unwrap_or(false)}
fn set_skip(id:u32,on:bool)->Result<String,String>{let mut ids:Vec<u32>=std::fs::read_to_string(skip_file()).unwrap_or_default().split(|c:char|!c.is_ascii_digit()).filter_map(|x|x.parse().ok()).collect();ids.retain(|x|*x!=id);if on{ids.push(id);}std::fs::create_dir_all(base()).map_err(|e|e.to_string())?;std::fs::write(skip_file(),ids.iter().map(|x|x.to_string()).collect::<Vec<_>>().join(",")).map_err(|e|e.to_string())?;tl(&format!("tab{id} skip={on}"));Ok(if on{format!("Tab {id} setzt aus: kein Check, kein Start, keine Prompts.")}else{format!("Tab {id} macht wieder mit.")})}
/// Alle Checks gruen: alle Notion-Fenster (auch Main) verstecken; der AdiCode-Chat steuert Main weiter per CDP.
fn hide_all_tabs(tabs:&[Tab]){let h:Vec<Tab>=tabs.iter().filter(|t|!skipped(t.id)).cloned().collect();if !h.is_empty(){windows::set_hidden(&h,true);}crate::notion_chat::set_main_hidden(true);}
/// Laufendes Co-Work: Kontext fuer den Chat, in dem der Nutzer zuerst schreibt (hier: AdiCode-Chat) - dieser Chat leitet dann.
pub(crate) fn cowork_main_context()->Option<String>{let s=STAGE.load(std::sync::atomic::Ordering::SeqCst);if !(2..=5).contains(&s){return None;}let tabs=load();let t=tabs.get(main_index()).cloned()?;if !claim_lead(t.id){return None;}Some(prompt_for(&t).replace(" Antworte jetzt nur: Co-Work bereit.",""))}
fn hide_workers(tabs:&[Tab]){let h:Vec<Tab>=tabs.iter().filter(|t|!is_main(t)&&!skipped(t.id)).cloned().collect();if !h.is_empty(){windows::set_hidden(&h,true);}}
/// Zeitprotokoll fuer Messungen: profiles/timeline.log
fn tl(s:&str){use std::io::Write;if let Ok(mut f)=std::fs::OpenOptions::new().create(true).append(true).open(base().join("timeline.log")){let _=f.write_all(format!("{} {}\n",chrono::Local::now().format("%H:%M:%S%.3f"),s).as_bytes());}}
/// Dauerhaftes Gedaechtnis pro Gmail-Konto: einmal bestaetigter MCP/Modell-Check wird nicht wiederholt.
static STAGE:std::sync::atomic::AtomicU32=std::sync::atomic::AtomicU32::new(0);
fn stage(n:u32){tl(&format!("STAGE {n}"));STAGE.store(n,std::sync::atomic::Ordering::SeqCst);}
fn step(id:u32,n:u32){mark_account(id,"step",json!(n));}
/// CDP-Port stabil pro Tab-ID statt pro Listenposition. Vorher: nach Entfernen/Hinzufuegen von Tabs bekam ein neuer Tab den Port eines anderen, laufenden Kontos -> Login-Vorschau zeigte fremdes Konto.
pub(crate) fn cdp_port(i: usize) -> u16 { if cfg!(test){return 9301 + i as u16;} port_for_id(load().get(i).map(|t|t.id).unwrap_or(i as u32 + 1)) }
pub(crate) fn port_for_id(id: u32) -> u16 { 9300 + id.clamp(1, MAX_TABS) as u16 }
static LEAD_CHATS:Lazy<Mutex<BTreeMap<String,String>>>=Lazy::new(||Mutex::new(BTreeMap::new()));
/// Co-Work: merkt, dass im Worker-Tab `worker` gerade der Lead-Chat `lead` laeuft (wird dann nie als Worker geweckt).
pub(crate) fn set_lead_chat(worker:&str,lead:&str){lock(&LEAD_CHATS).insert(worker.to_string(),lead.to_string());}
pub(crate) fn lead_chat_of(worker:&str)->Option<String>{lock(&LEAD_CHATS).get(worker).cloned()}
static LEAD:std::sync::atomic::AtomicU32=std::sync::atomic::AtomicU32::new(0);
/// Co-Work-Leiter: der Tab, in dem der Nutzer zuerst geschrieben hat (0 = noch keiner). Es gibt keinen festen Main mehr.
pub(crate) fn lead_id()->u32{LEAD.load(Ordering::SeqCst)}
fn set_lead(id:u32){tl(&format!("LEAD {id}"));LEAD.store(id,Ordering::SeqCst);}
fn claim_lead(id:u32)->bool{if id==0{return false;}if LEAD.compare_exchange(0,id,Ordering::SeqCst,Ordering::SeqCst).is_ok(){tl(&format!("LEAD {id}"));return true;}lead_id()==id}
/// Privacy: blockt beim Seitenstart alle Telemetrie-/Tracking-Sendetwege (sendBeacon, fetch, XHR)
/// zu Drittanbietern (Datadog, Segment, Sentry, Statsig, Amplitude). Notion-API (notion.so/com) bleibt frei.
const BLOCK_TELEMETRY_JS:&str=r#"(()=>{const blocked=u=>{try{if(typeof u!=='string')u=String(u);if(!/^https?:/i.test(u))return false;const h=new URL(u).hostname;return h==='api.segment.io'||h==='api.amplitude.com'||h==='cdn.pendo.io'||/\.ingest\.sentry\.io$/.test(h)||/\.browser-intake\.datadoghq\.com$/.test(h)||/\.statsigamplitude\.com$/.test(h)||h==='statsig.an.net'||h==='featuregates.org'||h==='events.statsigapi.net'||/^(www\.)?google-analytics\.com$/.test(h);}catch(e){return false}return false};const oldBeacon=navigator.sendBeacon?navigator.sendBeacon.bind(navigator):null;if(oldBeacon){navigator.sendBeacon=(u,d)=>!blocked(u)&&oldBeacon(u,d);}if(window.fetch){const of=window.fetch.bind(window);window.fetch=(i,init)=>{const u=typeof i==='string'?i:(i&&i.url)||'';return blocked(u)?Promise.resolve(new Response('',{status:204})):of(i,init);};}const XO=window.XMLHttpRequest;if(XO){const os=XO.prototype.open;XO.prototype.open=function(m,u,...r){if(!blocked(u)){return os.call(this,m,u,...r);}this.__blocked=true;return os.call(this,m,'about:blank',...r);};}window.__acPriv=true;return 1})()"#;
const TRIAL_JS:&str=r#"(async()=>{const post=(p,b)=>fetch('/api/v3/'+p,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(b||{})}).then(r=>r.ok?r.json():null).catch(()=>null);const sp=await post('getSpaces',{});if(!sp)return {ok:false};const uid=Object.keys(sp)[0];const sid=Object.keys((sp[uid]||{}).space||{})[0];if(!sid)return {ok:false};const v=sp[uid].space[sid];const sv=(v.value&&v.value.value)||v.value||v;const d=await post('getSubscriptionData',{spaceId:sid});if(!d)return {ok:false};const cd=d.customerData||{};const sub=!!(cd.isSubscribed===true||/^subscribed/.test(d.type||''));const paid=!!(d.hasPaidNonzero||cd.hasPaidNonzero);return {ok:true,sub,paid,tier:d.subscriptionTier||sv.subscription_tier||null,plan:sv.plan_type||null}})()"#;
/// Trial-Check: Abo aktiv, aber noch nie etwas bezahlt = Trial.
async fn check_entitlement(t:&Tab,i:usize){
    match js_eval(cdp_port(i),TRIAL_JS).await{
        Ok(r) if r["ok"].as_bool().unwrap_or(false)=>{let sub=r["sub"].as_bool().unwrap_or(false);let paid=r["paid"].as_bool().unwrap_or(false);
            let tier=r["tier"].as_str().unwrap_or("");
            if sub&&!paid&&tier!="free"{mark_account(t.id,"trial",json!(true));mark_account(t.id,"trial_state",json!(format!("Entitlement aktiv ({tier})")));}
            else if sub{mark_account(t.id,"trial",json!(false));mark_account(t.id,"trial_state",json!(format!("Bezahlter Plan ({tier}) - kein Trial")));}
            else{mark_account(t.id,"trial",json!(false));mark_account(t.id,"trial_state",json!("Kein aktives Entitlement (Free-Plan)"));}}
        _=>{mark_account(t.id,"trial",Value::Null);mark_account(t.id,"trial_state",json!("Trial-Status nicht lesbar"));}
    }
}
const USAGE_UI_JS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const byText=(re,sel)=>[...document.querySelectorAll(sel||'div[role="button"],div[role="menuitem"],[role="tab"],button,a')].filter(vis).find(e=>re.test((e.innerText||'').trim().split('\n')[0]));const dlgOpen=()=>document.querySelector('input[aria-label="Search settings"],input[placeholder="Search settings"],input[aria-label="Einstellungen durchsuchen"]');try{if(!dlgOpen()){let st=byText(/^(settings|einstellungen)$/i);if(!st){const sw=document.querySelector('.notion-sidebar-switcher,[class*="switcher"]')||byText(/space$/i);if(sw){sw.click();await sleep(900);}st=byText(/^(settings|einstellungen)$/i);}if(!st)return {found:false,error:'Einstellungen nicht gefunden'};st.click();await sleep(1500);}const ai=byText(/^notion ai$|^notion-ki$|^notion ki$/i);if(ai){(ai.closest('[role="tab"]')||ai).click();}let us=null;for(let k=0;k<12&&!us;k++){await sleep(500);us=byText(/^(usage|verwendung|nutzung)/i);}if(!us)return {found:false,error:'Usage-Tab nicht gefunden'};us.click();await sleep(2500);const d=(dlgOpen()||document.body).closest('[role="dialog"]')||document.body;const t=d.innerText||'';const m=t.match(/(\d+(?:[.,]\d+)?)\s*%\s*(used|verwendet|genutzt|benutzt)/i);const r=t.match(/(Resets on [^\n]+|Zurückgesetzt[^\n]*|Wird [^\n]*zurückgesetzt[^\n]*|Neustart [^\n]+)/i);if(!m)return {found:false,error:'Keine Prozentangabe gefunden'};return {found:true,pct:parseFloat(m[1].replace(',','.')),reset:r?r[1].trim():null}}catch(e){return {found:false,error:String(e&&e.message||e)}}})()"#;
const CHATS_JS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const re=/^(welcome to notion|willkommen (bei|in|zu) notion|tab \d+( kontext \d+)?$)/i;const seen=new Set();let welcome=0;try{if(![...document.querySelectorAll('[role="menuitem"]')].some(vis)){const sb=[...document.querySelectorAll('[role="button"],button')].find(b=>vis(b)&&/^(seitenleiste .ffnen|open sidebar)$/i.test(b.getAttribute('aria-label')||''));if(sb){sb.click();await sleep(1200)}}const tab=document.querySelector('#sidebar-tab-chats,[role="tab"][aria-label="Chat"],[role="tab"][aria-label="Chats"]');if(tab&&tab.getAttribute('aria-selected')!=='true'){tab.click();await sleep(1200);}for(let k=0;k<8;k++){for(const e of document.querySelectorAll('[role="menuitem"]')){if(!vis(e)||e.closest('[role="dialog"]')||e.getBoundingClientRect().left>420)continue;const tx=(e.innerText||'').trim().split('\n')[0];if(!tx||/^hide tab name$/i.test(tx))continue;const sc0=[...document.querySelectorAll('[role="menu"],[role="tabpanel"],[role="list"]')].find(x=>vis(x)&&x.scrollHeight>x.clientHeight+20);seen.add(tx+'#'+(re.test(tx)?'w':'o')+'@'+Math.round(e.getBoundingClientRect().top+(sc0?sc0.scrollTop:0)))}const sc=[...document.querySelectorAll('[role="menu"],[role="tabpanel"],[role="list"]')].find(e=>vis(e)&&e.scrollHeight>e.clientHeight+20);if(!sc)break;sc.scrollTop+=500;await sleep(400)}const all=[...seen];const total=all.length;welcome=all.filter(x=>x.includes('#w@')).length;const hasNew=[...document.querySelectorAll('[role=\"button\"]')].some(e=>vis(e)&&/^(new chat|neuer chat)$/i.test((e.innerText||'').trim()));return {ok:total>0||hasNew,total,welcome}}catch(e){return {ok:false,error:String(e&&e.message||e)}}})()"#;
async fn check_usage_ui(t:&Tab,i:usize){
    let port=cdp_port(i);
    open_settings(port).await;
    match js_eval(port,USAGE_UI_JS).await{
        Ok(r) if r["found"].as_bool().unwrap_or(false)=>{mark_account(t.id,"ui_pct",r["pct"].clone());mark_account(t.id,"usage",r["pct"].clone());mark_account(t.id,"usage_source",json!("Einstellungen \u{2192} Notion KI \u{2192} Usage (Monthly)"));mark_account(t.id,"usage_error",Value::Null);mark_account(t.id,"usage_reset",r["reset"].clone());}
        Ok(r)=>{mark_account(t.id,"usage_error",r["error"].clone());}
        Err(e)=>{mark_account(t.id,"usage_error",json!(e));}
    }
    close_settings(port).await;
}
const REFRESH_JS:&str=r#"(async()=>{const GO=__GO__;const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const byText=(re,sel)=>[...document.querySelectorAll(sel||'div[role=button],div[role=menuitem],[role=tab],button,a')].filter(vis).find(e=>re.test((e.innerText||'').trim().split('\n')[0]));const dlgOpen=()=>document.querySelector('input[aria-label^=Search],input[aria-label^=Einstellungen]');try{if(!dlgOpen()){let st=byText(/^(settings|einstellungen)$/i);if(!st){const sw=document.querySelector('.notion-sidebar-switcher,[class*=switcher]')||byText(/space$/i);if(sw){sw.click();await sleep(900)}st=byText(/^(settings|einstellungen)$/i)}if(!st)return {ok:false,msg:'Einstellungen nicht gefunden'};st.click();await sleep(1500)}const d=dlgOpen().closest('[role=dialog]');const acc=[...d.querySelectorAll('[role=tab]')].filter(vis)[0];if(!acc)return {ok:false,msg:'Konto-Tab nicht gefunden'};acc.click();await sleep(1500);const btn=[...d.querySelectorAll('[role=button],button')].filter(vis).find(e=>/^(delete my account|mein konto l.schen|konto l.schen)/i.test((e.innerText||'').trim()));if(!btn)return {ok:false,msg:'Konto-loeschen-Button nicht gefunden'};btn.click();await sleep(1500);const dl=[...document.querySelectorAll('[role=dialog]')].filter(vis).pop();const txt=dl?dl.innerText:'';const inp=dl&&dl.querySelector('input,textarea');if(!inp)return {ok:false,msg:'Kein Eingabefeld im Loeschdialog: '+txt.slice(0,300)};let name=inp.placeholder||'';if(!name){const m=txt.match(/[\u0022\u201c\u201e']([^\u0022\u201d\u201c'\n]{2,60})[\u0022\u201d']/);name=m?m[1]:''}if(!name)return {ok:false,msg:'Workspace-Name nicht erkannt: '+txt.slice(0,300)};if(!GO)return {ok:true,msg:'Dry-run: '+name};const setv=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;setv.call(inp,name);inp.dispatchEvent(new Event('input',{bubbles:true}));await sleep(700);const ok=[...dl.querySelectorAll('[role=button],button')].filter(vis).find(e=>/delete|l.schen/i.test((e.innerText||'').trim())&&!/cancel|abbrechen/i.test(e.innerText||'')&&e.getAttribute('aria-disabled')!=='true');if(!ok)return {ok:false,msg:'Bestaetigen-Button nicht aktiv'};ok.click();await sleep(2500);return {ok:true,msg:'Konto geloescht: '+name}}catch(e){return {ok:false,msg:String(e&&e.message||e)}}})()"#;
async fn refresh_account(t:Tab,i:usize){let port=cdp_port(i);if !wait_cdp(port).await{mark_account(t.id,"refresh_state",json!("Tab nicht erreichbar"));return;}let js=REFRESH_JS.replace("__GO__","true");match js_eval(port,&js).await{Ok(r)=>{let ok=r["ok"].as_bool().unwrap_or(false);let msg=r["msg"].as_str().unwrap_or("").to_string();mark_account(t.id,"refresh_state",json!(msg.clone()));mark_account(t.id,"check",json!(msg));if ok{mem_forget(&t.email);mark_account(t.id,"chat_ok",json!(false));mark_account(t.id,"refresh_state",json!("Konto gel\u{f6}scht - Gmail-Login mit derselben E-Mail wird ge\u{f6}ffnet ..."));tokio::time::sleep(human_sleep(Duration::from_secs(45),60)).await;let _=login_view(t.clone());post_refresh_setup(t.clone(),i).await;}}Err(e)=>{mark_account(t.id,"refresh_state",json!(e.to_string()));}}}
const SETUP_JS:&str=r#"(async()=>{const PH='__PH__';const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const norm=x=>(x.innerText||'').trim().replace(/\s+/g,' ');const clickT=(re,root,sel)=>{const e=[...(root||document).querySelectorAll(sel||'div[role=button],button,a,[role=tab],[role=menuitem],[role=radio],label')].filter(vis).find(x=>re.test(norm(x))&&!/^(skip to content|zum inhalt springen)$/i.test(norm(x)));if(e){if(PH==='onboard'){const ck=re.source+'|'+body.slice(0,300);window.__clk=window.__clk||{};if(Date.now()-(window.__clk[ck]||0)<20000)return true;window.__clk[ck]=Date.now()}e.click();return true}return false};const body=document.body.innerText||'';const dlgs=[...document.querySelectorAll('[role=dialog]')].filter(vis);const dlg=dlgs.length?dlgs[dlgs.length-1]:null;const dlgOpen=()=>document.querySelector('input[aria-label^=Search],input[aria-label^=Einstellungen]');const openSettings=async()=>{if(dlgOpen())return true;let st=[...document.querySelectorAll('div[role=button],div[role=menuitem],[role=tab],button,a')].filter(vis).find(e=>/^(settings|einstellungen)$/i.test(norm(e)));if(!st){const sw=document.querySelector('.notion-sidebar-switcher,[class*=switcher]');if(sw){sw.click();await sleep(900)}st=[...document.querySelectorAll('div[role=button],div[role=menuitem],[role=tab],button,a')].filter(vis).find(e=>/^(settings|einstellungen)$/i.test(norm(e)))}if(!st)return false;st.click();await sleep(1500);return !!dlgOpen()};const tab=async(re)=>{const d=dlgOpen().closest('[role=dialog]');const t=[...d.querySelectorAll('[role=tab]')].filter(vis).find(e=>re.test(norm(e)));if(!t)return false;t.click();await sleep(1500);return true};try{if(PH==='onboard'){if(document.readyState==='complete'&&(document.body.innerText||'').trim().length<40&&!document.querySelector('#sidebar-tab-chats')){const k=+sessionStorage.getItem('__blank')||0;if(!k){sessionStorage.setItem('__blank',String(Date.now()))}else if(Date.now()-k>8000){sessionStorage.setItem('__blank','0');if(location.pathname==='/'||location.pathname===''){location.reload()}else{location.href=location.origin+'/'}return {state:'reload'}}return {state:'blank'}}sessionStorage.setItem('__blank','0');if(/cookie preferences|cookie-einstellungen/i.test(body)&&clickT(/^(okay|ok)$/i)){return {state:'cookie-ok'}}if(/cookie notice|cookie-hinweis/i.test(body)&&clickT(/^(reject all|alle ablehnen)$/i)){return {state:'cookie'}}if(/cookie preferences|cookie-einstellungen/i.test(body)){return {state:'cookie-wait'}}if(/notion\.(so|com)$/.test(location.host)&&document.querySelector('input[type=email]')&&!document.querySelector('#sidebar-tab-chats')){if(!window.__gclick||Date.now()-window.__gclick>8000){if(clickT(/^(continue with google|weiter mit google|mit google fortfahren|google)$/i)){window.__gclick=Date.now();return {state:'notion-google'}}}return {state:'login'}}if(/accounts\.google\.com/.test(location.host)){const em='__EM__';if(/That.s an error|Das ist ein Fehler|(^|[^0-9])400([^0-9]|$)/i.test(body)&&!document.querySelector('[data-identifier],[data-email]')&&body.length<600){return {state:'google-error'}}const acs=[...document.querySelectorAll('[data-identifier],[data-email]')].filter(e=>(e.getAttribute('data-identifier')||e.getAttribute('data-email'))===em);const acv=acs.filter(vis);const ac=acv[acv.length-1]||acs[acs.length-1];if(ac){ac.click();return {state:'google-konto'}}if(clickT(/^(weiter|continue|fortfahren|zulassen|allow)$/i))return {state:'google-weiter'};return {state:'google'}}if(/What kind of work do you do|Welche Art von Arbeit/i.test(body)){clickT(/^(marketing)$/i);await sleep(500);clickT(/^(continue|weiter|fortfahren)$/i);return {state:'step-work'}}if(/What do you want to get done|Was m.chtest du erledigen/i.test(body)){clickT(/^(track projects and tasks|projekte und aufgaben)/i);await sleep(500);clickT(/^(continue|weiter|fortfahren)$/i);return {state:'step-goals'}}if(/Start with your real work|Starte mit deiner echten Arbeit/i.test(body)){clickT(/^(skip for now|vorerst .berspringen|.berspringen|sp.ter)/i);return {state:'step-connect'}}if(/Who else is on your team|Wer ist (sonst )?noch in deinem Team/i.test(body)){if(!clickT(/^(skip|skip for now|.berspringen)/i))clickT(/^(continue|weiter|fortfahren)$/i);return {state:'step-team'}}if(/Choose your plan|W.hle dein(en)? (Plan|Abo)/i.test(body)&&!/Try free for 30 days.*Skip/i.test(body)){clickT(/^(continue|weiter|fortfahren)$/i);return {state:'step-plan'}}if(/Notion is 50% faster|Desktop.?App/i.test(body)&&/Skip for now|.berspringen/i.test(body)){clickT(/^(skip for now|vorerst .berspringen|.berspringen|sp.ter)/i);return {state:'step-desktop'}}if(/How do you want to use Notion|Wie m.chtest du Notion/i.test(body)){clickT(/for work|f.r die arbeit|beruflich|arbeit/i);await sleep(600);clickT(/^(continue|weiter|fortfahren)$/i);return {state:'step1'}}if(/Start with your team|Notion works best|Mit deinem Team/i.test(body)){if(!clickT(/^(skip|skip for now|.berspringen|sp.ter)/i))clickT(/^(continue|weiter|fortfahren)$/i);return {state:'step2'}}if(/Choose your plan|W.hle dein(en)? (Plan|Abo)|Plan w.hlen/i.test(body)){clickT(/continue with free|mit .*kostenlos|kostenlos fortfahren/i);return {state:'step3'}}if(document.querySelector('.notion-sidebar,.notion-sidebar-container')&&!/Choose your plan|How do you want to use/i.test(body))return {state:'workspace'};return {state:'wait'}}if(PH==='trial'){if(!(await openSettings()))return {state:'noset'};if(!(await tab(/^(notion ai|notion-ki)/i)))return {state:'noai'};await tab(/^(ai connectors|ki-connectors|connectors)/i);if(!clickT(/^(try for free|kostenlos testen|gratis testen)/i,dlgOpen().closest('[role=dialog]')))return {state:'notry'};await sleep(2000);const d2=[...document.querySelectorAll('[role=dialog]')].filter(vis).pop();if(d2&&clickT(/^(try for free|kostenlos testen|gratis testen|start free trial)/i,d2)){await sleep(3500);return {state:'trialstarted'}}return {state:'nodlg'}}if(PH==='cancel'){if(!(await openSettings()))return {state:'noset'};let ok=await tab(/^(billing|abrechnung|plans|tarife|upgrade plan)/i);if(!ok)return {state:'nobilling'};await sleep(1200);const rootD=dlgOpen().closest('[role=dialog]');if(!clickT(/cancel (free )?trial|trial (beenden|k.ndigen)|testversion (beenden|k.ndigen)|cancel plan/i,rootD))return {state:'nocancel'};await sleep(1800);const d3=[...document.querySelectorAll('[role=dialog]')].filter(vis).pop();if(d3){clickT(/^(cancel (free )?trial|confirm|cancel plan|yes|best.tigen|beenden|k.ndigen)/i,d3);await sleep(2500)}return {state:'cancelled'}}return {state:'unknown'}}catch(e){return {state:'err',msg:String(e&&e.message||e)}}})()"#;
fn is_g(v:&Value)->bool{v["url"].as_str().unwrap_or("").contains("accounts.google.com")}
async fn google_close(port:u16){let list:Vec<Value>=match reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await{Ok(r)=>r.json().await.unwrap_or_default(),Err(_)=>return};let pages:Vec<Value>=list.into_iter().filter(|v|v["type"]=="page").collect();let others=pages.iter().filter(|v|!is_g(v)).count();for v in pages.iter().filter(|v|is_g(v)){if others>0{if let Some(id)=v["id"].as_str(){let _=reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json/close/{id}")).timeout(Duration::from_secs(3)).send().await;}}else if let Some(ws)=v["webSocketDebuggerUrl"].as_str(){let _=cdp_ws(ws,vec![json!({"method":"Page.navigate","params":{"url":"https://www.notion.so/login"}})]).await;}}}
async fn google_ws(port:u16)->Option<String>{let list:Vec<Value>=reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await.ok()?.json().await.ok()?;list.into_iter().filter(|v|{let o=chat_own();o.is_empty()||v["id"].as_str()!=Some(o.as_str())}).find(|v|v["type"]=="page"&&v["url"].as_str().unwrap_or("").contains("accounts.google.com")).and_then(|v|v["webSocketDebuggerUrl"].as_str().map(str::to_string))}
async fn setup_phase(port:u16,ph:&str,em:&str)->String{let js=SETUP_JS.replace("__PH__",ph).replace("__EM__",em);match (match google_ws(port).await{Some(ws)=>tokio::time::timeout(Duration::from_secs(8),cdp_ws(&ws,vec![json!({"method":"Runtime.evaluate","params":{"expression":js.as_str(),"awaitPromise":true,"returnByValue":true}})])).await.unwrap_or_else(|_|Err("Popup geschlossen".to_string())).map(|v|v.last().and_then(|x|x.pointer("/result/result/value")).cloned().unwrap_or(Value::Null)),None=>js_eval(port,&js).await}){Ok(r)=>{let st=r["state"].as_str().unwrap_or("?").to_string();if st=="google-error"{google_close(port).await;}if let Some(m)=r["msg"].as_str(){format!("{} {}",st,m)}else{st}}Err(e)=>format!("err {}",e)}}

/// Laeuft gerade eine Google-Login-Seite im Tab? (Nutzer meldet sich an - nicht stoeren.)
async fn on_google(port:u16)->bool{
    match reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await{
        Ok(r)=>r.json::<Vec<Value>>().await.map(|l|l.iter().any(|v|v["type"]=="page"&&v["url"].as_str().unwrap_or("").contains("accounts.google.com"))).unwrap_or(false),
        Err(_)=>false,
    }
}

async fn post_refresh_setup(t:Tab,i:usize){let port=cdp_port(i);mark_account(t.id,"refresh_state",json!("Warte auf Gmail-Login, dann Einrichtung ..."));let mut ws=false;let mut sg=false;let mut gone=0u32;for it in 0..240{tokio::time::sleep(human_sleep(Duration::from_millis(1500),50)).await;
    if target(port).await.is_err(){
        // FIX: Nutzer ist gerade auf accounts.google.com im Tab -> Sign-up/Login laufen lassen, nicht wegnavigieren.
        if on_google(port).await{gone=0;}
        else{gone+=1;if gone==2||gone%20==0{mark_account(t.id,"refresh_state",json!("Google-Login geschlossen \u{2013} Zum Chat automatisch ..."));goto_chat_auto(&t,i).await;}}
        continue;
    }
    gone=0;let st=setup_phase(port,"onboard",&t.email).await;if st.starts_with("google"){sg=true;}else if sg&&!st.starts_with("login")&&!st.starts_with("notion-google")&&!st.starts_with("err"){sg=false;mark_account(t.id,"refresh_state",json!("Notion wird nach dem Google-Login neu geladen"));let _=js_eval(port,"(()=>{location.href=location.origin+String.fromCharCode(47);return 1})()").await;tokio::time::sleep(Duration::from_secs(5)).await;continue;}if st.starts_with("workspace"){ws=true;break;}if it>=6&&!sg&&!["step","google","login","notion-google"].iter().any(|p|st.starts_with(p))&&logged_in(port).await{ws=true;break;}if st.starts_with("step"){mark_account(t.id,"refresh_state",json!(format!("Einrichtung: {}",st)));}}if !ws{mark_account(t.id,"refresh_state",json!("Einrichtung: Workspace nicht erreicht (Login pruefen)"));return;}tokio::time::sleep(Duration::from_secs(4)).await;mark_account(t.id,"refresh_state",json!("Login ok \u{2013} Check l\u{e4}uft (Trial, MCP, Modelle, Chat) \u{2026}"));match check_one(t.clone(),i).await{Ok(())=>{/* Kein Start-Prompt mehr in den Chat (legte teils einen neuen Chat an) */mark_account(t.id,"refresh_state",json!("Konto neu eingerichtet und gepr\u{fc}ft"));}Err(e)=>{mark_account(t.id,"refresh_state",json!(format!("Eingerichtet, aber: {e}")))}}}

/// Refresh: Google-Popup weg -> wie Knopf Zum Chat (Tab oeffnen bzw. auf Notion navigieren).
async fn goto_chat_auto(t:&Tab,i:usize){if !running_ids(std::slice::from_ref(t)).contains(&t.id){let _=launch(t,&start_url(t));}else if let Ok(ws)=any_target(cdp_port(i)).await{let _=cdp_ws(&ws,vec![json!({"method":"Page.navigate","params":{"url":start_url(t)}})]).await;}windows::set_hidden(std::slice::from_ref(t),false);}
pub(crate) const MCP_START_TEXT:&str="Verbinde dich mit AdiCode MCP Server.";
/// Letzter Refresh-Schritt: schreibt in den Willkommen-Chat, dass er sich mit AdiCode verbinden soll.
#[allow(dead_code)] async fn mcp_start_prompt(t:&Tab,i:usize)->Result<(),String>{mark_account(t.id,"mcp_start",json!("l\u{e4}uft"));let r=async{prepare_chat(t,i).await?;insert_prompt(cdp_port(i),MCP_START_TEXT.to_string()).await}.await;mark_account(t.id,"mcp_start",match &r{Ok(_)=>json!(true),Err(e)=>json!(format!("Fehler: {e}"))});r}
async fn check_chats(t:&Tab,i:usize){
    let port=cdp_port(i);for _ in 0..2{if js_eval(port,DIALOG_OPEN_JS).await.ok().and_then(|v|v.as_bool()).unwrap_or(false){press_key(port,"Escape","Escape",27,0).await;tokio::time::sleep(Duration::from_millis(400)).await;}}wait_ready(port,10).await;let mut res=js_eval(port,CHATS_JS).await;if res.as_ref().map(|r|r["total"].as_u64().unwrap_or(0)==0).unwrap_or(true){tokio::time::sleep(Duration::from_millis(1500)).await;res=js_eval(port,CHATS_JS).await;}
    match res{
        Ok(r) if r["ok"].as_bool().unwrap_or(false)=>{let total=r["total"].as_u64().unwrap_or(0);let w=r["welcome"].as_u64().unwrap_or(0);let multi=total>w||w>1;mark_account(t.id,"chats_none",json!(total==0));mark_account(t.id,"chats_total",json!(total));mark_account(t.id,"chats_welcome",json!(w));mark_account(t.id,"chats_multi",json!(multi));mark_account(t.id,"chats_state",json!(if total==0{"Kein Chat vorhanden".to_string()}else if multi{format!("{total} Chats offen (davon {w} Willkommen) - mehr als nur Willkommen")}else{"Nur der Chat Willkommen bei Notion".to_string()}));}
        _=>{mark_account(t.id,"chats_multi",Value::Null);mark_account(t.id,"chats_state",json!("Chat-Liste nicht lesbar"));}
    }
}
fn accounts_file()->PathBuf{base().join("accounts.json")}
fn mem_all()->Value{std::fs::read_to_string(accounts_file()).ok().and_then(|s|serde_json::from_str::<Value>(&s).ok()).filter(Value::is_object).unwrap_or_else(||json!({}))}
fn mem_get(email:&str,k:&str)->Value{mem_all().get(email.to_lowercase().as_str()).and_then(|e|e.get(k)).cloned().unwrap_or(Value::Null)}
fn mem_set(email:&str,k:&str,v:Value){if email.is_empty(){return;}let mut all=mem_all();let key=email.to_lowercase();if !all[key.as_str()].is_object(){all[key.as_str()]=json!({});}all[key.as_str()][k]=v;let _=std::fs::create_dir_all(base());let _=std::fs::write(accounts_file(),serde_json::to_vec_pretty(&all).unwrap_or_default());}
fn mem_forget(email:&str){let keep=mem_get(email,"lang_en");mem_forget_all(email);if keep.as_bool()==Some(true){mem_set(email,"lang_en",json!(true));}}
fn mem_forget_all(email:&str){acc_cache_clear(email);let mut all=mem_all();if let Some(o)=all.as_object_mut(){o.remove(&email.to_lowercase());}let _=std::fs::write(accounts_file(),serde_json::to_vec_pretty(&all).unwrap_or_default());}
fn acc_cache_file()->PathBuf{base().join("account-cache.json")}
fn acc_cache()->Value{std::fs::read_to_string(acc_cache_file()).ok().and_then(|s|serde_json::from_str::<Value>(&s).ok()).filter(Value::is_object).unwrap_or_else(||json!({}))}
const PERSIST:[&str;23]=["ai_off","mcp","mcp_saved","model_ok","model_state","chat","chat_ok","chats_none","chats_total","chats_welcome","chats_multi","chats_state","trial","trial_state","usage","used","limit","exhausted","usage_source","usage_reset","lang","cookie","last_check"];
fn acc_persist(id:u32,k:&str,v:&Value){if !PERSIST.contains(&k){return;}let Some(em)=load().into_iter().find(|t|t.id==id).map(|t|t.email.to_lowercase()).filter(|e|!e.is_empty()) else {return};let mut c=acc_cache();if !c[em.as_str()].is_object(){c[em.as_str()]=json!({});}c[em.as_str()][k]=v.clone();let _=std::fs::write(acc_cache_file(),serde_json::to_vec_pretty(&c).unwrap_or_default());}
fn acc_cache_clear(email:&str){let mut c=acc_cache();if let Some(o)=c.as_object_mut(){o.remove(&email.to_lowercase());}let _=std::fs::write(acc_cache_file(),serde_json::to_vec_pretty(&c).unwrap_or_default());}
fn mark_account(id: u32, k: &str, v: Value) { acc_persist(id,k,&v); if matches!(k,"check"|"refresh_state"|"trial_state"|"model_state"|"chat"|"mcp"|"step"|"usage_error"){tl(&format!("tab{id} {k}={v}"));} let mut a = lock(&ACCOUNT); let e=a.entry(id).or_insert_with(|| json!({"usage": null, "models": []})); if k=="check"{e["check_since"]=json!(chrono::Utc::now().timestamp());} e[k] = v; }

#[derive(Serialize, Deserialize, Clone, Default, Debug, PartialEq)]
#[serde(default)]
pub struct Tab {
    pub id: u32,
    pub label: String,
    pub email: String,
    pub role: String,
    pub url: String,
    pub autostart: bool,
}

fn base() -> PathBuf {
    let root = std::env::var_os("LOCALAPPDATA").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
    root.join("PlazCodeNotion").join("profiles")
}
fn dir(id: u32) -> PathBuf { base().join(format!("agent-{id}")) }
fn tabs_file() -> PathBuf { base().join("tabs.json") }
fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> { m.lock().unwrap_or_else(|e| e.into_inner()) }
/// Menschliche Pausen-Streuung: Basis-Dauer mit zufaelliger Abweichung (+/- spread Prozent),
/// damit Monitoring-Intervalle nicht wie eine Uhr laufen und API-Aufrufe natuerlicher wirken.
fn human_sleep(base: Duration, spread_pct: u64) -> Duration {
    let mut n = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.subsec_nanos() as u64).unwrap_or(0);
    n ^= std::process::id() as u64;
    let var = if spread_pct == 0 { 0 } else { ((n % (spread_pct * 2 + 1)) as i64) - (spread_pct as i64) };
    let ms = (((base.as_millis() as i128) * ((100 + var) as i128)) / 100).max(250) as u64;
    Duration::from_millis(ms)
}
fn parse_id(name: &str) -> Option<u32> { name.strip_prefix("agent-").and_then(|x| x.parse::<u32>().ok()).filter(|n| (1..=MAX_TABS).contains(n)) }
fn dir_ids() -> Vec<u32> {
    let mut v: Vec<u32> = std::fs::read_dir(base()).map(|rd| rd.flatten().filter(|e| e.path().is_dir()).filter_map(|e| parse_id(&e.file_name().to_string_lossy())).collect()).unwrap_or_default();
    v.sort_unstable(); v
}
fn normalize(tabs: &mut [Tab]) { for (n, t) in tabs.iter_mut().enumerate() { t.role = format!("Tab {}", n + 1); } }

pub fn load() -> Vec<Tab> {
    let mut tabs: Vec<Tab> = std::fs::read_to_string(tabs_file()).ok().and_then(|t| serde_json::from_str(t.trim_start_matches('\u{feff}')).ok()).unwrap_or_default();
    tabs.retain(|t| (1..=MAX_TABS).contains(&t.id));
    for id in dir_ids() {
        if tabs.len() >= MAX_TABS as usize { break; }
        if !tabs.iter().any(|t| t.id == id) {
            let label = std::fs::read_to_string(dir(id).join("plazcode-label.txt")).map(|s| s.trim().to_string()).unwrap_or_default();
            tabs.push(Tab { id, label: if label.is_empty() { format!("Tab {id}") } else { label }, autostart: true, ..Default::default() });
        }
    }
    normalize(&mut tabs); tabs
}
fn save(tabs: &[Tab]) -> Result<(), String> {
    std::fs::create_dir_all(base()).map_err(|e| e.to_string())?;
    let mut tabs = tabs.to_vec(); normalize(&mut tabs);
    let tmp = tabs_file().with_extension("json.tmp");
    std::fs::write(&tmp, serde_json::to_vec_pretty(&tabs).map_err(|e| e.to_string())?).map_err(|e| e.to_string())?;
    std::fs::rename(&tmp, tabs_file()).map_err(|e| e.to_string())
}
fn clean(s: &str, max: usize) -> String { s.trim().chars().filter(|c| !c.is_control()).take(max).collect::<String>().trim().to_string() }
fn sanitize(t: &Tab) -> Result<Tab, String> {
    let email = clean(&t.email, 120).to_ascii_lowercase();
    if !email.is_empty() && (!email.contains('@') || email.contains(' ') || email.starts_with('@') || email.ends_with('@')) { return Err(format!("Tab {}: ungültige E-Mail-Adresse.", t.id)); }
    let url = clean(&t.url, 300);
    if !url.is_empty() && !url.starts_with("https://") { return Err(format!("Tab {}: Die Startseite muss mit https:// beginnen.", t.id)); }
    let label = clean(&t.label, 40);
    Ok(Tab { id: t.id, label: if label.is_empty() { format!("Tab {}", t.id) } else { label }, email, role: String::new(), url, autostart: t.autostart })
}

const BROWSERS: [(&str, &str); 3] = [("Chrome", r"Google\Chrome\Application\chrome.exe"), ("Edge", r"Microsoft\Edge\Application\msedge.exe"), ("Brave", r"BraveSoftware\Brave-Browser\Application\brave.exe")];
fn browser_file() -> PathBuf { base().join("browser") }
fn token_file() -> PathBuf { base().join("token-mode") }
fn token_high() -> bool { std::fs::read_to_string(token_file()).map(|s| s.trim()=="high").unwrap_or(false) }
/// Alle installierten Browser, die Co-Work nutzen kann.
pub fn installed_browsers() -> Vec<(&'static str, PathBuf)> {
    let mut out = Vec::new();
    for (name, rel) in BROWSERS {
        for k in ["ProgramFiles", "ProgramFiles(x86)", "LOCALAPPDATA"] {
            if let Some(b) = std::env::var_os(k) { let p = PathBuf::from(b).join(rel); if p.is_file() { out.push((name, p)); break; } }
        }
    }
    out
}
pub fn chosen_browser() -> Option<String> { std::fs::read_to_string(browser_file()).ok().map(|s| s.trim().to_string()).filter(|s| !s.is_empty()) }
/// Der vom Nutzer gewaehlte Browser. Ohne Auswahl startet kein Tab.
pub fn browser() -> Option<(&'static str, PathBuf)> { let c = chosen_browser()?; installed_browsers().into_iter().find(|(n, _)| n.eq_ignore_ascii_case(&c)) }
pub fn browser_name() -> Value { browser().map(|(n, _)| json!(n)).unwrap_or(Value::Null) }
pub fn list() -> Value { json!(load().into_iter().map(|t| json!({"id":t.id,"label":t.label})).collect::<Vec<_>>()) }

fn cmd_uses(cmd: &str, dir: &str) -> bool {
    let (cmd, dir) = (cmd.to_ascii_lowercase(), dir.to_ascii_lowercase());
    cmd.match_indices(&dir).any(|(i, _)| !cmd[i + dir.len()..].starts_with(|c: char| !c.is_ascii_digit()))
}
fn browser_cmds() -> Vec<(sysinfo::Pid, String)> {
    use sysinfo::{ProcessRefreshKind, ProcessesToUpdate, System, UpdateKind};
    let mut sys = System::new(); sys.refresh_processes_specifics(ProcessesToUpdate::All, true, ProcessRefreshKind::new().with_cmd(UpdateKind::Always));
    sys.processes().iter().filter_map(|(pid,p)| { let cmd=p.cmd().iter().map(|a|a.to_string_lossy().to_string()).collect::<Vec<_>>().join(" "); cmd.contains("--user-data-dir=").then_some((*pid,cmd)) }).collect()
}
fn running_ids(tabs: &[Tab]) -> Vec<u32> { let cmds=browser_cmds(); tabs.iter().filter(|t| {let d=dir(t.id).display().to_string();cmds.iter().any(|(_,c)|cmd_uses(c,&d))}).map(|t|t.id).collect() }
fn stop_ids(ids: &[u32]) -> usize {
    use sysinfo::{ProcessRefreshKind, ProcessesToUpdate, System, UpdateKind};
    let mut sys=System::new();sys.refresh_processes_specifics(ProcessesToUpdate::All,true,ProcessRefreshKind::new().with_cmd(UpdateKind::Always));
    let dirs:Vec<String>=ids.iter().map(|i|dir(*i).display().to_string()).collect(); let mut n=0;
    for p in sys.processes().values(){let cmd=p.cmd().iter().map(|a|a.to_string_lossy().to_string()).collect::<Vec<_>>().join(" ");if cmd.contains("--user-data-dir=")&&dirs.iter().any(|d|cmd_uses(&cmd,d))&&p.kill(){n+=1;}}
    n
}

#[cfg(windows)]
pub(crate) mod windows {
    use super::*;
    // Versteckte Worker-Tabs (Tab-IDs). Ein Waechter-Thread versteckt jede Sekunde neu aufgetauchte Fenster
    // dieser Browser-Prozesse (Popups, Fenster die beim Verstecken noch keinen Titel hatten, Fenster nach
    // Neuladen). Vorher blieben die als schwarze/weisse Fenster in der Brave-/Edge-Taskleiste.
    static WANT: Lazy<Mutex<HashSet<u32>>> = Lazy::new(|| Mutex::new(HashSet::new()));
    static PIDCACHE: Lazy<Mutex<(BTreeMap<u32, HashSet<u32>>, Option<std::time::Instant>)>> = Lazy::new(|| Mutex::new((BTreeMap::new(), None)));
    static APPLY: Mutex<()> = Mutex::new(());
    static PIDS: Lazy<Mutex<(HashSet<u32>, bool)>> = Lazy::new(|| Mutex::new((HashSet::new(), false)));
    static HIDDEN: Lazy<Mutex<HashSet<isize>>> = Lazy::new(|| Mutex::new(HashSet::new()));
    static GUARD: std::sync::Once = std::sync::Once::new();
    #[link(name="user32")]
    extern "system" { fn EnumWindows(cb: unsafe extern "system" fn(isize,isize)->i32, data:isize)->i32; fn GetWindowThreadProcessId(hwnd:isize,pid:*mut u32)->u32; fn ShowWindowAsync(hwnd:isize,cmd:i32)->i32; fn EnableWindow(hwnd:isize,en:i32)->i32; fn SetForegroundWindow(hwnd:isize)->i32; fn IsWindowVisible(hwnd:isize)->i32; fn GetWindowTextLengthW(hwnd:isize)->i32; fn GetWindow(hwnd:isize,cmd:u32)->isize; fn GetClassNameW(hwnd:isize,buf:*mut u16,max:i32)->i32; }
    unsafe fn class(hwnd:isize)->String { let mut b=[0u16;64]; let n=GetClassNameW(hwnd,b.as_mut_ptr(),64).max(0) as usize; String::from_utf16_lossy(&b[..n]) }
    // Beim Zeigen nur echte Hauptfenster (Titel, ohne Owner) - nie Hilfsfenster, sonst schwarze Fenster.
    unsafe fn real_window(hwnd:isize)->bool { class(hwnd)=="Chrome_WidgetWin_1" && GetWindowTextLengthW(hwnd)>0 && GetWindow(hwnd,4)==0 }
    unsafe extern "system" fn visit(hwnd:isize,_:isize)->i32 {
        let mut pid=0; GetWindowThreadProcessId(hwnd,&mut pid); let g=lock(&PIDS); if !g.0.contains(&pid){return 1;}
        let mut h=lock(&HIDDEN);
        if g.1 { h.remove(&hwnd); if real_window(hwnd){EnableWindow(hwnd,1);ShowWindowAsync(hwnd,9);SetForegroundWindow(hwnd);} }
        // Verstecken: JEDES sichtbare Top-Level-Fenster des Prozesses (auch ohne Titel/mit Owner).
        else if IsWindowVisible(hwnd)!=0 && class(hwnd).starts_with("Chrome_WidgetWin") { h.insert(hwnd); ShowWindowAsync(hwnd,0); }
        1
    }
    fn pids_of(t:&Tab, cmds:&[(sysinfo::Pid, String)])->HashSet<u32>{ let d=dir(t.id).display().to_string(); cmds.iter().filter(|(_,c)|cmd_uses(c,&d)).map(|(p,_)|p.as_u32()).collect() }
    fn apply(p:HashSet<u32>, show:bool){ if p.is_empty(){return;} *lock(&PIDS)=(p,show); unsafe{EnumWindows(visit,0);} }
    pub fn any_hidden()->bool{!lock(&HIDDEN).is_empty()}
    // Edge-Hilfsfenster (Chrome_WidgetWin_0 ohne Titel) werden manchmal sichtbar und erscheinen als schwarze Fenster -> regelmaessig ausblenden.
    static HPIDS:Lazy<std::sync::Mutex<HashSet<u32>>>=Lazy::new(||std::sync::Mutex::new(HashSet::new()));
    static HELPERS:std::sync::Once=std::sync::Once::new();
    unsafe extern "system" fn visit_helper(hwnd:isize,_:isize)->i32 { let mut pid=0; GetWindowThreadProcessId(hwnd,&mut pid); if lock(&HPIDS).contains(&pid) && IsWindowVisible(hwnd)!=0 && class(hwnd)=="Chrome_WidgetWin_0" && GetWindowTextLengthW(hwnd)==0 { ShowWindowAsync(hwnd,0); } 1 }
    pub fn hide_helpers(){ HELPERS.call_once(|| { std::thread::spawn(|| loop { let cmds=browser_cmds(); let p:HashSet<u32>=load().iter().flat_map(|t|pids_of(t,&cmds)).collect(); if !p.is_empty(){ *lock(&HPIDS)=p; unsafe{EnumWindows(visit_helper,0);} } std::thread::sleep(Duration::from_secs(5)); }); }); }
    pub fn set_hidden(tabs:&[Tab], hidden:bool){
        // Verstecken der Notion-Tabs ist entfernt: Fenster bleiben immer sichtbar, nur Anzeigen ist noch moeglich.
        if hidden { return; }
        let cmds=browser_cmds();
        let _a=lock(&APPLY);
        let mut p=HashSet::new();
        { let mut w=lock(&WANT); let mut c=lock(&PIDCACHE);
          for t in tabs { let s=pids_of(t,&cmds); p.extend(s.iter().copied()); if hidden { w.insert(t.id); c.0.insert(t.id,s); } else { w.remove(&t.id); c.0.remove(&t.id); } } }
        apply(p, !hidden);
        if hidden { GUARD.call_once(|| { std::thread::spawn(guard); }); }
    }
    fn guard(){
        loop {
            std::thread::sleep(Duration::from_millis(900));
            if lock(&WANT).is_empty(){ continue; }
            // Prozessliste alle 4 s auffrischen (neue Renderer/Browser-Neustart), ausserhalb des Locks.
            let stale=lock(&PIDCACHE).1.map_or(true,|t|t.elapsed()>Duration::from_secs(4));
            let fresh=if stale { let cmds=browser_cmds(); let tabs=load(); let ids:Vec<u32>=lock(&WANT).iter().copied().collect();
                Some(tabs.iter().filter(|t|ids.contains(&t.id)).map(|t|(t.id,pids_of(t,&cmds))).collect::<Vec<_>>()) } else { None };
            let _a=lock(&APPLY);
            let p:HashSet<u32>={ let w=lock(&WANT); let mut c=lock(&PIDCACHE);
                if let Some(f)=fresh { for (id,s) in f { if w.contains(&id){ c.0.insert(id,s); } } c.1=Some(std::time::Instant::now()); }
                c.0.retain(|id,_|w.contains(id));
                c.0.values().flat_map(|s|s.iter().copied()).collect() };
            apply(p,false);
        }
    }
}
#[cfg(not(windows))] pub(crate) mod windows { use super::*; pub fn set_hidden(_: &[Tab],_:bool){} pub fn any_hidden()->bool{false} pub fn hide_helpers(){} }

/// Privacy-Injection: bringt den Telemetrie-Blocker in jeden frisch geladenen Notion-Tab
/// (CDP Page.addScriptToEvaluateOnNewDocument, einmal pro Port, laeuft im Hintergrund mit).
static PRIVACY_PORTS:Lazy<std::sync::Mutex<HashSet<u16>>>=Lazy::new(||std::sync::Mutex::new(HashSet::new()));
pub(crate) async fn privacy_start(port:u16){
    {let mut g=PRIVACY_PORTS.lock().unwrap_or_else(|e|e.into_inner());if g.contains(&port){return;}g.insert(port);}
    if !wait_cdp(port).await{{let mut g=PRIVACY_PORTS.lock().unwrap_or_else(|e|e.into_inner());g.remove(&port);return;}}
    if let Ok(ws)=target(port).await{
        let _=cdp_ws(&ws,vec![json!({"method":"Page.addScriptToEvaluateOnNewDocument","params":{"source":BLOCK_TELEMETRY_JS}})]).await;
        tl(&format!("PRIVACY port{port} aktiv"));
    }
}
fn start_url(t:&Tab)->String{if t.url.is_empty(){NOTION_URL.to_string()}else{t.url.clone()}}
fn tab_index(id:u32)->usize{load().iter().position(|t|t.id==id).unwrap_or(0)}
pub(crate) fn launch(t:&Tab,url:&str)->Result<&'static str,String>{start_load_watchdog();windows::hide_helpers();
    mark_account(t.id,"usage_error",Value::Null);mark_account(t.id,"check",json!("Tab startet \u{2026}"));
    let(name,exe)=browser().ok_or("Erst unter Co-Work einen Browser ausw\u{e4}hlen.")?;let d=dir(t.id);std::fs::create_dir_all(&d).map_err(|e|e.to_string())?;
    let port=cdp_port(tab_index(t.id));
    if std::net::TcpStream::connect_timeout(&std::net::SocketAddr::from(([127,0,0,1],port)),Duration::from_millis(300)).is_ok(){if running_ids(std::slice::from_ref(t)).contains(&t.id){return Ok(name);}return Err(format!("Port {port} f\u{fc}r Tab {} ist noch von einem anderen Browser-Fenster (anderes Konto) belegt. Bitte unter Co-Work einmal \u{201e}Alle stoppen\u{201c} und neu starten.",t.id));}
    if !t.email.is_empty(){let tabs=load();if let Some(o)=tabs.iter().find(|o|o.id!=t.id&&o.email.eq_ignore_ascii_case(&t.email)){if running_ids(std::slice::from_ref(o)).contains(&o.id){windows::set_hidden(std::slice::from_ref(o),false);return Err(format!("Das Konto {} ist schon in {} offen - dieses Fenster wurde nach vorn geholt. Ein Konto laeuft nur in einem Fenster, sonst teilen sich zwei Fenster den Speicher und Notion wird fehlerhaft.",t.email,o.label));}}}
    mark_clean_exit(&d);
    std::process::Command::new(&exe).arg(format!("--user-data-dir={}",d.display())).args(["--no-first-run","--hide-crash-restore-bubble","--no-default-browser-check","--disable-background-timer-throttling","--disable-backgrounding-occluded-windows","--disable-renderer-backgrounding","--disable-features=CalculateNativeWinOcclusion","--disable-popup-blocking"]).arg("--host-resolver-rules=MAP api.segment.io 127.0.0.2, MAP api.amplitude.com 127.0.0.2, MAP api2.amplitude.com 127.0.0.2, MAP statsig.an.net 127.0.0.2, MAP featuregates.org 127.0.0.2, MAP events.statsigapi.net 127.0.0.2, MAP google-analytics.com 127.0.0.2, MAP cdn.pendo.io 127.0.0.2").arg("--remote-debugging-address=127.0.0.1").arg(format!("--remote-debugging-port={port}")).arg(format!("--app={url}")).spawn().map_err(|e|format!("{name} konnte nicht gestartet werden: {e}"))?;
    // Privacy: Telemetrie-Blocker injizieren, sobald CDP da ist (Hintergrund, stoert niemanden).
    let p=port;tokio::spawn(async move{privacy_start(p).await;});
    Ok(name)
}
/// Co-Work-Tabs werden hart beendet -> Profil vor dem Start als sauber beendet markieren, damit beim Sichtbarmachen keine Wiederherstellen-Leiste erscheint.
fn mark_clean_exit(d:&std::path::Path){let p=d.join("Default").join("Preferences");let Ok(s)=std::fs::read_to_string(&p) else {return};let Ok(mut v)=serde_json::from_str::<Value>(&s) else {return};let Some(o)=v.as_object_mut() else {return};let pr=o.entry("profile").or_insert_with(||json!({}));if let Some(pr)=pr.as_object_mut(){pr.insert("exit_type".into(),json!("Normal"));pr.insert("exited_cleanly".into(),json!(true));}if let Ok(n)=serde_json::to_string(&v){let _=std::fs::write(&p,n);}}
fn find(id:Option<u32>)->Result<Tab,String>{let id=id.ok_or("Tab-Nummer fehlt.")?;load().into_iter().find(|t|t.id==id).ok_or(format!("Tab {id} gibt es nicht."))}
fn enc(s:&str)->String{s.bytes().map(|b|if b.is_ascii_alphanumeric()||b"-_.~".contains(&b){(b as char).to_string()}else{format!("%{b:02X}")}).collect()}

pub(crate) async fn target(port:u16)->Result<String,String>{
    let list:Vec<Value>=reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await.map_err(|e|e.to_string())?.json().await.map_err(|e|e.to_string())?;
    // 1.0.114: Zusatz-Chats (eigene Browser-Tabs im selben Profil) nie mit dem Haupt-Chat verwechseln.
    let sl:Vec<String>=load().get((port as usize).saturating_sub(9301)).map(|t|slots_of(t.id)).unwrap_or_default();
    list.into_iter().filter(|v|{let o=chat_own();o.is_empty()||v["id"].as_str()!=Some(o.as_str())}).filter(|v|sl.is_empty()||!sl.contains(&url_tid(v["url"].as_str().unwrap_or("")))).find(|v|v["type"]=="page"&&v["url"].as_str().unwrap_or("").contains("notion.")).and_then(|v|v["webSocketDebuggerUrl"].as_str().map(str::to_string)).ok_or("Kein Notion-CDP-Tab gefunden.".into())
}
async fn cdp(port:u16, commands:Vec<Value>)->Result<Vec<Value>,String>{let ws=target(port).await?;cdp_ws(&ws,commands).await}
async fn cdp_ws(ws:&str, commands:Vec<Value>)->Result<Vec<Value>,String>{
    let(mut socket,_)=tokio_tungstenite::connect_async(ws).await.map_err(|e|e.to_string())?;let mut out=Vec::new();
    for mut cmd in commands{let id=out.len()+1;cmd["id"]=json!(id);socket.send(tokio_tungstenite::tungstenite::Message::Text(cmd.to_string().into())).await.map_err(|e|e.to_string())?;loop{let msg=tokio::time::timeout(Duration::from_secs(30),socket.next()).await.map_err(|_|"CDP timeout".to_string())?.ok_or("CDP geschlossen")?.map_err(|e|e.to_string())?;if let Ok(txt)=msg.into_text(){if let Ok(v)=serde_json::from_str::<Value>(&txt){if v["id"]==id{out.push(v);break;}}}}
    } Ok(out)
}
async fn trusted_click(port:u16,point:&Value)->Result<(),String>{let x=point["x"].as_f64().ok_or("Klickposition X fehlt")?;let y=point["y"].as_f64().ok_or("Klickposition Y fehlt")?;cdp(port,vec![json!({"method":"Input.dispatchMouseEvent","params":{"type":"mousePressed","x":x,"y":y,"button":"left","clickCount":1}}),json!({"method":"Input.dispatchMouseEvent","params":{"type":"mouseReleased","x":x,"y":y,"button":"left","clickCount":1}})]).await?;Ok(())}
fn groups_file()->PathBuf{base().join("groups.json")}
#[allow(dead_code)] fn groups_raw()->BTreeMap<u32,u32>{std::fs::read_to_string(groups_file()).ok().and_then(|s|serde_json::from_str::<BTreeMap<String,u32>>(s.trim_start_matches('\u{feff}')).ok()).map(|m|m.into_iter().filter_map(|(k,v)|k.parse::<u32>().ok().map(|k|(k,v))).collect()).unwrap_or_default()}
/// Tab-ID -> Leiter-Tab-ID. Es gibt keinen festen Main mehr: alle Tabs gehoeren zum aktuellen Leiter
/// (der Chat, in dem der Nutzer zuerst geschrieben hat; solange keiner feststeht: erster Tab).
pub(crate) fn groups_of(tabs:&[Tab])->BTreeMap<u32,u32>{
    let l=lead_id();let m=if tabs.iter().any(|t|t.id==l){l}else{tabs.first().map(|t|t.id).unwrap_or(0)};
    tabs.iter().map(|t|(t.id,m)).collect()
}
#[allow(dead_code)] fn save_groups(g:&BTreeMap<u32,u32>)->Result<(),String>{let m:BTreeMap<String,u32>=g.iter().map(|(k,v)|(k.to_string(),*v)).collect();std::fs::create_dir_all(base()).map_err(|e|e.to_string())?;std::fs::write(groups_file(),serde_json::to_string(&m).unwrap_or_default()).map_err(|e|e.to_string())}
fn set_group(_v:&Value)->Result<String,String>{Ok("Es gibt keine Gruppen und keinen Main mehr: der Chat, in dem du zuerst schreibst, leitet das Co-Work, die anderen Tabs treten automatisch bei.".into())}
static WAKE_LAST: Lazy<Mutex<BTreeMap<String,std::time::Instant>>> = Lazy::new(|| Mutex::new(BTreeMap::new()));
/// Live-Bridge: AdiCode-Tab des Agents mit einer Nachricht wecken, sobald er frei ist (nicht am Generieren,
/// niemand tippt darin; wartet max. 10 min). Max. 1x pro 2 min pro Agent. true = Tab gefunden, Wecken laeuft.
pub(crate) fn wake_agent(agent:&str,text:String)->bool{
    if cfg!(test)||agent_unavailable(agent){return false;}let text=with_mcp_hint(agent,text);
    let tabs=load();
    if let Some((i,t,tid))=find_slot(&tabs,agent){if skipped(t.id){return false;}{let mut w=lock(&WAKE_LAST);if w.get(agent).map(|t|t.elapsed()<Duration::from_secs(120)).unwrap_or(false){return false;}w.insert(agent.to_string(),std::time::Instant::now());}wake_slot(i,tid,agent.to_string(),text);return true;}
    let Some(i)=tabs.iter().position(|t|agent_of(t)==agent&&!skipped(t.id)&&!is_paused(t.id)) else {return false};
    {let mut w=lock(&WAKE_LAST);if w.get(agent).map(|t|t.elapsed()<Duration::from_secs(120)).unwrap_or(false){return false;}w.insert(agent.to_string(),std::time::Instant::now());}
    let port=cdp_port(i);let agent=agent.to_string();
    tokio::spawn(async move{
        for _ in 0..60{
            if !user_present(port).await&&chat_idle(port).await{
                tokio::time::sleep(Duration::from_secs(2)).await;
                if chat_idle(port).await{let r=insert_prompt(port,text.clone()).await;tl(&format!("LIVE-WAKE {agent}: {:?}",r));return;}
            }
            tokio::time::sleep(Duration::from_secs(10)).await;
        }
        tl(&format!("LIVE-WAKE {agent}: Tab 10 min nicht frei, Nachricht kommt beim naechsten Tool-Aufruf"));
    });
    true
}
/// Co-Work nur ueber die Bridge (CDP, keine Browser-Erweiterung): Keeper und Nudger laufen, sobald ein Main ein Projekt startet oder promptet - nicht erst nach dem Start-Knopf.
pub(crate) fn ensure_cowork_bridge(){if cfg!(test)||tokio::runtime::Handle::try_current().is_err(){return;}let tabs=load();if tabs.is_empty(){return;}ensure_multichat();if !KEEPER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(keep_alive(tabs.clone()));}if !NUDGER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(nudger(tabs));}}
/// Worker-Tabs, deren Fenster gerade nicht laeuft (kein CDP-Port): die Bridge kann sie nicht wecken.
pub(crate) fn offline_workers(names:&[String])->Vec<String>{if cfg!(test){return Vec::new();}load().iter().enumerate().filter(|(_,t)|names.contains(&agent_of(t))).filter(|(i,_)|std::net::TcpStream::connect_timeout(&std::net::SocketAddr::from(([127,0,0,1],cdp_port(*i))),Duration::from_millis(200)).is_err()).map(|(_,t)|agent_of(t)).collect()}
/// Main-Tab des Leads, dessen Fenster nicht laeuft (z. B. Main angelegt, aber Lead-Chat sitzt in einem Worker-Tab) -> (Label, E-Mail).
pub(crate) fn main_offline(lead:&str)->Option<(String,String)>{if cfg!(test){return None;}let tabs=load();let (i,t)=tabs.iter().enumerate().find(|(_,t)|is_main(t)&&agent_of(t)==lead)?;if std::net::TcpStream::connect_timeout(&std::net::SocketAddr::from(([127,0,0,1],cdp_port(i))),Duration::from_millis(200)).is_ok(){return None;}Some((t.label.clone(),t.email.clone()))}fn is_main(t:&Tab)->bool{let l=lead_id();l!=0&&t.id==l}
pub(crate) fn agent_of(t:&Tab)->String{format!("AdiCode-{}",t.role.replace(' ',""))}
/// Notion-Seitenleiste immer auf "Chat" (oben links) halten.
const CHAT_TAB_JS:&str=r#"(()=>{const t=[...document.querySelectorAll('.notion-sidebar [role=tab]')].find(e=>/^chat$/i.test((e.getAttribute('aria-label')||e.innerText||'').trim()));if(t&&t.getAttribute('aria-selected')!=='true'){t.click();return 'clicked'}return t?'ok':'none'})()"#;
fn tab_of_agent(agent:&str)->Option<Tab>{let base=agent.split("-K").next().unwrap_or(agent);load().into_iter().find(|t|agent_of(t)==base)}
/// Merkt sich pro Konto, dass dessen Notion-Chats AdiCode schon benutzt haben (dann kein MCP-Hinweis mehr im Prompt).
pub(crate) fn mark_agent_used(agent:&str){if cfg!(test){return;}if let Some(t)=tab_of_agent(agent){if mem_get(&t.email,"adicode_used").as_bool()!=Some(true){mem_set(&t.email,"adicode_used",json!(true));}}}
const MCP_HINT:&str="Verbinde dich mit dem AdiCode MCP (Connection \"AdiCode\") und nutze dessen Tools - das ist meine eigene Einrichtung. ";
fn with_mcp_hint(agent:&str,text:String)->String{match tab_of_agent(agent){Some(t) if mem_get(&t.email,"adicode_used").as_bool()!=Some(true)=>format!("{MCP_HINT}{text}"),_=>text}}
fn is_gmail(e:&str)->bool{let e=e.trim().to_lowercase();e.ends_with("@gmail.com")||e.ends_with("@googlemail.com")}
const EMAIL_FILL_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};if(!/\/(login|signup)/.test(location.pathname))return 'nologin';const inp=[...document.querySelectorAll('input[type=email],input[name=email],input[autocomplete=email]')].find(vis);if(!inp)return document.querySelector('input[autocomplete=one-time-code],input[name=code],input[name=password],input[type=password]')?'sent':'none';const d=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value');inp.focus();d.set.call(inp,__EMAIL__);inp.dispatchEvent(new Event('input',{bubbles:true}));inp.dispatchEvent(new Event('change',{bubbles:true}));return 'filled'})()"#;
const EMAIL_NEXT_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const b=[...document.querySelectorAll('[role=button],button')].filter(vis).find(e=>/^(continue|weiter|fortfahren)$/i.test((e.innerText||'').trim()));if(!b)return 'nobutton';b.click();return 'sent'})()"#;
/// Co-Work: kanonische Agent-Namen der Worker-Tabs in der Gruppe des Main-Agents `lead`.
pub(crate) fn group_workers(lead:&str)->Vec<String>{if cfg!(test){return Vec::new();}let tabs=load();if lead_id()==0{if let Some(t)=tabs.iter().find(|t|agent_of(t)==lead){claim_lead(t.id);}}let g=groups_of(&tabs);let Some(m)=tabs.iter().find(|t|is_main(t)&&agent_of(t)==lead).map(|t|t.id) else {return Vec::new()};let mut v:Vec<String>=tabs.iter().filter(|t|!is_main(t)&&!skipped(t.id)&&g.get(&t.id)==Some(&m)).map(agent_of).collect();v.extend(tabs.iter().filter(|t|!skipped(t.id)&&g.get(&t.id)==Some(&m)).flat_map(slot_agents));v.retain(|a|!agent_unavailable(a));v}
/// Co-Work: kanonische Agent-Namen aller aktiven Worker-Tabs.
pub(crate) fn worker_tab_agents()->Vec<String>{if cfg!(test){return Vec::new();}let tabs=load();let mut v:Vec<String>=tabs.iter().filter(|t|!is_main(t)&&!skipped(t.id)).map(agent_of).collect();v.extend(tabs.iter().filter(|t|!skipped(t.id)).flat_map(slot_agents));v.retain(|a|!agent_unavailable(a));v}
fn chat_own_file()->PathBuf{base().join("chat-own.txt")}
static CHAT_OWN: Lazy<Mutex<String>> = Lazy::new(|| Mutex::new(std::fs::read_to_string(chat_own_file()).map(|s|s.trim().to_string()).unwrap_or_default()));
/// Eigener CDP-Tab nur fuer den AdiCode-Chat (nie von Co-Work benutzt).
pub(crate) fn chat_own()->String{lock(&CHAT_OWN).clone()}
pub(crate) fn set_chat_own(s:&str){*lock(&CHAT_OWN)=s.to_string();let _=std::fs::write(chat_own_file(),s);}
fn prompt_for(t:&Tab)->String {
    const CONN:&str="Die Tools kommen von meinem AdiCode-MCP-Server (in Notion als Verbindung \"asf\" oder \"AdiCode\" eingetragen).";
    let tabs=load();let g=groups_of(&tabs);
    let me=tabs.iter().find(|x|x.id==t.id).cloned().unwrap_or_else(||t.clone());
    let m=g.get(&me.id).copied().unwrap_or(me.id);
    let lead=tabs.iter().find(|x|x.id==m).cloned().unwrap_or_else(||me.clone());
    let la=agent_of(&lead);let proj=format!("Projekt {}",lead.role);
    if me.id==lead.id{
        let ws:Vec<String>=tabs.iter().filter(|x|x.id!=me.id&&!skipped(x.id)).map(|x|format!("{} (Agent {})",x.role,agent_of(x))).collect();
        let ws:Vec<String>=ws.into_iter().chain(tabs.iter().flat_map(|x|slot_agents(x).into_iter().map(|a|format!("Zusatz-Chat (Agent {a})")))).collect();
        let ws=if ws.is_empty(){"keine - arbeite allein".to_string()}else{ws.join(", ")};
        format!("Hallo! AdiCode Co-Work: Du bist der Chat, in dem ich schreibe ({r}), und leitest das Co-Work. {CONN} Die anderen Tabs treten automatisch bei und helfen dir: {ws}. Es gibt keine festen Rollen: jeder hilft bei allem.\n1. Neue Aufgabe: project_memory oeffnen, Skill cowork lesen, dann cowork_start mit title \"{proj}: <Thema>\", agent \"{la}\" und 3-10 parallelen Tasks (files angeben). Kleine Fragen selbst beantworten.\n2. Die anderen Tabs schicken dir Ergebnisse UND Kritik/Verbesserungsideen. Verfolge sie mit cowork_wait (agent \"{la}\"), pruefe jedes Ergebnis selbst kritisch und gib per cowork_add_tasks neue Verbesserungsrunden aus - so lange iterieren, bis das Ergebnis wirklich perfekt ist (laeuft, getestet, sauber).\n3. Neues vom Nutzer waehrend des Projekts sofort per cowork_prompt.\n4. Erst am Ende: cowork_results, mir EINE kurze Antwort, HANDOUT.md und project_memory aktualisieren.\nTempo: unabhaengige Tool-Calls parallel in EINER Antwort, selbst mitarbeiten statt warten, knapp antworten, Diffs statt Volltext. Bei schreibenden Tools agent \"{la}\" mitgeben. Antworte jetzt nur: Co-Work bereit.",r=me.role)
    }else{
        let a=agent_of(&me);
        format!("Hallo! AdiCode Co-Work: Du bist {r} und hilfst {lr} (Agent \"{la}\") - das ist der Chat, in dem ich schreibe und der das Co-Work leitet. {CONN} Es gibt keine festen Rollen - du hilfst bei allem. {lr} ist dein einziger Ansprechpartner, nicht der Nutzer.\n1. cowork_board aufrufen und das neueste Projekt mit Lead {la} waehlen (Titel beginnt meist mit \"{proj}\"); dann cowork_join mit project <diese id> und agent \"{a}\". Gibt es noch keins: kurz warten und erneut pruefen.\n2. Loop: cowork_claim, erledigen, cowork_update mit 1-Satz-Ergebnis, wieder cowork_claim. Bei JEDEM schreibenden Tool (safe_write_file, files_*, pc_PowerShell, git_*) agent \"{a}\" mitgeben.\n3. Nach jeder Aufgabe kritisch pruefen (Bugs, Luecken, bessere Loesung) und Kritik + Verbesserungsvorschlaege per cowork_message mit to \"{la}\" schicken. {lr} entscheidet und gibt die naechste Runde aus - so wird iteriert, bis das Ergebnis perfekt ist.\n4. Nichts frei: cowork_wait.\nTempo: unabhaengige Tool-Calls parallel in EINER Antwort, keine Zwischenberichte. Antworte jetzt nur: Bereit.",r=me.role,lr=lead.role)
    }
}
/// Chat is idle: Notion AI is not generating/recording and the composer is empty.
async fn chat_idle(port:u16)->bool{
    let expr=r#"(()=>{if(document.querySelector('[data-testid="agent-chat-stop-button"],[data-testid="agent-stop-inference-button"],[data-testid="agent-chat-stop-recording-button"]'))return false;const c=document.querySelector('[role="textbox"][contenteditable="true"]');return !!c&&!(c.innerText||'').trim()})()"#;
    cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":expr,"returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_bool)).unwrap_or(false)
}
/// Snapshot of a generating chat (null when idle). Digits are stripped so the "Working for 3m 12s" timer does not count as progress.
async fn gen_snapshot(port:u16)->Option<String>{
    let expr=r#"(()=>{if(!document.querySelector('[data-testid="agent-chat-stop-button"],[data-testid="agent-stop-inference-button"]'))return null;const m=document.querySelector('main')||document.body;const t=(m.innerText||'').replace(/\d/g,'');return t.length+':'+t.slice(-300)})()"#;
    cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":expr,"returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_str).map(String::from))
}
async fn stop_generation(port:u16){
    let expr="(()=>{const b=document.querySelector('[data-testid=\"agent-chat-stop-button\"],[data-testid=\"agent-stop-inference-button\"]');if(b)b.click();return !!b})()";
    let _=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":expr,"returnByValue":true}})]).await;
}
static GEN_STARTED: AtomicBool = AtomicBool::new(false);
/// Startet einmalig den Tab-Monitor (liest nur, schreibt nie in Chats).
pub(crate) fn ensure_gen_monitor(){if !GEN_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(gen_monitor());}}
/// Tab-Monitor (immer an, auch ohne "Co-Work starten"): meldet der Live-Bridge, welcher Tab gerade generiert,
/// und stoppt haengende Chats nach STUCK_SECS ohne Fortschritt (nicht bei "Selbst schreiben").
/// Erkennt "Notion AI was disabled in this workspace" (und deutsche Varianten) im Tab.
const AI_OFF_JS:&str=r#"(()=>{const t=(document.body&&document.body.innerText)||'';const m=t.match(/(Notion AI (was|has been|is|got) (disabled|turned off|deactivated)[^\n]{0,60}|AI (was|has been|is) disabled (in|for) this workspace|Notion[ -]?KI (wurde|ist) [^\n]{0,40}deaktiviert[^\n]{0,40}|KI (wurde|ist) (in|f.r) diese[nm] (Workspace|Arbeitsbereich) deaktiviert)/i);if(!m)return null;const i=t.indexOf(m[0]);return {hit:m[0],ctx:t.slice(Math.max(0,i-800),i+800),url:location.href,title:document.title}})()"#;
static AI_OFF: Lazy<Mutex<BTreeMap<u32,bool>>> = Lazy::new(|| Mutex::new(BTreeMap::new()));
/// Co-Work (1.0.123): Zusatz-Chats, die gerade nicht schreiben koennen (Tab zu oder "KI fuer diesen Workspace deaktiviert").
static SLOT_OFF: Lazy<Mutex<HashSet<String>>> = Lazy::new(|| Mutex::new(HashSet::new()));
static UNAVAIL: Lazy<Mutex<BTreeMap<String,(std::time::Instant,bool)>>> = Lazy::new(|| Mutex::new(BTreeMap::new()));
/// Tab-Fenster laeuft nicht (kein CDP-Port).
fn tab_offline(i:usize)->bool{std::net::TcpStream::connect_timeout(&std::net::SocketAddr::from(([127,0,0,1],cdp_port(i))),Duration::from_millis(200)).is_err()}
/// Konto-Tab zeigt "Notion KI ist fuer diesen Workspace deaktiviert".
pub(crate) fn tab_ai_off(id:u32)->bool{lock(&AI_OFF).get(&id).copied().unwrap_or(false)}
/// Co-Work: Agent kann gerade nicht schreiben (Fenster zu, uebersprungen, KI im Tab oder im Zusatz-Chat deaktiviert)
/// -> wird nicht eingetragen, nicht geweckt, seine Tasks werden wieder frei. Agents ohne AdiCode-Tab (freie Namen) gelten als verfuegbar.
pub(crate) fn agent_unavailable(agent:&str)->bool{
    if cfg!(test){return false;}
    if lock(&SLOT_OFF).contains(agent){return true;}
    if let Some((at,v))=lock(&UNAVAIL).get(agent).copied(){if at.elapsed()<Duration::from_secs(5){return v;}}
    let tabs=load();let base=agent.split("-K").next().unwrap_or(agent);
    let v=match tabs.iter().enumerate().find(|(_,t)|agent_of(t)==base){Some((i,t))=>skipped(t.id)||tab_ai_off(t.id)||tab_offline(i),None=>false};
    lock(&UNAVAIL).insert(agent.to_string(),(std::time::Instant::now(),v));v
}
/// Nur lesen: steht im Tab "Notion AI ... disabled", wird EINMAL pro Auftreten ein Bericht mit allem,
/// was kurz vorher passiert ist, geschrieben (logs\ai-disabled\<Zeit>-tab<ID>.txt + .jpg).
async fn ai_off_check(t:&Tab,i:usize){
    let port=cdp_port(i);
    let Ok(v)=js_eval(port,AI_OFF_JS).await else {return};
    let hit=v.is_object();
    let was={let mut m=lock(&AI_OFF);let w=m.get(&t.id).copied().unwrap_or(false);m.insert(t.id,hit);w};
    if hit!=was{mark_account(t.id,"ai_off",json!(hit));}
    if !hit{if was{tl(&format!("tab{} AI-DISABLED-Hinweis ist wieder weg",t.id));}return;}
    if was{return;}
    tl(&format!("tab{} AI-DISABLED erkannt: {}",t.id,v["hit"].as_str().unwrap_or("")));
    let shot=cdp(port,vec![json!({"method":"Page.captureScreenshot","params":{"format":"jpeg","quality":60}})]).await.ok()
        .and_then(|r|r.first().and_then(|x|x.pointer("/result/data")).and_then(Value::as_str).map(str::to_string));
    let feed=crate::notion_live::feed(0);
    let acc=lock(&ACCOUNT).get(&t.id).cloned().unwrap_or(Value::Null);
    let others:Vec<Value>=AI_OFF.lock().map(|m|m.iter().filter(|(_,v)|**v).map(|(k,_)|json!(k)).collect()).unwrap_or_default();
    let t2=t.clone();
    let _=tokio::task::spawn_blocking(move||ai_off_report(&t2,&v,shot,&feed,&acc,&others)).await;
}
fn tail_file(p:&std::path::Path,n:usize)->String{let s=std::fs::read_to_string(p).unwrap_or_else(|e|format!("({}: {e})",p.display()));let l:Vec<&str>=s.lines().collect();l[l.len().saturating_sub(n)..].join("\n")}
fn b64_decode(s:&str)->Vec<u8>{let mut out=Vec::with_capacity(s.len()*3/4);let (mut acc,mut bits)=(0u32,0u32);for c in s.bytes(){let v=match c{b'A'..=b'Z'=>c-b'A',b'a'..=b'z'=>c-b'a'+26,b'0'..=b'9'=>c-b'0'+52,b'+'=>62,b'/'=>63,_=>continue} as u32;acc=(acc<<6)|v;bits+=6;if bits>=8{bits-=8;out.push((acc>>bits) as u8);acc&=(1<<bits)-1;}}out}
fn ai_off_report(t:&Tab,v:&Value,shot:Option<String>,feed:&Value,acc:&Value,others:&[Value]){
    let root=std::env::var_os("LOCALAPPDATA").map(PathBuf::from).unwrap_or_default().join("PlazCodeNotion");
    let dir=root.join("logs").join("ai-disabled");
    if std::fs::create_dir_all(&dir).is_err(){return;}
    let now=chrono::Local::now();
    let name=format!("{}-tab{}",now.format("%Y%m%d-%H%M%S"),t.id);
    let mut r=String::new();
    r.push_str(&format!("AdiCode: 'Notion AI disabled' erkannt\nZeit: {}\nTab: {} ({}) {} {}\nURL: {}\nTitel: {}\nTreffer: {}\nAndere Tabs mit Hinweis: {:?}\n\n--- Seitentext um den Treffer ---\n{}\n\n",
        now.format("%Y-%m-%d %H:%M:%S"),t.id,t.role,t.email,t.label,v["url"].as_str().unwrap_or(""),v["title"].as_str().unwrap_or(""),v["hit"].as_str().unwrap_or(""),others,v["ctx"].as_str().unwrap_or("")));
    r.push_str(&format!("--- Konto-Status (AdiCode) ---\n{}\n\n",serde_json::to_string_pretty(acc).unwrap_or_default()));
    r.push_str(&format!("--- Zeitprotokoll profiles\\timeline.log (letzte 400 Zeilen) ---\n{}\n\n",tail_file(&base().join("timeline.log"),400)));
    r.push_str(&format!("--- Live-Feed (letzte Tool-Aufrufe aller Chats) ---\n{}\n\n",serde_json::to_string_pretty(&feed["items"]).unwrap_or_default()));
    r.push_str(&format!("--- Live-Agents ---\n{}\n\n",serde_json::to_string_pretty(&feed["agents"]).unwrap_or_default()));
    r.push_str(&format!("--- app\\logs\\agent.log (letzte 300 Zeilen) ---\n{}\n\n",tail_file(&crate::platform::installation_root().join("logs").join("agent.log"),300)));
    r.push_str(&format!("--- logs\\launcher.log (letzte 120 Zeilen) ---\n{}\n\n",tail_file(&root.join("logs").join("launcher.log"),120)));
    r.push_str(&format!("--- logs\\mcp-auth.log (letzte 40 Zeilen) ---\n{}\n",tail_file(&root.join("logs").join("mcp-auth.log"),40)));
    let _=std::fs::write(dir.join(format!("{name}.txt")),r);
    if let Some(b64)=shot{let _=std::fs::write(dir.join(format!("{name}.jpg")),b64_decode(&b64));}
    tl(&format!("tab{} AI-DISABLED-Bericht: {}",t.id,dir.join(format!("{name}.txt")).display()));
}
async fn gen_monitor(){
    let mut stuck:BTreeMap<u32,(String,std::time::Instant)>=BTreeMap::new();
    let mut running:Vec<u32>=Vec::new();
    let mut n:u64=0;
    loop{
        tokio::time::sleep(human_sleep(Duration::from_secs(3),40)).await;
        let tabs=load();
        if n%5==0{let tc=tabs.clone();running=tokio::task::spawn_blocking(move||running_ids(&tc)).await.unwrap_or_default();}
        n+=1;
        for(i,t)in tabs.iter().enumerate(){
            let agent=agent_of(t);
            if !running.contains(&t.id){crate::notion_live::set_generating(&agent,false);stuck.remove(&t.id);continue;}
            if n%3==1{ai_off_check(t,i).await;}
            match gen_snapshot(cdp_port(i)).await{
                Some(s)=>{crate::notion_live::set_generating(&agent,true);if is_paused(t.id){stuck.remove(&t.id);continue;}let e=stuck.entry(t.id).or_insert((s.clone(),std::time::Instant::now()));if e.0!=s{*e=(s,std::time::Instant::now());}else if e.1.elapsed()>Duration::from_secs(STUCK_SECS){stop_generation(cdp_port(i)).await;stuck.remove(&t.id);tracing::warn!("Co-Work: Chat {} hing {STUCK_SECS}s ohne Fortschritt - gestoppt",t.role);}}
                None=>{crate::notion_live::set_generating(&agent,false);stuck.remove(&t.id);}
            }
        }
    }
}
/// Watchdog: Notion AI bleibt manchmal haengen ("Processing" ohne neuen Text, z. B. nach einem AdiCode-Neustart). Nach STUCK_SECS ohne Fortschritt stoppen; der Nudger weckt den Chat danach wieder.
const STUCK_SECS:u64=180;
/// Notion AI chats stop after each turn. Wake idle chats when work is waiting.
async fn nudger(tabs:Vec<Tab>){
    let mut last:BTreeMap<u32,(String,std::time::Instant,u32)>=BTreeMap::new();
    let mut stuck:BTreeMap<u32,(String,std::time::Instant)>=BTreeMap::new();
    loop{
        tokio::time::sleep(human_sleep(Duration::from_secs(4),50)).await;
        for(i,t)in tabs.iter().enumerate(){
            if is_paused(t.id){stuck.remove(&t.id);continue;}
            let gen_agent=agent_of(t);
            match gen_snapshot(cdp_port(i)).await{
                Some(s)=>{crate::notion_live::set_generating(&gen_agent,true);let e=stuck.entry(t.id).or_insert((s.clone(),std::time::Instant::now()));if e.0!=s{*e=(s,std::time::Instant::now());}else if e.1.elapsed()>Duration::from_secs(STUCK_SECS){stop_generation(cdp_port(i)).await;stuck.remove(&t.id);last.remove(&t.id);tracing::warn!("Co-Work: Chat {} hing {STUCK_SECS}s ohne Fortschritt - gestoppt",t.role);}continue;}
                None=>{crate::notion_live::set_generating(&gen_agent,false);stuck.remove(&t.id);}
            }
            let agent=agent_of(t);
            if is_main(t){continue;} /* Mains werden nie automatisch beschrieben */
            let Some((sig,text))=crate::notion_cowork::nudge_for(&agent) else {continue};
            if let Some((s,at,n))=last.get(&t.id){if *s==sig&&(sig.starts_with("done:")||*n>=3||at.elapsed()<Duration::from_secs(90)){continue;}}
            if user_present(cdp_port(i)).await{continue;}
            if !chat_idle(cdp_port(i)).await{continue;}
            tokio::time::sleep(Duration::from_secs(2)).await;
            if !chat_idle(cdp_port(i)).await{continue;}
            if insert_prompt(cdp_port(i),text).await.is_ok(){let n=last.get(&t.id).filter(|(s,_,_)|*s==sig).map(|x|x.2+1).unwrap_or(1);last.insert(t.id,(sig,std::time::Instant::now(),n));}
        }
    }
}
fn set_status(s:impl Into<String>){let s=s.into();tl(&format!("STATUS {s}"));*lock(&COWORK_STATUS)=s;}
pub(crate) fn status_text()->String{lock(&COWORK_STATUS).clone()}
pub(crate) fn mcp_ok(id:u32)->bool{lock(&ACCOUNT).get(&id).and_then(|a|a["mcp"].as_str()).map(|s|s=="Verbunden"||s=="Bereits verbunden").unwrap_or(false)||load().iter().find(|t|t.id==id).map(|t|mem_get(&t.email,"mcp_ok2").as_bool()==Some(true)).unwrap_or(false)}
static CHECKING: AtomicBool = AtomicBool::new(false);
/// Seite fertig geladen? (readyState, kein Spinner, App-Geruest da)
const READY_JS:&str=r#"(()=>{const vis=e=>{if(!e)return false;const r=e.getBoundingClientRect();return r.width>0&&r.height>0};if(document.readyState!=='complete')return false;const busy=[...document.querySelectorAll('[role=progressbar],.loading-spinner,[class*=LoadingSpinner],[class*=loading-spinner]')].some(vis);const app=document.querySelector('.notion-sidebar,nav,main,.notion-frame,[class*=sidebar]');return !busy&&!!app&&((document.body&&document.body.innerText)||'').trim().length>25})()"#;
const SETTINGS_OPEN_JS:&str=r#"(()=>!![...document.querySelectorAll('input')].find(e=>/^(search settings|einstellungen durchsuchen|in einstellungen suchen|suche in einstellungen)/i.test(e.getAttribute('aria-label')||e.placeholder||'')))()"#;
const OPEN_SIDEBAR_JS:&str=r#"(()=>{const b=[...document.querySelectorAll('[aria-label]')].find(e=>/^(lock sidebar open|open sidebar|seitenleiste (\u00f6ffnen|fixieren|offen halten|anheften))/i.test(e.getAttribute('aria-label')||''));if(b){b.click();return true}return false})()"#;
/// Kandidaten fuer das Workspace-/Konto-Menue: oben links (klassisch) ODER unten links (neues Layout).
const SWITCHER_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.visibility!=='hidden'&&s.display!=='none'};const H=innerHeight;const pt=e=>{const r=e.getBoundingClientRect();return {x:r.left+Math.min(r.width/2,60),y:r.top+r.height/2}};const out=[];const add=e=>{if(e&&vis(e)&&!out.includes(e))out.push(e)};document.querySelectorAll('.notion-sidebar-switcher').forEach(add);const side=[...document.querySelectorAll('[role=button],button')].filter(e=>{if(!vis(e))return false;const r=e.getBoundingClientRect();return r.left<40&&r.width>90&&r.right<460&&r.height<72&&(r.top<90||r.bottom>H-120)&&!/^(new (task|chat|page)|neue[rs]? |customize sidebar|seitenleiste anpassen|search|suche|inbox|posteingang|home|startseite|add new|neu hinzuf)/i.test((e.innerText||e.getAttribute('aria-label')||'').trim())});side.filter(e=>e.querySelector('img,[class*=avatar],[class*=Avatar]')||e.getAttribute('aria-haspopup')||/space|workspace|arbeitsbereich|\u2019s|'s/i.test(e.innerText||'')).forEach(add);side.forEach(add);return out.slice(0,6).map(pt)})()"#;
const SETTINGS_ITEM_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const re=/^(settings|einstellungen)(\s*(&|und)\s*(members|mitglieder))?$/i;const tx=x=>(x.innerText||x.getAttribute('aria-label')||'').trim().split('\n')[0];const roots=[...document.querySelectorAll('[role=dialog],[role=menu],[role=listbox]')].filter(vis).reverse();let e=null;for(const r of roots){e=[...r.querySelectorAll('[role=menuitem],[role=option],[role=button],button,a')].filter(vis).find(x=>re.test(tx(x)));if(e)break}if(!e)e=[...document.querySelectorAll('[role=menuitem],[role=option]')].filter(vis).find(x=>re.test(tx(x)));if(!e)return null;const r=e.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2}})()"#;
/// Wartet, bis Notion fertig geladen hat (2x hintereinander bereit), max. max_s Sekunden.
async fn wait_ready(port:u16,max_s:u64)->bool{let t0=std::time::Instant::now();let mut n=0;while t0.elapsed().as_secs()<max_s{if js_eval(port,READY_JS).await.ok().and_then(|v|v.as_bool()).unwrap_or(false){n+=1;if n>=2{return true;}}else{n=0;}tokio::time::sleep(Duration::from_millis(500)).await;}false}
/// Wertet js wiederholt aus, bis ein Wert (nicht null/false) kommt oder secs vorbei sind.
async fn poll_js(port:u16,js:&str,secs:u64)->Value{let t0=std::time::Instant::now();loop{if let Ok(v)=js_eval(port,js).await{if !(v.is_null()||v==Value::Bool(false)){return v;}}if t0.elapsed().as_secs()>=secs{return Value::Null;}tokio::time::sleep(Duration::from_millis(400)).await;}}
async fn press_key(port:u16,key:&str,code:&str,vk:i64,mods:i64){let _=cdp(port,vec![json!({"method":"Input.dispatchKeyEvent","params":{"type":"keyDown","key":key,"code":code,"windowsVirtualKeyCode":vk,"modifiers":mods}}),json!({"method":"Input.dispatchKeyEvent","params":{"type":"keyUp","key":key,"code":code,"windowsVirtualKeyCode":vk,"modifiers":mods}})]).await;}
/// Oeffnet die Notion-Einstellungen egal ob das Workspace-Menue oben oder unten sitzt (echte CDP-Klicks, wartet aufs Laden).
pub(crate) async fn open_settings(port:u16)->bool{
    wait_ready(port,30).await;
    if poll_js(port,SETTINGS_OPEN_JS,0).await.as_bool()==Some(true){return true;}
    let _=js_eval(port,OPEN_SIDEBAR_JS).await;tokio::time::sleep(Duration::from_millis(600)).await;
    for _ in 0..2{
        let pts=js_eval(port,SWITCHER_JS).await.ok().and_then(|v|v.as_array().cloned()).unwrap_or_default();
        for p in pts{
            if trusted_click(port,&p).await.is_err(){continue;}
            let item=poll_js(port,SETTINGS_ITEM_JS,4).await;
            if item.is_object(){let _=trusted_click(port,&item).await;if poll_js(port,SETTINGS_OPEN_JS,10).await.as_bool()==Some(true){wait_ready(port,10).await;return true;}}
            press_key(port,"Escape","Escape",27,0).await;tokio::time::sleep(Duration::from_millis(400)).await;
        }
        press_key(port,",","Comma",188,2).await;
        if poll_js(port,SETTINGS_OPEN_JS,4).await.as_bool()==Some(true){wait_ready(port,10).await;return true;}
        wait_ready(port,15).await;
    }
    false
}
const DIALOG_OPEN_JS:&str=r#"[...document.querySelectorAll('[role=dialog],[role=alertdialog]')].some(d=>{const r=d.getBoundingClientRect();return r.width>0&&r.height>0})"#;
const LANG_IS_EN_JS:&str=r#"(document.documentElement.lang||'').toLowerCase().startsWith('en')"#;
const LANG_BTN_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const pt=e=>{const r=e.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2}};const d=[...document.querySelectorAll('[role=dialog]')].filter(vis).shift();if(!d)return null;const L=/^(deutsch|english( \((us|uk)\))?|dansk|suomi|fran\u00e7ais.*|bahasa indonesia|italiano|nederlands|norsk|portugu\u00eas.*|svenska|espa\u00f1ol.*|ti\u1ebfng vi\u1ec7t)$/i;const b=[...d.querySelectorAll('[role=button],button')].filter(vis).find(e=>{const t=(e.innerText||'').trim();return L.test(t)||(t.length<10&&/[\u3040-\u30ff\u4e00-\u9fff\uac00-\ud7af\u0600-\u06ff\u0590-\u05ff\u0e00-\u0e7f]/.test(t))});if(b){const p=pt(b);p.en=/^english \(us\)$/i.test((b.innerText||'').trim());return p}const tab=[...d.querySelectorAll('[role=tab]')].filter(vis).find(e=>/^(my settings|preferences|meine einstellungen|einstellungen|pr\u00e4ferenzen)$/i.test((e.innerText||'').trim()));if(!tab)return null;const p=pt(tab);p.tab=true;return p})()"#;
const LANG_OPT_JS:&str=r#"(()=>{const e=[...document.querySelectorAll('[role=option],[role=menuitem],[role=menuitemradio]')].filter(e=>e.getBoundingClientRect().width>0).find(e=>/^english \(us\)/i.test((e.innerText||'').trim()));if(!e)return null;const r=e.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2}})()"#;
const LANG_CONFIRM_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const d=[...document.querySelectorAll('[role=dialog],[role=alertdialog]')].filter(vis).reverse().find(x=>/english \(us\)/i.test(x.innerText||'')&&(x.innerText||'').length<400);if(!d)return null;const bs=[...d.querySelectorAll('[role=button],button')].filter(vis);const b=bs.find(e=>/^(aktualisieren|update|confirm|best\u00e4tigen|ok|change|\u00e4ndern)$/i.test((e.innerText||'').trim()))||bs[0];if(!b)return null;const r=b.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2}})()"#;
/// Stellt die Notion-Oberflaeche auf English (US) (Einstellungen > Sprache), damit keine Sprachprobleme entstehen.
pub(crate) async fn set_english(port:u16)->Result<String,String>{
    wait_ready(port,30).await;
    if js_eval(port,LANG_IS_EN_JS).await.ok().and_then(|v|v.as_bool()).unwrap_or(false){return Ok("English".into());}
    if !open_settings(port).await{return Err("Sprache: Einstellungen lie\u{df}en sich nicht \u{f6}ffnen".into());}
    for _ in 0..4{
        let b=poll_js(port,LANG_BTN_JS,6).await;
        if !b.is_object(){break;}
        if b["tab"].as_bool()==Some(true){let _=trusted_click(port,&b).await;tokio::time::sleep(Duration::from_millis(700)).await;continue;}
        if b["en"].as_bool()==Some(true){press_key(port,"Escape","Escape",27,0).await;return Ok("English (US)".into());}
        let _=trusted_click(port,&b).await;
        let o=poll_js(port,LANG_OPT_JS,4).await;if !o.is_object(){press_key(port,"Escape","Escape",27,0).await;continue;}
        let _=trusted_click(port,&o).await;
        let c=poll_js(port,LANG_CONFIRM_JS,5).await;if c.is_object(){let _=trusted_click(port,&c).await;}
        tokio::time::sleep(Duration::from_millis(2500)).await;wait_ready(port,40).await;
        if poll_js(port,LANG_IS_EN_JS,15).await.as_bool()==Some(true){return Ok("Auf English (US) gestellt".into());}
        return Err("Sprache gewechselt, Seite aber noch nicht Englisch".into());
    }
    press_key(port,"Escape","Escape",27,0).await;
    Err("Sprach-Knopf nicht gefunden".into())
}
const ALREADY_JS:&str=r#"(()=>{const d=[...document.querySelectorAll('[role=dialog],[role=alertdialog]')].filter(d=>d.getBoundingClientRect().width>0).map(d=>d.innerText||'').join(' ');return /bereits (zu deinem workspace )?hinzugef\u00fcgt|bereits vorhanden|already (been )?added|already exists|already connected/i.test(d)})()"#;
/// MCP ist schon im Workspace: Dialog schliessen und als verbunden markieren.
async fn mcp_already(t:&Tab,port:u16)->bool{if !js_eval(port,ALREADY_JS).await.ok().and_then(|v|v.as_bool()).unwrap_or(false){return false;}for _ in 0..2{press_key(port,"Escape","Escape",27,0).await;tokio::time::sleep(Duration::from_millis(300)).await;}let mut a=lock(&ACCOUNT);a.entry(t.id).or_insert_with(||json!({}))["mcp"]=json!("Bereits verbunden");true}
const FS_BTN_JS:&str=r#"(()=>{if(/^\/chat/.test(location.pathname))return {done:true};const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const lb=e=>((e.getAttribute('aria-label')||'')+' '+(e.getAttribute('title')||'')+' '+(e.innerText||'')).trim();const W=innerWidth;const bs=[...document.querySelectorAll('[role=button],button')].filter(e=>{if(!vis(e))return false;const r=e.getBoundingClientRect();return r.top<90&&r.left>W*0.35&&r.width<60});const pr=e=>/full ?screen|vollbild|view|ansicht|anzeige|layout|display|sidebar|seitenleiste|floating|mode|modus|dock/i.test(lb(e))?0:e.getAttribute('aria-haspopup')?1:9;const c=bs.filter(e=>pr(e)<9).sort((a,b)=>pr(a)-pr(b))[0];if(!c)return null;const r=c.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2}})()"#;
const FS_ITEM_JS:&str=r#"(()=>{const e=[...document.querySelectorAll('[role=menuitem],[role=menuitemradio],[role=option],[role=button],button')].filter(e=>e.getBoundingClientRect().width>0).find(e=>/^(full ?screen|vollbild(modus)?|ganzer bildschirm)/i.test((e.innerText||'').trim()));if(!e)return null;const r=e.getBoundingClientRect();return {x:r.left+r.width/2,y:r.top+r.height/2}})()"#;
/// Chat offen als Seitenleiste/Floating (anderes Notion-Layout) -> auf Full screen umstellen.
async fn ensure_fullscreen(port:u16)->bool{
    for _ in 0..3{
        let b=js_eval(port,FS_BTN_JS).await.unwrap_or(Value::Null);
        if b["done"].as_bool()==Some(true){return true;}
        if !b.is_object(){return false;}
        let _=trusted_click(port,&b).await;
        let it=poll_js(port,FS_ITEM_JS,3).await;
        if it.is_object(){let _=trusted_click(port,&it).await;if poll_js(port,"/^\\/chat/.test(location.pathname)",6).await.as_bool()==Some(true){wait_ready(port,10).await;return true;}}
        press_key(port,"Escape","Escape",27,0).await;tokio::time::sleep(Duration::from_millis(400)).await;
    }
    false
}
const STUCK_LOAD_JS:&str=r#"(()=>{if(!/notion\.(so|com)$/.test(location.hostname))return false;if(document.readyState==='complete'&&!document.querySelector('#sidebar-tab-chats,[role="tab"][aria-label="Chat"],[role="tab"][aria-label="Chats"]')&&!document.querySelector('[role="dialog"]')&&!document.querySelector('[aria-label="New chat"],[aria-label="Start new chat"],[aria-label="Neuer Chat"],[aria-label="Neuen Chat starten"],[aria-label="New AI chat"],[contenteditable="true"][data-content-editable-leaf]')&&!/[0-9a-f]{32}|[?&](t|p|v)=|\/chat/i.test(location.href)&&/(^|\n)\s*(Teamspaces|Private|Privat|New task|Neue Aufgabe)\s*(\n|$)/.test((document.body&&document.body.innerText)||''))return 'layout';if(document.readyState==='loading')return true;const t=((document.body&&document.body.innerText)||'').trim();const n=[...document.querySelectorAll('[role=button],button,[role=menuitem],[role=tab],a,input')].filter(e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0&&((e.innerText||e.value||e.placeholder||'').trim())}).length;return t.length<25&&n<2})()"#;
const COOKIE_JS:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.visibility!=='hidden'&&s.display!=='none'};const lb=e=>(e.innerText||e.getAttribute('aria-label')||'').trim();const bs=[...document.querySelectorAll('button,[role=button],a')].filter(vis);const near=e=>{let p=e;for(let k=0;k<7&&p;k++){p=p.parentElement;if(p&&/cookie/i.test(p.innerText||'')&&(p.innerText||'').length<1500)return true}return false};const rej=bs.find(e=>/^(reject all|reject|decline( all)?|deny( all)?|only necessary|necessary only|use necessary cookies only|alle ablehnen|ablehnen|nur (notwendige|erforderliche|nötige)( cookies)?|alle verweigern)$/i.test(lb(e))&&near(e));if(rej){rej.click();return 'reject:'+lb(rej)}const body=(document.body&&document.body.innerText)||'';if(/cookie preferences|cookie-einstellungen|cookie settings/i.test(body)&&/reload|neu geladen/i.test(body)){const ok=bs.find(e=>/^(ok|okay)$/i.test(lb(e))&&near(e));if(ok){ok.click();return 'ok'}}return null})()"#;
static LOAD_WD:std::sync::atomic::AtomicBool=std::sync::atomic::AtomicBool::new(false);
/// Startet einmalig den Lade-Waechter: laedt Notion neu, wenn es >20 s im Lade-Skelett haengt, und lehnt Cookie-Banner ab.
fn start_load_watchdog(){if LOAD_WD.swap(true,std::sync::atomic::Ordering::SeqCst){return;}match tokio::runtime::Handle::try_current(){Ok(h)=>{h.spawn(load_watchdog());}Err(_)=>{LOAD_WD.store(false,std::sync::atomic::Ordering::SeqCst);}}}
async fn load_watchdog(){
    let mut since:BTreeMap<u32,(std::time::Instant,u32)>=BTreeMap::new();let mut lay:BTreeMap<u32,(std::time::Instant,u32)>=BTreeMap::new();
    loop{
        tokio::time::sleep(human_sleep(Duration::from_secs(5),40)).await;
        let tabs=load();
        for t in tabs.iter(){
            let port=cdp_port(tab_index(t.id));
            let Ok(st)=tokio::time::timeout(Duration::from_secs(4),js_eval(port,STUCK_LOAD_JS)).await else {continue};
            let Ok(st)=st else {since.remove(&t.id);continue};
            if let Ok(Ok(c))=tokio::time::timeout(Duration::from_secs(3),js_eval(port,COOKIE_JS)).await{if c.is_string(){mark_account(t.id,"cookie",c);}}
            if st.as_str()==Some("layout"){if user_present(port).await{since.remove(&t.id);continue;}let e=lay.entry(t.id).or_insert((std::time::Instant::now(),0));if e.1<2&&e.0.elapsed()>=Duration::from_secs(8){e.1+=1;e.0=std::time::Instant::now();let cmd=match welcome_url(t){Some(u)=>json!({"method":"Page.navigate","params":{"url":u}}),None=>json!({"method":"Page.reload","params":{"ignoreCache":true}})};let _=cdp(port,vec![cmd]).await;mark_account(t.id,"load_state",json!("Notion ohne Chat-Leiste geladen \u{2013} neu ge\u{f6}ffnet"));tracing::warn!("Tab {}: Notion ohne Chat-Leiste, neu geoeffnet",t.id);}since.remove(&t.id);continue;}else if lay.get(&t.id).map_or(false,|e|e.0.elapsed()>=Duration::from_secs(600)){lay.remove(&t.id);}
            if st.as_bool()!=Some(true){since.remove(&t.id);continue;}
            let e=since.entry(t.id).or_insert((std::time::Instant::now(),0));
            if e.0.elapsed()>=Duration::from_secs(20)&&!user_present(port).await{
                e.1+=1;e.0=std::time::Instant::now();
                let cmd=if e.1>=3{e.1=0;json!({"method":"Page.navigate","params":{"url":NOTION_URL}})}else{json!({"method":"Page.reload","params":{"ignoreCache":true}})};
                let _=cdp(port,vec![cmd]).await;mark_account(t.id,"load_state",json!("Notion hing beim Laden \u{2013} neu geladen"));tracing::warn!("Tab {}: Notion hing beim Laden, neu geladen",t.id);
            }
        }
    }
}
/// Sprache nur einmal pro Konto umstellen (gemerkt in accounts.json, bleibt auch nach Refresh).
async fn english_once(t:&Tab,port:u16)->Result<String,String>{if mem_get(&t.email,"lang_en").as_bool()==Some(true){return Ok("English (gemerkt)".into());}let r=set_english(port).await;if r.is_ok(){mem_set(&t.email,"lang_en",json!(true));}r}
/// Fuellt Name + Bearer-Token im MCP-Dialog (EN/DE), stellt Authentifizierung bei Bedarf auf Bearer.
const FILL_JS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden'};const dl=[...document.querySelectorAll('[role=dialog]')].filter(vis).pop()||document;const set=(e,v)=>{if(!e)return false;e.focus();const d=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value');d.set.call(e,v);e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));return true};const lab=e=>{let t=(e.getAttribute('aria-label')||'')+' '+(e.placeholder||'');let p=e;for(let k=0;k<4&&p;k++){p=p.parentElement;if(!p)break;const l=[...p.childNodes].map(n=>n.nodeType===3?n.textContent:(n.contains&&n.contains(e)?'':(n.innerText||''))).join(' ');if(l.trim()){t+=' '+l;break}}return t.toLowerCase()};const ins=()=>[...dl.querySelectorAll('input')].filter(e=>vis(e)&&!['checkbox','radio','hidden'].includes(e.type));let a=ins();const url=a.find(e=>/^https?:/i.test(e.value)||/https?:|mcp|url/i.test(e.placeholder||''));let name=a.find(e=>e!==url&&e.type!=='password'&&/name|example mcp|beispiel/i.test(lab(e)));if(!name)name=a.find(e=>e!==url&&e.type!=='password'&&!/token|bearer|präfix|prefix|header|schlüssel/i.test(lab(e)));if(name&&!name.value.trim())set(name,'AdiCode');const findTok=()=>ins().find(e=>e!==url&&e!==name&&(e.type==='password'||/token|api key|schlüssel/i.test(lab(e))));let tok=findTok();if(!tok&&__TOKEN__){const auth=[...dl.querySelectorAll('button,[role=button],[role=combobox],select')].filter(vis).find(e=>{const t=(e.innerText||'').trim();return /^(none|keine|ohne|no auth|kein)/i.test(t)||(/authenti/i.test(lab(e))&&t.length<30&&!/bearer/i.test(t))});if(auth){if(auth.tagName==='SELECT'){const o=[...auth.options].find(o=>/bearer/i.test(o.text));if(o){auth.value=o.value;auth.dispatchEvent(new Event('change',{bubbles:true}))}}else{auth.click();await sleep(600);const opt=[...document.querySelectorAll('[role=menuitem],[role=option],[role=menuitemradio],button,[role=button]')].filter(vis).find(e=>/^bearer/i.test((e.innerText||'').trim()));if(opt){opt.click();await sleep(700)}}tok=findTok()}if(tok&&__TOKEN__&&tok.value!==__TOKEN__)set(tok,__TOKEN__);await sleep(400);const btn=[...dl.querySelectorAll('button,[role=button]')].filter(vis).reverse().find(e=>/^(connect|verbinden|hinzufügen|add|speichern|save)$/i.test((e.innerText||'').trim()));if(!btn||btn.disabled||btn.getAttribute('aria-disabled')==='true')return null;const r=btn.getBoundingClientRect();return {x:r.x+r.width/2,y:r.y+r.height/2,name:!!(name&&name.value),token:!!(tok&&tok.value)}})()"#;
async fn js_eval(port:u16,expr:&str)->Result<Value,String>{Ok(cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":expr,"awaitPromise":true,"returnByValue":true}})]).await?.last().and_then(|v|v.pointer("/result/result/value")).cloned().unwrap_or(Value::Null))}
async fn wait_cdp(port:u16)->bool{for _ in 0..40{if target(port).await.is_ok(){return true;}tokio::time::sleep(Duration::from_secs(1)).await;}false}
const FIND_WELCOME:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.visibility!=='hidden'&&s.display!=='none'};const re=/^(welcome to notion|willkommen (bei|in|zu) notion)/i;for(let k=0;k<20;k++){const tab=document.querySelector('#sidebar-tab-chats,[role="tab"][aria-label="Chat"],[role="tab"][aria-label="Chats"]');if(tab&&tab.getAttribute('aria-selected')!=='true')tab.click();if(!tab&&k>=6)return {found:false,notabs:true};const its=[...document.querySelectorAll('[role="menuitem"]')].filter(vis);const side=k>=6?its.filter(e=>e.getBoundingClientRect().left<420&&!e.closest('[role="dialog"]')&&!/^(new chat|neuer chat|hide tab name|show more|mehr anzeigen)$/i.test((e.innerText||'').trim().split('\n')[0].trim())).sort((a,b)=>a.getBoundingClientRect().top-b.getBoundingClientRect().top):[];const pool=side.filter(e=>e.closest('[role="tabpanel"]'));const item=its.find(e=>/^tab \d+$/i.test((e.innerText||'').trim().split('\n')[0].trim()))||its.find(e=>re.test((e.innerText||'').trim()))||(pool.length?pool:side)[0];if(item){item.click();await sleep(1500);return {found:true}}if(k%5===4){const sc=[...document.querySelectorAll('[role="menu"],[role="tabpanel"],[role="list"]')].find(e=>vis(e)&&e.scrollHeight>e.clientHeight+20);if(sc)sc.scrollTop+=500;}await sleep(500);}return {found:false}})()"#;
const CHAT_READY:&str=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>180&&r.height>20&&s.visibility!=='hidden'&&s.display!=='none'};const composer=[...document.querySelectorAll('textarea,[contenteditable="true"]')].filter(vis)[0];const p=location.pathname;return {ready:(p==='/ai'||p.startsWith('/ai/')||p==='/chat'||p.startsWith('/chat/'))&&!!composer,href:location.href}})()"#;
/// Oeffnet IMMER den bestehenden Chat "Willkommen bei Notion" - es wird nie ein neuer Chat angelegt.
/// Schliesst offene Notion-Einstellungen (z. B. nach dem MCP-Check) per X bzw. Escape.
const CLOSE_SETTINGS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const q=()=>document.querySelector('input[aria-label="Search settings"],input[placeholder="Search settings"],input[aria-label="Einstellungen durchsuchen"]');for(let k=0;k<5;k++){const s=q();if(!s)return true;const dlg=s.closest('[role="dialog"]')||document.body;const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const b=[...dlg.querySelectorAll('[aria-label="Close"],[aria-label="Schließen"],[aria-label="Schliessen"]')].filter(vis)[0];if(b)b.click();else document.activeElement&&document.activeElement.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',code:'Escape',keyCode:27,bubbles:true}));await sleep(700);}return !q()})()"#;
async fn close_settings(port:u16){let ok=js_eval(port,CLOSE_SETTINGS).await.ok().and_then(|v|v.as_bool()).unwrap_or(false);if !ok{let k=|t:&str|json!({"method":"Input.dispatchKeyEvent","params":{"type":t,"key":"Escape","code":"Escape","windowsVirtualKeyCode":27}});let _=cdp(port,vec![k("keyDown"),k("keyUp")]).await;tokio::time::sleep(Duration::from_millis(500)).await;}}
const GUARD_JS:&str=r#"(()=>{if(window.__acg)return 1;window.__acg=1;const re=/^(new chat|neuer chat|start a new chat|neuen chat starten|new agent|neuer agent)$/i;document.addEventListener('click',e=>{const el=e.target.closest&&e.target.closest('a,button,[role=button],[role=menuitem]');if(!el)return;const raw=(el.innerText||el.getAttribute('aria-label')||'').trim().replace(/\s+/g,' ');const t=raw.replace(/ ctrl.o$/i,'');if(re.test(t)){e.preventDefault();e.stopPropagation();e.stopImmediatePropagation()}},true);document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&(e.key==='o'||e.key==='O')){e.preventDefault();e.stopPropagation()}},true);return 1})()"#;
/// Gemerkte URL des Chats Willkommen bei Notion (nur echte Chat-URLs).
pub(crate) fn welcome_url(t:&Tab)->Option<String>{lock(&ACCOUNT).get(&t.id).and_then(|a|a["welcome_url"].as_str().map(String::from)).or_else(||mem_get(&t.email,"welcome_url").as_str().map(String::from)).filter(|u|u.contains("/chat")&&u.contains("t="))}
pub(crate) async fn prepare_chat(t:&Tab,i:usize)->Result<(),String>{
    let port=cdp_port(i);close_settings(port).await;let _=js_eval(port,GUARD_JS).await;
    let known=lock(&ACCOUNT).get(&t.id).and_then(|a|a["welcome_url"].as_str().map(String::from)).or_else(||mem_get(&t.email,"welcome_url").as_str().map(String::from)).filter(|u|u.contains("/chat"));
    let mut found=false;
    if let Some(u)=known.as_ref(){
        let here=js_eval(port,"location.href").await?;
        if here.as_str()!=Some(u.as_str()){cdp(port,vec![json!({"method":"Page.navigate","params":{"url":u}})]).await?;tokio::time::sleep(Duration::from_secs(3)).await;}
        let noacc=js_eval(port,"/don.t have access to this chat|keinen Zugriff auf diesen Chat/i.test(document.body.innerText)").await.ok().and_then(|v|v.as_bool()).unwrap_or(false);if noacc{mem_set(&t.email,"welcome_url",Value::Null);mark_account(t.id,"welcome_url",Value::Null);cdp(port,vec![json!({"method":"Page.navigate","params":{"url":NOTION_URL}})]).await?;tokio::time::sleep(Duration::from_secs(4)).await;}
        found=true;
    }
    if !found{
        for attempt in 0..4{
            if attempt>0{let cmd=if attempt%2==1{json!({"method":"Page.reload","params":{"ignoreCache":true}})}else{json!({"method":"Page.navigate","params":{"url":NOTION_URL}})};cdp(port,vec![cmd]).await?;tokio::time::sleep(Duration::from_secs(5)).await;}
            let r=js_eval(port,FIND_WELCOME).await?;
            if r["found"].as_bool().unwrap_or(false){found=true;break;}
        }
    }
    if found{ensure_fullscreen(port).await;}
    if !found{mark_account(t.id,"chat",json!("Chat \u{201a}Willkommen bei Notion\u{2018} nicht gefunden"));return Err(format!("{}: Chat \u{201a}Willkommen bei Notion\u{2018} nicht gefunden (es wird bewusst kein neuer Chat ge\u{f6}ffnet)",t.role));}
    for _ in 0..25{
        tokio::time::sleep(Duration::from_secs(1)).await;
        let v=js_eval(port,CHAT_READY).await?;
        if v["ready"].as_bool().unwrap_or(false){let _=js_eval(port,GUARD_JS).await;let mut a=lock(&ACCOUNT);let e=a.entry(t.id).or_insert_with(||json!({"usage":null,"models":[]}));e["chat"]=json!("Willkommen bei Notion bereit");e["url"]=v["href"].clone();e["welcome_url"]=v["href"].clone();drop(a);mem_set(&t.email,"welcome_url",v["href"].clone());return Ok(());}
    }
    mark_account(t.id,"chat",json!("Chat nicht bereit"));
    Err(format!("{}: Notion-Chatbox wurde nicht bereit",t.role))
}
/// Claude-Modelle in "Allowed models for Notion Agent" (interne Notion-Codenamen -> Anzeigename).
const CLAUDE_MODELS:[(&str,&str);8]=[("albuquerque-quinn","Opus 5.5"),("achira-donut","Sonnet 5.5"),("agave-flan","Opus 5"),("ambrosia-tart-high","Opus 4.8"),("apricot-sorbet-high","Opus 4.7"),("angel-cake-high","Sonnet 5"),("almond-croissant-low","Sonnet 4.6"),("anthropic-haiku-4.5","Haiku 4.5")];
/// Main = Opus 5.5 (Orchestrator), alle Worker = Sonnet 5.5.
fn target_model(i:usize)->(&'static str,&'static str){if i==0||token_high(){CLAUDE_MODELS[0]}else{CLAUDE_MODELS[1]}}
const MODELS_JS:&str=r#"(async()=>{const T='__T__';const ALL=__ALL__;const OTHER=['openai','gemini','xai','deepseek','kimi','glm'];const post=async(u,b)=>{const r=await fetch('/api/v3/'+u,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(b)});if(!r.ok)throw new Error(u+' HTTP '+r.status);return r.json()};const read=async()=>{const j=await post('getSpaces',{});const uid=Object.keys(j)[0];const sid=Object.keys((j[uid]||{}).space||{})[0];if(!sid)throw new Error('Workspace nicht gefunden');const v=j[uid].space[sid].value;const s=((v&&v.value)||v||{}).settings||{};return {sid,pol:s.personal_agent_model_policy||{}}};const allowed=p=>ALL.filter(m=>!(p.disabledModels||[]).includes(m));const good=p=>{const a=allowed(p);return a.length===1&&a[0]===T&&OTHER.every(x=>(p.disabledProviders||[]).includes(x))};try{let {sid,pol}=await read();if(good(pol))return {ok:true,changed:false,allowed:allowed(pol)};const np={disabledModels:ALL.filter(m=>m!==T),disabledProviders:OTHER};await post('saveTransactionsFanout',{requestId:crypto.randomUUID(),transactions:[{id:crypto.randomUUID(),spaceId:sid,debug:{userAction:'ModelControls.save'},operations:[{pointer:{table:'space',id:sid,spaceId:sid},path:['settings','personal_agent_model_policy'],command:'set',args:np}]}]});await new Promise(r=>setTimeout(r,1500));pol=(await read()).pol;return {ok:good(pol),changed:true,allowed:allowed(pol)}}catch(e){return {ok:false,error:String(e&&e.message||e)}}})()"#;
/// Prueft und setzt Notion AI -> Model controls -> Allowed models for Notion Agent auf genau das Rollenmodell. Wird gemerkt.
/// Stellt im offenen Chat (Willkommen bei Notion) den Modell-Knopf auf das Rollenmodell (Automatisch nutzt sonst oft Sonnet).
const CHAT_MODEL_JS:&str=r#"(async()=>{const T='__TM__';const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const norm=e=>(e.innerText||'').trim().replace(/\s+/g,' ');const btn=()=>[...document.querySelectorAll('[aria-haspopup="dialog"]')].filter(vis).find(e=>/^(automatisch|auto|opus|sonnet|haiku|gpt|gemini|claude)\b/i.test(norm(e)));const label=()=>{const b=btn();return b?norm(b):null};const esc=()=>document.activeElement&&document.activeElement.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',code:'Escape',keyCode:27,bubbles:true}));const want=e=>norm(e).toLowerCase().startsWith(T.toLowerCase());const items=()=>[...document.querySelectorAll('[role="menuitem"],[role="menuitemradio"],[role="option"]')].filter(vis);const busyEl=()=>[...document.querySelectorAll('[aria-label]')].filter(vis).find(e=>/^(stop|stoppen|antwort stoppen|ki-nachricht stoppen|stop ai message|stop generating)$/i.test(e.getAttribute('aria-label')||''));try{const ck=[...document.querySelectorAll('[role="dialog"]')].filter(vis).find(d=>/cookie/i.test(d.innerText||''));if(ck){const okb=[...ck.querySelectorAll('[role="button"],button')].filter(vis).find(e=>/^(ok|okay)$/i.test(norm(e)));if(okb){okb.click();return {ok:false,busy:true,unblock:'cookie-ok'}}if(busyEl()){const fresh=!/adicode/i.test(document.body.innerText||'');if(fresh&&'__UNBLOCK__'==='1'){const rj=[...document.querySelectorAll('[role="button"],button')].filter(vis).find(e=>/^(alle ablehnen|reject all|deny all)$/i.test(norm(e)));if(rj){rj.click();return {ok:false,busy:true,unblock:'reject'}}busyEl().click();return {ok:false,busy:true,unblock:'stop'}}return {ok:false,busy:true,error:'Chat arbeitet gerade'}}const b0=btn();if(!b0){const comp=document.querySelector('[aria-label="KI-Nachricht senden"],[aria-label="Send AI message"],[aria-label="Sprachaufnahme starten"],[aria-label="Start voice recording"]');if(comp)return {ok:true,changed:false,nopicker:true,before:'',after:''};return {ok:false,error:'Modell-Knopf im Chat nicht gefunden'}}const before=norm(b0);if(before.toLowerCase().startsWith(T.toLowerCase()))return {ok:true,changed:false,before,after:before};let it=items().find(want);if(!it){b0.click();await sleep(900);it=items().find(want);}if(!it){const more=items().find(e=>/^(weitere modelle|more models)/i.test(norm(e)));if(more){more.click();await sleep(900);it=items().find(want);}}if(!it){const seen=items().map(norm).slice(0,12);esc();return {ok:false,before,error:'Eintrag '+T+' nicht im Modell-Menue',seen}}it.click();await sleep(1200);const after=label();return {ok:!!after&&after.toLowerCase().startsWith(T.toLowerCase()),changed:true,before,after}}catch(e){return {ok:false,error:String(e&&e.message||e)}}})()"#;
async fn ensure_chat_model(t:&Tab,i:usize)->Result<(),String>{
    let (_,tname)=target_model(i);if mem_get(&t.email,"chat_model").as_str()==Some(AsRef::<str>::as_ref(&tname)){mark_account(t.id,"model_ok",json!(true));return Ok(());}
    let mut r=Value::Null;for k in 0..40{r=js_eval(cdp_port(i),&CHAT_MODEL_JS.replace("__TM__",tname).replace("__UNBLOCK__",if k>=4{"1"}else{"0"})).await?;if r["ok"].as_bool().unwrap_or(false)||k==39{break;}if let Some(u)=r["unblock"].as_str(){tl(&format!("tab{} chat_unblock={u}",t.id));}if r["busy"].as_bool().unwrap_or(false){mark_account(t.id,"check",json!("Warte bis der Chat frei ist \u{2026}"));}tokio::time::sleep(Duration::from_secs(3)).await;}
    if r["ok"].as_bool().unwrap_or(false){mem_set(&t.email,"chat_model",json!(tname));mark_account(t.id,"model_ok",json!(true));mark_account(t.id,"model_state",json!(format!("{tname}: Policy + Chat{}",if r["nopicker"].as_bool().unwrap_or(false){" ok (kein Modell-Knopf: nur Policy-Modell erlaubt)"}else if r["changed"].as_bool().unwrap_or(false){" umgestellt"}else{" ok"})));Ok(())}
    else if r["busy"].as_bool().unwrap_or(false){mark_account(t.id,"model_state",json!(format!("Policy {tname}; Chat arbeitet gerade \u{2013} Chat-Modell beim n\u{e4}chsten Check")));Ok(())}
    else{let e=r["error"].as_str().unwrap_or("unbekannt").to_string();mark_account(t.id,"model_ok",json!(false));mark_account(t.id,"model_state",json!(format!("Chat nicht auf {tname}: {e}")));Err(format!("{}: Chat-Modell {e}",t.role))}
}
/// Startet unter Einstellungen -> Notion-KI -> KI-Konnektoren das kostenlose Probe-Abo (Business), wenn noch keins aktiv ist.
const ENTITLEMENT_START_JS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const norm=e=>(e.innerText||e.getAttribute('aria-label')||'').trim().replace(/\s+/g,' ');const byText=(re,sel)=>[...document.querySelectorAll(sel||'div[role="button"],div[role="menuitem"],[role="tab"],button,a')].filter(vis).find(e=>re.test((e.innerText||'').trim().split('\n')[0]));const tabBy=re=>[...document.querySelectorAll('[role="tab"]')].filter(vis).find(e=>re.test(norm(e)));const btnBy=re=>[...document.querySelectorAll('button,[role="button"]')].filter(vis).find(e=>re.test(norm(e)));const wait=async(f,n)=>{for(let k=0;k<(n||16);k++){const x=f();if(x)return x;await sleep(500);}return null};try{if(!tabBy(/^notion[- ]?(ki|ai)$/i)){let st=byText(/^(settings|einstellungen)$/i);if(!st){const sw=document.querySelector('.notion-sidebar-switcher,[class*="switcher"]')||byText(/space$/i);if(sw){sw.click();await sleep(900);}st=byText(/^(settings|einstellungen)$/i);}if(!st)return {ok:false,error:'Einstellungen nicht gefunden'};st.click();}const ai=await wait(()=>tabBy(/^notion[- ]?(ki|ai)$/i));if(!ai)return {ok:false,error:'Tab Notion-KI nicht gefunden'};ai.click();const con=await wait(()=>tabBy(/^(ki-konnektoren|ai connectors)$/i));if(!con)return {ok:false,error:'Tab KI-Konnektoren nicht gefunden'};con.click();const tr=await wait(()=>btnBy(/^(kostenlos ausprobieren|try for free|try it free|start free trial)$/i),10);if(!tr)return {ok:false,error:'Knopf Kostenlos ausprobieren nicht da'};tr.click();const go=await wait(()=>btnBy(/^(kostenloses probe-abo starten|probe-abo starten|start free trial|start trial)$/i),12);if(!go)return {ok:false,error:'Knopf Probe-Abo starten nicht da'};go.click();await sleep(9000);return {ok:true}}catch(e){return {ok:false,error:String(e&&e.message||e)}}})()"#;
async fn ensure_entitlement(t:&Tab,i:usize)->Result<(),String>{
    let port=cdp_port(i);mark_account(t.id,"trial_state",json!("Aktiviere Entitlement \u{2026}"));
    let r=tokio::time::timeout(Duration::from_secs(50),js_eval(port,ENTITLEMENT_START_JS)).await;tokio::time::sleep(human_sleep(Duration::from_secs(8),50)).await;close_settings(port).await;check_entitlement(t,i).await;
    if lock(&ACCOUNT).get(&t.id).map(|a|a["trial"].as_bool()==Some(true)).unwrap_or(false){tokio::time::sleep(Duration::from_secs(3)).await;let mut s2=String::new();for _ in 0..3{s2=setup_phase(port,"cancel",&t.email).await;if s2.starts_with("cancelled"){break;}tokio::time::sleep(Duration::from_secs(3)).await;}close_settings(port).await;mark_account(t.id,"trial_state",json!(if s2.starts_with("cancelled"){"Entitlement aktiv (gestartet + gek\u{fc}ndigt)".to_string()}else{format!("Entitlement aktiv, K\u{fc}ndigung offen: {s2}")}));return Ok(());}
    let e=match r{Ok(Ok(v))=>v["error"].as_str().unwrap_or("nicht best\u{e4}tigt").to_string(),Ok(Err(e))=>e,Err(_)=>"Zeit\u{fc}berschreitung".into()};mark_account(t.id,"trial_state",json!(format!("Entitlement nicht aktiviert: {e}")));Err(format!("{}: Trial {e}",t.role))
}
async fn ensure_models(t:&Tab,i:usize)->Result<(),String>{
    let (tid,tname)=target_model(i);if mem_get(&t.email,"models_ok").as_str()==Some(AsRef::<str>::as_ref(&tid)){mark_account(t.id,"model_ok",json!(true));return Ok(());}
    mark_account(t.id,"model_target",json!(tname));
    let all=serde_json::to_string(&CLAUDE_MODELS.iter().map(|(k,_)|*k).collect::<Vec<_>>()).unwrap_or_default();
    let r=js_eval(cdp_port(i),&MODELS_JS.replace("__T__",tid).replace("__ALL__",&all)).await?;
    if r["ok"].as_bool().unwrap_or(false){mem_set(&t.email,"models_ok",json!(tid));mark_account(t.id,"model_ok",json!(true));mark_account(t.id,"model_state",json!(if r["changed"].as_bool().unwrap_or(false){format!("{tname} gesetzt")}else{tname.to_string()}));Ok(())}
    else{let e=r["error"].as_str().map(String::from).unwrap_or_else(||format!("erlaubt: {}",r["allowed"]));mark_account(t.id,"model_ok",json!(false));mark_account(t.id,"model_state",json!(format!("Nicht {tname}: {e}")));Err(format!("{}: Modell {e}",t.role))}
}
/// Ein einziger Check pro Konto: Tab -> Login -> AdiCode-MCP (gemerkt) -> Modelle (gemerkt) -> Usage -> Chat "Willkommen bei Notion". Laeuft immer komplett durch.
static CHECK_TABS:std::sync::Mutex<Vec<u32>>=std::sync::Mutex::new(Vec::new());
/// Laufende Checks (pro Tab bzw. Gesamt-Check) - fuer den Stopp-Knopf.
static CHECK_JOBS:Lazy<Mutex<BTreeMap<u32,tokio::task::AbortHandle>>>=Lazy::new(||Mutex::new(BTreeMap::new()));
static CHECK_ALL:Lazy<Mutex<Option<tokio::task::AbortHandle>>>=Lazy::new(||Mutex::new(None));
fn check_stop(id:Option<u32>)->Result<String,String>{
    let tabs=load();let mut n=0;
    let mut ids:Vec<u32>=match id{Some(x)=>vec![x],None=>tabs.iter().map(|t|t.id).collect()};
    let all_running=CHECKING.load(Ordering::SeqCst);
    if id.is_none()||(all_running&&!lock(&CHECK_JOBS).contains_key(&id.unwrap_or(0))){if let Some(h)=lock(&CHECK_ALL).take(){h.abort();n+=1;ids=tabs.iter().map(|t|t.id).collect();}CHECKING.store(false,Ordering::SeqCst);}
    for x in &ids{if let Some(h)=lock(&CHECK_JOBS).remove(x){h.abort();n+=1;}}
    CHECK_TABS.lock().unwrap_or_else(|e|e.into_inner()).retain(|x|!ids.contains(x));
    for x in ids{let was=lock(&ACCOUNT).get(&x).map(|a|a["checking"].as_bool()==Some(true)).unwrap_or(false);mark_account(x,"checking",json!(false));if was{mark_account(x,"check",json!("Check gestoppt"));tokio::spawn(async move{mcp_cleanup(cdp_port(tab_index(x))).await;});}}
    Ok(if n>0{"Check gestoppt.".into()}else{"Kein Check aktiv.".into()})
}
/// Ein Check pro Tab gleichzeitig (zwei parallele Checks im selben Tab haben sich im MCP-Dialog gegenseitig blockiert) + Zeitlimit 8 min.
async fn check_one(t:Tab,i:usize)->Result<(),String>{
    let id=t.id;let role=format!("{}",t.role);
    {let mut g=CHECK_TABS.lock().unwrap_or_else(|e|e.into_inner());if g.contains(&id){return Err(format!("{role}: Check l\u{e4}uft bereits"));}g.push(id);}
    mark_account(id,"checking",json!(true));
    let r=match tokio::time::timeout(Duration::from_secs(480),check_one_inner(t,i)).await{Ok(r)=>r,Err(_)=>{mcp_cleanup(cdp_port(i)).await;mark_account(id,"check",json!("Check abgebrochen (Zeitlimit 8 min)"));Err(format!("{role}: Check-Zeitlimit"))}};
    mark_account(id,"checking",json!(false));
    CHECK_TABS.lock().unwrap_or_else(|e|e.into_inner()).retain(|x|*x!=id);r
}
async fn check_one_inner(t:Tab,i:usize)->Result<(),String>{
    if t.email.is_empty(){mark_account(t.id,"check",json!("Keine E-Mail eingetragen"));return Err(format!("{}: keine E-Mail",t.role));}
    let port=cdp_port(i);
    mark_account(t.id,"check",json!("Warte auf Tab \u{2026}"));
    if !wait_cdp(port).await{mark_account(t.id,"check",json!("Tab nicht erreichbar"));mark_account(t.id,"usage_error",json!("Tab nicht erreichbar"));return Err(format!("{}: Tab nicht erreichbar",t.role));}
    let mut ok=false;for _ in 0..25{if logged_in(port).await{ok=true;break;}tokio::time::sleep(Duration::from_secs(1)).await;}
    if !ok{mark_account(t.id,"check",json!("Auto-Login \u{2026}"));for _ in 0..40{let st=setup_phase(port,"onboard",&t.email).await;if st.starts_with("workspace"){ok=true;break;}tokio::time::sleep(Duration::from_secs(3)).await;if logged_in(port).await{ok=true;break;}}}
    if !ok{mark_account(t.id,"check",json!("Nicht eingeloggt \u{2013} Login nutzen"));return Err(format!("{}: nicht in Notion eingeloggt",t.role));}
    mark_account(t.id,"check",json!("Stelle Notion auf Englisch \u{2026}"));match english_once(&t,port).await{Ok(v)=>mark_account(t.id,"lang",json!(v)),Err(e)=>mark_account(t.id,"lang",json!(e))}step(t.id,1);let mut missing:Vec<&str>=Vec::new();let mut errs:Vec<String>=Vec::new();mark_account(t.id,"check",json!("Pr\u{fc}fe Trial \u{2026}"));check_entitlement(&t,i).await;if lock(&ACCOUNT).get(&t.id).and_then(|a|a["trial_state"].as_str().map(|s|s.starts_with("Kein aktives Entitlement"))).unwrap_or(false){mark_account(t.id,"check",json!("Aktiviere Entitlement \u{2026}"));if let Err(e)=ensure_entitlement(&t,i).await{missing.push("Trial");errs.push(e);}}
    if mem_get(&t.email,"mcp_ok2").as_bool()==Some(true){mark_account(t.id,"check",json!("AdiCode-MCP gemerkt \u{2013} \u{fc}bersprungen"));mark_account(t.id,"mcp",json!("Verbunden (gemerkt)"));mark_account(t.id,"mcp_saved",json!(true));if mem_get(&t.email,"mcp_perm3").as_bool()!=Some(true){mark_account(t.id,"check",json!("Setze AdiCode-Rechte auf Run automatically \u{2026}"));let _=tokio::time::timeout(Duration::from_secs(90),mcp_finish(&t,cdp_port(i))).await;mcp_cleanup(cdp_port(i)).await;}}else{mark_account(t.id,"check",json!("Pr\u{fc}e AdiCode-MCP \u{2026}"));match setup_mcp_safe(&t,i).await{Ok(_)=>{mem_set(&t.email,"mcp_ok2",json!(true));mark_account(t.id,"mcp_saved",json!(true));}Err(e)=>{mark_account(t.id,"mcp",json!(format!("Fehlt: {e}")));missing.push("MCP");errs.push(format!("{}: MCP {e}",t.role));}}}
    step(t.id,2);mark_account(t.id,"check",json!("Pr\u{fc}fe Modelle \u{2026}"));
    if let Err(e)=ensure_models(&t,i).await{missing.push("Modell");errs.push(e);}step(t.id,3);step(t.id,4);
    mark_account(t.id,"check",json!("Pr\u{fc}e Usage \u{2026}"));
    inspect_account(&t,i).await;step(t.id,5);if mem_get(&t.email,"usage_ui_ok").as_bool()!=Some(true){let _=tokio::time::timeout(Duration::from_secs(40),check_usage_ui(&t,i)).await;mem_set(&t.email,"usage_ui_ok",json!(true));}let _=tokio::time::timeout(Duration::from_secs(40),check_chats(&t,i)).await;
    mark_account(t.id,"check",json!("\u{d6}ffne \u{201a}Willkommen bei Notion\u{2018} \u{2026}"));
    match {let r=prepare_chat(&t,i).await;if r.is_err(){tokio::time::sleep(Duration::from_secs(3)).await;prepare_chat(&t,i).await}else{r}}{Ok(())=>{mark_account(t.id,"chat_ok",json!(true));mark_account(t.id,"check",json!("Pr\u{fc}fe Chat-Modell \u{2026}"));if let Err(e)=ensure_chat_model(&t,i).await{missing.push("Modell");errs.push(e);}mark_account(t.id,"check",json!("Benenne Chats \u{2026}"));let n=pick_chat_tab(&t);match tokio::time::timeout(Duration::from_secs(90),name_chats(&t,i,n)).await{Ok(Ok(s))=>{if s.starts_with("Chats hei"){mem_set(&t.email,"chats_named",json!(true));}mark_account(t.id,"chat_tab",json!(n));mark_account(t.id,"chat_tab_state",json!(s));}Ok(Err(e))=>{mark_account(t.id,"chat_tab_state",json!(format!("Tab {n}: {e}")));}Err(_)=>{mark_account(t.id,"chat_tab_state",json!(format!("Tab {n}: Zeit\u{fc}berschreitung")));}}},Err(e)=>{mark_account(t.id,"chat_ok",json!(true));mark_account(t.id,"chat",json!(format!("Chat vorhanden \u{2013} {e}")));}}
    {let off=js_eval(cdp_port(i),AI_OFF_JS).await.map(|v|v.is_object()).unwrap_or(false);mark_account(t.id,"ai_off",json!(off));if off{mark_account(t.id,"chat_ok",json!(false));mark_account(t.id,"chat",json!("Notion KI ist f\u{fc}r diesen Workspace deaktiviert"));missing.push("Chat");errs.push(format!("{}: Notion KI f\u{fc}r diesen Workspace deaktiviert",t.role));}}
    step(t.id,7);if !errs.is_empty(){mark_account(t.id,"check",json!(format!("{} fehlt",missing.join(", "))));return Err(errs.join("; "));}
    step(t.id,7);let ex=lock(&ACCOUNT).get(&t.id).map(|a|a["exhausted"].as_bool().unwrap_or(false)).unwrap_or(false);
    mark_account(t.id,"check",json!(if ex{"OK \u{2013} aber KI-Kontingent aufgebraucht"}else{"OK"}));mark_account(t.id,"last_check",json!(chrono::Local::now().format("%d.%m. %H:%M").to_string()));
    Ok(())
}
async fn full_check(tabs:&[Tab])->Vec<String>{
    set_status("Account-Check: AdiCode-MCP, Usage und Chat \u{201a}Willkommen bei Notion\u{2018} \u{2026}");
    let hs:Vec<_>=tabs.iter().cloned().enumerate().filter(|(_,t)|!skipped(t.id)).map(|(i,t)|tokio::spawn(check_one(t,i))).collect();
    let mut errs=Vec::new();for h in hs{match h.await{Ok(Err(e))=>errs.push(e),Err(e)=>errs.push(e.to_string()),_=>{}}}errs
}
fn check_action()->Result<String,String>{
    let tabs=load();if tabs.is_empty(){return Err("Noch keine Tabs eingetragen.".into());}
    if CHECKING.swap(true,Ordering::SeqCst){return Ok("Check l\u{e4}uft bereits.".into());}
    let running=running_ids(&tabs);
    for t in tabs.iter().filter(|t|!running.contains(&t.id)&&!t.email.is_empty()&&!skipped(t.id)){if let Err(e)=launch(t,&start_url(t)){CHECKING.store(false,Ordering::SeqCst);return Err(e);}}
    let h=tokio::spawn(async move{let errs=full_check(&tabs).await;CHECKING.store(false,Ordering::SeqCst);if errs.is_empty(){hide_all_tabs(&tabs);}set_status(if errs.is_empty(){"Check ok: alle Konten bereit (MCP, Usage, Chat \u{201a}Willkommen bei Notion\u{2018}).".to_string()}else{format!("Check: {}",errs.join("; "))});});*lock(&CHECK_ALL)=Some(h.abort_handle());
    Ok("Check l\u{e4}uft: fehlende Tabs werden gestartet, dann MCP, Usage und Chat gepr\u{fc}ft.".into())
}
async fn open_main(port:u16)->Result<(),String>{cdp(port,vec![json!({"method":"Page.bringToFront"})]).await?;Ok(())
}
const QUOTA_JS:&str=r#"/used your (trial )?AI allowance|add a payment method to unlock more AI|KI-Kontingent|AI-Guthaben/i.test((document.body&&document.body.innerText)||'')"#;
async fn insert_prompt(port:u16,prompt:String)->Result<(),String>{
    // Harte Regel: AdiCode schreibt NIE in einen anderen Chat als Willkommen bei Notion.
    let chk=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":"JSON.stringify({u:location.href,b:(document.body.innerText||'').slice(0,300),t:document.title})","returnByValue":true}})]).await?.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_str).map(String::from).unwrap_or_default();
    let cv:Value=serde_json::from_str(&chk).unwrap_or(Value::Null);let cu=cv["u"].as_str().unwrap_or("").to_string();let cb=cv["b"].as_str().unwrap_or("").to_lowercase();
    let idx=(port as usize).saturating_sub(9301);let email=load().get(idx).map(|t|t.email.clone()).unwrap_or_default();
    let known=mem_get(&email,"welcome_url");let known=known.as_str().unwrap_or("").to_string();
    let tid=|u:&str|u.split(|c|c=='?'||c=='&').find_map(|p|p.strip_prefix("t=")).unwrap_or("").to_string();
    let same=!known.is_empty()&&!tid(&known).is_empty()&&tid(&known)==tid(&cu);
    let crumb=cb.contains("welcome to notion")||cb.contains("willkommen bei notion")||cb.contains("willkommen in notion")||mem_get(&email,"chat_tab").as_u64().map_or(false,|n|cb.contains(&format!("tab {n}")));
    let ct=cv["t"].as_str().unwrap_or("").to_lowercase();let named=ct.contains("welcome to notion")||ct.contains("willkommen bei notion")||ct.contains("willkommen in notion")||mem_get(&email,"chat_tab").as_u64().map_or(false,|n|ct.starts_with(&format!("tab {n}")));
    // Nie in einen neuen, leeren Chat schreiben (das legt in Notion einen neuen Chat an): nur in einen bestehenden Chat (URL mit t=).
    if tid(&cu).is_empty()||!(same||crumb||named){return Err("Nicht im Chat Willkommen bei Notion - nichts gesendet (AdiCode legt nie einen neuen Chat an).".into());}
    type_and_send(port,prompt,false).await
}
const SELECT_BOX_JS:&str=r#"(()=>{const b=[...document.querySelectorAll('[role=textbox][contenteditable=true]')].find(e=>(e.innerText||'').trim().length>0);if(!b)return false;b.focus();const r=document.createRange();r.selectNodeContents(b);const s=getSelection();s.removeAllRanges();s.addRange(r);return true})()"#;
/// Text ins Notion-AI-Eingabefeld schreiben und abschicken (replace: vorhandenen Text im Feld ersetzen).
async fn type_and_send(port:u16,prompt:String,replace:bool)->Result<(),String>{
    // Harte Sperre: nur in einen bestehenden Chat (URL mit t=<id>) schreiben - AdiCode erstellt nie einen neuen Notion-Chat.
    let here=js_eval(port,"location.href").await?;if url_tid(here.as_str().unwrap_or("")).is_empty(){return Err("Kein bestehender Chat offen - nichts gesendet (AdiCode erstellt nie einen neuen Notion-Chat).".into());}
    let focus=r#"(()=>{const q=[...document.querySelectorAll('textarea,[contenteditable=\"true\"]')].filter(e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>180&&r.height>20&&r.left>70&&s.visibility!=='hidden'&&s.display!=='none'}).sort((a,b)=>{const score=e=>{const hint=((e.getAttribute('placeholder')||'')+' '+(e.getAttribute('aria-label')||'')).toLowerCase();return (/ask notion ai|notion ai fragen|frag notion ai|describe your own/.test(hint)?100000:0)+e.getBoundingClientRect().bottom};return score(b)-score(a)});if(!q[0])return false;q[0].focus();return true})()"#;
    let sel=replace&&js_eval(port,SELECT_BOX_JS).await.ok().and_then(|v|v.as_bool())==Some(true);
    let mut ready=sel;for _ in 0..(if sel{0}else{20}){ready=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":focus,"returnByValue":true}})]).await?.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_bool).unwrap_or(false);if ready{break;}tokio::time::sleep(Duration::from_millis(500)).await;}
    if !ready{let quota=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":QUOTA_JS,"returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_bool)).unwrap_or(false);if quota{return Err("KI-Kontingent dieses Notion-Kontos ist aufgebraucht".into());}return Err("Notion-AI-Eingabefeld nicht gefunden; Startprompt kopieren verwenden.".into());}
    cdp(port,vec![json!({"method":"Input.insertText","params":{"text":prompt}})]).await?;tokio::time::sleep(Duration::from_millis(300)).await;
    // Co-Work-Fix: Senden-Knopf per data-testid bevorzugen, warten bis er aktiv ist, und pruefen, ob der Text wirklich abgeschickt wurde.
    let submit=r#"(()=>{const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.display!=='none'};const ok=e=>vis(e)&&!e.disabled&&e.getAttribute('aria-disabled')!=='true';let e=[...document.querySelectorAll('[data-testid=agent-send-message-button],[data-testid=agent-chat-send-button]')].find(ok);if(!e)e=[...document.querySelectorAll('button,[role=button]')].find(x=>ok(x)&&/^(submit ai message|send( message)?|senden|nachricht senden)$/i.test((x.getAttribute('aria-label')||'').trim()));if(!e)return null;const r=e.getBoundingClientRect();return {x:r.x+r.width/2,y:r.y+r.height/2}})()"#;
    const LEFT_JS:&str=r#"(()=>[...document.querySelectorAll('[role=textbox][contenteditable]')].some(e=>(e.innerText||'').trim().length>0))()"#;
    for attempt in 0..3u8{
        let mut point=Value::Null;
        for _ in 0..10{point=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":submit,"returnByValue":true}})]).await?.last().and_then(|v|v.pointer("/result/result/value")).cloned().unwrap_or(Value::Null);if point.is_object(){break;}tokio::time::sleep(Duration::from_millis(300)).await;}
        let mods=if attempt==1{2}else{0};
        if point.is_object(){trusted_click(port,&point).await?;}else{cdp(port,vec![json!({"method":"Input.dispatchKeyEvent","params":{"type":"keyDown","key":"Enter","code":"Enter","windowsVirtualKeyCode":13,"modifiers":mods}}),json!({"method":"Input.dispatchKeyEvent","params":{"type":"keyUp","key":"Enter","code":"Enter","windowsVirtualKeyCode":13,"modifiers":mods}})]).await?;}
        tokio::time::sleep(Duration::from_millis(1200)).await;
        let left=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":LEFT_JS,"returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_bool)).unwrap_or(false);
        if !left{return Ok(());}
    }
    Err("Prompt eingefuegt, aber nicht abgeschickt (Senden-Knopf reagiert nicht).".into())
}
/// Chat-Liste lesen (K<0) bzw. Chat Nr. K (Willkommen/Tab-Chats, von oben) zum Umbenennen oeffnen. H=1: Menue-Knopf nach echtem Hover.
const CHAT_RENAME_JS:&str=r#"(async()=>{const K=__K__;const H=__H__;const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const tx=e=>(e.innerText||'').trim().split('\n')[0].trim();const RE=/^(welcome to notion|willkommen (bei|in|zu) notion|tab \d+( kontext \d+)?)$/i;const esc=()=>document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',code:'Escape',keyCode:27,bubbles:true}));try{if(!H){if(![...document.querySelectorAll('[role="menuitem"]')].some(e=>vis(e)&&e.getBoundingClientRect().left<420)){const sb=[...document.querySelectorAll('[role="button"],button')].find(b=>vis(b)&&/^(seitenleiste .ffnen|open sidebar)$/i.test(b.getAttribute('aria-label')||''));if(sb){sb.click();await sleep(1200)}}const tab=document.querySelector('#sidebar-tab-chats,[role="tab"][aria-label="Chat"],[role="tab"][aria-label="Chats"]');if(tab&&tab.getAttribute('aria-selected')!=='true'){tab.click();await sleep(1200)}}const items=[...document.querySelectorAll('[role="menuitem"]')].filter(e=>vis(e)&&!e.closest('[role="dialog"]')&&e.getBoundingClientRect().left<420&&RE.test(tx(e))).sort((a,b)=>a.getBoundingClientRect().top-b.getBoundingClientRect().top);if(K<0)return {ok:true,names:items.map(tx)};const it=items[K];if(!it)return {ok:false,error:'Chat '+(K+1)+' nicht in der Liste'};const ren=()=>[...document.querySelectorAll('[role="menuitem"],[role="option"],[role="button"],button')].filter(vis).find(e=>/^(rename|umbenennen)$/i.test(tx(e)));let r=null;if(!H){it.scrollIntoView({block:'center'});await sleep(300);const b=it.getBoundingClientRect();it.dispatchEvent(new MouseEvent('contextmenu',{bubbles:true,cancelable:true,view:window,button:2,clientX:b.left+20,clientY:b.top+b.height/2}));await sleep(900);r=ren();if(!r){esc();await sleep(300);const b2=it.getBoundingClientRect();return {ok:false,hover:{x:b2.left+Math.min(b2.width/2,120),y:b2.top+b2.height/2}}}}else{const bs=[...it.querySelectorAll('[role="button"],button')].filter(vis);const more=bs.find(e=>/more|mehr|option|aktion|\.\.\.|\u2026/i.test((e.getAttribute('aria-label')||'')+' '+(e.innerText||'')))||bs[bs.length-1];if(!more)return {ok:false,error:'Men\u00fc-Knopf am Chat nicht gefunden'};more.click();await sleep(900);r=ren()}if(!r){esc();return {ok:false,error:'Eintrag Umbenennen nicht gefunden'}}r.click();await sleep(800);let f=document.activeElement;if(!(f&&(f.tagName==='INPUT'||f.tagName==='TEXTAREA'||f.isContentEditable))){f=[...document.querySelectorAll('input,textarea,[contenteditable="true"]')].filter(vis).find(e=>e.closest('[role="dialog"]')||RE.test((e.value||e.innerText||'').trim()));if(f)f.focus()}if(!f)return {ok:false,error:'Namensfeld nicht gefunden'};if(f.select)f.select();return {ok:true}}catch(e){return {ok:false,error:String(e&&e.message||e)}}})()"#;
static CHAT_TAB_LOCK:Mutex<()>=Mutex::new(());
/// Chat-Tab-Nummer pro Konto: eigene behalten, wenn kein anderes eingetragenes Konto sie hat; sonst die kleinste freie (z. B. 2,3,4 belegt -> 1).
fn pick_chat_tab(t:&Tab)->u32{
    let _g=lock(&CHAT_TAB_LOCK);let me=t.email.to_lowercase();
    let used:HashSet<u32>=load().iter().filter(|x|!x.email.is_empty()&&x.email.to_lowercase()!=me).filter_map(|x|mem_get(&x.email,"chat_tab").as_u64().map(|n|n as u32)).collect();
    let cnt=(load().len() as u32).max(1);let n=mem_get(&t.email,"chat_tab").as_u64().map(|n|n as u32).filter(|n|*n>0&&*n<=cnt&&!used.contains(n)).unwrap_or_else(||(1u32..=cnt).find(|n|!used.contains(n)).unwrap_or((tab_index(t.id) as u32+1).min(cnt)));
    mem_set(&t.email,"chat_tab",json!(n));n
}
/// Benennt die (bis zu) 3 Willkommen-Chats um: "Tab N", "Tab N Kontext 2", "Tab N Kontext 3".
async fn name_chats(t:&Tab,i:usize,n:u32)->Result<String,String>{
    let port=cdp_port(i);close_settings(port).await;let _=t;
    let want=[format!("Tab {n} Kontext 1"),format!("Tab {n} Kontext 2"),format!("Tab {n} Kontext 3")];
    let js=|k:i64,h:bool|CHAT_RENAME_JS.replace("__K__",&k.to_string()).replace("__H__",if h{"1"}else{"0"});
    for _ in 0..8{
        let v=js_eval(port,&js(-1,false)).await?;
        let cur:Vec<String>=v["names"].as_array().map(|a|a.iter().filter_map(|x|x.as_str().map(String::from)).collect()).unwrap_or_default();
        if cur.is_empty(){return Err("keine Willkommen-Chats in der Liste".into());}


        let Some(k)=(0..cur.len().min(3)).find(|&k|!cur[k].eq_ignore_ascii_case(&want[k])) else {let ok=cur.len().min(3);return Ok(if ok>=3{format!("Chats hei\u{df}en Tab {n} Kontext 1, Tab {n} Kontext 2, Tab {n} Kontext 3")}else{format!("Nur {ok} Willkommen-Chat(s) vorhanden \u{2013} benannt als Tab {n} Kontext 1..{ok}")})};let next=want[k].clone();
        let mut r=js_eval(port,&js(k as i64,false)).await?;
        if r["hover"].is_object(){let x=r["hover"]["x"].as_f64().unwrap_or(0.0);let y=r["hover"]["y"].as_f64().unwrap_or(0.0);let _=cdp(port,vec![json!({"method":"Input.dispatchMouseEvent","params":{"type":"mouseMoved","x":x,"y":y}})]).await;tokio::time::sleep(Duration::from_millis(500)).await;r=js_eval(port,&js(k as i64,true)).await?;}
        if r["ok"].as_bool()!=Some(true){press_key(port,"Escape","Escape",27,0).await;return Err(r["error"].as_str().unwrap_or("Umbenennen fehlgeschlagen").to_string());}
        press_key(port,"a","KeyA",65,2).await;
        cdp(port,vec![json!({"method":"Input.insertText","params":{"text":next}})]).await?;
        tokio::time::sleep(Duration::from_millis(300)).await;
        press_key(port,"Enter","Enter",13,0).await;
        tokio::time::sleep(Duration::from_millis(1200)).await;
    }
    Err("Chats nicht vollst\u{e4}ndig umbenannt".into())
}
/// Nach dem MCP-Einrichten: AdiCode -> Notion Agent -> Read tools + Write tools auf "Run automatically", dann zurueck zu "Browse Connections".
const MCP_FINISH_JS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{if(!e)return false;const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden'};const tx=e=>(e.innerText||e.getAttribute('aria-label')||'').trim().replace(/\s+/g,' ');const press=e=>{for(const t of ['pointerdown','mousedown','pointerup','mouseup','click']){e.dispatchEvent(new (t[0]==='p'?PointerEvent:MouseEvent)(t,{bubbles:true,cancelable:true,view:window}))}};const esc=el=>(el||document.activeElement||document.body).dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',code:'Escape',keyCode:27,bubbles:true}));const dlgs=()=>[...document.querySelectorAll('[role=dialog]')].filter(vis);const setD=()=>{const i=[...document.querySelectorAll('input')].find(e=>/^(search settings|einstellungen durchsuchen|in einstellungen suchen)/i.test(e.getAttribute('aria-label')||e.placeholder||''));return i?i.closest('[role=dialog]'):null};const AUTO=/^(run automatically|automatisch ausf)/i;const ASK=/^(always ask|immer fragen)/i;const opts=()=>[...document.querySelectorAll('[role=menuitem],[role=menuitemradio],[role=option]')].filter(vis).filter(e=>AUTO.test(tx(e)));const agentTab=()=>{for(const d of dlgs().reverse()){const x=[...d.querySelectorAll('[role=tab]')].filter(vis).find(e=>/^notion[ -]agent$/i.test(tx(e)));if(x)return x}return null};const out={ok:false,perm:[],browse:false};try{let at=agentTab();if(!at){const sd=setD();if(sd){const ct=[...sd.querySelectorAll('[role=tab]')].filter(vis).find(e=>/^(manage|manage connections|verwalten|connected|verbunden|installed|installiert)\b/i.test(tx(e)));if(ct){ct.click();await sleep(1200)}for(let k=0;k<10&&!at;k++){const trs=[...sd.querySelectorAll('tr,[role=row]')].filter(e=>vis(e)&&/\bAdiCode\b/i.test(e.innerText||'')).sort((a,b)=>tx(a).length-tx(b).length);const mb=trs.length?[...trs[0].querySelectorAll('button,[role=button]')].filter(vis).find(e=>/^(manage|verwalten|configure|konfigurieren|details)$/i.test(tx(e))):null;if(mb){mb.click();await sleep(1500);at=agentTab();if(at)break}const row=[...sd.querySelectorAll('[role=button],button,[role=row],[role=menuitem],[role=link]')].filter(e=>vis(e)&&/^AdiCode\b/i.test(tx(e))&&tx(e).length<200).sort((a,b)=>tx(a).length-tx(b).length).pop();if(row){row.click();await sleep(1300)}at=agentTab();if(!at)await sleep(600)}}}if(!at){out.error='AdiCode-Details (Tab Notion Agent) nicht gefunden'}else{at.click();await sleep(1300);const dlg=at.closest('[role=dialog]')||document;const NOTAUTO=/^(always ask|ask|ask first|immer fragen|fragen|nachfragen|never|nie|niemals|disabled|deaktiviert|off|aus|blocked|blockiert)\b/i;const pbtns=()=>[...dlg.querySelectorAll('[role=button],button,[aria-haspopup],[role=combobox]')].filter(e=>vis(e)&&tx(e).length<40&&(AUTO.test(tx(e))||NOTAUTO.test(tx(e))));const lbl=b=>{let r=b;for(let j=0;j<6&&r;j++){r=r.parentElement;if(!r)break;const t=tx(r).replace(tx(b),'').trim();if(t)return t.slice(0,40)}return '?'};const isW=b=>/\b(write|schreib)/i.test(lbl(b));const fix=async()=>{for(let pass=0;pass<4;pass++){const todo=pbtns().filter(b=>isW(b)&&!AUTO.test(tx(b)));if(!todo.length)break;for(const b of todo){b.scrollIntoView({block:'center'});await sleep(250);b.click();await sleep(800);let o=opts()[0];if(!o){press(b);await sleep(800);o=opts()[0]}if(o){o.click();await sleep(1100)}else{esc();await sleep(500)}}}};let total=0,left=[];await fix();for(const b of pbtns().filter(isW)){total++;if(AUTO.test(tx(b)))out.perm.push('ok:'+lbl(b));else{out.perm.push('fehlt:'+lbl(b));left.push(lbl(b))}}out.ok=total>0&&left.length===0;if(!out.ok)out.error=total?('Run automatically fehlt bei: '+left.join(', ')):'Keine Berechtigungs-Auswahl gefunden';if(dlg!==document&&dlg!==setD()){const cb=[...dlg.querySelectorAll('[aria-label=Close],[aria-label=Schlie\u00dfen],[aria-label=Schliessen]')].filter(vis)[0];if(cb)cb.click();else esc(dlg);await sleep(900)}}const sd=setD();if(sd){for(let k=0;k<8&&!out.browse;k++){const bt=[...sd.querySelectorAll('[role=tab]')].filter(vis).find(e=>/^(browse connections|browse|discover|entdecken|verbindungen durchsuchen)$/i.test(tx(e)));if(bt){bt.click();await sleep(900);out.browse=bt.getAttribute('aria-selected')!=='false'}else await sleep(600)}}}catch(e){out.error=String(e&&e.message||e)}return out})()"#;
/// Wechselt in den Einstellungen auf Connections -> Browse Connections.
const BROWSE_JS:&str=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const tx=e=>(e.innerText||e.getAttribute('aria-label')||'').trim();for(let k=0;k<12;k++){const c=[...document.querySelectorAll('[role=tab]')].filter(vis);const b=c.find(e=>/^(browse connections|browse|discover|entdecken|verbindungen durchsuchen)$/i.test(tx(e)));if(b){b.click();await sleep(800);return true}const cn=c.find(e=>/^(connections|verbindungen)$/i.test(tx(e)));if(cn&&k%3===0)cn.click();await sleep(600)}return false})()"#;
const CONN_JS:&str=r#"(async()=>{const vis=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0};const tx=e=>(e.innerText||e.getAttribute('aria-label')||'').trim();const tabs=[...document.querySelectorAll('[role=tab]')].filter(vis);if(tabs.some(e=>/^notion[ -]agent$/i.test(tx(e))))return 'details';const c=tabs.find(e=>/^(connections|verbindungen)$/i.test(tx(e)));if(c){c.click();await new Promise(r=>setTimeout(r,1200));return 'conn'}return 'none'})()"#;
async fn mcp_cleanup(port:u16){for _ in 0..3{let _=press_key(port,"Escape","Escape",27,0).await;tokio::time::sleep(Duration::from_millis(400)).await;}}
/// setup_mcp mit Zeitlimit (150 s) und einem zweiten Versuch; schliesst haengende Dialoge, damit der Check weiterlaeuft.
pub(crate) async fn setup_mcp_safe(t:&Tab,i:usize)->Result<String,String>{
    let port=cdp_port(i);let mut last=String::new();
    for k in 0..2{
        if k>0{mark_account(t.id,"check",json!("AdiCode-MCP: zweiter Versuch \u{2026}"));}
        match tokio::time::timeout(Duration::from_secs(150),setup_mcp(t,i)).await{Ok(Ok(m))=>return Ok(m),Ok(Err(e))=>last=e,Err(_)=>last="Zeitlimit MCP-Einrichtung (150 s)".into()}
        tl(&format!("tab{} setup_mcp versuch {} fehlgeschlagen: {last}",t.id,k+1));
        mcp_cleanup(port).await;tokio::time::sleep(Duration::from_secs(2)).await;
    }
    Err(last)
}
async fn mcp_finish(t:&Tab,port:u16){
    if js_eval(port,CONN_JS).await.ok().and_then(|v|v.as_str().map(|s|s.to_string())).as_deref()==Some("none"){if poll_js(port,SETTINGS_OPEN_JS,0).await.as_bool()!=Some(true){let _=open_settings(port).await;tokio::time::sleep(Duration::from_millis(900)).await;}let _=js_eval(port,CONN_JS).await;}
    let mut r=Value::Null;
    for _ in 0..3{r=js_eval(port,MCP_FINISH_JS).await.unwrap_or(Value::Null);if r["ok"].as_bool()==Some(true){break;}tokio::time::sleep(Duration::from_millis(1500)).await;}
    if r["browse"].as_bool()!=Some(true)&&js_eval(port,BROWSE_JS).await.ok().and_then(|v|v.as_bool())!=Some(true){
        press_key(port,"Escape","Escape",27,0).await;tokio::time::sleep(Duration::from_millis(700)).await;
        if poll_js(port,SETTINGS_OPEN_JS,0).await.as_bool()!=Some(true){let _=open_settings(port).await;}
        let _=js_eval(port,BROWSE_JS).await;
    }
    tl(&format!("tab{} mcp_finish={r}",t.id));
    if r["ok"].as_bool()==Some(true){mem_set(&t.email,"mcp_perm3",json!(true));}
    mark_account(t.id,"mcp_perm",json!(if r["ok"].as_bool()==Some(true){format!("Run automatically: {}",r["perm"].as_array().map(|a|a.iter().filter_map(|v|v.as_str()).map(|s|s.trim_start_matches("ok:")).collect::<Vec<_>>().join(", ")).unwrap_or_default())}else{format!("Run automatically offen: {}",r["error"].as_str().unwrap_or("?"))}));
}
pub(crate) async fn setup_mcp(t:&Tab,i:usize)->Result<String,String>{
    let(url,token)=crate::notion_mcp::cowork_connection();if url.is_empty()||token.is_empty(){return Err("MCP-URL oder Token fehlt in AdiCode.".into());}let port=cdp_port(i);
    let _=english_once(t,port).await;
    if !open_settings(port).await{return Err("Einstellungen lie\u{df}en sich nicht \u{f6}ffnen (Workspace-Men\u{fc} oben/unten nicht gefunden).".into());}
    let open=r#"(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const vis=e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>0&&r.height>0&&s.display!=='none'&&s.visibility!=='hidden'};const exact=(sel,text)=>[...document.querySelectorAll(sel)].find(e=>vis(e)&&(e.innerText||e.getAttribute('aria-label')||'').trim().toLowerCase()===text);let sidebar=document.querySelector('[aria-label=\"Lock sidebar open\"]');if(sidebar)sidebar.click();await sleep(500);if(![...document.querySelectorAll('input')].find(e=>/^(search settings|einstellungen durchsuchen|in einstellungen suchen)/i.test(e.getAttribute('aria-label')||e.placeholder||''))){const ws=[...document.querySelectorAll('[role=\"button\"]')].find(e=>vis(e)&&e.getBoundingClientRect().x<30&&e.getBoundingClientRect().y<45&&(e.innerText||'').trim());if(ws)ws.click();await sleep(500);const dlgEl=document.querySelector('[role=dialog]');const inDlg=t=>dlgEl&&[...dlgEl.querySelectorAll('button,[role=button],[role=menuitem]')].find(e=>vis(e)&&(e.innerText||'').trim().toLowerCase()===t);const settings=inDlg('settings')||inDlg('einstellungen')||exact('button,[role=\"button\"]','settings')||exact('button,[role=\"button\"]','einstellungen');if(settings)settings.click();await sleep(1200);}const connections=exact('[role=\"tab\"]','connections')||exact('[role=\"tab\"]','verbindungen');if(connections)connections.click();await sleep(1200);const hasA=()=>/\b(AdiCode|PlazCode)\b/i.test([...document.querySelectorAll('[role=dialog]')].map(d=>d.innerText||'').join(' '));const tabs=[...document.querySelectorAll('[role=tab]')].filter(vis);const conn=tabs.find(e=>/^(connected|verbunden|installed|installiert)\b/i.test((e.innerText||'').trim()));const mng=tabs.find(e=>/^(manage|verwalten)$/i.test((e.innerText||'').trim()));if(conn){conn.click();await sleep(1100);if(hasA())return {existing:true};}if(mng){mng.click();await sleep(1100);if(hasA())return {existing:true};const all=[...document.querySelectorAll('button,[role=button]')].find(e=>vis(e)&&/^(all connections|alle verbindungen)/i.test((e.innerText||'').trim()));if(all){all.click();await sleep(1300);if(hasA())return {existing:true};}}const discover=exact('[role=\"tab\"]','discover')||exact('[role=\"tab\"]','verbindungen durchsuchen')||exact('[role=\"tab\"]','entdecken');const disc2=discover||[...document.querySelectorAll('[role=tab]')].find(e=>vis(e)&&/^(browse connections|browse|discover|entdecken|verbindungen durchsuchen)$/i.test((e.innerText||e.getAttribute('aria-label')||'').trim()));if(disc2){disc2.click();await sleep(1200);}else{await sleep(700);}let custom=null,addClicked=false,att=0;const press=e=>{for(const t of ['pointerdown','mousedown','pointerup','mouseup','click']){e.dispatchEvent(new (t[0]==='p'?PointerEvent:MouseEvent)(t,{bubbles:true,cancelable:true,view:window}))}};for(let k=0;k<14&&!custom;k++){const lb=e=>(e.innerText||e.getAttribute('aria-label')||'').trim();const pr=t=>/^(\+\s*)?(add connection|verbindung hinzuf|neue verbindung)/i.test(t)?0:/^(\+\s*)?(configure|konfigurieren)\b/i.test(t)?1:/^(\+\s*)?(add|hinzuf\u00fcgen)$/i.test(t)?2:9;const abs=[...document.querySelectorAll('button,[role=button]')].filter(e=>vis(e)&&pr(lb(e))<9).sort((x,y)=>pr(lb(x))-pr(lb(y)));const ab=abs.length?abs[Math.floor(att/2)%abs.length]:null;if(ab&&k%2===0){if(att%2===0)ab.click();else press(ab);att++;addClicked=true;await sleep(1100);}const cs=[...document.querySelectorAll('[role=\"menuitem\"],button,[role=\"button\"]')].filter(e=>vis(e)&&/custom mcp|custom connection|benutzerdefinierte?r? (mcp|verbindung)|individuelle?r? (mcp|verbindung)|eigene[nr]? (mcp|server)|new mcp connection|neue mcp|\bcustom\b[^\n]{0,20}\b(mcp|server|connector)\b|add mcp server|mcp-server hinzuf/i.test((e.innerText||''));custom=cs.find(e=>e.getAttribute('role')==='menuitem')||cs[0]||null;if(!custom)await sleep(700);}if(!custom)return {error:'Custom MCP fehlt'};custom.click();await sleep(700);const input=[...document.querySelectorAll('input')].find(e=>vis(e)&&/example\.com\/mcp/i.test(e.placeholder||''));if(!input)return {error:'URL-Feld fehlt'};const d=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value');d.set.call(input,__URL__);input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));await sleep(300);const dl=input.closest('[role=dialog]')||[...document.querySelectorAll('[role=dialog]')].filter(vis).pop()||document;const btn=[...dl.querySelectorAll('button,[role=\"button\"]')].find(e=>vis(e)&&/^(connect|verbinden)$/.test((e.innerText||'').trim().toLowerCase()));if(!btn)return {error:'Connect 1 fehlt'};const r=btn.getBoundingClientRect();return {x:r.x+r.width/2,y:r.y+r.height/2}})()"#.replace("__URL__",&json!(url).to_string());
    let first=cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":open,"awaitPromise":true,"returnByValue":true}})]).await?.last().and_then(|v|v.pointer("/result/result/value")).cloned().unwrap_or(Value::Null);
    if first["existing"].as_bool().unwrap_or(false){mcp_finish(t,port).await;let mut a=lock(&ACCOUNT);a.entry(t.id).or_insert_with(||json!({}))["mcp"]=json!("Bereits verbunden");return Ok("MCP bereits verbunden.".into());}if !first.is_object()||first.get("error").is_some(){return Err(first["error"].as_str().unwrap_or("MCP-Dialog nicht gefunden").into());}trusted_click(port,&first).await?;tokio::time::sleep(Duration::from_millis(800)).await;wait_ready(port,10).await;
    let fill=FILL_JS.replace("__TOKEN__",&json!(token).to_string());
    let mut second=Value::Null;for _ in 0..15{if mcp_already(t,port).await{mcp_finish(t,port).await;return Ok("MCP bereits verbunden.".into());}second=js_eval(port,&fill).await.unwrap_or(Value::Null);if second.is_object(){break;}tokio::time::sleep(Duration::from_millis(700)).await;}if !second.is_object(){if mcp_already(t,port).await{mcp_finish(t,port).await;return Ok("MCP bereits verbunden.".into());}return Err("Finaler MCP-Connect-Knopf fehlt.".into());}trusted_click(port,&second).await?;tokio::time::sleep(Duration::from_secs(2)).await;if mcp_already(t,port).await{mcp_finish(t,port).await;return Ok("MCP bereits verbunden.".into());}
    let verify=r#"(()=>{const body=(document.body&&document.body.innerText)||'';const dt=[...document.querySelectorAll('[role=dialog]')].map(d=>d.innerText||'').join(' ');return /\bAdiCode\b/i.test(dt)||(/Installed connections|Installierte Verbindungen/i.test(body)&&/\bAdiCode\b/i.test(body))})()"#;let ok=poll_js(port,verify,20).await.as_bool().unwrap_or(false);if ok{mcp_finish(t,port).await;}let mut a=lock(&ACCOUNT);a.entry(t.id).or_insert_with(||json!({}))["mcp"]=json!(if ok{"Verbunden"}else{"Manueller Fallback nötig"});if ok{Ok("MCP verbunden.".into())}else{Err("MCP-Verbindung konnte nicht bestätigt werden.".into())}
}
/// Usage-Check: fragt die interne Notion-API des eingeloggten Kontos (getSpaces + getAIUsageEligibility[V2]) ab, Fallback Seitentext. Erkennt aufgebrauchte Kontingente.
const USAGE_JS:&str=r#"(async()=>{const body=(document.body&&document.body.innerText)||'';const exText=/used your (trial )?AI allowance|add a payment method to unlock more AI|KI-Kontingent (ist )?aufgebraucht|AI-Guthaben aufgebraucht|out of AI responses/i.test(body);const post=(p,b)=>fetch('/api/v3/'+p,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(b||{})}).then(r=>r.ok?r.json():null).catch(()=>null);const out={usage:null,used:null,limit:null,basic_used:null,basic_limit:null,premium_used:null,premium_limit:null,plan_type:null,exhausted:exText,usage_source:'nicht gefunden',usage_error:null,models:[],checked:new Date().toLocaleTimeString(),url:location.href};try{const sp=await post('getSpaces',{});let spaceId=null;if(sp){for(const u of Object.values(sp)){const ids=Object.keys((u&&u.space)||{});if(ids.length){spaceId=ids[0];break;}}}if(!spaceId){out.usage_error='Nicht eingeloggt oder kein Workspace';return out;}const v1=await post('getAIUsageEligibility',{spaceId,surface:'ai_module'});const v2=await post('getAIUsageEligibilityV2',{spaceId,surface:'ai_module'});if(v1){out.plan_type=v1.type||null;out.basic_used=v1.userUsage??v1.spaceUsage??null;out.basic_limit=v1.userLimit??v1.spaceLimit??null;if(v1.isEligible===false)out.exhausted=true;out.usage_source='getAIUsageEligibility';}if(v2){const b=v2.basicCredits||{};if(out.basic_used==null)out.basic_used=b.userUsage??null;if(out.basic_limit==null)out.basic_limit=b.userLimit??null;const ps=(v2.premiumCredits&&v2.premiumCredits.perSource)||{};let pu=0,pl=0;for(const s of Object.values(ps)){if(s&&typeof s.limit==='number'){pu+=s.usageTotal||0;pl+=s.limit;}}if(pl>0){out.premium_used=pu;out.premium_limit=pl;}out.usage_source=v1?'getAIUsageEligibility + V2':'getAIUsageEligibilityV2';}const unlimited=out.plan_type==='unlimited';if(out.premium_limit){out.used=out.premium_used;out.limit=out.premium_limit;out.usage=Math.min(100,Math.round(out.premium_used/out.premium_limit*100));}else if(!unlimited&&out.basic_limit){out.used=out.basic_used;out.limit=out.basic_limit;out.usage=Math.min(100,Math.round(out.basic_used/out.basic_limit*100));}else if(unlimited){out.usage=0;}if(!unlimited&&!out.premium_limit&&out.basic_limit&&out.basic_used>=out.basic_limit)out.exhausted=true;}catch(e){out.usage_error='Usage-Abfrage fehlgeschlagen: '+e;}if(out.exhausted)out.usage=100;return out})()"#;
async fn inspect_account(t:&Tab,i:usize){
    let value=cdp(cdp_port(i),vec![json!({"method":"Runtime.evaluate","params":{"expression":USAGE_JS,"awaitPromise":true,"returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).cloned()).filter(Value::is_object).unwrap_or_else(||json!({"usage_error":"Tab nicht erreichbar"}));
    let mut a=lock(&ACCOUNT);let entry=a.entry(t.id).or_insert_with(||json!({"usage":null,"models":[]}));if let Some(obj)=value.as_object(){for(k,v)in obj{entry[k]=v.clone();}}if entry["usage"].is_null(){if let Some(p)=entry.get("ui_pct").cloned().filter(|v|!v.is_null()){entry["usage"]=p;}}apply_rate(entry);
}
/// Live-Dashboard: Usage fuer jeden laufenden Tab (mit menschlicher Streuung), unabhaengig davon, ob Co-Work gestartet wurde.
async fn usage_monitor(){loop{let tabs=load();let running=tokio::task::spawn_blocking({let t=tabs.clone();move||running_ids(&t)}).await.unwrap_or_default();for(i,t)in tabs.iter().enumerate(){if running.contains(&t.id){if !is_paused(t.id){inspect_account(t,i).await;mark_account(t.id,"usage_live",json!(chrono::Local::now().format("%H:%M:%S").to_string()));}}else{mark_account(t.id,"usage_error",json!("Tab l\u{e4}uft nicht"));}}tokio::time::sleep(human_sleep(Duration::from_secs(30),45)).await;}}
async fn logged_in(port:u16)->bool{
    let expr=r#"(()=>/(^|\.)notion\.(so|com)$/.test(location.hostname)&&!/\/login|\/signup|onboarding/.test(location.pathname)&&!!document.querySelector('.notion-sidebar,nav,[role="tab"]'))()"#;
    cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":expr,"returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_bool)).unwrap_or(false)
}
/// Auto-MCP: traegt AdiCode in jedem laufenden, eingeloggten Tab ohne Verbindung automatisch ein (max. alle 5 min pro Tab).
async fn auto_mcp_watcher(){
    let mut tried:BTreeMap<u32,std::time::Instant>=BTreeMap::new();
    loop{
        tokio::time::sleep(human_sleep(Duration::from_secs(20),40)).await;
        if !auto_mcp_on(){continue;}
        let tabs=load();let running=tokio::task::spawn_blocking({let t=tabs.clone();move||running_ids(&t)}).await.unwrap_or_default();
        for(i,t)in tabs.iter().enumerate(){
            if !running.contains(&t.id)||mcp_ok(t.id)||is_paused(t.id){continue;}
            if tried.get(&t.id).map(|x|x.elapsed()<Duration::from_secs(300)).unwrap_or(false){continue;}
            if !logged_in(cdp_port(i)).await{continue;}
            tried.insert(t.id,std::time::Instant::now());
            mark_account(t.id,"mcp",json!("Wird automatisch eingetragen ..."));
            match setup_mcp_safe(t,i).await{Ok(m)=>tracing::info!("Auto-MCP Tab {}: {m}",t.id),Err(e)=>mark_account(t.id,"mcp",json!(format!("Auto-Einrichtung fehlgeschlagen: {e}")))}
        }
    }
}
pub(crate) fn ensure_monitors(){ensure_gen_monitor();ensure_multichat();if !USAGE_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(usage_monitor());}if !AUTO_MCP_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(auto_mcp_watcher());}}
/// Hat der Nutzer das Worker-Fenster gerade selbst im Fokus, schickt AdiCode keine Erinnerung hinein.
async fn user_present(port:u16)->bool{cdp(port,vec![json!({"method":"Runtime.evaluate","params":{"expression":"document.hasFocus()","returnByValue":true}})]).await.ok().and_then(|r|r.last().and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_bool)).unwrap_or(false)}async fn keep_alive(tabs:Vec<Tab>){loop{for(i,t)in tabs.iter().enumerate(){let _=cdp(cdp_port(i),vec![json!({"method":"Runtime.evaluate","params":{"expression":"(()=>{window.dispatchEvent(new Event('focus'));document.dispatchEvent(new Event('visibilitychange'));return document.visibilityState})()"}})]).await;let _=t;}tokio::time::sleep(human_sleep(Duration::from_secs(20),40)).await;}}
/// Worker, die sich nach dem Kickoff nicht gemeldet haben: Fenster nach vorn, Startnachricht EINMAL erneut schicken.
async fn rejoin(tabs:&[Tab],wanted:&[String]){
    let joined=crate::notion_cowork::joined_agents();
    for(i,t)in tabs.iter().enumerate(){
        let a=agent_of(t);
        if is_main(t)||skipped(t.id)||!wanted.contains(&a)||joined.iter().any(|x|x.eq_ignore_ascii_case(&a)){continue;}
        if gen_snapshot(cdp_port(i)).await.is_some(){continue;}
        let _=open_main(cdp_port(i)).await;tokio::time::sleep(Duration::from_secs(2)).await;
        let ok=insert_prompt(cdp_port(i),prompt_for(t)).await.is_ok();
        set_status(format!("{} hat sich nicht gemeldet \u{2013} Startnachricht erneut geschickt{}.",t.role,if ok{""}else{" (fehlgeschlagen)"}));
    }
}
/// Haken im Notion-Eingabefeld/Senden-Knopf: solange AdiCode ihn alle < 3 s neu scharf schaltet, wird die erste Nachricht
/// des Nutzers abgefangen und von AdiCode mit dem Co-Work-Kontext abgeschickt - dieser Chat leitet dann das Co-Work.
const LEAD_ARM_JS:&str=r#"(()=>{const D=__DISARM__;if(!window.__acHook){window.__acHook=1;const box=()=>[...document.querySelectorAll('[role=textbox][contenteditable=true]')].find(e=>(e.innerText||'').trim().length>0);const grab=e=>{const now=Date.now();if(window.__acBlk&&now-window.__acBlk<700){e.preventDefault();e.stopImmediatePropagation();return}if(!window.__acArmTs||now-window.__acArmTs>3000)return;const b=box();if(!b)return;e.preventDefault();e.stopImmediatePropagation();window.__acArmTs=0;window.__acBlk=now;window.__acSent={text:(b.innerText||'').trim()}};document.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.isComposing&&e.target&&e.target.closest&&e.target.closest('[role=textbox][contenteditable=true]'))grab(e)},true);for(const ev of ['pointerdown','mousedown','pointerup','mouseup','click'])document.addEventListener(ev,e=>{if(e.target&&e.target.closest&&e.target.closest('[data-testid=agent-send-message-button],[data-testid=agent-chat-send-button]'))grab(e)},true);}const s=window.__acSent||null;window.__acSent=null;window.__acArmTs=(D||s)?0:Date.now();return s})()"#;
/// Alle Tabs abfragen (und scharf schalten bzw. mit disarm entschaerfen); liefert den ersten Tab, in dem der Nutzer gesendet hat.
async fn lead_poll(tabs:&[Tab],disarm:bool)->Option<(usize,Tab,String)>{
    let js=LEAD_ARM_JS.replace("__DISARM__",if disarm{"true"}else{"false"});
    let all=load();
    let rs=futures::future::join_all(tabs.iter().filter(|t|!skipped(t.id)).map(|t|{let js=js.clone();let t=t.clone();let i=all.iter().position(|x|x.id==t.id).unwrap_or(0);async move{let v=tokio::time::timeout(Duration::from_secs(3),js_eval(cdp_port(i),&js)).await.ok().and_then(|r|r.ok()).unwrap_or(Value::Null);(i,t,v)}})).await;
    rs.into_iter().find_map(|(i,t,v)|{let s=v["text"].as_str().unwrap_or("").trim().to_string();if s.is_empty(){None}else{Some((i,t,s))}})
}
/// Die abgefangene Nachricht des Nutzers mit dem Leiter-Kontext im selben Chat abschicken.
async fn start_as_lead(i:usize,t:&Tab,text:&str)->Result<(),String>{
    let ctx=prompt_for(t).replace(" Antworte jetzt nur: Co-Work bereit.","");
    tokio::time::sleep(Duration::from_millis(900)).await;
    type_and_send(cdp_port(i),format!("{ctx}\n\nMeine Aufgabe: {text}"),true).await
}
async fn kickoff(tabs:Vec<Tab>, baseline:usize){
    stage(1);for t in &tabs{step(t.id,0);}
    // Tabs starten nicht alle auf die Sekunde gleichzeitig (API-Spitzenlast vermeiden, natuerlicher wirken).
    for _ in 1..tabs.iter().filter(|t|!skipped(t.id)).count().max(1){tokio::time::sleep(human_sleep(Duration::from_secs(20),30)).await;}
    let errors=full_check(&tabs).await;
    if !errors.is_empty(){windows::set_hidden(&tabs,false);stage(6);/* Co-Work-Fix: gesunde Tabs trotzdem wecken */if !KEEPER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(keep_alive(tabs.clone()));}if !NUDGER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(nudger(tabs.clone()));}set_status(format!("Start angehalten \u{2013} Account-Check: {}",errors.join("; ")));return;}
    stage(2);set_status("Account-Check ok: alle Konten im Chat \u{201a}Willkommen bei Notion\u{2018}.");
    if !KEEPER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(keep_alive(tabs.clone()));}
    /* Nudger nie fuer den Leiter-Chat (dort schreibt der Nutzer) */if !NUDGER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(nudger(tabs.clone()));}
    // Kein fester Main mehr: der Chat, in dem der Nutzer zuerst schreibt (Notion-Tab oder AdiCode-Chat), leitet.
    stage(3);set_status("Co-Work bereit \u{2013} schreibe deine Aufgabe in einen beliebigen Notion-Tab (oder in den AdiCode-Chat). Dieser Chat leitet, die anderen treten automatisch bei.");
    let mut disarmed=false;let mut k=0u32;
    loop{
        if crate::notion_cowork::project_count()>baseline{break;}
        k+=1;
        if k%8==0{let running=tokio::task::spawn_blocking({let t=tabs.clone();move||running_ids(&t)}).await.unwrap_or_default();if running.is_empty(){set_lead(0);stage(0);set_status("Co-Work beendet (keine Notion-Fenster offen).");return;}}
        if lead_id()==0{
            if let Some((i,t,text))=lead_poll(&tabs,false).await{
                if claim_lead(t.id){
                    disarmed=true;let others:Vec<Tab>=tabs.iter().filter(|x|x.id!=t.id).cloned().collect();let _=lead_poll(&others,true).await;
                    set_status(format!("{} leitet das Co-Work (dort hast du geschrieben) \u{2013} die anderen Tabs treten gleich bei \u{2026}",t.role));
                    if let Err(e)=start_as_lead(i,&t,&text).await{set_status(format!("Nachricht in {} nicht abgeschickt ({e}) \u{2013} bitte dort nochmal senden.",t.role));}
                }
            }
            tokio::time::sleep(Duration::from_millis(700)).await;
        }else{
            if !disarmed{disarmed=true;let _=lead_poll(&tabs,true).await;}
            tokio::time::sleep(Duration::from_secs(1)).await;
        }
    }
    if !disarmed{let _=lead_poll(&tabs,true).await;}
    if lead_id()==0{if let Some(l)=crate::notion_cowork::latest_lead_opt(){if let Some(t)=tabs.iter().find(|t|agent_of(t)==l){set_lead(t.id);}}}
    // Leiter unbekannt (z. B. ohne Haken gesendet): der Tab, der gerade antwortet, ist der Chat des Nutzers - nie hineinschreiben.
    let mut busy:Vec<u32>=Vec::new();
    if lead_id()==0{for(i,t)in tabs.iter().enumerate(){if gen_snapshot(cdp_port(i)).await.is_some(){busy.push(t.id);}}if busy.len()==1{set_lead(busy[0]);}}
    let lead=lead_id();let lead_name=tabs.iter().find(|t|t.id==lead).map(|t|t.role.clone()).unwrap_or_else(||"Der Start-Chat".into());
    stage(4);set_status(format!("Projekt erkannt ({lead_name} leitet). Die anderen Tabs treten bei \u{2026}"));
    let mut prompt_errors=Vec::new();
    let rs=futures::future::join_all(tabs.iter().enumerate().filter(|(_,t)|!is_main(t)&&!skipped(t.id)&&!busy.contains(&t.id)).map(|(i,t)|{let p=prompt_for(t);let port=cdp_port(i);let role=t.role.clone();async move{(role,insert_prompt(port,p).await)}})).await;for(role,r)in rs{if let Err(e)=r{prompt_errors.push(format!("{}: {e}",role));}}
    let failed:Vec<String>=prompt_errors.iter().map(|e|e.split(':').next().unwrap_or("").to_string()).collect();
    let note=if prompt_errors.is_empty(){String::new()}else{format!(" Nicht gestartet: {} - die anderen \u{fc}bernehmen diese Aufgaben mit.",prompt_errors.join("; "))};
    let wanted:Vec<String>=tabs.iter().filter(|t|!is_main(t)&&!skipped(t.id)&&!busy.contains(&t.id)&&!failed.contains(&t.role)).map(agent_of).collect();
    if wanted.is_empty(){windows::set_hidden(&tabs,false);stage(6);set_status(format!("Beitritt der anderen Tabs fehlgeschlagen:{note}"));return;}
    let grp=groups_of(&tabs);
    let lead_of=|a:&String|->String{tabs.iter().find(|t|agent_of(t)==*a).and_then(|t|{let m=grp.get(&t.id).copied().unwrap_or(t.id);tabs.iter().find(|x|x.id==m)}).map(agent_of).unwrap_or_default()};
    let ready=|j:&[String],a:&String|->bool{j.iter().any(|x|x.eq_ignore_ascii_case(a))||!j.iter().any(|x|x.eq_ignore_ascii_case(&lead_of(a)))};
    for k in 0..150 {if k==40{rejoin(&tabs,&wanted).await;}let j=crate::notion_cowork::joined_agents();if wanted.iter().all(|a|ready(&j,a)){stage(5);set_status(format!("Co-Work aktiv: {lead_name} leitet, {} helfen mit und melden Ergebnisse und Kritik zur\u{fc}ck.{note}",wanted.join(", ")));let li=tabs.iter().position(|t|t.id==lead_id()).unwrap_or(main_index());let _=open_main(cdp_port(li)).await;return;}tokio::time::sleep(Duration::from_secs(1)).await;}
    let j=crate::notion_cowork::joined_agents();let missing:Vec<String>=wanted.iter().filter(|a|!ready(&j,a)).cloned().collect();windows::set_hidden(&tabs,false);stage(6);set_status(format!("Verbindungstest fehlgeschlagen. Nicht beigetreten: {}. Fenster wurden zur Kontrolle gezeigt.{note}",missing.join(", ")));
}
fn add_tab()->Result<String,String>{let mut tabs=load();if tabs.len()>=MAX_TABS as usize{return Err("Maximal 8 Tabs.".into());}let id=(1..=MAX_TABS).find(|id|!tabs.iter().any(|t|t.id==*id)).ok_or("Maximal 8 Tabs.")?;std::fs::create_dir_all(dir(id)).map_err(|e|e.to_string())?;tabs.push(Tab{id,label:format!("Tab {}",tabs.len()+1),autostart:true,..Default::default()});save(&tabs)?;Ok(format!("Tab {} angelegt.",tabs.len()))}
fn save_tabs(v:&Value)->Result<String,String>{let incoming:Vec<Tab>=serde_json::from_value(v.clone()).map_err(|e|format!("Ungültige Daten: {e}"))?;if incoming.len()>MAX_TABS as usize{return Err("Maximal 8 Tabs.".into());}let known=load();let mut out=Vec::new();for t in &incoming{if !known.iter().any(|k|k.id==t.id){return Err(format!("Tab {} gibt es nicht mehr.",t.id));}if !out.iter().any(|o:&Tab|o.id==t.id){out.push(sanitize(t)?);}}for k in known{if !out.iter().any(|o|o.id==k.id){out.push(k);}}{let mut seen:Vec<String>=Vec::new();for o in &out{let e=o.email.trim().to_ascii_lowercase();if e.is_empty(){continue;}if seen.contains(&e){return Err(format!("Das Konto {} ist in mehreren Tabs eingetragen. Pro Konto nur ein Tab, sonst wird Notion fehlerhaft.",o.email));}seen.push(e);}}normalize(&mut out);save(&out)?;Ok(format!("{} Tabs gespeichert.",out.len()))}
fn start_all(_: &Value)->Result<String,String>{let tabs=load();if tabs.len()<2||tabs.iter().any(|t|t.email.is_empty()){return Err("Start erst m\u{f6}glich, wenn mindestens 2 Tabs mit E-Mail eingetragen sind.".into());}let running=running_ids(&tabs);{let s=STAGE.load(Ordering::SeqCst);if (1..=2).contains(&s){return Err("Co-Work startet bereits \u{2013} bitte kurz warten.".into());}if (3..=5).contains(&s)&&!running.is_empty(){return Ok("Co-Work l\u{e4}uft bereits. Schreibe einfach deine Aufgabe in einen Notion-Tab oder den AdiCode-Chat.".into());}}for t in tabs.iter().filter(|t|!running.contains(&t.id)&&!skipped(t.id)){launch(t,&start_url(t))?;}tl("START_ALL");set_lead(0);STAGE.store(1,Ordering::SeqCst);let baseline=crate::notion_cowork::project_count();tokio::spawn(kickoff(tabs,baseline));Ok("Co-Work startet. Danach schreibst du deine Aufgabe in einen beliebigen Notion-Tab (oder den AdiCode-Chat): dieser Chat leitet, die anderen treten automatisch bei.".into())}
fn delete(id:Option<u32>)->Result<String,String>{let t=find(id)?;if running_ids(std::slice::from_ref(&t)).contains(&t.id){return Err("Tab läuft noch. Erst stoppen.".into());}if dir(t.id).is_dir(){std::fs::remove_dir_all(dir(t.id)).map_err(|e|e.to_string())?;}let tabs:Vec<Tab>=load().into_iter().filter(|x|x.id!=t.id).collect();save(&tabs)?;lock(&ACCOUNT).remove(&t.id);Ok(format!("Tab {} entfernt; die Tabs wurden neu nummeriert.",t.id))}
fn open_tab(t:&Tab)->Result<String,String>{launch(t,&start_url(t)).map(|b|format!("Tab {} geöffnet ({b}).",t.id))}

/// Nach einem AdiCode-Neustart (z. B. Update) laufen die Co-Work-Browser weiter, Keeper und Nudger aber nicht. Wieder anwerfen, wenn Co-Work-Fenster offen sind.
pub(crate) fn resume_background(){
    tokio::spawn(async{
        ensure_monitors();
        tokio::time::sleep(Duration::from_secs(20)).await;
        let tabs=load();
        let running=tokio::task::spawn_blocking({let t=tabs.clone();move||running_ids(&t)}).await.unwrap_or_default();
        if tabs.is_empty()||running.is_empty(){return;}
        if lead_id()==0{if let Some(l)=crate::notion_cowork::latest_lead_opt(){if let Some(t)=tabs.iter().find(|t|agent_of(t)==l){set_lead(t.id);}}}
        if !KEEPER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(keep_alive(tabs.clone()));}
        /* Co-Work-Fix: STAGE ist nach Neustart 0 - Nudger immer fortsetzen, wenn Co-Work-Fenster laufen */if !NUDGER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(nudger(tabs.clone()));}
        tracing::info!("Co-Work: Keeper/Nudger nach Neustart fortgesetzt");
    });
}
pub(crate) fn show_all_windows(){let tabs=load();if tabs.len()>1{windows::set_hidden(&tabs[1..],false);}}


fn set_browser(v:&Value)->Result<String,String>{
    let n=v.as_str().or_else(||v.get("name").and_then(Value::as_str)).unwrap_or("").trim().to_string();
    if n.is_empty(){return Err("Bitte einen Browser ausw\u{e4}hlen.".into());}
    let found=installed_browsers().into_iter().find(|(x,_)|x.eq_ignore_ascii_case(&n)).ok_or(format!("{n} ist auf diesem PC nicht installiert."))?;
    if chosen_browser().map(|c|c.eq_ignore_ascii_case(found.0)).unwrap_or(false){return Ok(format!("Browser: {}.",found.0));}
    if !running_ids(&load()).is_empty(){return Err("Erst alle Tabs stoppen, dann den Browser wechseln.".into());}
    std::fs::create_dir_all(base()).map_err(|e|e.to_string())?;std::fs::write(browser_file(),found.0).map_err(|e|e.to_string())?;
    Ok(format!("Browser: {} \u{2013} alle Tabs starten ab jetzt darin.",found.0))
}
fn login_url(_t:&Tab)->String{["https://www.","notion",".so/login"].concat()}
/// Gmail-Login direkt in AdiCode: der echte Tab-Browser laedt die Google-Seite (Cookies landen im Container),
/// das Fenster wird versteckt und AdiCode zeigt/steuert es per CDP (Screenshot + Maus/Tastatur).
fn login_view(t:Tab)->Result<String,String>{
    if t.email.is_empty(){return Err("Erst E-Mail-Konto eintragen und speichern.".into());}
    let url=login_url(&t);let i=tab_index(t.id);
    let running=running_ids(std::slice::from_ref(&t)).contains(&t.id);
    if !running{launch(&t,&url)?;}
    let msg=format!("Login-Ansicht f\u{fc}r {} ge\u{f6}ffnet.",t.email);
    tokio::spawn(async move{
        if running{if let Ok(ws)=any_target(cdp_port(i)).await{let _=cdp_ws(&ws,vec![json!({"method":"Page.navigate","params":{"url":url}})]).await;}}
        else{for _ in 0..30{if any_target(cdp_port(i)).await.is_ok(){break;}tokio::time::sleep(Duration::from_millis(500)).await;}}
        tokio::time::sleep(Duration::from_millis(1500)).await;
        mem_set(&t.email,"login_method",json!(if is_gmail(&t.email){"google"}else{"email"}));
        if !is_gmail(&t.email){let fill=EMAIL_FILL_JS.replace("__EMAIL__",&serde_json::to_string(t.email.trim()).unwrap_or_default());for _ in 0..12{if let Ok(ws)=any_target(cdp_port(i)).await{match ws_eval(&ws,&fill).await.ok().and_then(|v|v.as_str().map(String::from)).as_deref(){Some("filled")=>{tokio::time::sleep(Duration::from_millis(700)).await;let r=ws_eval(&ws,EMAIL_NEXT_JS).await.ok().and_then(|v|v.as_str().map(String::from)).unwrap_or_default();if r=="sent"{mark_account(t.id,"login_state",json!("Code wurde an die E-Mail geschickt - Code im Fenster eingeben."));break;}}Some("sent")=>break,_=>{}}}tokio::time::sleep(Duration::from_millis(800)).await;}}
        // Login im echten Fenster: sichtbar und bedienbar lassen (nicht mehr verstecken).
        windows::set_hidden(std::slice::from_ref(&t),false);
    });
    Ok(msg)
}
async fn any_target(port:u16)->Result<String,String>{
    let list:Vec<Value>=reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await.map_err(|_|"Tab l\u{e4}uft nicht.".to_string())?.json().await.map_err(|e|e.to_string())?;
    list.into_iter().filter(|v|{let o=chat_own();o.is_empty()||v["id"].as_str()!=Some(o.as_str())}).find(|v|v["type"]=="page"&&!v["url"].as_str().unwrap_or("").starts_with("devtools://")).and_then(|v|v["webSocketDebuggerUrl"].as_str().map(str::to_string)).ok_or("Kein Browser-Fenster im Tab gefunden.".into())
}
fn vk(key:&str)->Option<i64>{Some(match key{"Enter"=>13,"Backspace"=>8,"Tab"=>9,"Escape"=>27,"Delete"=>46,"ArrowLeft"=>37,"ArrowUp"=>38,"ArrowRight"=>39,"ArrowDown"=>40,"Home"=>36,"End"=>35,_=>return None})}
async fn view_op(req:Value)->Result<Value,String>{
    let id=req["id"].as_u64().and_then(|n|u32::try_from(n).ok());let t=find(id)?;let port=cdp_port(tab_index(t.id));
    let ws=any_target(port).await?;
    let num=|k:&str|req[k].as_f64().unwrap_or(0.0);
    match req["op"].as_str().unwrap_or("shot"){
        "shot"=>{
            let r=cdp_ws(&ws,vec![json!({"method":"Page.captureScreenshot","params":{"format":"jpeg","quality":req["q"].as_u64().unwrap_or(60).clamp(20,90)}}),json!({"method":"Runtime.evaluate","params":{"expression":"JSON.stringify({w:innerWidth,h:innerHeight,u:location.href,t:document.title})","returnByValue":true}})]).await?;
            let img=r.first().and_then(|v|v.pointer("/result/data")).and_then(Value::as_str).ok_or("Kein Bild vom Tab.")?.to_string();
            let info:Value=r.get(1).and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_str).and_then(|s|serde_json::from_str(s).ok()).unwrap_or(json!({}));
            let url=info["u"].as_str().unwrap_or("").to_string();
            let notion=url.contains("notion.so")||url.contains("notion.com");
            let done=if req["fast"].as_bool()==Some(true){notion&&!url.contains("/login")&&!url.contains("/signup")}else{notion&&!url.contains("/login")&&!url.contains("/signup")&&logged_in(port).await};
            Ok(json!({"ok":true,"img":img,"w":info["w"],"h":info["h"],"url":url,"title":info["t"],"logged_in":done}))
        }
        "click"=>{let(x,y)=(num("x"),num("y"));cdp_ws(&ws,vec![json!({"method":"Input.dispatchMouseEvent","params":{"type":"mouseMoved","x":x,"y":y}}),json!({"method":"Input.dispatchMouseEvent","params":{"type":"mousePressed","x":x,"y":y,"button":"left","clickCount":1}}),json!({"method":"Input.dispatchMouseEvent","params":{"type":"mouseReleased","x":x,"y":y,"button":"left","clickCount":1}})]).await?;Ok(json!({"ok":true}))}
        "type"=>{let text=req["text"].as_str().unwrap_or("").chars().take(2000).collect::<String>();if !text.is_empty(){cdp_ws(&ws,vec![json!({"method":"Input.insertText","params":{"text":text}})]).await?;}Ok(json!({"ok":true}))}
        "key"=>{
            let key=req["key"].as_str().unwrap_or("").to_string();let code=vk(&key).ok_or("Taste nicht unterst\u{fc}tzt.")?;
            let mut down=json!({"type":"rawKeyDown","key":key,"code":key,"windowsVirtualKeyCode":code,"nativeVirtualKeyCode":code});
            if key=="Enter"{down["type"]=json!("keyDown");down["text"]=json!("\r");}
            let up=json!({"type":"keyUp","key":key,"code":key,"windowsVirtualKeyCode":code,"nativeVirtualKeyCode":code});
            cdp_ws(&ws,vec![json!({"method":"Input.dispatchKeyEvent","params":down}),json!({"method":"Input.dispatchKeyEvent","params":up})]).await?;Ok(json!({"ok":true}))
        }
        "scroll"=>{cdp_ws(&ws,vec![json!({"method":"Input.dispatchMouseEvent","params":{"type":"mouseWheel","x":num("x"),"y":num("y"),"deltaX":0,"deltaY":num("dy")}})]).await?;Ok(json!({"ok":true}))}
        "back"=>{cdp_ws(&ws,vec![json!({"method":"Runtime.evaluate","params":{"expression":"history.back()"}})]).await?;Ok(json!({"ok":true}))}
        "fit"=>{
            let w=num("w").clamp(600.0,2600.0);let h=num("h").clamp(400.0,1800.0);
            let r=cdp_ws(&ws,vec![json!({"method":"Browser.getWindowForTarget","params":{}}),json!({"method":"Runtime.evaluate","params":{"expression":"JSON.stringify([outerWidth-innerWidth,outerHeight-innerHeight])","returnByValue":true}})]).await?;
            let wid=r.first().and_then(|v|v.pointer("/result/windowId")).and_then(Value::as_i64).ok_or("Kein Fenster.")?;
            let d:Vec<f64>=r.get(1).and_then(|v|v.pointer("/result/result/value")).and_then(Value::as_str).and_then(|s|serde_json::from_str(s).ok()).unwrap_or_else(||vec![16.0,39.0]);
            let dx=d.first().copied().unwrap_or(16.0).clamp(0.0,200.0);let dy=d.get(1).copied().unwrap_or(39.0).clamp(0.0,300.0);
            cdp_ws(&ws,vec![json!({"method":"Browser.setWindowBounds","params":{"windowId":wid,"bounds":{"width":(w+dx).round() as i64,"height":(h+dy).round() as i64}}})]).await?;
            Ok(json!({"ok":true,"w":w,"h":h}))
        }
        _=>Err("Unbekannte Aktion.".into()),
    }
}
pub async fn view_handler(Json(req):Json<Value>)->impl IntoResponse{match view_op(req).await{Ok(v)=>(axum::http::StatusCode::OK,Json(v)),Err(e)=>(axum::http::StatusCode::BAD_REQUEST,Json(json!({"ok":false,"error":e})))}}
static MAIN_ID:std::sync::atomic::AtomicU32=std::sync::atomic::AtomicU32::new(u32::MAX);
fn main_file()->std::path::PathBuf{std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from).unwrap_or_else(std::env::temp_dir).join("PlazCodeNotion").join("main_tab.txt")}
/// Tab-ID, die der AdiCode-Chat steuert (0 = erster Tab).
pub fn main_id()->u32{let v=MAIN_ID.load(Ordering::SeqCst);if v!=u32::MAX{return v;}let id=std::fs::read_to_string(main_file()).ok().and_then(|s|s.trim().parse::<u32>().ok()).unwrap_or(0);MAIN_ID.store(id,Ordering::SeqCst);id}
pub fn main_index()->usize{let m=main_id();if m==0{0}else{tab_index(m)}}
fn set_main(t:Tab)->Result<String,String>{MAIN_ID.store(t.id,Ordering::SeqCst);let _=std::fs::write(main_file(),t.id.to_string());Ok(format!("{} ({}) steuert jetzt den AdiCode-Chat.",t.label,t.role))}
pub fn state()->Value{let tabs=load();let running=running_ids(&tabs);let acc=lock(&ACCOUNT).clone();let mem=mem_all();auto_rename(tabs.iter().enumerate().filter(|(_,t)|running.contains(&t.id)).map(|(i,t)|(i,t.id,proj_of(&tabs,t))).filter(|x|!x.2.is_empty()).map(|(i,id,p)|(i,id,format!("{p} Chat"))).collect());json!({"ok":true,"groups":groups_of(&tabs).iter().map(|(k,v)|(k.to_string(),json!(v))).collect::<serde_json::Map<String,Value>>(),"main_id":tabs.get(main_index()).map(|t|t.id).unwrap_or(0),"lead_id":lead_id(),"generating":tabs.iter().map(|t|(t.id.to_string(),json!(crate::notion_live::is_generating(&agent_of(t))))).collect::<serde_json::Map<String,Value>>(),"max_chats":MAX_CHATS_PER_ACCOUNT,"stage":if running.is_empty(){0}else{STAGE.load(std::sync::atomic::Ordering::SeqCst)},"hidden":windows::any_hidden(),"auto_mcp":auto_mcp_on(),"token_mode":if token_high(){"high"}else{"low"},"browser":browser_name(),"browsers":installed_browsers().iter().map(|(n,_)|*n).collect::<Vec<_>>(),"status":lock(&COWORK_STATUS).clone(),"tabs":({let cache=acc_cache();tabs.iter().map(|t|{let mut v=json!(t);v["running"]=json!(running.contains(&t.id));v["paused"]=json!(is_paused(t.id));v["skipped"]=json!(skipped(t.id));v["project"]=json!(proj_of(&tabs,t));v["slots"]=json!(slots_of(t.id));v["slot_agents"]=json!(slot_agents(t));v["agent"]=json!(agent_of(t));v["account"]={let mut base=cache.get(t.email.to_lowercase().as_str()).cloned().filter(Value::is_object).unwrap_or_else(||json!({"usage":null,"models":[]}));if let Some(live)=acc.get(&t.id).and_then(Value::as_object){for(k,x)in live{base[k.as_str()]=x.clone();}}base};v["memory"]=mem.get(t.email.to_lowercase().as_str()).cloned().unwrap_or(Value::Null);v}).collect::<Vec<_>>()})})}
pub async fn tabs_handler()->impl IntoResponse{ensure_monitors();Json(tokio::task::spawn_blocking(state).await.unwrap_or_else(|e|json!({"ok":false,"error":e.to_string()})))}
/// Einzelschritt aus dem Co-Work-Tab (Klick auf ein Haekchen): fuehrt nur diesen Schritt aus.
async fn run_step(t:Tab,i:usize,st:String){
    let port=cdp_port(i);let id=t.id;
    let name=match st.as_str(){"perm"=>"Run automatically","model"=>"Modell","chat"=>"Chat","chats"=>"Chats","name"=>"Chats benennen","usage"=>"Usage",_=>"?"};
    mark_account(id,"checking",json!(true));
    mark_account(id,"check",json!(format!("Einzelschritt {name} l\u{e4}uft \u{2026}")));
    let res:Result<String,String>=match st.as_str(){
        "perm"=>{let _=tokio::time::timeout(Duration::from_secs(90),mcp_finish(&t,port)).await;mcp_cleanup(port).await;Ok("fertig".to_string())}
        "model"=>{let a=ensure_models(&t,i).await;let b=ensure_chat_model(&t,i).await;a.and(b).map(|_|"ok".to_string())}
        "chat"=>prepare_chat(&t,i).await.map(|_|{mark_account(id,"chat_ok",json!(true));"ok".to_string()}),
        "chats"=>{let _=tokio::time::timeout(Duration::from_secs(40),check_chats(&t,i)).await;Ok("fertig".to_string())}
        "name"=>{let n=pick_chat_tab(&t);match tokio::time::timeout(Duration::from_secs(90),name_chats(&t,i,n)).await{Ok(Ok(s))=>{if s.starts_with("Chats hei"){mem_set(&t.email,"chats_named",json!(true));}mark_account(id,"chat_tab",json!(n));mark_account(id,"chat_tab_state",json!(s.clone()));Ok(s)}Ok(Err(e))=>{mark_account(id,"chat_tab_state",json!(format!("Tab {n}: {e}")));Err(e)}Err(_)=>Err("Zeit\u{fc}berschreitung".to_string())}}
        "usage"=>{inspect_account(&t,i).await;Ok("fertig".to_string())}
        _=>Err("Unbekannter Schritt".to_string())
    };
    mark_account(id,"check",json!(match &res{Ok(_)=>format!("Einzelschritt {name}: fertig"),Err(e)=>format!("Einzelschritt {name}: {e}")}));
    mark_account(id,"checking",json!(false));
}
pub fn action(name:&str,v:&Value)->Option<Result<String,String>>{
    let id=v.as_u64().or_else(||v.get("id").and_then(Value::as_u64)).and_then(|n|u32::try_from(n).ok());
    Some(match name{
        "cowork_set_main"=>find(id).and_then(set_main),"cowork_set_group"=>set_group(v),"cowork_add_tab"=>add_tab(),"cowork_save_tabs"=>save_tabs(v),"cowork_start_all"=>start_all(v),
        "cowork_stop_all"=>{let ids:Vec<u32>=load().iter().map(|t|t.id).collect();Ok(format!("{} Browser-Prozesse beendet.",stop_ids(&ids)))},
        "cowork_show_all"=>{show_all_windows();Ok("Alle Co-Work-Fenster angezeigt.".into())},
        "cowork_check_accounts"|"cowork_check"=>check_action(),
        "cowork_check_stop"=>check_stop(id),
        "cowork_check_one"=>find(id).and_then(|t|{if !running_ids(std::slice::from_ref(&t)).contains(&t.id){launch(&t,&start_url(&t))?;}let i=tab_index(t.id);let msg=format!("Check f\u{fc}r Tab {} ({}) l\u{e4}uft.",t.id,t.role);let jid=t.id;let h=tokio::spawn(async move{let id=t.id;if check_one(t,i).await.is_ok(){let all=load();let ok=all.iter().filter(|x|!skipped(x.id)).all(|x|lock(&ACCOUNT).get(&x.id).and_then(|a|a["check"].as_str().map(|s|s.starts_with("OK"))).unwrap_or(false));if ok{hide_all_tabs(&all);}else{let me:Vec<Tab>=all.into_iter().filter(|x|x.id==id).collect();windows::set_hidden(&me,true);}}});lock(&CHECK_JOBS).insert(jid,h.abort_handle());Ok(msg)}),
        "cowork_goto_chat"=>find(id).and_then(|t|{if !running_ids(std::slice::from_ref(&t)).contains(&t.id){launch(&t,&start_url(&t))?;}windows::set_hidden(std::slice::from_ref(&t),false);let i=tab_index(t.id);let msg=format!("Tab {} ({}) wird zum Chat \u{201a}Willkommen bei Notion\u{2018} gebracht.",t.id,t.role);tokio::spawn(async move{let port=cdp_port(i);if !wait_cdp(port).await{return;}let _=cdp(port,vec![json!({"method":"Page.bringToFront"})]).await;let ok=prepare_chat(&t,i).await.is_ok();mark_account(t.id,"chat_ok",json!(ok));let st=lock(&ACCOUNT).get(&t.id).and_then(|a|a["check"].as_str().map(String::from)).unwrap_or_default();if ok&&st=="Chat fehlt"{mark_account(t.id,"check",json!("OK"));}});Ok(msg)}),
        "cowork_refresh_confirm"=>find(id).map(|t|{let i=tab_index(t.id);windows::set_hidden(std::slice::from_ref(&t),false);mark_account(t.id,"refresh_state",json!("Konto wird gel\u{f6}scht ..."));let t2=t.clone();tokio::spawn(refresh_account(t2,i));format!("Refresh f\u{fc}r Tab {} gestartet.",t.id)}),
        "cowork_refresh_all"=>{let tabs:Vec<Tab>=load();let n=tabs.len();if n==0{Err("Keine Konten vorhanden.".to_string())}else{for t in &tabs{windows::set_hidden(std::slice::from_ref(&t),false);mark_account(t.id,"refresh_state",json!("Refresh all: wartet ..."));}tokio::spawn(async move{for t in tabs{if !running_ids(std::slice::from_ref(&t)).contains(&t.id){let _=launch(&t,&start_url(&t));tokio::time::sleep(Duration::from_secs(8)).await;}let i=tab_index(t.id);mark_account(t.id,"refresh_state",json!("Konto wird gel\u{f6}scht ..."));tl(&format!("REFRESH-ALL Tab {}",t.id));refresh_account(t,i).await;tokio::time::sleep(human_sleep(Duration::from_secs(3),50)).await;}tl("REFRESH-ALL fertig");});Ok(format!("Refresh all f\u{fc}r {n} Konten gestartet (nacheinander)."))}},
        "cowork_skip"=>find(id).and_then(|t|set_skip(t.id,!skipped(t.id))),
        "cowork_add_chat"=>chat_action(true,v,id),"cowork_remove_chat"=>chat_action(false,v,id),
        "cowork_forget"=>find(id).map(|t|{mem_forget(&t.email);mark_account(t.id,"mcp_saved",json!(false));mark_account(t.id,"model_ok",Value::Null);format!("Gemerkte Checks f\u{fc}r {} gel\u{f6}scht \u{2013} n\u{e4}chster Check pr\u{fc}ft MCP und Modelle neu.",t.email)}),
        "cowork_set_english"=>find(id).map(|t|{let i=tab_index(t.id);tokio::spawn(async move{let r=set_english(cdp_port(i)).await;mark_account(t.id,"lang",json!(r.unwrap_or_else(|e|e)));});"Sprache wird auf English (US) gestellt.".into()}),
        "cowork_check_step"=>{let st=v.get("step").and_then(Value::as_str).unwrap_or("").to_string();find(id).map(|t|{let i=tab_index(t.id);let jid=t.id;let h=tokio::spawn(run_step(t,i,st));lock(&CHECK_JOBS).insert(jid,h.abort_handle());"Einzelschritt gestartet.".to_string()})},
        "cowork_setup_mcp"=>find(id).map(|t|{let i=tab_index(t.id);let jid=t.id;mark_account(jid,"checking",json!(true));let h=tokio::spawn(async move{match setup_mcp_safe(&t,i).await{Ok(_)=>{mem_set(&t.email,"mcp_ok2",json!(true));mark_account(t.id,"mcp_saved",json!(true));}Err(e)=>{mark_account(t.id,"mcp",json!(format!("Fehlt: {e}")));}}mark_account(t.id,"checking",json!(false));});lock(&CHECK_JOBS).insert(jid,h.abort_handle());"MCP-Check gestartet.".into()}),
        "cowork_takeover"=>find(id).map(|t|{lock(&PAUSED).insert(t.id);windows::set_hidden(std::slice::from_ref(&t),false);let i=tab_index(t.id);tokio::spawn(async move{stop_generation(cdp_port(i)).await;let _=cdp(cdp_port(i),vec![json!({"method":"Page.bringToFront"})]).await;});format!("Tab {} ({}) \u{fc}bernommen: AdiCode schickt keine Erinnerungen mehr, du kannst dort selbst schreiben.",t.id,t.role)}),
        "cowork_release"=>find(id).map(|t|{lock(&PAUSED).remove(&t.id);format!("Tab {} ({}) wieder an Co-Work \u{fc}bergeben.",t.id,t.role)}),
        "cowork_auto_mcp"=>{let on=v.as_bool().or_else(||v.get("on").and_then(Value::as_bool)).unwrap_or(false);let r=if on{std::fs::create_dir_all(base()).and_then(|_|std::fs::write(auto_mcp_file(),"1"))}else{match std::fs::remove_file(auto_mcp_file()){Err(e) if e.kind()!=std::io::ErrorKind::NotFound=>Err(e),_=>Ok(())}};ensure_monitors();r.map(|_|if on{"Auto-MCP an: neue Tabs bekommen AdiCode automatisch, sobald sie in Notion eingeloggt sind.".to_string()}else{"Auto-MCP aus.".to_string()}).map_err(|e|e.to_string())},
        "cowork_token_mode"=>{let high=v.as_str().or_else(||v.get("mode").and_then(Value::as_str)).map(|s|s=="high").unwrap_or(false);let r=if high{std::fs::create_dir_all(base()).and_then(|_|std::fs::write(token_file(),"high"))}else{match std::fs::remove_file(token_file()){Err(e) if e.kind()!=std::io::ErrorKind::NotFound=>Err(e),_=>Ok(())}};let ck=if r.is_ok(){check_action().unwrap_or_else(|e|e)}else{String::new()};r.map(|_|format!("{} {}",if high{"Viel-Token-Modus: alle Agents auf Opus 5.5."}else{"Spar-Modus: Tab 1 Opus 5.5, die anderen Sonnet 5.5."},ck)).map_err(|e|e.to_string())},
        "cowork_wake"=>{let tabs=load();tokio::spawn(async move{for(i,t)in tabs.iter().enumerate(){let agent=agent_of(t);let Some((_,text))=crate::notion_cowork::nudge_for(&agent) else{continue};if chat_idle(cdp_port(i)).await{let _=insert_prompt(cdp_port(i),text).await;}}});Ok("Aufwecken gesendet (nur an ruhende Chats mit offener Arbeit, nur im Willkommen-Chat).".into())},
        "cowork_set_browser"=>set_browser(v),
        "cowork_hide_all"=>{let tabs=load();if tabs.len()>1{hide_workers(&tabs);}Ok("Worker-Fenster versteckt.".into())},
        "cowork_show_tab"=>find(id).map(|t|{windows::set_hidden(std::slice::from_ref(&t),false);format!("Fenster von Tab {} angezeigt.",t.id)}),
        "cowork_login_view"=>find(id).and_then(login_view),
        "cowork_copy_prompt"=>find(id).map(|t|prompt_for(&t)),
        "cowork_stop"=>find(id).map(|t|format!("Tab {} gestoppt ({} Prozesse).",t.id,stop_ids(&[t.id]))),
        "open_notion_window"=>match id{Some(_)=>find(id).and_then(|t|open_tab(&t)),None=>add_tab().and_then(|_|load().last().cloned().ok_or("Tab fehlt.".into())).and_then(|t|open_tab(&t))},
        "cowork_login"=>find(id).and_then(|t|{if t.email.is_empty(){return Err("Erst E-Mail-Konto eintragen und speichern.".into());}let url=login_url(&t);launch(&t,&url).map(|b|format!("Login für {} geöffnet ({b}).",t.email))}),
        "delete_notion_profile"|"cowork_delete"=>delete(id),
        "rename_notion_profile"=>find(id).and_then(|t|{let mut tabs=load();if let Some(x)=tabs.iter_mut().find(|x|x.id==t.id){x.label=clean(v.get("label").and_then(Value::as_str).unwrap_or(""),40);}save(&tabs).map(|_|"Name gespeichert.".into())}),
        _=>return None,
    })
}

// 1.0.92: Notion-Chats nach Projekt benennen
const RENAME_JS:&str=r##"(async()=>{const N=__NAME__;const sl=ms=>new Promise(r=>setTimeout(r,ms*(0.5+Math.random()*0.3)));const cur=document.title.replace(/\s*\|\s*Notion\s*$/i,'').trim();if(cur===N)return 'same';const b=[...document.querySelectorAll('[aria-label]')].find(e=>/rename|umbenennen/i.test(e.getAttribute('aria-label')||'')&&!e.closest('[aria-label=Sidebar],nav'));if(!b)return 'nobtn';b.click();await sl(700);const it=[...document.querySelectorAll('[role=menuitem],[role=option]')].find(e=>/^(rename|umbenennen)/i.test(e.textContent.trim()));if(!it){document.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',code:'Escape',keyCode:27,bubbles:true}));return 'noitem'}it.click();let a=null;for(let i=0;i<15;i++){await sl(200);a=document.activeElement;if(a&&a.tagName==='INPUT')break;a=[...document.querySelectorAll('input')].find(x=>x.value===cur&&x.offsetParent);if(a){a.focus();break}}if(!a||a.tagName!=='INPUT'){return 'noinput'}Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(a,N);a.dispatchEvent(new Event('input',{bubbles:true}));await sl(150);a.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',keyCode:13,which:13,bubbles:true}));await sl(800);if(document.activeElement===a){a.blur()}await sl(400);return 'ok:'+document.title})()"##;
fn proj_of(tabs:&[Tab],t:&Tab)->String{let p=crate::notion_cowork::project_name_for(&agent_of(t));if !p.is_empty(){return p;}let g=groups_of(tabs);let m=g.get(&t.id).copied().unwrap_or(t.id);if m==t.id{return String::new();}tabs.iter().find(|x|x.id==m).map(|x|crate::notion_cowork::project_name_for(&agent_of(x))).unwrap_or_default()}
static RN_LAST:std::sync::OnceLock<std::sync::Mutex<std::collections::HashMap<u32,(String,u64,bool)>>>=std::sync::OnceLock::new();
fn auto_rename(list:Vec<(usize,u32,String)>){
    let Ok(h)=tokio::runtime::Handle::try_current() else{return};
    let now=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d|d.as_secs()).unwrap_or(0);
    let m=RN_LAST.get_or_init(Default::default);let mut todo=Vec::new();
    {let mut g=m.lock().unwrap_or_else(|e|e.into_inner());for(i,id,name)in list{let e=g.entry(id).or_insert((String::new(),0,false));if e.0==name&&(e.2||now<e.1+60){continue;}*e=(name.clone(),now,false);todo.push((i,id,name));}}
    if todo.is_empty(){return;}
    h.spawn(async move{for(i,id,name)in todo{let port=cdp_port(i);if user_present(port).await{continue;}let js=RENAME_JS.replace("__NAME__",&serde_json::to_string(&name).unwrap_or_default());if let Ok(v)=js_eval(port,&js).await{let s=v.as_str().unwrap_or("");if s=="same"||s.starts_with("ok"){if let Some(m)=RN_LAST.get(){if let Some(e)=m.lock().unwrap_or_else(|e|e.into_inner()).get_mut(&id){if e.0==name{e.2=true;}}}}}}});
}
// ===== 1.0.114: Multi-Chat pro Konto =====
// Live-Chatzaehler + Live-Usage direkt aus den Notion-Webseitendaten (interne API des eingeloggten Kontos, alle 10 s)
// und Co-Work-Chat-Slots: ein Konto setzt mehrere Chats (je ein eigener Browser-Tab im selben Profil) im Co-Work ein.
// Messung 07.10.2026 (Konto adiabi26444, Sonnet/Opus): 10 bestehende Chats liefen gleichzeitig fehlerfrei (alle fertig
// in 12-18 s). NEUE Chats verwirft Notion still (Thread ohne Antwort, "Agent thread not found"), sobald mehr als ~5 kurz
// hintereinander gestartet werden. REGEL (Nutzer): AdiCode erstellt NIE einen neuen Chat - Co-Work-Chats sind immer
// bestehende Chats des Kontos (open_target/ws_send_prompt lehnen alles ohne t=<id> ab). Pro Chat-Tab braucht der
// Browser ca. 350-400 MB RAM (15 Tabs: freier RAM 5,1 -> 0,5 GB) -> RAM-Waechter.
pub(crate) const MAX_CHATS_PER_ACCOUNT:usize=8;
const MIN_FREE_RAM_MB:u64=1200;
static LIVE_STARTED:AtomicBool=AtomicBool::new(false);
static SLOTS_STARTED:AtomicBool=AtomicBool::new(false);
static SLOT_BUSY:Lazy<Mutex<HashSet<u32>>>=Lazy::new(||Mutex::new(HashSet::new()));
/// Chat-Liste (getInferenceTranscriptsForUser inkl. Laufzustand displayRuntimeStatus) + 6h-Kreditfenster (getCreditRateLimitStatus).
const LIVE_JS:&str=r#"(async()=>{const post=(p,b)=>fetch('/api/v3/'+p,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(b||{})}).then(r=>r.ok?r.json():null).catch(()=>null);const sp=await post('getSpaces',{});let spaceId=null;if(sp){for(const u of Object.values(sp)){const ids=Object.keys((u&&u.space)||{});if(ids.length){spaceId=ids[0];break;}}}if(!spaceId)return {ok:false,error:'Nicht eingeloggt oder kein Workspace'};const chats=[];let cursor=undefined;for(let pg=0;pg<3;pg++){const l=await post('getInferenceTranscriptsForUser',{threadParentPointer:{table:'space',id:spaceId,spaceId},limit:100,cursor});if(!l)break;const th=(l.recordMap&&l.recordMap.thread)||{};for(const x of (l.transcripts||[])){const r=th[x.id];const v=(r&&((r.value&&r.value.value)||r.value))||{};const d=v.data||{};const ap=d.agent_provider||{};const st=(ap.displayRuntimeStatus&&ap.displayRuntimeStatus.state)||null;chats.push({id:String(x.id).replace(/-/g,''),title:String(x.title||d.title||'').slice(0,80),updated:x.updated_at||v.updated_time||0,running:st==='running',state:st,model:ap.model||null})}if(!l.hasMore||!l.nextCursor)break;cursor=l.nextCursor;}const rl=await post('getCreditRateLimitStatus',{spaceId});const w=(rl&&rl.window)||{};return {ok:true,chats,rate:{status:rl?rl.status||null:null,used:typeof w.used==='number'?w.used:null,limit:typeof w.limit==='number'?w.limit:null,window:w.window||null,reset_s:rl&&typeof rl.resetsInSeconds==='number'?rl.resetsInSeconds:null,type:w.creditType||null}}})()"#;
const SLOT_GEN_JS:&str=r#"(()=>{if(!document.querySelector('[data-testid="agent-chat-stop-button"],[data-testid="agent-stop-inference-button"]'))return null;const m=document.querySelector('main')||document.body;const t=(m.innerText||'').replace(/\d/g,'');return t.length+':'+t.slice(-300)})()"#;
const SLOT_IDLE_JS:&str=r#"(()=>{if(document.querySelector('[data-testid="agent-chat-stop-button"],[data-testid="agent-stop-inference-button"],[data-testid="agent-chat-stop-recording-button"]'))return false;const c=document.querySelector('[role="textbox"][contenteditable="true"]');return !!c&&!(c.innerText||'').trim()})()"#;
const SLOT_STOP_JS:&str=r#"(()=>{const b=document.querySelector('[data-testid="agent-chat-stop-button"],[data-testid="agent-stop-inference-button"]');if(b)b.click();return !!b})()"#;
const SLOT_FOCUS_JS:&str=r#"(()=>{const q=[...document.querySelectorAll('textarea,[contenteditable="true"]')].filter(e=>{const r=e.getBoundingClientRect(),s=getComputedStyle(e);return r.width>180&&r.height>10&&s.visibility!=='hidden'&&s.display!=='none'}).sort((a,b)=>{const score=e=>{const hint=((e.getAttribute('placeholder')||'')+' '+(e.getAttribute('aria-label')||'')).toLowerCase();return (/ask notion ai|notion ai fragen|frag notion ai|describe your own/.test(hint)?100000:0)+e.getBoundingClientRect().bottom};return score(b)-score(a)});if(!q[0])return false;q[0].focus();return true})()"#;
const SLOT_SUBMIT_JS:&str=r#"(()=>{const ok=e=>{const r=e.getBoundingClientRect();return r.width>0&&r.height>0&&!e.disabled&&e.getAttribute('aria-disabled')!=='true'};let e=[...document.querySelectorAll('[data-testid=agent-send-message-button],[data-testid=agent-chat-send-button]')].find(ok);if(!e)e=[...document.querySelectorAll('button,[role=button]')].find(x=>ok(x)&&/^(submit ai message|send( message)?|senden|nachricht senden)$/i.test((x.getAttribute('aria-label')||'').trim()));if(!e)return false;e.click();return true})()"#;
const SLOT_LEFT_JS:&str=r#"(()=>[...document.querySelectorAll('[role=textbox][contenteditable]')].some(e=>(e.innerText||'').trim().length>0))()"#;
/// Hat Notion den Lauf in Thread __TID__ wirklich gestartet? (verworfene Starts haben weder Nachrichten noch Funding-Quelle)
const THREAD_OK_JS:&str=r#"(async()=>{const T='__TID__';const id=T.replace(/^(.{8})(.{4})(.{4})(.{4})(.{12})$/,'$1-$2-$3-$4-$5');const post=(p,b)=>fetch('/api/v3/'+p,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(b||{})}).then(r=>r.ok?r.json():null).catch(()=>null);const sp=await post('getSpaces',{});let spaceId=null;if(sp){for(const u of Object.values(sp)){const ids=Object.keys((u&&u.space)||{});if(ids.length){spaceId=ids[0];break;}}}const rv=await post('syncRecordValuesMain',{requests:[{pointer:{table:'thread',id,spaceId},version:-1}]});const x=rv&&rv.recordMap&&rv.recordMap.thread&&rv.recordMap.thread[id];const v=(x&&((x.value&&x.value.value)||x.value))||{};const d=v.data||{};const st=d.agent_provider&&d.agent_provider.displayRuntimeStatus&&d.agent_provider.displayRuntimeStatus.state;return !!(st==='running'||(v.messages&&v.messages.length)||d.last_observed_funding_source||d.last_turn_outcome)})()"#;
fn slots_file()->PathBuf{base().join("chat-slots.json")}
fn slots_all()->BTreeMap<u32,Vec<String>>{std::fs::read_to_string(slots_file()).ok().and_then(|s|serde_json::from_str::<BTreeMap<String,Vec<String>>>(s.trim_start_matches('\u{feff}')).ok()).map(|m|m.into_iter().filter_map(|(k,v)|k.parse::<u32>().ok().map(|k|(k,v))).collect()).unwrap_or_default()}
fn slots_save(m:&BTreeMap<u32,Vec<String>>){let s:BTreeMap<String,&Vec<String>>=m.iter().filter(|(_,v)|!v.is_empty()).map(|(k,v)|(k.to_string(),v)).collect();let _=std::fs::create_dir_all(base());let _=std::fs::write(slots_file(),serde_json::to_vec_pretty(&s).unwrap_or_default());}
/// Thread-IDs (32 Hex-Zeichen, wie im URL-Parameter t=) der Zusatz-Chats eines Tabs; Chat 1 ist immer der Haupt-Tab.
pub(crate) fn slots_of(id:u32)->Vec<String>{slots_all().remove(&id).unwrap_or_default()}
fn norm_tid(s:&str)->String{s.chars().filter(|c|c.is_ascii_hexdigit()).collect::<String>().to_lowercase()}
fn url_tid(u:&str)->String{u.split(|c|c=='?'||c=='&').find_map(|p|p.strip_prefix("t=")).map(norm_tid).unwrap_or_default()}
/// Agent-Name von Chat k (k>=2) eines Tabs, z. B. AdiCode-Tab1-K2 oder Main1-K2.
pub(crate) fn slot_agent(t:&Tab,k:usize)->String{format!("{}-K{k}",agent_of(t))}
fn slot_agents(t:&Tab)->Vec<String>{(0..slots_of(t.id).len()).map(|j|slot_agent(t,j+2)).collect()}
/// Agent-Name -> (Tab-Index, Tab, Thread-ID) eines Zusatz-Chats.
fn find_slot(tabs:&[Tab],agent:&str)->Option<(usize,Tab,String)>{let all=slots_all();tabs.iter().enumerate().find_map(|(i,t)|all.get(&t.id).and_then(|v|v.iter().enumerate().find(|(j,_)|slot_agent(t,j+2)==agent).map(|(_,tid)|(i,t.clone(),tid.clone()))))}
fn free_ram_mb()->Option<u64>{let mut s=sysinfo::System::new();s.refresh_memory();let a=s.available_memory();if a==0{None}else{Some(a/1024/1024)}}
async fn page_targets(port:u16)->Vec<Value>{match reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await{Ok(r)=>r.json::<Vec<Value>>().await.unwrap_or_default().into_iter().filter(|v|v["type"]=="page"&&v["url"].as_str().unwrap_or("").contains("notion.")).collect(),Err(_)=>Vec::new()}}
fn origin_of(targets:&[Value])->String{targets.iter().filter_map(|v|v["url"].as_str()).find_map(|u|{let p=u.find("://")?;let rest=&u[p+3..];let e=rest.find('/').unwrap_or(rest.len());Some(format!("{}{}",&u[..p+3],&rest[..e]))}).unwrap_or_else(||"https://www.notion.so".into())}
async fn browser_ws(port:u16)->Result<String,String>{let v:Value=reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json/version")).timeout(Duration::from_secs(3)).send().await.map_err(|e|e.to_string())?.json().await.map_err(|e|e.to_string())?;v["webSocketDebuggerUrl"].as_str().map(String::from).ok_or("Browser-CDP fehlt".into())}
async fn open_target(port:u16,url:&str)->Result<String,String>{if url_tid(url).is_empty(){return Err("Nur bestehende Chats (Link mit t=) - AdiCode erstellt nie einen neuen Notion-Chat.".into());}let b=browser_ws(port).await?;cdp_ws(&b,vec![json!({"method":"Target.createTarget","params":{"url":url,"background":true}})]).await?.last().and_then(|v|v.pointer("/result/targetId")).and_then(Value::as_str).map(String::from).ok_or("Browser-Tab nicht erstellt".into())}
async fn close_target(port:u16,id:&str){if let Ok(b)=browser_ws(port).await{let _=cdp_ws(&b,vec![json!({"method":"Target.closeTarget","params":{"targetId":id}})]).await;}}
async fn target_ws_by_id(port:u16,id:&str,secs:u64)->Result<String,String>{for _ in 0..secs*2{let list:Vec<Value>=match reqwest::Client::new().get(format!("http://127.0.0.1:{port}/json")).timeout(Duration::from_secs(3)).send().await{Ok(r)=>r.json().await.unwrap_or_default(),Err(_)=>Vec::new()};if let Some(ws)=list.iter().find(|v|v["id"].as_str()==Some(id)).and_then(|v|v["webSocketDebuggerUrl"].as_str()){return Ok(ws.to_string());}tokio::time::sleep(Duration::from_millis(500)).await;}Err("Neuer Chat-Tab nicht erreichbar".into())}
async fn ws_eval(ws:&str,expr:&str)->Result<Value,String>{Ok(cdp_ws(ws,vec![json!({"method":"Runtime.evaluate","params":{"expression":expr,"awaitPromise":true,"returnByValue":true}})]).await?.last().and_then(|v|v.pointer("/result/result/value")).cloned().unwrap_or(Value::Null))}
async fn slot_ws(port:u16,tid:&str)->Option<String>{page_targets(port).await.into_iter().find(|v|url_tid(v["url"].as_str().unwrap_or(""))==tid).and_then(|v|v["webSocketDebuggerUrl"].as_str().map(String::from))}
/// Prompt in den Chat-Tab `ws` schreiben und abschicken. expect_tid: Sicherheitsregel - nur in den eigenen Zusatz-Chat schreiben.
async fn ws_send_prompt(ws:&str,expect_tid:Option<&str>,prompt:&str)->Result<(),String>{
    let cur={let u=ws_eval(ws,"location.href").await?;url_tid(u.as_str().unwrap_or(""))};
    if cur.is_empty(){return Err("Kein bestehender Chat im Tab - nichts gesendet; AdiCode erstellt nie einen neuen Notion-Chat.".into());}
    if let Some(tid)=expect_tid{if cur!=tid{return Err("Falscher Chat im Slot-Tab - nichts gesendet.".into());}}
    let mut ready=false;for _ in 0..40{if ws_eval(ws,SLOT_FOCUS_JS).await?.as_bool()==Some(true){ready=true;break;}tokio::time::sleep(Duration::from_millis(500)).await;}
    if !ready{if ws_eval(ws,QUOTA_JS).await.ok().and_then(|v|v.as_bool())==Some(true){return Err("KI-Kontingent dieses Notion-Kontos ist aufgebraucht".into());}return Err("Notion-AI-Eingabefeld im Chat-Tab nicht gefunden".into());}
    cdp_ws(ws,vec![json!({"method":"Input.insertText","params":{"text":prompt}})]).await?;tokio::time::sleep(Duration::from_millis(400)).await;
    for attempt in 0..3u8{
        let mut clicked=false;for _ in 0..8{if ws_eval(ws,SLOT_SUBMIT_JS).await?.as_bool()==Some(true){clicked=true;break;}tokio::time::sleep(Duration::from_millis(300)).await;}
        if !clicked{let mods=if attempt==1{2}else{0};cdp_ws(ws,vec![json!({"method":"Input.dispatchKeyEvent","params":{"type":"keyDown","key":"Enter","code":"Enter","windowsVirtualKeyCode":13,"modifiers":mods}}),json!({"method":"Input.dispatchKeyEvent","params":{"type":"keyUp","key":"Enter","code":"Enter","windowsVirtualKeyCode":13,"modifiers":mods}})]).await?;}
        tokio::time::sleep(Duration::from_millis(1200)).await;
        if ws_eval(ws,SLOT_LEFT_JS).await.ok().and_then(|v|v.as_bool())!=Some(true){return Ok(());}
    }
    Err("Prompt eingefuegt, aber nicht abgeschickt (Senden-Knopf reagiert nicht).".into())
}
fn prompt_for_slot(t:&Tab,k:usize)->String{
    const CONN:&str="Die Tools kommen von meinem AdiCode-MCP-Server (in Notion als Verbindung \"asf\" oder \"AdiCode\" eingetragen).";
    let tabs=load();let g=groups_of(&tabs);let m=g.get(&t.id).copied().unwrap_or(t.id);
    let main=tabs.iter().find(|x|x.id==m).cloned().unwrap_or_else(||t.clone());
    let ma=agent_of(&main);let proj=format!("Projekt {}",main.role);let a=slot_agent(t,k);let mr=main.role.clone();
    format!("Hallo! AdiCode Co-Work: Du bist Chat {k} von {r} (Konto {em}) und hilfst als zusaetzlicher Chat {mr} (Agent \"{ma}\"). {CONN} Mehrere Chats desselben Kontos arbeiten parallel - es gibt keine festen Rollen, du hilfst bei allem. {mr} ist dein einziger Ansprechpartner, nicht der Nutzer.\n1. cowork_board aufrufen und das Projekt waehlen, dessen Titel mit \"{proj}\" beginnt (Lead {ma}); dann cowork_join mit project <diese id>, agent \"{a}\". Gibt es noch keins: kurz warten und erneut pruefen.\n2. Loop: cowork_claim, erledigen, cowork_update mit 1-Satz-Ergebnis, wieder cowork_claim. Bei JEDEM schreibenden Tool (safe_write_file, files_*, pc_PowerShell, git_*) agent \"{a}\" mitgeben - die Bridge sperrt damit Dateien, damit sich die Chats nicht gegenseitig ueberschreiben.\n3. Nach jeder Aufgabe kritisch pruefen und Kritik + Verbesserungsvorschlaege per cowork_message mit to \"{ma}\" schicken.\n4. Nichts frei: cowork_wait.\nTempo: unabhaengige Tool-Calls parallel in EINER Antwort, keine Zwischenberichte. Antworte jetzt nur: Bereit.",r=t.role,em=t.email)
}
/// Freien BESTEHENDEN Chat des Kontos waehlen (zuerst "Tab n Kontext ...", dann Willkommen-Chats, dann zuletzt genutzte).
/// Niemals einen neuen Chat anlegen: gibt es keinen freien bestehenden Chat, kommt ein Fehler.
async fn pick_existing_chat(t:&Tab,port:u16,sl:&[String],open:&HashSet<String>)->Result<String,String>{
    let main=welcome_url(t).map(|u|url_tid(&u)).unwrap_or_default();
    let mut chats=lock(&ACCOUNT).get(&t.id).and_then(|a|a["chats_live"].as_array().cloned()).unwrap_or_default();
    if chats.is_empty(){if let Ok(v)=js_eval(port,LIVE_JS).await{chats=v["chats"].as_array().cloned().unwrap_or_default();}}
    let n=mem_get(&t.email,"chat_tab").as_u64();
    let mut cand:Vec<(u8,usize,String)>=chats.iter().enumerate().filter_map(|(k,c)|{
        let id=norm_tid(c["id"].as_str().unwrap_or(""));
        if id.len()!=32||id==main||sl.contains(&id)||open.contains(&id)||c["running"].as_bool()==Some(true){return None;}
        let ti=c["title"].as_str().unwrap_or("").to_lowercase();
        let s=if n.map_or(false,|n|ti.starts_with(&format!("tab {n} kontext"))){0}else if ti.contains("willkommen bei notion")||ti.contains("welcome to notion"){1}else{2};
        Some((s,k,id))}).collect();
    cand.sort();
    cand.into_iter().next().map(|x|x.2).ok_or_else(||"Kein freier bestehender Chat in diesem Konto - AdiCode erstellt bewusst nie einen neuen Notion-Chat.".to_string())
}
/// Einen BESTEHENDEN Chat des Kontos (thread=Some oder automatisch gewaehlt) als Co-Work-Chat einsetzen. Es wird NIE ein neuer Chat erstellt.
async fn add_chat(t:Tab,i:usize,thread:Option<String>)->Result<String,String>{
    let port=cdp_port(i);let sl=slots_of(t.id);
    if 1+sl.len()>=MAX_CHATS_PER_ACCOUNT{return Err(format!("Maximal {MAX_CHATS_PER_ACCOUNT} Co-Work-Chats pro Konto (getestet: 10 parallel stabil; Reserve fuer RAM)."));}
    if let Some(fr)=free_ram_mb(){if fr<MIN_FREE_RAM_MB{return Err(format!("Zu wenig freier Arbeitsspeicher ({fr} MB frei, je Chat-Tab ca. 400 MB) - erst andere Tabs schliessen."));}}
    let targets=page_targets(port).await;if targets.is_empty(){return Err("Tab laeuft nicht - erst oeffnen.".into());}
    let open:HashSet<String>=targets.iter().map(|v|url_tid(v["url"].as_str().unwrap_or(""))).filter(|s|!s.is_empty()).collect();
    let th=match thread.map(|x|norm_tid(&x)).filter(|x|!x.is_empty()){Some(x)=>x,None=>pick_existing_chat(&t,port,&sl,&open).await?};
    if th.len()!=32{return Err("Ungueltige Chat-ID.".into());}
    if sl.contains(&th){return Err("Dieser Chat arbeitet schon im Co-Work.".into());}
    if open.contains(&th){return Err("Dieser Chat ist schon offen (Haupt-Chat dieses Kontos).".into());}
    let k=sl.len()+2;let agent=slot_agent(&t,k);let origin=origin_of(&targets);
    mark_account(t.id,"slots_state",json!(format!("Bestehender Chat {k} wird geoeffnet \u{2026}")));
    let tgt=open_target(port,&format!("{origin}/chat?t={th}")).await?;
    let ws=match target_ws_by_id(port,&tgt,20).await{Ok(w)=>w,Err(e)=>{close_target(port,&tgt).await;return Err(e);}};
    let mut here=false;for _ in 0..20{if url_tid(ws_eval(&ws,"location.href").await.ok().and_then(|v|v.as_str().map(String::from)).unwrap_or_default().as_str())==th{here=true;break;}tokio::time::sleep(Duration::from_millis(500)).await;}
    if !here{close_target(port,&tgt).await;return Err("Bestehender Chat liess sich nicht oeffnen - nichts gesendet.".into());}
    let js=THREAD_OK_JS.replace("__TID__",&th);
    if ws_eval(&ws,&js).await.ok().and_then(|v|v.as_bool())!=Some(true){close_target(port,&tgt).await;return Err("Dieser Chat ist leer oder von Notion verworfen - nicht genutzt.".into());}
    let mut idle=false;for _ in 0..6{if ws_eval(&ws,SLOT_IDLE_JS).await.ok().and_then(|v|v.as_bool())==Some(true){idle=true;break;}tokio::time::sleep(Duration::from_millis(500)).await;}
    if !idle{close_target(port,&tgt).await;return Err("Dieser Chat arbeitet gerade - nicht genutzt.".into());}
    if let Err(e)=ws_send_prompt(&ws,Some(&th),&prompt_for_slot(&t,k)).await{close_target(port,&tgt).await;return Err(e);}
    let tid=th;
    {let mut all=slots_all();let v=all.entry(t.id).or_default();if !v.contains(&tid){v.push(tid.clone());}slots_save(&all);}
    let n=1+slots_of(t.id).len();mark_account(t.id,"slots_state",json!(format!("{n} Co-Work-Chats: {agent} ist bereit")));tl(&format!("tab{} SLOT+ {agent} t={tid}",t.id));
    Ok(format!("Chat {k} fuer {} laeuft: Agent {agent} ({n} Co-Work-Chats in diesem Konto).",t.role))
}
/// Letzten Zusatz-Chat aus dem Co-Work nehmen (nur den letzten, damit die Agent-Namen K2, K3 ... stabil bleiben); der Chat bleibt in Notion erhalten.
async fn remove_chat(t:Tab,i:usize)->Result<String,String>{
    let mut all=slots_all();let v=all.entry(t.id).or_default();let Some(tid)=v.pop() else {return Err("Dieses Konto hat keine Zusatz-Chats.".into())};
    let agent=slot_agent(&t,v.len()+2);slots_save(&all);crate::notion_live::set_generating(&agent,false);
    let port=cdp_port(i);if let Some(x)=page_targets(port).await.into_iter().find(|x|url_tid(x["url"].as_str().unwrap_or(""))==tid){if let Some(id)=x["id"].as_str(){close_target(port,id).await;}}
    let n=1+slots_of(t.id).len();mark_account(t.id,"slots_state",json!(format!("{n} Co-Work-Chat(s)")));tl(&format!("tab{} SLOT- t={tid}",t.id));
    Ok(format!("Zusatz-Chat aus dem Co-Work genommen ({n} Co-Work-Chat(s) uebrig; der Chat bleibt in Notion)."))
}
fn chat_action(add:bool,v:&Value,id:Option<u32>)->Result<String,String>{
    let t=find(id)?;let i=tab_index(t.id);let thread=v.get("thread").and_then(Value::as_str).map(String::from);
    if !lock(&SLOT_BUSY).insert(t.id){return Err("Fuer dieses Konto laeuft schon eine Chat-Aenderung.".into());}
    let msg=if add{format!("Zusatz-Chat fuer {} wird gestartet (dauert bis zu 1 Minute).",t.role)}else{format!("Zusatz-Chat von {} wird entfernt.",t.role)};
    tokio::spawn(async move{let id=t.id;let r=if add{add_chat(t,i,thread).await}else{remove_chat(t,i).await};if let Err(e)=&r{mark_account(id,"slots_state",json!(format!("Fehler: {e}")));}lock(&SLOT_BUSY).remove(&id);});
    Ok(msg)
}
fn apply_rate(entry:&mut Value){
    let (Some(u),Some(l))=(entry["rate_used"].as_f64(),entry["rate_limit"].as_f64()) else {return};if l<=0.0{return;}
    let p=((u/l*100.0).round() as i64).clamp(0,100);entry["rate_pct"]=json!(p);
    let cur=entry["usage"].as_i64().or_else(||entry["usage"].as_f64().map(|f|f.round() as i64));if cur.map(|c|p>c).unwrap_or(true){entry["usage"]=json!(p);}
    let st=entry["rate_status"].as_str().unwrap_or("within_limit");if st!="within_limit"||u>=l{entry["exhausted"]=json!(true);entry["usage"]=json!(100);}
}
async fn live_one(t:&Tab,i:usize){
    let port=cdp_port(i);
    let _=js_eval(port,CHAT_TAB_JS).await;let v=match js_eval(port,LIVE_JS).await{Ok(v) if v["ok"].as_bool()==Some(true)=>v,Ok(v)=>{mark_account(t.id,"chats_live_error",v["error"].clone());return;},Err(e)=>{mark_account(t.id,"chats_live_error",json!(e));return;}};
    let targets=page_targets(port).await;let open:HashSet<String>=targets.iter().map(|x|url_tid(x["url"].as_str().unwrap_or(""))).filter(|s|!s.is_empty()).collect();
    let slots=slots_of(t.id);let chats=v["chats"].as_array().cloned().unwrap_or_default();
    let running=chats.iter().filter(|c|c["running"].as_bool()==Some(true)).count();let total=chats.len();
    let list:Vec<Value>=chats.iter().take(40).map(|c|{let id=c["id"].as_str().unwrap_or("").to_string();let mut c=c.clone();c["open"]=json!(open.contains(&id));c["agent"]=slots.iter().position(|s|*s==id).map(|k|json!(slot_agent(t,k+2))).unwrap_or(Value::Null);c}).collect();
    let r=&v["rate"];let now=chrono::Local::now().format("%H:%M:%S").to_string();
    let changed=lock(&ACCOUNT).get(&t.id).map(|a|a["chats_total"].as_u64()!=Some(total as u64)).unwrap_or(true);
    if changed{mark_account(t.id,"chats_total",json!(total));mark_account(t.id,"chats_none",json!(total==0));}
    let mut a=lock(&ACCOUNT);let e=a.entry(t.id).or_insert_with(||json!({"usage":null,"models":[]}));
    e["chats_live_total"]=json!(total);e["chats_live_running"]=json!(running);e["chats_live_open"]=json!(open.len());e["chats_live"]=json!(list);e["chats_live_at"]=json!(now);e["chats_live_error"]=Value::Null;
    e["slots"]=json!(slots.len());e["slot_agents"]=json!(slots.iter().enumerate().map(|(j,_)|slot_agent(t,j+2)).collect::<Vec<_>>());
    e["rate_used"]=r["used"].clone();e["rate_limit"]=r["limit"].clone();e["rate_window"]=r["window"].clone();e["rate_reset_s"]=r["reset_s"].clone();e["rate_status"]=r["status"].clone();e["rate_type"]=r["type"].clone();e["usage_live"]=json!(now);
    apply_rate(e);
}
/// Live-Monitor: Chat-Liste, laufende Chats und 6h-Kreditfenster jedes laufenden Kontos direkt von Notion (mit menschlicher Streuung).
async fn live_monitor(){loop{let tabs=load();let running=tokio::task::spawn_blocking({let t=tabs.clone();move||running_ids(&t)}).await.unwrap_or_default();for(i,t)in tabs.iter().enumerate(){if running.contains(&t.id){let _=tokio::time::timeout(Duration::from_secs(20),live_one(t,i)).await;}else{let mut a=lock(&ACCOUNT);if let Some(e)=a.get_mut(&t.id){e["chats_live_running"]=json!(0);e["chats_live_open"]=json!(0);}}}tokio::time::sleep(human_sleep(Duration::from_secs(9),60)).await;}}
/// Zusatz-Chats: Generier-Status an die Live-Bridge, haengende Laeufe stoppen, Co-Work-Erinnerungen schicken und
/// Geschlossene Slot-Tabs werden NIE automatisch wieder geoeffnet.
async fn slot_monitor(){
    let mut stuck:BTreeMap<String,(String,std::time::Instant)>=BTreeMap::new();
    let mut last:BTreeMap<String,(String,std::time::Instant,u32)>=BTreeMap::new();
    let mut last_fill=std::time::Instant::now().checked_sub(Duration::from_secs(120)).unwrap_or_else(std::time::Instant::now);
    loop{
        tokio::time::sleep(human_sleep(Duration::from_secs(4),50)).await;
        let tabs=load();
        if last_fill.elapsed()>Duration::from_secs(15){last_fill=std::time::Instant::now();auto_fill(&tabs).await;}
        let all=slots_all();if all.values().all(|v|v.is_empty()){continue;}
        for(i,t)in tabs.iter().enumerate(){
            let sl=all.get(&t.id).cloned().unwrap_or_default();if sl.is_empty(){continue;}
            let port=cdp_port(i);let targets=page_targets(port).await;
            if targets.is_empty(){for j in 0..sl.len(){crate::notion_live::set_generating(&slot_agent(t,j+2),false);lock(&SLOT_OFF).insert(slot_agent(t,j+2));}continue;}
            for(j,tid)in sl.iter().enumerate(){
                let agent=slot_agent(t,j+2);
                let Some(ws)=targets.iter().find(|x|url_tid(x["url"].as_str().unwrap_or(""))==*tid).and_then(|x|x["webSocketDebuggerUrl"].as_str().map(String::from)) else {
                    crate::notion_live::set_generating(&agent,false);
                    lock(&SLOT_OFF).insert(agent.clone());
                    // Co-Work oeffnet NIE selbst Browser-Tabs: geschlossene Zusatz-Chat-Tabs werden nicht wieder geoeffnet (nur die im Co-Work gestarteten Tabs zaehlen).
                    continue;
                };
                // Chat offen, aber "KI fuer diesen Workspace deaktiviert": er kann nicht schreiben -> aus Co-Work nehmen, bis der Hinweis weg ist.
                let off=ws_eval(&ws,AI_OFF_JS).await.ok().map(|v|v.is_object()).unwrap_or(false);
                {let mut so=lock(&SLOT_OFF);let was=so.contains(&agent);if off&&!was{tl(&format!("{agent}: KI fuer diesen Workspace deaktiviert - aus Co-Work genommen"));}if off{so.insert(agent.clone());}else{so.remove(&agent);}}
                if off{crate::notion_live::set_generating(&agent,false);continue;}
                match ws_eval(&ws,SLOT_GEN_JS).await.ok().and_then(|v|v.as_str().map(String::from)){
                    Some(s)=>{crate::notion_live::set_generating(&agent,true);let e=stuck.entry(agent.clone()).or_insert((s.clone(),std::time::Instant::now()));if e.0!=s{*e=(s,std::time::Instant::now());}else if e.1.elapsed()>Duration::from_secs(STUCK_SECS){let _=ws_eval(&ws,SLOT_STOP_JS).await;stuck.remove(&agent);last.remove(&agent);tracing::warn!("Co-Work: Zusatz-Chat {agent} hing {STUCK_SECS}s ohne Fortschritt - gestoppt");}continue;}
                    None=>{crate::notion_live::set_generating(&agent,false);stuck.remove(&agent);}
                }
                if skipped(t.id){continue;}
                let Some((sig,text))=crate::notion_cowork::nudge_for(&agent) else {continue};
                if let Some((s,at,n))=last.get(&agent){if *s==sig&&(sig.starts_with("done:")||*n>=3||at.elapsed()<Duration::from_secs(90)){continue;}}
                if ws_eval(&ws,"document.hasFocus()").await.ok().and_then(|v|v.as_bool())==Some(true){continue;}
                if ws_eval(&ws,SLOT_IDLE_JS).await.ok().and_then(|v|v.as_bool())!=Some(true){continue;}
                tokio::time::sleep(Duration::from_secs(2)).await;
                if ws_eval(&ws,SLOT_IDLE_JS).await.ok().and_then(|v|v.as_bool())!=Some(true){continue;}
                if ws_send_prompt(&ws,Some(tid.as_str()),&text).await.is_ok(){let n=last.get(&agent).filter(|(s,_,_)|*s==sig).map(|x|x.2+1).unwrap_or(1);last.insert(agent.clone(),(sig,std::time::Instant::now(),n));}
            }
        }
    }
}
/// Jedes laufende Konto nutzt automatisch ALLE freien bestehenden Chats, solange ein Co-Work-Projekt fuer das Konto aktiv ist.
/// Chats, die gerade generieren, werden uebersprungen; es wird nie ein neuer Notion-Chat erstellt. Pro Durchgang hoechstens 1 Chat je Konto (RAM-Schonung).
async fn auto_fill(tabs:&[Tab]){
    if crate::notion_cowork::project_count()==0||crate::notion_cowork::open_task_count()==0{return;}
    let running=tokio::task::spawn_blocking({let t=tabs.to_vec();move||running_ids(&t)}).await.unwrap_or_default();
    for(i,t)in tabs.iter().enumerate(){
        if !running.contains(&t.id)||is_paused(t.id){continue;}
        if tab_ai_off(t.id){continue;}
        let sl=slots_of(t.id);if 1+sl.len()>=MAX_CHATS_PER_ACCOUNT{continue;}
        let main=welcome_url(t).map(|u|url_tid(&u)).unwrap_or_default();
        let chats=lock(&ACCOUNT).get(&t.id).and_then(|a|a["chats_live"].as_array().cloned()).unwrap_or_default();
        let free=chats.iter().any(|c|{let id=norm_tid(c["id"].as_str().unwrap_or(""));id.len()==32&&id!=main&&!sl.contains(&id)&&c["open"].as_bool()!=Some(true)&&c["running"].as_bool()!=Some(true)});
        if !free{continue;}
        if !lock(&SLOT_BUSY).insert(t.id){continue;}
        let (t2,id)=(t.clone(),t.id);
        tokio::spawn(async move{let r=add_chat(t2,i,None).await;if let Err(e)=&r{mark_account(id,"slots_state",json!(format!("Auto: {e}")));}lock(&SLOT_BUSY).remove(&id);});
    }
}
pub(crate) fn ensure_multichat(){if cfg!(test)||tokio::runtime::Handle::try_current().is_err(){return;}if !LIVE_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(live_monitor());}if !SLOTS_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(slot_monitor());}}
/// Live-Bridge fuer Zusatz-Chats: wie wake_agent, aber im Slot-Tab des Agents.
fn wake_slot(i:usize,tid:String,agent:String,text:String){
    let port=cdp_port(i);
    tokio::spawn(async move{
        for _ in 0..60{
            if let Some(ws)=slot_ws(port,&tid).await{
                let idle=ws_eval(&ws,SLOT_IDLE_JS).await.ok().and_then(|v|v.as_bool())==Some(true);let focus=ws_eval(&ws,"document.hasFocus()").await.ok().and_then(|v|v.as_bool())==Some(true);
                if idle&&!focus{tokio::time::sleep(Duration::from_secs(2)).await;if ws_eval(&ws,SLOT_IDLE_JS).await.ok().and_then(|v|v.as_bool())==Some(true){let r=ws_send_prompt(&ws,Some(tid.as_str()),&text).await;tl(&format!("LIVE-WAKE {agent}: {:?}",r));return;}}
            }
            tokio::time::sleep(Duration::from_secs(10)).await;
        }
        tl(&format!("LIVE-WAKE {agent}: Zusatz-Chat 10 min nicht frei, Nachricht kommt beim naechsten Tool-Aufruf"));
    });
}
#[cfg(test)]
mod multichat_tests{
    use super::*;
    #[test] fn notion_multichat_tid(){assert_eq!(url_tid("https://app.notion.com/chat?t=3f215fab178980a38b3800a96682c233&wfv=chat"),"3f215fab178980a38b3800a96682c233");assert_eq!(url_tid("https://app.notion.com/p/X-1?t=AB-cd"),"abcd");assert_eq!(url_tid("https://app.notion.com/chat"),"");assert_eq!(norm_tid("3f215fab-1789-80a3-8b38-00a96682c233"),"3f215fab178980a38b3800a96682c233");}
    #[test] fn notion_multichat_never_new_chat(){for u in ["https://www.notion.so/chat","https://www.notion.so/ai","https://app.notion.com/chat?wfv=chat","https://www.notion.so/"]{assert!(url_tid(u).is_empty(),"{u}");}let rt=tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();assert!(rt.block_on(open_target(1,"https://www.notion.so/chat")).unwrap_err().contains("nie einen neuen"));}
    #[test] fn notion_multichat_origin(){assert_eq!(origin_of(&[json!({"url":"https://app.notion.com/chat?t=1"})]),"https://app.notion.com");assert_eq!(origin_of(&[]),"https://www.notion.so");}
    #[test] fn notion_multichat_rate(){let mut e=json!({"usage":0,"rate_used":42.4,"rate_limit":100.0,"rate_status":"within_limit"});apply_rate(&mut e);assert_eq!(e["usage"],json!(42));assert_eq!(e["rate_pct"],json!(42));assert!(e.get("exhausted").is_none()||e["exhausted"]!=json!(true));let mut f=json!({"usage":10,"rate_used":100.0,"rate_limit":100.0,"rate_status":"over_limit"});apply_rate(&mut f);assert_eq!(f["exhausted"],json!(true));assert_eq!(f["usage"],json!(100));let mut g=json!({"usage":70,"rate_used":5.0,"rate_limit":100.0});apply_rate(&mut g);assert_eq!(g["usage"],json!(70));}
    #[test] fn notion_multichat_slot_agent(){let t=Tab{id:2,label:"Tab 2".into(),email:"a@b.c".into(),role:"Tab 1".into(),url:String::new(),autostart:true};assert_eq!(slot_agent(&t,2),"AdiCode-Tab1-K2");let m=Tab{role:"Main 1".into(),..t.clone()};assert_eq!(slot_agent(&m,3),"AdiCode-Main1-K3");}
}
