  function emptyEl() {
    var e = document.createElement("div"); e.className = "ac-empty";
    e.innerHTML = '<div class="ac-logo">A</div><h2>Wobei kann ich helfen?</h2><p>Dein Notion AI direkt in AdiCode \u2013 mit Fotos, Videos, Sprache und Co-Work. Die KI kann \u00fcber AdiCode deinen PC, den Browser und Roblox Studio steuern.</p><div class="ac-sugg">' +
      [["Co-Work-Projekt starten", "Mehrere KIs arbeiten gemeinsam", "Starte ein Co-Work-Projekt: "], ["Was l\u00e4uft gerade?", "AdiCode-Status abfragen", "Rufe adicode_status auf und fasse kurz zusammen, was verbunden ist."], ["Bild erkl\u00e4ren", "Foto per + oder Strg+V anh\u00e4ngen", "Was ist auf diesem Bild zu sehen?"], ["PC-Aufgabe", "z. B. Dateien aufr\u00e4umen", "Zeig mir die 10 gr\u00f6\u00dften Dateien in meinem Downloads-Ordner."]].map(function (s) { return '<button data-p="' + esc(s[2]) + '"><b>' + esc(s[0]) + "</b><span>" + esc(s[1]) + "</span></button>"; }).join("") + "</div>";
    e.querySelectorAll("button").forEach(function (b) { b.onclick = function () { var ta = $("acInput"); ta.value = b.getAttribute("data-p"); autosize(); ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); updateSend(); }; });
    return e;
  }
  function nearBottom() { var s = $("acScroll"); return s.scrollHeight - s.scrollTop - s.clientHeight < 140; }
  function toBottom() { var s = $("acScroll"); s.scrollTop = s.scrollHeight; }
  $("acScroll").addEventListener("scroll", function () { S.stick = nearBottom(); });
  function render(msgs) {
    var box = $("acMsgs"); var near = S.stick || nearBottom();
    var list = msgs.slice();
    if (S.pending) list.push({ role: "user", text: S.pending.text, files: S.pending.files, pending: true, id: "pending" });
    var tail = list[list.length - 1];
    if (S.pending || (S.gen && (!tail || tail.role === "user"))) list.push({ role: "assistant", typing: true, html: "", steps: [], id: "typing" });
    if (!list.length) { if (!box.querySelector(".ac-empty")) { box.innerHTML = ""; box.appendChild(emptyEl()); } S.sigs = []; return; }
    var em = box.querySelector(".ac-empty"); if (em) { em.remove(); S.sigs = []; box.innerHTML = ""; }
    for (var i = 0; i < list.length; i++) {
      var m = list[i]; m.last = i === list.length - 1;
      var sig = JSON.stringify(m) + (m.last && S.gen ? "g" + ((typeof Live !== "undefined" && Live) ? Live.last : 0) : "") + (S.open[m.id] === undefined ? "u" : (S.open[m.id] ? "o" : "c"));
      if (S.sigs[i] === sig && box.children[i]) continue;
      var el = msgEl(m);
      if (box.children[i]) { el.classList.add("ac-upd"); box.replaceChild(el, box.children[i]); } else box.appendChild(el);
      S.sigs[i] = sig;
    }
    while (box.children.length > list.length) box.removeChild(box.lastChild);
    S.sigs.length = list.length;
    if (near) toBottom();
  }

  /* ---------- Composer ---------- */
  var ta = $("acInput");
  function autosize() { ta.style.height = "auto"; ta.style.height = Math.min(240, ta.scrollHeight) + "px"; }
  function uploading() { return S.att.some(function (a) { return a.status === "up"; }); }
  function updateSend() {
    var b = $("acSend");
    if (S.gen) { b.innerHTML = IC.stop; b.title = "Antwort stoppen"; b.disabled = false; return; }
    b.innerHTML = IC.send; b.title = "Senden (Enter)";
    b.disabled = !!S.pending || uploading() || (!ta.value.trim() && !S.att.some(function (a) { return a.status === "ok"; }));
  }
  ta.addEventListener("input", function () { autosize(); updateSend(); });
  ta.addEventListener("keydown", function (e) {
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); if (!S.gen) send(); }
  });
  ta.addEventListener("paste", function (e) {
    var files = e.clipboardData && e.clipboardData.files;
    if (files && files.length) { e.preventDefault(); addFiles(files); }
  });
  $("acSend").onclick = function () { if (S.gen) stopGen(); else send(); };
  function stopGen() { ctl("stop").then(poll).catch(function (e) { toast(e.message); }); }

  function send(textOverride) {
    var text = (textOverride != null ? textOverride : ta.value).trim();
    if (uploading()) { toast("Dateien werden noch hochgeladen \u2026", true); return Promise.resolve(false); }
    var ready = S.att.filter(function (a) { return a.status === "ok"; });
    if (!text && !ready.length) return Promise.resolve(false);
    if (S.pending) return Promise.resolve(false);
    var users = S.msgs.filter(function (m) { return m.role === "user"; }).length;
    ready.forEach(function (a) { S.local[a.name] = { url: a.url, type: a.type }; });
    var known = {}; S.msgs.forEach(function (m) { if (m.role === "user") known[(m.id || "") + "|" + (m.text || "")] = 1; });
    S.genT = Date.now() / 1000 + Live.off - 3; S.pending = { text: text, files: ready.map(function (a) { return a.name; }), t: Date.now(), users: users, inflight: true, known: known };
    var keep = { text: ta.value, att: S.att.slice() };
    if (textOverride == null) { ta.value = ""; autosize(); }
    S.att = S.att.filter(function (a) { return a.status !== "ok"; }); renderAtt();
    S.stick = true; render(S.msgs); updateSend(); schedule();
    if (!S.running) setPill("busy", "Main startet \u2026");
    return api("/api/notion/chat/send", { text: text, files: ready.map(function (a) { return a.path; }) }).then(function (r) {
      if (S.pending) { S.pending.inflight = false; S.pending.doneAt = Date.now(); }
      if (r.warning) toast(r.warning);
      poll(); return true;
    }).catch(function (e) {
      S.pending = null; render(S.msgs); updateSend();
      if (textOverride == null && !ta.value) { ta.value = keep.text; autosize(); }
      if (!S.att.length) { S.att = keep.att; renderAtt(); }
      toast(e.message); updateSend(); return false;
    });
  }

  /* ---------- Attachments ---------- */
  var MAX = 512 * 1024 * 1024, seq = 0;
  $("acPlus").onclick = function () { $("acFile").click(); };
  $("acFile").onchange = function () { addFiles(this.files); this.value = ""; };
  function addFiles(list) {
    Array.prototype.forEach.call(list, function (file) {
      if (file.size > MAX) { toast(file.name + " ist zu gro\u00df (max. 512 MB)."); return; }
      var name = file.name || ("Einfuegen-" + (++seq) + "." + ((file.type.split("/")[1] || "bin").replace("jpeg", "jpg")));
      var a = { id: ++seq, name: name, type: file.type || "", size: file.size, url: URL.createObjectURL(file), status: "up", path: "" };
      S.att.push(a); renderAtt(); updateSend();
      api("/api/notion/chat/upload?name=" + encodeURIComponent(name), undefined, file).then(function (r) { a.path = r.path; a.name = r.name; a.status = "ok"; })
        .catch(function (e) { a.status = "err"; toast(name + ": " + e.message); })
        .then(function () { renderAtt(); updateSend(); });
    });
  }
  function renderAtt() {
    var box = $("acAtt"); box.innerHTML = ""; box.classList.toggle("has", S.att.length > 0);
    S.att.forEach(function (a) {
      var w = document.createElement("div"); w.className = "ac-a" + (a.status === "err" ? " err" : ""); w.title = a.name + " \u00b7 " + Math.max(1, Math.round(a.size / 1024)) + " KB";
      w.appendChild(fileView(a.name, a));
      if (a.status === "up") { var u = document.createElement("div"); u.className = "ac-up"; w.appendChild(u); }
      var x = document.createElement("button"); x.className = "ac-rm"; x.textContent = "\u00d7"; x.title = "Entfernen";
      x.onclick = function () { S.att = S.att.filter(function (o) { return o !== a; }); renderAtt(); updateSend(); };
      w.appendChild(x); box.appendChild(w);
    });
  }
  var main = $("acMain"), dragN = 0;
  main.addEventListener("dragenter", function (e) { if (e.dataTransfer && Array.prototype.indexOf.call(e.dataTransfer.types, "Files") >= 0) { dragN++; $("acDrop").classList.add("show"); e.preventDefault(); } });
  main.addEventListener("dragover", function (e) { if ($("acDrop").classList.contains("show")) e.preventDefault(); });
  main.addEventListener("dragleave", function () { dragN = Math.max(0, dragN - 1); if (!dragN) $("acDrop").classList.remove("show"); });
  main.addEventListener("drop", function (e) { e.preventDefault(); dragN = 0; $("acDrop").classList.remove("show"); if (e.dataTransfer && e.dataTransfer.files.length) addFiles(e.dataTransfer.files); });

  /* ---------- Microphone level (optional) ---------- */
  var Mic = { stream: null, ctx: null, an: null, data: null, level: 0, failed: false,
    start: function () {
      if (Mic.an || Mic.failed || !navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return Promise.resolve(!!Mic.an);
      return navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: true, noiseSuppression: true } }).then(function (s) {
        Mic.stream = s; Mic.ctx = new (window.AudioContext || window.webkitAudioContext)(); var src = Mic.ctx.createMediaStreamSource(s);
        Mic.an = Mic.ctx.createAnalyser(); Mic.an.fftSize = 1024; Mic.data = new Uint8Array(Mic.an.fftSize); src.connect(Mic.an); return true;
      }).catch(function () { Mic.failed = true; return false; });
    },
    read: function () { if (!Mic.an) return 0; Mic.an.getByteTimeDomainData(Mic.data); var s = 0; for (var i = 0; i < Mic.data.length; i++) { var v = (Mic.data[i] - 128) / 128; s += v * v; } Mic.level = Math.sqrt(s / Mic.data.length); return Mic.level; },
    stop: function () { try { if (Mic.stream) Mic.stream.getTracks().forEach(function (t) { t.stop(); }); if (Mic.ctx) Mic.ctx.close(); } catch (e) {} Mic.stream = Mic.ctx = Mic.an = null; }
  };

  /* ---------- Dictation (Notion speech-to-text) ---------- */
  var Rec = { on: false, t0: 0, raf: 0, bars: [] };
  function drawWave() {
    var c = $("acWave"); var w = c.clientWidth, h = c.clientHeight; if (c.width !== w) c.width = w; if (c.height !== h) c.height = h;
    var g = c.getContext("2d"); g.clearRect(0, 0, w, h);
    var lv = Mic.an ? Math.min(1, Mic.read() * 6) : (0.25 + 0.2 * Math.sin(Date.now() / 180));
    Rec.bars.push(lv); var n = Math.floor(w / 5); while (Rec.bars.length > n) Rec.bars.shift();
    g.fillStyle = "#a3aac0";
    for (var i = 0; i < Rec.bars.length; i++) { var bh = Math.max(2, Rec.bars[i] * h * 0.9); g.fillRect(w - (Rec.bars.length - i) * 5, (h - bh) / 2, 3, bh); }
    var s = Math.floor((Date.now() - Rec.t0) / 1000); $("acRecTime").textContent = Math.floor(s / 60) + ":" + ("0" + (s % 60)).slice(-2);
    if (Rec.on) Rec.raf = requestAnimationFrame(drawWave);
  }
  function recUi(on) { Rec.on = on; $("acBox").classList.toggle("recording", on); if (on) { Rec.t0 = Date.now(); Rec.bars = []; cancelAnimationFrame(Rec.raf); drawWave(); } else { cancelAnimationFrame(Rec.raf); if (!Voice.on) Mic.stop(); } }
  $("acMic").onclick = function () {
    var b = this; b.disabled = true; setPill("busy", "Mikrofon startet \u2026");
    Mic.start();
    ctl("dictate", { action: "start" }).then(function () { recUi(true); }).catch(function (e) { toast(e.message); }).then(function () { b.disabled = false; poll(); });
  };
  $("acRecCancel").onclick = function () { recUi(false); ctl("dictate", { action: "cancel" }).catch(function () {}); };
  function finishRec(andSend) {
    recUi(false); var prev = ta.placeholder; ta.placeholder = "Transkribiere \u2026"; ta.disabled = true;
    return ctl("dictate", { action: "stop" }).then(function (r) {
      var t = (r.text || "").trim();
      if (!t) { toast("Es wurde keine Sprache erkannt.", true); return; }
      ta.value = ta.value ? (ta.value.replace(/\s+$/, "") + " " + t) : t; autosize(); updateSend();
      if (andSend) { ta.disabled = false; send(); }
    }).catch(function (e) { toast(e.message); }).then(function () { ta.disabled = false; ta.placeholder = prev; ta.focus(); });
  }
  $("acRecOk").onclick = function () { finishRec(false); };
  $("acRecSend").onclick = function () { finishRec(true); };

  /* ---------- Text to speech ---------- */
  var Tts = { speaking: false, cb: null,
    voice: function () { try { var v = speechSynthesis.getVoices(); return v.filter(function (x) { return /^de/i.test(x.lang) && /natural|online|neural/i.test(x.name); })[0] || v.filter(function (x) { return /^de/i.test(x.lang); })[0] || v[0] || null; } catch (e) { return null; } },
    speak: function (text, cb) {
      Tts.stop(); Tts.cb = cb || null;
      if (!window.speechSynthesis || !text) { Tts.end(); return; }
      var parts = text.replace(/\n+/g, ". ").match(/[^.!?]+[.!?]*\s*/g) || [text]; var chunks = [], cur = "";
      parts.forEach(function (p) { if ((cur + p).length > 220) { if (cur) chunks.push(cur); cur = p; } else cur += p; }); if (cur.trim()) chunks.push(cur);
      var voice = Tts.voice(), i = 0; Tts.speaking = true;
      (function next() { if (!Tts.speaking) return; if (i >= chunks.length) { Tts.end(); return; } var u = new SpeechSynthesisUtterance(chunks[i++]); if (voice) { u.voice = voice; u.lang = voice.lang; } else u.lang = "de-DE"; u.rate = 1.05; u.onend = next; u.onerror = next; speechSynthesis.speak(u); })();
    },
    end: function () { var cb = Tts.cb; Tts.cb = null; Tts.speaking = false; if (cb) cb(); },
    stop: function () { Tts.speaking = false; Tts.cb = null; try { speechSynthesis.cancel(); } catch (e) {} }
  };
  try { speechSynthesis.getVoices(); speechSynthesis.onvoiceschanged = function () {}; } catch (e) {}

  /* ---------- Voice mode (talk with the AI) ---------- */
  var Voice = { on: false, phase: "idle", paused: false, heard: false, quiet: 0, raf: 0, base: 0, t0: 0,
    set: function (phase, label, text) { Voice.phase = phase; $("acVui").setAttribute("data-phase", phase); $("acVState").textContent = label; if (text != null) $("acVText").textContent = text; },
    open: function () { if (Voice.on) return; Voice.on = true; Voice.paused = false; $("acVui").classList.add("show"); Mic.start().then(function () { Voice.listen(); }); schedule(); },
    close: function () {
      if (!Voice.on) return; var wasListening = Voice.phase === "listen"; Voice.on = false; cancelAnimationFrame(Voice.raf); Tts.stop(); Mic.stop();
      $("acVui").classList.remove("show"); $("acOrb").style.transform = ""; if (wasListening) ctl("dictate", { action: "cancel" }).catch(function () {});
    },
    listen: function () {
      if (!Voice.on || Voice.paused) return;
      Voice.set("start", "Mikrofon startet \u2026", "");
      ctl("dictate", { action: "start" }).then(function () {
        if (!Voice.on) { ctl("dictate", { action: "cancel" }).catch(function () {}); return; }
        Voice.heard = false; Voice.quiet = 0; Voice.t0 = Date.now();
        Voice.set("listen", Mic.an ? "H\u00f6rt zu \u2026" : "H\u00f6rt zu \u2026 tippe auf den Kreis, wenn du fertig bist");
        Voice.loop();
      }).catch(function (e) { Voice.set("idle", "Mikrofon-Fehler", e.message); });
    },
    loop: function () {
      cancelAnimationFrame(Voice.raf);
      var step = function () {
        if (!Voice.on || Voice.phase !== "listen") return;
        var lv = Mic.read(); $("acOrb").style.transform = "scale(" + (1 + Math.min(0.35, lv * 3)).toFixed(3) + ")";
        if (Mic.an) {
          if (lv > 0.035) { Voice.heard = true; Voice.quiet = Date.now(); }
          if (Voice.heard && Date.now() - Voice.quiet > 1500) { Voice.finish(); return; }
          if (!Voice.heard && Date.now() - Voice.t0 > 45000) { Voice.set("idle", "Pausiert \u2013 tippe auf den Kreis", ""); ctl("dictate", { action: "cancel" }).catch(function () {}); return; }
        }
        Voice.raf = requestAnimationFrame(step);
      };
      step();
    },
    finish: function () {
      cancelAnimationFrame(Voice.raf); $("acOrb").style.transform = ""; Voice.set("transcribe", "Verstehe \u2026");
      ctl("dictate", { action: "stop" }).then(function (r) {
        var t = (r.text || "").trim(); if (!Voice.on) return;
        if (!t) { Voice.listen(); return; }
        $("acVText").textContent = "\u201e" + t + "\u201c";
        Voice.base = S.msgs.filter(function (m) { return m.role === "user"; }).length;
        Voice.set("think", "Denkt nach \u2026");
        send(t).then(function (ok) { if (!ok && Voice.on) Voice.set("idle", "Senden fehlgeschlagen \u2013 tippe zum Wiederholen"); });
      }).catch(function (e) { Voice.set("idle", "Fehler", e.message); });
    },
    tick: function (msgs) {
      if (Voice.phase !== "think" || S.gen || S.pending) return;
      var users = 0, last = null; msgs.forEach(function (m) { if (m.role === "user") users++; }); last = msgs[msgs.length - 1];
      if (users > Voice.base && last && last.role === "assistant" && last.done) {
        var text = htmlText(last.html || ""); if (!text) { Voice.listen(); return; }
        Voice.set("speak", "Spricht \u2026 (tippen zum Unterbrechen)", text.slice(0, 400));
        Tts.speak(text, function () { if (Voice.on && Voice.phase === "speak") Voice.listen(); });
      }
    }
  };
  $("acVoice").onclick = function () { Voice.open(); };
  $("acVEnd").onclick = function () { Voice.close(); poll(); };
  $("acOrb").onclick = function () {
    if (Voice.phase === "listen") Voice.finish();
    else if (Voice.phase === "speak") { Tts.stop(); Voice.listen(); }
    else if (Voice.phase === "think") { stopGen(); }
    else if (Voice.phase === "idle") { Voice.paused = false; Voice.listen(); }
  };
  $("acVMute").onclick = function () {
    Voice.paused = !Voice.paused;
    if (Voice.paused) { cancelAnimationFrame(Voice.raf); Tts.stop(); if (Voice.phase === "listen") ctl("dictate", { action: "cancel" }).catch(function () {}); Voice.set("idle", "Pausiert"); }
    else Voice.listen();
  };
  document.addEventListener("keydown", function (e) {
    if (!active()) return;
    if (e.key === "Escape" && Voice.on) { Voice.close(); }
    if (e.key.toLowerCase() === "o" && e.ctrlKey && e.shiftKey) { e.preventDefault(); newChat(); }
  });

  /* ---------- Header, history, Co-Work ---------- */
  function newChat() {
    if (S.gen) { toast("Bitte erst warten oder stoppen.", true); return; }
    S.pending = null; S.msgs = []; S.sigs = []; $("acMsgs").innerHTML = ""; render([]); $("acTitle").textContent = "Neuer Chat";
    setPill("busy", "Neuer Chat \u2026");
    ctl("new").then(function (r) { setBase((r && r.base) || ""); S.histDirty = true; }).then(poll).catch(function (e) { toast(e.message); poll(); }); ta.focus();
  }
  $("acNew").onclick = newChat;
  $("acTrim").onclick = function () { ctl("trim", { keep: 12 }).then(function (r) { toast("Ältere Nachrichten ausgeblendet: " + (r.hidden || 0), true); }).catch(function (e) { toast(e.message); }); };
  $("acCarry").onclick = function () {
    if (S.gen) { toast("Bitte erst warten oder stoppen.", true); return; }
    var NL = String.fromCharCode(10); var last = (S.msgs || []).slice(-8).map(function (m) { return (m.role === "user" ? "Nutzer: " : "KI: ") + String(m.text || "").replace(/\s+/g, " ").slice(0, 300); }).join(NL);
    var text = "Kontext aus dem vorherigen Chat (Kurzfassung):" + NL + last + NL + NL + "Lies zuerst project_memory_open und die HANDOUT.md des Projekts und mache dort weiter. Arbeite sparsam mit Tokens.";
    newChat(); setTimeout(function () { send(text); }, 6000);
  };
  $("acWin").onclick = function () { var show = S.hidden || !S.running; ctl("window", { show: show }).then(function (r) { S.hidden = r.hidden; poll(); }).catch(function (e) { toast(e.message); }); };
  $("acCowork").onclick = function () {
    var b = this; b.disabled = true;
    $("acMsgs").innerHTML = ""; S.pending = null; S.sigs = []; render([]); $("acTitle").textContent = "Co-Work"; setPill("busy", "Co-Work startet \u2026");
    ctl("new").then(function (r) { setBase((r && r.base) || ""); S.histDirty = true; }).catch(function () {}).then(function () { return api("/api/notion/action", { action: "cowork_start_all", value: null }); }).then(function (r) { toast(r.message || "Co-Work startet \u2026", true, 8000); })
      .catch(function (e) { toast(e.message + " \u2013 Konten auf der Seite Co-Work eintragen."); }).then(function () { b.disabled = false; poll(); });
  };
  function curBase() { if (S.base == null) { try { S.base = localStorage.getItem("acBase") || ""; } catch (e) { S.base = ""; } } return S.base; }
  function setBase(b) { S.base = b || ""; try { localStorage.setItem("acBase", S.base); } catch (e) {} }
  function tid(u) { var m = /[?&]t=([0-9a-f]+)/i.exec(u || ""); return m ? m[1] : ""; }
  function sameChat(a, b) { var m = /#b=(.*)$/.exec(a || ""); return !!tid(a) && tid(a) === tid(b) && (m ? m[1] : "") === curBase(); }
  function loadHist() { S.histAt = Date.now(); api("/api/notion/chat/history").then(function (r) { S.hist = r.items || []; renderHist(); }).catch(function () {}); }
  function renderHist() {
    var box = $("acHist"); box.innerHTML = "";
    if (!S.hist.length) { box.innerHTML = '<div class="ac-hempty">Noch keine Chats.</div>'; return; }
    S.hist.forEach(function (h) {
      var it = document.createElement("div"); it.className = "ac-hitem" + (sameChat(h.url, S.url) ? " on" : ""); it.title = h.title + (h.updated ? " \u00b7 " + h.updated : "");
      it.innerHTML = "<span>" + esc(h.title) + '</span><button class="ac-x" title="Aus Verlauf entfernen">\u00d7</button>';
      it.onclick = function (e) {
        if (e.target.classList.contains("ac-x")) { e.stopPropagation(); ctl("forget", { url: h.url }).then(loadHist); return; }
        if (S.gen) { toast("Bitte erst warten oder stoppen.", true); return; }
        S.pending = null; S.sigs = []; $("acMsgs").innerHTML = ""; $("acTitle").textContent = h.title; setPill("busy", "\u00d6ffne Chat \u2026");
        setBase((/#b=(.*)$/.exec(h.url) || [0, ""])[1]); ctl("open", { url: h.url }).then(poll).catch(function (er) { toast(er.message); poll(); });
      };
      box.appendChild(it);
    });
  }
  function markHist() { var items = $("acHist").children; for (var i = 0; i < items.length && i < S.hist.length; i++) items[i].classList.toggle("on", sameChat(S.hist[i].url, S.url)); }

  render([]);
  /* ---------- Live: was die KI gerade macht (auf Deutsch) ---------- */
  var Live = { last: 0, items: [], t: null, open: false, off: 0, locks: [], filter: "" };
  function liveAgo(ts) { var s = Math.max(0, Math.round(Date.now() / 1000 + Live.off - ts)); return s < 60 ? "vor " + s + " s" : "vor " + Math.round(s / 60) + " min"; }
  function liveRender() {
    var box = $("acLive"); if (!box) return;
    var now = Date.now() / 1000 + Live.off, items = Live.items.filter(function (e) { return now - e.ts < 900; });
    if (!items.length) { box.classList.remove("on"); box.innerHTML = ""; return; }
    var cur = items[items.length - 1], run = S.gen && now - cur.ts < 180;
    var h = '<div class="ac-live-head"><span class="ac-live-dot' + (run ? " run" : "") + '"></span><b>' + (run ? "Gerade:" : "Zuletzt:") + '</b><span class="ac-live-txt">' + esc(cur.text) + '</span><span class="ac-live-tool">' + esc(cur.tab + " \u00b7 " + cur.tool + " \u00b7 " + liveAgo(cur.ts)) + ' ' + (Live.open ? "\u25B4" : "\u25BE") + '</span></div>';
    if (Live.open) {
      var seen = []; items.forEach(function (e) { if (seen.indexOf(e.tab) < 0) seen.push(e.tab); });
      if (seen.length > 1) h += '<div class="ac-live-chips">' + seen.map(function (n) { return '<span class="ac-live-chip' + (Live.filter === n ? " on" : "") + '" data-tab="' + esc(n) + '">' + esc(n) + '</span>'; }).join("") + '</div>';
      h += '<div class="ac-live-list">' + items.filter(function (e) { return !Live.filter || e.tab === Live.filter; }).slice(-15).reverse().map(function (e) {
        return '<div class="ac-live-row' + (/^Blockiert/.test(e.text) ? " blk" : "") + '"><span class="t">' + esc(liveAgo(e.ts)) + '</span><span class="x">' + esc(e.text) + '</span><span class="g">' + esc(e.tab + " \u00b7 " + e.tool) + '</span></div>';
      }).join("") + '</div>';
    }
    if (Live.locks && Live.locks.length) h += '<div class="ac-live-locks">' + Live.locks.map(function (k) { return '<span class="ac-live-lock" title="' + esc(k.path) + '">\uD83D\uDD12 ' + esc(k.file) + ' \u00b7 ' + esc(k.owner) + '</span>'; }).join("") + '</div>';
    box.innerHTML = h; box.classList.add("on");
  }
  var Tabs = { list: [], t: null };
  function tabsPoll() {
    clearTimeout(Tabs.t);
    if (!active()) { Tabs.t = setTimeout(tabsPoll, 4000); return; }
    api("/api/notion/cowork-tabs").then(function (r) { Tabs.list = (r && r.tabs) || []; tabsRender(); }).catch(function () {}).then(function () { Tabs.t = setTimeout(tabsPoll, 4000); });
  }
  function tabsRender() {
    var box = $("acTabs"); if (!box) return;
    var list = Tabs.list.filter(function (t) { return t.running || t.paused; });
    if (!list.length) { box.classList.remove("on"); box.innerHTML = ""; return; }
    var hasLive = typeof Live !== "undefined" && Live, now = Date.now() / 1000 + (hasLive ? Live.off : 0);
    box.innerHTML = '<span class="ac-tabs-cap">Aktive Tabs</span>' + list.map(function (t) {
      var keys = [t.role, t.label].filter(Boolean).map(function (s) { return String(s).toLowerCase(); }), ev = null;
      if (hasLive) for (var i = Live.items.length - 1; i >= 0; i--) { var e = Live.items[i], tb = String(e.tab || "").toLowerCase(); if (keys.some(function (k) { return tb === k || tb.indexOf(k) >= 0; })) { ev = e; break; } }
      var busy = !!ev && now - ev.ts < 90, talk = !!ev && /^cowork_/.test(ev.tool || "") && now - ev.ts < 300;
      var st = t.paused ? "paused" : (busy ? "busy" : "idle");
      var sub = t.paused ? "pausiert" : (busy ? String(ev.text || acTool(ev.tool)).replace(/^(Co-Work: *)+/i, "") : (talk ? String(ev.text || acTool(ev.tool)).replace(/^(Co-Work: *)+/i, "") : "bereit"));
      return '<div class="ac-tab ' + st + '" title="' + esc((t.label || "") + " \u00b7 " + (t.email || "") + (ev ? " \u00b7 " + ev.tool + " \u00b7 " + liveAgo(ev.ts) : "")) + '"><span class="ac-tab-dot"></span><b>' + esc(t.role || t.label) + '</b><span class="ac-tab-sub">' + esc(sub) + "</span>" + (talk ? '<span class="ac-tab-cw" title="spricht \u00fcber Co-Work">\u21c4</span>' : "") + "</div>";
    }).join("");
    box.classList.add("on");
  }
  setTimeout(tabsPoll, 400);  function livePoll() {
    clearTimeout(Live.t);
    if (!active()) { Live.t = setTimeout(livePoll, S.gen ? 700 : 2000); return; }
    api("/api/notion/live?since=" + Live.last).then(function (r) {
      if (!r) return;
      if (typeof r.now === "number") Live.off = r.now - Date.now() / 1000;
      if (typeof r.last === "number" && r.last < Live.last) { Live.last = 0; Live.items = []; return; }
      (r.items || []).forEach(function (e) { if (e.id > Live.last) Live.items.push(e); });
      if (Live.items.length > 60) Live.items = Live.items.slice(-60);
      Live.locks = Array.isArray(r.lock_list) ? r.lock_list : [];
      if (typeof r.last === "number") Live.last = r.last;
    }).catch(function () {}).then(function () { liveRender(); if (S.gen && S.msgs) render(S.msgs); Live.t = setTimeout(livePoll, S.gen ? 700 : 2000); });
  }
  $("acLive").addEventListener("click", function (ev) { var c = ev.target && ev.target.closest ? ev.target.closest("[data-tab]") : null; if (c) { var v = c.getAttribute("data-tab"); Live.filter = Live.filter === v ? "" : v; liveRender(); return; } Live.open = !Live.open; liveRender(); });
  livePoll();
  if (active()) { poll(); loadHist(); }
})();
</script>
<style id="ac-readable">
#page-chat .ac-md,#page-chat .ac-md :where(p,li,span,div,em,i,u,td,th,blockquote){color:#eef1f7!important;opacity:1!important}
#page-chat .ac-md{font-size:15.5px!important;line-height:1.72!important}
#page-chat .ac-md :where(b,strong){color:#ffffff!important;font-weight:800!important}
#page-chat .ac-md :where(h1,h2,h3,h4){color:#ffffff!important;font-weight:800!important}
#page-chat .ac-md :not(pre)>code{background:#2b303d!important;border:1px solid #4a5163!important;color:#ffc27a!important;font-weight:600!important;border-radius:5px!important;padding:.1em .4em!important}
#page-chat .ac-md pre{background:#0e1118!important;border:1px solid #3a4152!important}
#page-chat .ac-md pre code{color:#f1f3f8!important}
#page-chat .ac-md a{color:#6cc4ff!important;text-decoration:underline!important;text-decoration-color:rgba(108,196,255,.55)!important}
#page-chat .ac-md a:hover{color:#a8dcff!important}
#page-chat .ac-md li::marker{color:#6cc4ff!important;font-weight:800}
#page-chat .ac-md blockquote{border-left:3px solid #6cc4ff!important;background:rgba(108,196,255,.07)!important}
#page-chat .ac-md h2{border-bottom-color:#3a4152!important}
#page-chat .ac-s2h,#page-chat .ac-s2r,#page-chat .ac-s2app,#page-chat .ac-s2plain{color:#c9d0de!important}
#page-chat .ac-s2r b{color:#ffffff!important}
#page-chat .ac-s2raw{color:#8d96aa!important}
#page-chat .ac-tab-sub{color:#c3cad8!important}
</style><style id="ac-clean">
#page-chat #acTrim,#page-chat #acCarry{display:inline-flex!important;width:calc(50% - 3px)!important;justify-content:center;padding:7px 6px!important;font-size:12px!important;font-weight:500!important;background:transparent!important;border:1px solid #2c3346!important;color:#aeb6c8!important;margin:0!important;box-shadow:none!important}
#page-chat #acTrim{margin-right:4px!important}
#page-chat #acTrim:hover,#page-chat #acCarry:hover{background:#1c2232!important;color:#fff!important}
#page-chat .ac-sidehint{display:none!important}
#page-chat .ac-cap{margin-top:14px!important;font-size:10.5px!important;letter-spacing:.08em;color:#7e879c!important}
#page-chat .ac-hitem{border-radius:8px!important;padding:7px 10px!important;font-size:13px!important;color:#b9c1d2!important}
#page-chat .ac-hitem:hover{background:#1a2030!important;color:#fff!important}
#page-chat .ac-head{padding:10px 20px!important;min-height:0!important;gap:10px;border-bottom:1px solid #1f2535!important}
#page-chat .ac-title{font-size:14px!important;font-weight:600!important;color:#e9ecf3!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;flex:1}
#page-chat .ac-hbtn{padding:5px 10px!important;font-size:12px!important;background:transparent!important;border:1px solid #2c3346!important;color:#aeb6c8!important;border-radius:8px!important}
#page-chat .ac-hbtn:hover{color:#fff!important;background:#1c2232!important}
#page-chat .ac-cw,#page-chat .ac-live{display:none!important}
#page-chat .ac-tabs{padding:6px 20px!important;gap:6px!important;background:transparent!important;border-bottom:1px solid #1f2535!important}
#page-chat .ac-tabs-cap{display:none!important}
#page-chat .ac-tab{padding:3px 10px!important;font-size:12px!important;background:#161b28!important;border-color:#262d40!important}
#page-chat .ac-tab-sub{max-width:220px}
#page-chat .ac-tab.idle .ac-tab-sub{display:none}
#page-chat .ac-msgs{max-width:780px!important;margin:0 auto!important;padding:24px 24px 12px!important}
#page-chat .ac-msg{margin:0 0 22px!important}
#page-chat .ac-tools{opacity:0;transition:opacity .15s}
#page-chat .ac-msg:hover .ac-tools,#page-chat .ac-msg.last .ac-tools{opacity:1}
#page-chat .ac-bubble{border-radius:16px 16px 4px 16px!important;padding:9px 14px!important;box-shadow:none!important}
#page-chat .ac-foot{padding:8px 24px 12px!important}
#page-chat .ac-box{max-width:780px!important;margin:0 auto!important;border-radius:16px!important;background:#141927!important;border:1px solid #2a3145!important;box-shadow:0 8px 30px rgba(0,0,0,.35)!important}
#page-chat .ac-box:focus-within{border-color:#4a5a8a!important}
#page-chat .ac-note{text-align:center;font-size:11px!important;color:#6f788c!important;margin-top:6px!important}
#page-chat .ac-scroll::-webkit-scrollbar{width:8px}
#page-chat .ac-scroll::-webkit-scrollbar-thumb{background:#2a3145;border-radius:8px}
#page-chat .ac-scroll::-webkit-scrollbar-track{background:transparent}
</style>
<style id="ac-gpt">
#page-chat .ac-wrap{background:#212121!important}
#page-chat .ac-side{position:relative;background:#171717!important;backdrop-filter:none!important;border-right:1px solid #2a2a2a!important;overflow:hidden;width:var(--ac-sw,220px)!important;min-width:0!important;padding:10px 8px!important}
#page-chat .ac-wrap.side-off .ac-side{display:none!important}
@media (max-width:1100px){#page-chat .ac-wrap:not(.side-off) .ac-side{display:flex!important}}
#page-chat .ac-grip{position:absolute;top:0;right:-3px;width:7px;height:100%;cursor:col-resize;z-index:5}
#page-chat .ac-grip:hover,#page-chat .ac-grip.on{background:#3a3a3a}
#page-chat .ac-sbtn{display:inline-flex!important;align-items:center;justify-content:center;width:34px;height:34px;padding:0!important;border:0!important;border-radius:8px!important;color:#cfcfcf!important;background:transparent!important;flex:none;cursor:pointer;-webkit-app-region:no-drag;position:relative;z-index:10}
#page-chat .ac-sbtn:hover{background:#2f2f2f!important;color:#fff!important}
#page-chat .ac-sbtn svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;pointer-events:none}
#page-chat .ac-head{-webkit-app-region:no-drag}
#page-chat .ac-new{background:transparent!important;border:0!important;box-shadow:none!important;color:#ececec!important;justify-content:flex-start!important;border-radius:8px!important;font-weight:500!important;width:100%!important}
#page-chat .ac-new:hover{background:#2a2a2a!important}
#page-chat #acTrim,#page-chat #acCarry{display:flex!important;width:100%!important;margin:0!important;border:0!important;padding:6px 10px!important;font-size:12.5px!important;color:#a8a8a8!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;justify-content:flex-start!important}
#page-chat .ac-hitem{color:#d6d6d6!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#page-chat .ac-hitem:hover,#page-chat .ac-hitem.on,#page-chat .ac-hitem.active{background:#2a2a2a!important;color:#fff!important}
#page-chat .ac-cwbtn{background:#2a2a2a!important;border:1px solid #3a3a3a!important;color:#ececec!important;box-shadow:none!important;border-radius:10px!important}
#page-chat .ac-head{background:#212121!important;border-bottom:0!important;padding:8px 14px!important}
#page-chat .ac-title{font-size:15px!important;color:#ececec!important}
#page-chat .ac-pill{background:#2a2a2a!important;border-color:#353535!important;color:#cfcfcf!important}
#page-chat .ac-tabs{border-bottom:1px solid #2a2a2a!important;padding:4px 16px 8px!important}
#page-chat .ac-tab{background:#2a2a2a!important;border-color:#353535!important;color:#e0e0e0!important}
#page-chat .ac-msgs{max-width:880px!important;margin:0!important;padding:28px 40px 16px 40px!important}
#page-chat .ac-msg{margin:0 0 28px!important}
#page-chat .ac-av{display:none!important}
#page-chat .ac-body{max-width:100%!important}
#page-chat .ac-md,#page-chat .ac-md p,#page-chat .ac-md li{font-family:ui-sans-serif,-apple-system,"Segoe UI",Roboto,Arial,sans-serif!important;font-size:16px!important;line-height:1.75!important;color:#ececec!important}
#page-chat .ac-md p{margin:0 0 12px!important}
#page-chat .ac-md b,#page-chat .ac-md strong{color:#fff!important;font-weight:700!important}
#page-chat .ac-md h2,#page-chat .ac-md h3,#page-chat .ac-md h4{color:#fff!important;margin:20px 0 8px!important}
#page-chat .ac-md ul,#page-chat .ac-md ol{padding-left:24px!important;margin:4px 0 12px!important}
#page-chat .ac-md li{margin:4px 0!important}
#page-chat .ac-md li::marker{color:#ececec!important;font-weight:600}
#page-chat .ac-md a{color:#ececec!important;text-decoration:underline!important;text-decoration-color:#8a8a8a!important;text-underline-offset:3px}
#page-chat .ac-md code{color:#ececec!important;background:#2f2f2f!important;border:0!important;border-radius:5px!important;padding:1px 6px!important}
#page-chat .ac-md pre{background:#171717!important;border:1px solid #2f2f2f!important;border-radius:12px!important}
#page-chat .ac-md pre code{background:transparent!important;padding:0!important;color:#e6e6e6!important}
#page-chat .ac-md blockquote{border-left:3px solid #555!important;color:#d0d0d0!important;background:transparent!important}
#page-chat .ac-steps2,#page-chat .ac-steps2 *{color:#b4b4b4!important}
#page-chat .ac-uwrap{max-width:70%!important}
#page-chat .ac-bubble{background:#303030!important;color:#ececec!important;border:0!important;border-radius:20px!important;padding:10px 16px!important;font-size:16px!important;line-height:1.6!important}
#page-chat .ac-foot{background:#212121!important;padding:6px 40px 14px!important}
#page-chat .ac-box{max-width:880px!important;margin:0!important;background:#303030!important;border:1px solid #3a3a3a!important;border-radius:26px!important;box-shadow:none!important}
#page-chat .ac-box:focus-within{border-color:#5a5a5a!important}
#page-chat .ac-ta{font-size:16px!important;color:#ececec!important}
#page-chat .ac-note{max-width:880px;text-align:center;color:#8a8a8a!important}
#page-chat .ac-scroll::-webkit-scrollbar-thumb{background:#3a3a3a}
</style>
<script>
(function(){
  var w=document.querySelector('#page-chat .ac-wrap'),h=document.querySelector('#page-chat .ac-head'),a=document.querySelector('#page-chat .ac-side');
  if(!w||!h||!a)return;
  function g(k){try{return localStorage.getItem(k)}catch(e){return null}}
  function p(k,v){try{localStorage.setItem(k,v)}catch(e){}}
  var sw=parseInt(g('acSideW')||'220',10);if(!(sw>=160&&sw<=420))sw=220;w.style.setProperty('--ac-sw',sw+'px');
  var b=document.createElement('button');b.type='button';
  b.id='acSideT';b.className='ac-sbtn';b.title='Seitenleiste ein-/ausklappen (Strg+Shift+S)';
  b.innerHTML='<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/></svg>';
  h.insertBefore(b,h.firstChild);
  function off(){return w.classList.contains('side-off')}
  function set(o){w.classList.toggle('side-off',o);a.style.display=o?'none':'';p('acSide',o?'0':'1')}
  var s=g('acSide');set(s===null?window.innerWidth<1100:s==='0');
  b.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();set(!off())},true);
  document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&e.shiftKey&&(e.key==='S'||e.key==='s')){e.preventDefault();set(!off())}},true);
  var gr=document.createElement('div');gr.className='ac-grip';gr.title='Ziehen zum Verbreitern, Doppelklick zum Zurücksetzen';a.appendChild(gr);
  gr.addEventListener('pointerdown',function(e){e.preventDefault();gr.classList.add('on');gr.setPointerCapture(e.pointerId);var x0=e.clientX,w0=a.getBoundingClientRect().width;
    function mv(ev){sw=Math.max(160,Math.min(420,Math.round(w0+ev.clientX-x0)));w.style.setProperty('--ac-sw',sw+'px')}
    function up(){gr.classList.remove('on');gr.removeEventListener('pointermove',mv);gr.removeEventListener('pointerup',up);p('acSideW',String(sw))}
    gr.addEventListener('pointermove',mv);gr.addEventListener('pointerup',up)});
  gr.addEventListener('dblclick',function(){sw=220;w.style.setProperty('--ac-sw','220px');p('acSideW','220')});
  var pc=document.getElementById('page-chat');
  setInterval(function(){var f=document.getElementById('pcw-btn'),q=document.getElementById('pcw-panel');var vis=pc&&pc.offsetParent!==null;if(f)f.style.display=vis?'none':'';if(q&&vis)q.style.display='none'},800);
})();
</script>
