+async fn native(state: &crate::AppState, name: &str, args: Value, timeout: u64) -> Result<String, String> {
+    match tokio::time::timeout(Duration::from_secs(timeout.max(3) + 5), crate::roblox_tool(state, name, args)).await {
+        Err(_) => Err(format!("Roblox Studio hat bei '{name}' nicht rechtzeitig geantwortet.")),
+        Ok(Err(e)) => Err(format!("{e:#}")),
+        Ok(Ok(out)) => Ok(out.text),
+    }
+}
