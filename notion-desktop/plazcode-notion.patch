+const SNAP_BODY: &str = r##"local ss = game:GetService("ServerStorage")
+local store = ss:FindFirstChild("__BrickwireSnapshots")
+if not store then store = Instance.new("Folder"); store.Name = "__BrickwireSnapshots"; store.Parent = ss end
+local snap = Instance.new("Folder"); snap.Name = ARGS.id; snap:SetAttribute("Label", ARGS.label); snap:SetAttribute("CreatedAt", os.time())
+local entries = {}
+for i, segs in ipairs(ARGS.segsList) do
+	local inst = bw_resolve(segs)
+	local entry = {index=i, path=ARGS.paths[i], segs=segs, absent=inst == nil, saved=false}
+	if inst then
+		entry.parentSegs = {}; for j=1,#segs-1 do table.insert(entry.parentSegs,segs[j]) end
+		entry.name = inst.Name
+		local ok, clone = pcall(function() return inst:Clone() end)
+		if ok and clone then
+			clone.Name = tostring(i); clone:SetAttribute("BW_OriginalName", inst.Name)
+			for _, d in ipairs(clone:GetDescendants()) do if d:IsA("BaseScript") then d:SetAttribute("BW_WasDisabled",d.Disabled); d.Disabled=true end end
+			if clone:IsA("BaseScript") then clone:SetAttribute("BW_WasDisabled",clone.Disabled); clone.Disabled=true end
+			clone.Parent=snap; entry.saved=true
+		else entry.reason="not archivable" end
+	end
+	table.insert(entries,entry)
+end
+snap:SetAttribute("Entries",HttpService:JSONEncode(entries)); snap.Parent=store
+return {snapshotId=ARGS.id, label=ARGS.label, entries=entries}"##;
+
+const LOGS_BODY: &str = r##"local history=game:GetService("LogService"):GetLogHistory(); local out={}
+for i=#history,1,-1 do local e=history[i]; local n=e.messageType and e.messageType.Name or "MessageOutput"; if n=="MessageError" or n=="MessageWarning" then table.insert(out,1,"["..n.."] "..e.message); if #out>=ARGS.limit then break end end end
+return {lines=out,count=#out}"##;
+
+const LIST_SNAP_BODY: &str = r##"local store=game:GetService("ServerStorage"):FindFirstChild("__BrickwireSnapshots"); local out={}
+if store then for _,s in ipairs(store:GetChildren()) do local ok,e=pcall(function() return HttpService:JSONDecode(s:GetAttribute("Entries") or "[]") end); table.insert(out,{id=s.Name,label=s:GetAttribute("Label"),createdAt=s:GetAttribute("CreatedAt"),entries=if ok then e else {}}) end end
+return {snapshots=out}"##;
+
+const RESTORE_BODY: &str = r##"local store=game:GetService("ServerStorage"):FindFirstChild("__BrickwireSnapshots"); local snap=store and store:FindFirstChild(ARGS.id); if not snap then error("snapshot not found",0) end
+local entries=HttpService:JSONDecode(snap:GetAttribute("Entries") or "[]"); local restored,removed,failed={},{},{}
+for _,e in ipairs(entries) do local current=bw_resolve(e.segs)
+	if e.absent then if current then current:Destroy(); table.insert(removed,e.path) end
+	elseif e.saved then local saved=snap:FindFirstChild(tostring(e.index)); local parent=bw_resolve(e.parentSegs)
+		if not saved or not parent then table.insert(failed,e.path) else
+			if current then current:Destroy() end
+			local c=saved:Clone(); c.Name=saved:GetAttribute("BW_OriginalName") or c.Name; c:SetAttribute("BW_OriginalName",nil)
+			local all=c:GetDescendants(); table.insert(all,c); for _,d in ipairs(all) do if d:IsA("BaseScript") then local was=d:GetAttribute("BW_WasDisabled"); if was~=nil then d.Disabled=was; d:SetAttribute("BW_WasDisabled",nil) end end end
+			c.Parent=parent; table.insert(restored,e.path)
+		end
+	end
+end
+return {snapshotId=ARGS.id,restored=restored,removed=removed,failed=failed}"##;
+
+const PROJECT_BODY: &str = r##"local names={"Workspace","ReplicatedStorage","ReplicatedFirst","ServerScriptService","ServerStorage","StarterGui","StarterPack","StarterPlayer","Lighting","SoundService","Teams"}
+local out={placeName=game.Name,placeId=game.PlaceId,gameId=game.GameId,creatorId=game.CreatorId,services={},scripts={},guis={},remotes=0,scriptCount=0}
+for _,name in ipairs(names) do local ok,svc=pcall(function() return game:GetService(name) end); if ok then out.services[name]={children=#svc:GetChildren(),descendants=#svc:GetDescendants()}; for _,d in ipairs(svc:GetDescendants()) do if d:IsA("LuaSourceContainer") then out.scriptCount+=1; if #out.scripts<ARGS.maxScripts then table.insert(out.scripts,{path=bw_path(d),class=d.ClassName}) end end end end end
+for _,g in ipairs(game:GetService("StarterGui"):GetChildren()) do table.insert(out.guis,{path=bw_path(g),class=g.ClassName,descendants=#g:GetDescendants()}) end
+for _,d in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("UnreliableRemoteEvent") then out.remotes+=1 end end
+return out"##;
+
+const TREE_BODY: &str = r##"local root=bw_must(ARGS.segs); local count=0
+local function walk(inst,depth) count+=1; local kids=inst:GetChildren(); local node={name=inst.Name,class=inst.ClassName,childCount=#kids}
+	if depth<ARGS.depth and #kids>0 then node.children={}; for _,c in ipairs(kids) do if count>=ARGS.maxNodes then node.truncated=true; break end; table.insert(node.children,walk(c,depth+1)) end end
+	return node
+end
+local tree=walk(root,0); return {path=bw_path(root),nodes=count,truncated=count>=ARGS.maxNodes,tree=tree}"##;
+
+const READ_INSTANCE_BODY: &str = r##"local inst=bw_must(ARGS.segs); local props=ARGS.properties; local explicit=props~=nil
+if not props then props={"Name","ClassName"}; local more={}; if inst:IsA("BasePart") then more={"Size","Position","Color","Material","Anchored","CanCollide","Transparency"} elseif inst:IsA("LuaSourceContainer") then more={"Source"}; if inst:IsA("BaseScript") then table.insert(more,"Disabled") end elseif inst:IsA("GuiObject") then more={"Size","Position","Visible","BackgroundColor3","Text"} elseif inst:IsA("LayerCollector") then more={"Enabled","ResetOnSpawn"} end; for _,p in ipairs(more) do table.insert(props,p) end end
+local out={path=bw_path(inst),className=inst.ClassName,properties={},attributes={},children={}}
+for _,p in ipairs(props) do local ok,v=pcall(function() return inst[p] end); if ok then if p=="Source" and type(v)=="string" and #v>20000 then v=string.sub(v,1,20000).."\n-- truncated; use read_script" end; out.properties[p]=bw_enc(v) elseif explicit then out.properties[p]="<error: "..tostring(v)..">" end end
+for k,v in pairs(inst:GetAttributes()) do out.attributes[k]=bw_enc(v) end
+for i,c in ipairs(inst:GetChildren()) do if i>200 then break end; table.insert(out.children,c.Name.." ("..c.ClassName..")") end
+return out"##;
+
+const READ_SCRIPT_BODY: &str = r##"local s=bw_must(ARGS.segs); if not s:IsA("LuaSourceContainer") then error("not a script",0) end
+local lines=string.split(s.Source,"\n"); local first=math.max(1,ARGS.fromLine); local last=math.min(#lines,ARGS.toLine>0 and ARGS.toLine or #lines); local out,size,truncated={},0,false
+for i=first,last do local line=string.format("%4d| %s",i,lines[i]); if size+#line>ARGS.maxChars then truncated=true; break end; table.insert(out,line); size+=#line+1 end
+return {path=bw_path(s),className=s.ClassName,lineCount=#lines,fromLine=first,toLine=last,source=table.concat(out,"\n"),truncated=truncated}"##;
+
+const SEARCH_BODY: &str = r##"local hits,total={},0
+for _,d in ipairs(game:GetDescendants()) do if d:IsA("LuaSourceContainer") then local ok,src=pcall(function() return d.Source end); if ok then for i,line in ipairs(string.split(src,"\n")) do if string.find(line,ARGS.text,1,true) then total+=1; if #hits<ARGS.limit then table.insert(hits,{path=bw_path(d),line=i,text=string.sub(line,1,240)}) end end end end end end
+return {total=total,hits=hits}"##;
+
+const CREATE_BODY: &str = r##"local parent=bw_must(ARGS.parentSegs); local tree=ARGS.tree
+if tree.name then local old=parent:FindFirstChild(tree.name); if old then if ARGS.replace then old:Destroy() else error("already exists: "..old:GetFullName().." - choose another name or pass replaceExisting",0) end end end
+local created,errors={},{}; local root=bw_create_tree(tree,parent,created,errors); return {path=bw_path(root),className=root.ClassName,created=created,propertyErrors=errors}"##;
+
+const MODIFY_BODY: &str = r##"local inst=bw_must(ARGS.segs); local before,after={},{}
