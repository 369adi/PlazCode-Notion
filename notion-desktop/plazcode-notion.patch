+//! Durable, project-scoped memory for long-running Notion AI chats.
+use once_cell::sync::Lazy;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{collections::BTreeMap, path::{Path, PathBuf}, sync::Mutex, time::Duration};
+
+#[derive(Clone, Default, Serialize, Deserialize)]
+#[serde(default)]
+struct Record { name:String, summary:String, handout:String, handout_path:String, updated:i64 }
+#[derive(Default, Serialize, Deserialize)]
+#[serde(default)]
+struct Store { projects:BTreeMap<String,Record> }
+static STORE:Lazy<Mutex<Store>>=Lazy::new(||Mutex::new(load()));
+fn lock()->std::sync::MutexGuard<'static,Store>{STORE.lock().unwrap_or_else(|e|e.into_inner())}
+fn root()->PathBuf{std::env::var_os("LOCALAPPDATA").map(PathBuf::from).unwrap_or_else(std::env::temp_dir).join("PlazCodeNotion").join("project-memory")}
+fn db()->PathBuf{root().join("projects.json")}
+fn load()->Store{std::fs::read_to_string(db()).ok().and_then(|s|serde_json::from_str(s.trim_start_matches('\u{feff}')).ok()).unwrap_or_default()}
+fn save(s:&Store){let p=db();if let Some(d)=p.parent(){let _=std::fs::create_dir_all(d);}let tmp=p.with_extension("tmp");if std::fs::write(&tmp,serde_json::to_vec_pretty(s).unwrap_or_default()).is_ok(){let _=std::fs::rename(tmp,p);}}
+fn key(s:&str)->String{s.trim().to_lowercase().chars().filter(|c|c.is_alphanumeric()||*c=='-'||*c=='_').take(80).collect()}
+fn now()->i64{chrono::Utc::now().timestamp()}
+fn read_handout(path:&Path)->Option<String>{let m=std::fs::metadata(path).ok()?;if !m.is_file()||m.len()>512*1024{return None;}std::fs::read_to_string(path).ok()}
+fn shared_work()->PathBuf{std::env::var_os("PLAZCODE_SHARED_DIR").map(PathBuf::from).unwrap_or_else(||std::env::var_os("USERPROFILE").map(PathBuf::from).unwrap_or_else(||PathBuf::from(".")).join("PlazCode-Shared")).join("work")}
+fn discover(dir:&Path,depth:u8,out:&mut Vec<PathBuf>){if depth==0||out.len()>200{return;}let Ok(rd)=std::fs::read_dir(dir)else{return};for e in rd.flatten(){let p=e.path();if p.is_dir(){let n=e.file_name().to_string_lossy().to_ascii_lowercase();if !matches!(n.as_str(),"node_modules"|"target"|".git"|"dist"|"build"){discover(&p,depth-1,out);}}else{let n=e.file_name().to_string_lossy().to_ascii_lowercase();if matches!(n.as_str(),"handout.md"|"project_handout.md"|"project-memory.md"|"memory.md"){out.push(p);}}}}
+fn sync(){
+    let mut changed=false;let mut store=lock();let mut found=Vec::new();discover(&shared_work(),5,&mut found);
