+    for _ in 0..20{
+        let mut busy=false;
+        for i in &stopped{ let p=cdp_port(*i); if gen_snapshot(p).await.is_some(){ busy=true; let _=js_eval(p,UPD_STOP_JS).await; } }
+        if !busy{break;}
+        tokio::time::sleep(Duration::from_millis(500)).await;
+    }
+    let _=std::fs::create_dir_all(crate::notion_updates::base_dir());
+    std::fs::write(update_resume_file(),serde_json::to_string(&stopped).unwrap_or_else(|_|"[]".into())).map_err(|e|e.to_string())?;
