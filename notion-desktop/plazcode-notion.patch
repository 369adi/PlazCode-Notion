+fn save_db(db: &Map<String, Value>) {
+    let file = memory_file();
+    if let Some(p) = file.parent() { let _ = std::fs::create_dir_all(p); }
+    let tmp = file.with_extension("tmp");
+    if let Ok(data) = serde_json::to_vec_pretty(db) {
+        if std::fs::write(&tmp, data).is_ok() { let _ = std::fs::rename(&tmp, &file); }
+    }
+}
