+    if !started{close_target(port,&tgt).await;let m="Notion hat den Start verworfen (zu viele neue Chats kurz hintereinander) - in 1 Minute erneut versuchen.";mark_account(t.id,"slots_state",json!(m));return Err(m.into());}
