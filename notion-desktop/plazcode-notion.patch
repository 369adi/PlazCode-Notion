+//! AdiCode 1.0.8: Multi-KI-Web-Agenten + Direkt-Modus (aus Secretscript portiert).
+//!
+//! Die AdiCode-Browser-Erweiterung verbindet sich per WebSocket mit
+//! `ws://127.0.0.1:<port>/extension/ws` (Token = Erweiterungs-Token). Notion AI steuert
+//! damit nur Tabs, die du in der Erweiterung ausdruecklich freigegeben hast
+//! (ChatGPT, Claude, Gemini, DeepSeek, Qwen, Kimi, GLM, Arena, Notion AI).
+//!
+//! Direkt-Modus: Ein freigegebener KI-Tab steuert Roblox Studio selbst ueber
+//! `/direct-agent/*`; jede Aenderung braucht eine frische Freigabe im Seiten-Panel.
+
+use axum::{
+    extract::{ws::{CloseFrame, Message, WebSocket, WebSocketUpgrade}, Path, State},
+    http::{HeaderMap, StatusCode},
+    response::{IntoResponse, Response},
+    Json,
+};
+use futures::{SinkExt, StreamExt};
+use once_cell::sync::Lazy;
+use serde_json::{json, Value};
+use std::{collections::{HashMap, HashSet}, sync::Mutex, time::{Duration, Instant}};
+
+const SESSION_TTL: Duration = Duration::from_secs(300);
+const MAX_TOOL_CALLS: u32 = 50;
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> { m.lock().unwrap_or_else(|e| e.into_inner()) }
+
+fn providers() -> Value {
+    json!([
+        {"id":"deepseek","name":"DeepSeek","hosts":["chat.deepseek.com"],"status":"beta","maxMessageChars":60000},
+        {"id":"chatgpt","name":"ChatGPT","hosts":["chatgpt.com","chat.openai.com"],"status":"experimental","maxMessageChars":30000},
+        {"id":"claude","name":"Claude","hosts":["claude.ai"],"status":"experimental","maxMessageChars":40000},
+        {"id":"gemini","name":"Gemini","hosts":["gemini.google.com"],"status":"experimental","maxMessageChars":30000},
+        {"id":"qwen","name":"Qwen","hosts":["chat.qwen.ai"],"status":"experimental","maxMessageChars":30000},
+        {"id":"kimi","name":"Kimi","hosts":["kimi.com","kimi.ai"],"status":"experimental","maxMessageChars":30000},
+        {"id":"glm","name":"GLM (Z.ai)","hosts":["chat.z.ai"],"status":"experimental","maxMessageChars":30000},
+        {"id":"arena","name":"Arena","hosts":["lmarena.ai","arena.ai"],"status":"experimental","maxMessageChars":20000,"notes":"Nur Direkt-Modus; Battle/Side-by-side wird nicht unterstuetzt."},
+        {"id":"notion","name":"Notion AI","hosts":["notion.so","app.notion.com"],"status":"experimental","enabledByDefault":false,"maxMessageChars":12000,"notes":"Standardmaessig aus; in den Erweiterungs-Optionen aktivieren."}
+    ])
+}
+
+const PROVIDER_IDS: &[&str] = &["deepseek", "chatgpt", "claude", "gemini", "qwen", "kimi", "glm", "arena", "notion"];
+
+fn random_hex(n: usize) -> String {
+    let mut b = vec![0u8; n];
+    let _ = getrandom::getrandom(&mut b);
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+fn token_eq(a: &str, b: &str) -> bool {
+    if b.is_empty() { return false; }
+    use sha2::Digest;
+    let x = sha2::Sha256::digest(a.as_bytes());
+    let y = sha2::Sha256::digest(b.as_bytes());
+    x.iter().zip(y.iter()).fold(0u8, |acc, (p, q)| acc | (p ^ q)) == 0
+}
+
+// ---------------------------------------------------------------- Broker
+
+struct Conn { id: String, tx: tokio::sync::mpsc::UnboundedSender<String> }
+
+static CONN: Lazy<Mutex<Option<Conn>>> = Lazy::new(|| Mutex::new(None));
+static PENDING: Lazy<Mutex<HashMap<String, tokio::sync::oneshot::Sender<Value>>>> = Lazy::new(|| Mutex::new(HashMap::new()));
+
+pub fn extension_connected() -> bool { lock(&CONN).is_some() }
+
+fn detach(id: &str) {
+    let mut c = lock(&CONN);
+    if c.as_ref().map(|x| x.id == id).unwrap_or(false) {
+        *c = None;
+        drop(c);
+        let pending: Vec<_> = lock(&PENDING).drain().collect();
+        for (_, tx) in pending { let _ = tx.send(json!({"error": "Browser-Erweiterung wurde getrennt."})); }
+    }
+}
+
+pub(crate) async fn ws_handler(ws: WebSocketUpgrade, headers: HeaderMap) -> Response {
+    let origin = headers.get("origin").and_then(|v| v.to_str().ok()).unwrap_or("").to_string();
+    if !origin.is_empty() && !origin.starts_with("chrome-extension://") {
+        return StatusCode::FORBIDDEN.into_response();
+    }
+    ws.on_upgrade(handle_socket)
+}
+
+async fn handle_socket(mut socket: WebSocket) {
+    let hello = tokio::time::timeout(Duration::from_secs(10), socket.recv()).await;
+    let ok = match hello {
+        Ok(Some(Ok(Message::Text(t)))) => serde_json::from_str::<Value>(&t).ok()
+            .map(|v| v["type"] == "hello" && token_eq(v["token"].as_str().unwrap_or(""), &crate::notion_mcp::web_token()))
+            .unwrap_or(false),
+        _ => false,
+    };
+    if !ok {
+        let _ = socket.send(Message::Close(Some(CloseFrame { code: 4401, reason: "unauthorized".into() }))).await;
+        return;
+    }
+    let (mut sink, mut stream) = socket.split();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel::<String>();
+    let id = random_hex(12);
+    *lock(&CONN) = Some(Conn { id: id.clone(), tx });
+    tracing::info!("[notion] Browser-Erweiterung verbunden");
+    let _ = sink.send(Message::Text(json!({"type": "ready", "providers": PROVIDER_IDS}).to_string())).await;
+    loop {
+        tokio::select! {
+            out = rx.recv() => match out {
+                Some(text) => if sink.send(Message::Text(text)).await.is_err() { break; },
+                None => break,
+            },
+            inc = stream.next() => match inc {
+                Some(Ok(Message::Text(t))) => {
+                    if let Ok(v) = serde_json::from_str::<Value>(&t) {
+                        if v["type"] == "response" {
+                            if let Some(rid) = v["id"].as_str() {
+                                if let Some(waiter) = lock(&PENDING).remove(rid) {
+                                    let result = if v["result"].is_object() { v["result"].clone() } else { json!({"error": "Ungueltige Antwort der Erweiterung."}) };
+                                    let _ = waiter.send(result);
+                                }
+                            }
+                        }
+                    }
+                }
+                Some(Ok(Message::Close(_))) | None | Some(Err(_)) => break,
+                _ => {}
+            },
+        }
+    }
+    detach(&id);
+    tracing::info!("[notion] Browser-Erweiterung getrennt");
+}
+
+async fn broker_call(tool: &str, args: &Value) -> Result<Value, String> {
+    if tool == "web_sites" {
+        return Ok(json!({"providers": providers(), "extensionConnected": extension_connected()}));
+    }
+    let action = args["action"].as_str().unwrap_or("");
+    let allowed: &[&str] = if tool == "web_chat" { &["inspect", "send", "wait", "read"] } else { &["list", "inspect", "run", "send", "wait", "read"] };
+    if !allowed.contains(&action) { return Err(format!("Aktion '{action}' wird von {tool} nicht unterstuetzt")); }
+    if tool == "web_agents" && action != "list" {
+        let id = args["agent_id"].as_str().unwrap_or("");
+        if !id.starts_with("agent-") { return Err("agent_id fehlt - zuerst web_agents(action='list') aufrufen".into()); }
+    }
+    if action == "send" || action == "run" {
+        let key = if action == "run" { "task" } else { "text" };
+        let text = args[key].as_str().unwrap_or("");
+        if text.trim().is_empty() { return Err(format!("{action} braucht einen nicht-leeren Wert fuer '{key}'")); }
+        if text.chars().count() > 60_000 { return Err("Text ueberschreitet 60.000 Zeichen".into()); }
+    }
+    let wait = match args.get("wait_seconds") {
+        None | Some(Value::Null) => if action == "run" { 150 } else { 30 },
+        Some(v) => v.as_i64().filter(|n| (1..=150).contains(n)).ok_or("wait_seconds muss zwischen 1 und 150 liegen")?,
+    } as u64;
+    let mut payload = args.clone();
+    payload["wait_seconds"] = json!(wait);
+    let request_id = random_hex(12);
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    {
+        let conn = lock(&CONN);
+        let Some(c) = conn.as_ref() else {
+            return Err("Browser-Erweiterung ist nicht verbunden. Oeffne ihre Optionen, trage den Erweiterungs-Token aus AdiCode ein und oeffne eine unterstuetzte Chat-Seite.".into());
+        };
+        lock(&PENDING).insert(request_id.clone(), tx);
+        let msg = json!({"type": "request", "id": request_id, "tool": tool, "arguments": payload}).to_string();
+        if c.tx.send(msg).is_err() { lock(&PENDING).remove(&request_id); return Err("Browser-Erweiterung ist nicht erreichbar.".into()); }
+    }
+    let limit = if action == "wait" || action == "run" { wait + 5 } else { 60 };
+    let result = tokio::time::timeout(Duration::from_secs(limit.clamp(3, 180)), rx).await;
+    lock(&PENDING).remove(&request_id);
+    match result {
+        Err(_) => Err("Zeitueberschreitung beim Warten auf den Chat-Tab. Ist der Browser offen und die Erweiterung verbunden?".into()),
+        Ok(Err(_)) => Err("Browser-Erweiterung wurde getrennt.".into()),
+        Ok(Ok(v)) => match v.get("error").and_then(|e| e.as_str()) { Some(e) => Err(e.to_string()), None => Ok(v) },
+    }
+}
+
+pub fn tools() -> Vec<Value> {
+    vec![
+        json!({"name": "web_sites", "description": "[Web-Agenten] Listet die unterstuetzten KI-Chat-Seiten und ob die AdiCode-Browser-Erweiterung verbunden ist.",
+            "inputSchema": {"type": "object", "properties": {}}, "annotations": {"readOnlyHint": true}}),
+        json!({"name": "web_agents", "description": "[Web-Agenten] Steuert nur KI-Chat-Tabs, die du in der Browser-Erweiterung mit 'Agent aktivieren' freigegeben hast (ChatGPT, Claude, Gemini, DeepSeek, Qwen, Kimi, GLM, Arena, Notion AI). list liefert agent_ids; run schickt eine Aufgabe und wartet auf die Antwort; send/wait/read/inspect fuer einzelne Schritte. Ideal als zusaetzliche Team-Mitglieder in Co-Work.",
+            "inputSchema": {"type": "object", "required": ["action"], "properties": {
+                "action": {"type": "string", "enum": ["list", "inspect", "run", "send", "wait", "read"]},
+                "agent_id": {"type": "string", "description": "Ausser bei list erforderlich; kommt aus list."},
+                "task": {"type": "string", "description": "Fuer run: Aufgabe an die KI dieses Tabs."},
+                "text": {"type": "string", "description": "Fuer send: normale Nachricht."},
+                "wait_seconds": {"type": "integer", "minimum": 1, "maximum": 150}
+            }}}),
+        json!({"name": "web_chat", "description": "[Web-Agenten] Kompatibilitaets-Tool fuer den gerade aktiven, freigegebenen Chat-Tab: inspect, send, wait, read.",
+            "inputSchema": {"type": "object", "required": ["action"], "properties": {
+                "action": {"type": "string", "enum": ["inspect", "send", "wait", "read"]},
+                "text": {"type": "string"}, "wait_seconds": {"type": "integer", "minimum": 1, "maximum": 150}
+            }}}),
+    ]
+}
+
+pub async fn call(name: &str, args: &Value) -> Option<Value> {
+    if !["web_sites", "web_agents", "web_chat"].contains(&name) { return None; }
+    Some(match broker_call(name, args).await {
+        Ok(v) => json!({"content": [{"type": "text", "text": serde_json::to_string_pretty(&v).unwrap_or_default()}]}),
+        Err(e) => json!({"isError": true, "content": [{"type": "text", "text": e}]}),
+    })
+}
+
+// ---------------------------------------------------------------- Direkt-Modus
+
+#[derive(Clone)]
+struct Session { id: String, agent_id: String, provider: String, last: Instant, calls: u32, native: HashSet<String> }
+
+static SESSION: Lazy<Mutex<Option<Session>>> = Lazy::new(|| Mutex::new(None));
+
+fn expire() {
+    let mut s = lock(&SESSION);
+    if s.as_ref().map(|x| x.last.elapsed() > SESSION_TTL).unwrap_or(false) { *s = None; }
+}
+
+pub fn direct_session_info() -> Value {
+    expire();
+    match lock(&SESSION).as_ref() {
+        Some(s) => json!({"active": true, "provider": s.provider, "agent_id": s.agent_id, "tool_calls": s.calls}),
+        None => json!({"active": false}),
+    }
+}
+
+/// Notion-Schreibzugriffe auf Studio sind gesperrt, solange ein Direkt-Agent laeuft.
+pub fn notion_write_allowed() -> Result<(), String> {
+    expire();
+    if lock(&SESSION).is_some() {
+        return Err("Roblox Studio ist gerade fuer einen Direkt-Agenten im Browser reserviert. Stoppe ihn im Seiten-Panel, bevor Notion Aenderungen macht.".into());
+    }
+    Ok(())
+}
+
+enum DErr { Bad(String), Forbidden(String), Conflict(String) }
+impl From<String> for DErr { fn from(s: String) -> Self { DErr::Conflict(s) } }
+
+fn get_session(session_id: &str, agent_id: &str) -> Result<Session, DErr> {
+    expire();
+    match lock(&SESSION).as_ref() {
+        Some(s) if s.id == session_id && s.agent_id == agent_id => Ok(s.clone()),
+        _ => Err(DErr::Conflict("Direkt-Agent-Sitzung ist abgelaufen oder gehoert zu einer anderen Seite".into())),
+    }
+}
+
+async fn direct_start(state: &crate::AppState, body: &Value) -> Result<Value, DErr> {
+    let agent_id = body["agent_id"].as_str().unwrap_or("");
+    let provider = body["provider"].as_str().unwrap_or("");
+    let task = body["task"].as_str().unwrap_or("").trim().to_string();
+    if agent_id.len() < 7 || !agent_id.starts_with("agent-") || !agent_id[6..].chars().all(|c| c.is_ascii_digit()) { return Err(DErr::Bad("Ein registrierter Seiten-Agent ist erforderlich".into())); }
+    if !PROVIDER_IDS.contains(&provider) { return Err(DErr::Bad("Nicht unterstuetzter KI-Anbieter".into())); }
+    if task.is_empty() || task.chars().count() > 8000 { return Err(DErr::Bad("Die Aufgabe muss 1-8.000 Zeichen haben".into())); }
+    expire();
+    if lock(&SESSION).is_some() { return Err(DErr::Conflict("Ein anderer Direkt-Agent nutzt Roblox Studio bereits. Stoppe ihn zuerst.".into())); }
+    let tools: Vec<Value> = { state.roblox_mcp.lock().await.tools.clone() };
+    if tools.is_empty() { return Err(DErr::Conflict("Roblox Studio ist nicht bereit oder meldet keine MCP-Tools.".into())); }
+    let session_id = format!("direct_{}", random_hex(18));
+    let native: HashSet<String> = tools.iter().filter_map(|t| t["name"].as_str().map(String::from)).collect();
+    {
+        let mut s = lock(&SESSION);
+        if s.is_some() { return Err(DErr::Conflict("Ein anderer Direkt-Agent nutzt Roblox Studio bereits.".into())); }
+        *s = Some(Session { id: session_id.clone(), agent_id: agent_id.into(), provider: provider.into(), last: Instant::now(), calls: 0, native });
+    }
+    let native_tools: Vec<Value> = tools.iter().map(|t| {
+        let name = t["name"].as_str().unwrap_or("");
+        let desc: String = t["description"].as_str().unwrap_or("").chars().take(240).collect();
+        json!({"name": name, "description": desc, "inputSchema": t.get("inputSchema").cloned().unwrap_or_else(|| json!({})),
+               "risk": if crate::notion_roblox_plus::is_guarded(name) { "write" } else { "read" }})
+    }).collect();
+    tracing::info!("[notion] Direkt-Agent gestartet ({provider}, {agent_id})");
+    Ok(json!({
+        "session_id": session_id, "provider": provider, "task": task,
+        "studio_actions": crate::notion_roblox_plus::STUDIO_ACTIONS,
+        "native_tools": native_tools, "max_tool_calls": MAX_TOOL_CALLS,
+        "approval_policy": "Jede Aenderung braucht eine frische, ausdrueckliche Freigabe im Seiten-Panel."
+    }))
+}
+
+async fn direct_tool(state: &crate::AppState, body: &Value) -> Result<Value, DErr> {
+    let session_id = body["session_id"].as_str().unwrap_or("");
+    let agent_id = body["agent_id"].as_str().unwrap_or("");
+    let tool = body["tool"].as_str().unwrap_or("");
+    let args = body.get("arguments").cloned().unwrap_or_else(|| json!({}));
+    let approved = body["approved"].as_bool().unwrap_or(false);
+    if !args.is_object() { return Err(DErr::Bad("Tool-Argumente muessen ein Objekt sein".into())); }
+    let session = get_session(session_id, agent_id)?;
+    if session.calls >= MAX_TOOL_CALLS { return Err(DErr::Conflict("Diese Direkt-Agent-Sitzung hat das Limit von 50 Aufrufen erreicht.".into())); }
+    let risk = match tool {
+        "roblox_studio" => {
+            let action = args["action"].as_str().unwrap_or("");
+            if !crate::notion_roblox_plus::STUDIO_ACTIONS.contains(&action) { return Err(DErr::Bad("Nicht unterstuetzte roblox_studio-Aktion".into())); }
+            if !args.get("arguments").map(|v| v.is_object() || v.is_null()).unwrap_or(true) { return Err(DErr::Bad("roblox_studio arguments muss ein Objekt sein".into())); }
+            if crate::notion_roblox_plus::STUDIO_READS.contains(&action) { "read" } else { "write" }
+        }
+        "roblox_execute_luau" => "destructive",
+        "roblox_native_call" => {
+            let name = args["tool_name"].as_str().unwrap_or("");
+            if !session.native.contains(name) { return Err(DErr::Bad("Natives Tool ist nicht verfuegbar".into())); }
+            if crate::notion_roblox_plus::is_guarded(name) { "write" } else { "read" }
+        }
+        _ => return Err(DErr::Bad("Der Direkt-Agent darf nur Roblox-Studio-Tools nutzen".into())),
+    };
+    if risk != "read" && !approved { return Err(DErr::Forbidden("Diese Aenderung braucht eine frische Freigabe im Browser-Panel.".into())); }
+    {
+        let mut s = lock(&SESSION);
+        match s.as_mut() {
+            Some(x) if x.id == session_id => { x.calls += 1; x.last = Instant::now(); }
+            _ => return Err(DErr::Conflict("Direkt-Agent-Sitzung ist abgelaufen".into())),
+        }
+    }
+    match tool {
+        "roblox_studio" => {
+            let action = args["action"].as_str().unwrap_or("").to_string();
+            let nested = args.get("arguments").cloned().filter(|v| v.is_object()).unwrap_or_else(|| json!({}));
+            let result = crate::notion_roblox_plus::run_action(state, &action, &nested, 60).await?;
+            if risk != "read" { crate::notion_roblox_plus::record_event(state, "change", &action, &nested, "Direkt-Agent", result["snapshotId"].as_str()).await; }
+            Ok(json!({"tool": tool, "action": action, "risk": risk, "result": result}))
+        }
+        "roblox_execute_luau" => {
+            let code = args["code"].as_str().unwrap_or("");
+            if code.len() > 30_000 { return Err(DErr::Bad("Luau-Code darf hoechstens 30.000 Zeichen haben".into())); }
+            let mut a = args.clone();
+            a["timeout_seconds"] = json!(60);
+            let result = crate::notion_roblox_plus::execute_luau(state, &a).await?;
+            crate::notion_roblox_plus::record_event(state, "change", "execute_luau", &json!({}), "Direkt-Agent hat Luau ausgefuehrt", result["snapshotId"].as_str()).await;
+            Ok(json!({"tool": tool, "risk": risk, "result": result}))
+        }
+        _ => {
+            let name = args["tool_name"].as_str().unwrap_or("").to_string();
+            let native_args = args.get("arguments").cloned().filter(|v| v.is_object()).unwrap_or_else(|| json!({}));
+            let snapshot = if risk != "read" { crate::notion_roblox_plus::before_native_write(state, &name, &native_args).await } else { None };
+            let out = tokio::time::timeout(Duration::from_secs(65), crate::roblox_tool(state, &name, native_args.clone())).await
+                .map_err(|_| DErr::Conflict("Roblox Studio hat nicht rechtzeitig geantwortet".into()))?
+                .map_err(|e| DErr::Conflict(format!("{e:#}")))?;
+            if risk != "read" { crate::notion_roblox_plus::record_event(state, "change", &name, &native_args, "Direkt-Agent", snapshot.as_deref()).await; }
+            let text: String = out.text.chars().take(20_000).collect();
+            Ok(json!({"tool": tool, "native_tool": name, "risk": risk, "result": {"text": text, "images": out.images.len(), "snapshotId": snapshot}}))
+        }
+    }
+}
+
+pub(crate) async fn direct_handler(State(state): State<crate::AppState>, Path(op): Path<String>, headers: HeaderMap, body: axum::body::Bytes) -> Response {
+    let got = headers.get("authorization").and_then(|v| v.to_str().ok())
+        .filter(|a| a.len() > 7 && a[..7].eq_ignore_ascii_case("bearer ")).map(|a| a[7..].trim().to_string()).unwrap_or_default();
+    if !token_eq(&got, &crate::notion_mcp::web_token()) {
+        return (StatusCode::UNAUTHORIZED, Json(json!({"error": "Erweiterungs-Token ungueltig"}))).into_response();
+    }
+    let body: Value = serde_json::from_slice(&body).unwrap_or_else(|_| json!({}));
+    let result: Result<Value, DErr> = match op.as_str() {
+        "start" => direct_start(&state, &body).await,
+        "tool" => direct_tool(&state, &body).await,
+        "heartbeat" => get_session(body["session_id"].as_str().unwrap_or(""), body["agent_id"].as_str().unwrap_or("")).map(|_| {
+            if let Some(s) = lock(&SESSION).as_mut() { s.last = Instant::now(); }
+            json!({"ok": true})
+        }),
+        "stop" => {
+            let mut s = lock(&SESSION);
+            if s.as_ref().map(|x| Some(x.id.as_str()) == body["session_id"].as_str() && Some(x.agent_id.as_str()) == body["agent_id"].as_str()).unwrap_or(false) { *s = None; }
+            Ok(json!({"ok": true}))
+        }
+        _ => return StatusCode::NOT_FOUND.into_response(),
+    };
+    match result {
+        Ok(v) => Json(v).into_response(),
+        Err(DErr::Bad(e)) => (StatusCode::BAD_REQUEST, Json(json!({"error": e}))).into_response(),
+        Err(DErr::Forbidden(e)) => (StatusCode::FORBIDDEN, Json(json!({"error": e}))).into_response(),
+        Err(DErr::Conflict(e)) => (StatusCode::CONFLICT, Json(json!({"error": e}))).into_response(),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn tokens_and_writer_lock() {
+        assert!(token_eq("abc", "abc"));
+        assert!(!token_eq("abc", "abd"));
+        assert!(!token_eq("", ""));
+        assert!(notion_write_allowed().is_ok());
+        *lock(&SESSION) = Some(Session { id: "s".into(), agent_id: "agent-1".into(), provider: "claude".into(), last: Instant::now(), calls: 0, native: HashSet::new() });
+        assert!(notion_write_allowed().is_err());
+        *lock(&SESSION) = None;
+    }
+}
