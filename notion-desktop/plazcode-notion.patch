@@ -0,0 +1,174 @@
+//! AdiCode (unofficial fork): built-in coding skills and control tools
+//! for Notion AI. Skills are short, opinionated checklists the agent loads
+//! before it writes code (Roblox/Luau and general app development).
+
+use serde_json::{json, Value};
+
+pub(crate) const INSTRUCTIONS: &str = "AdiCode verbindet Notion AI mit diesem PC. Tempo: unabhaengige Tool-Aufrufe immer parallel im selben Schritt starten. Braucht ein Tool laenger als ~20 s, antwortet AdiCode sofort mit Hintergrund-Job N - dann NICHT warten oder neu starten, sondern direkt weiterarbeiten; das Ergebnis haengt sich automatisch an eine der naechsten Tool-Antworten (gezielt: adicode_job). Lange Befehle (Builds, Tests, Installationen, Releases, alles ueber ~50 s) mit pc_job starten und per action=status abfragen statt pc_PowerShell. Selten genutzte Add-ons (comfyui, robloxstudio) sind ausgeblendet: mit adicode_find_tools suchen und mit adicode_call aufrufen. Code lesen und suchen IMMER zuerst mit codebase_* (codebase_search_code, codebase_get_code_snippet, codebase_get_file_outline; Projektname aus project_memory_open oder codebase_list_projects) - viel schneller und kontextsparender als ganze Dateien lesen; pc_*/files_* nur zum Schreiben oder fuer Nicht-Code-Dateien. Mehrere Tabs an einer neuen Version: vor Code-Aenderungen cowork_release action=join (version, feature, files), fertig mit action=ready, veroeffentlichen nur nach cowork_release action=publish, danach action=done. roblox_* = Roblox Studio (Skripte lesen/bearbeiten, Luau ausfuehren, Spielbaum), pc_* = Windows-Steuerung (PowerShell, Dateien, Apps), browser_* = Browser, files_* = Local files (Pfade relativ zum Shared-Ordner), git_* = Git, context7_* = aktuelle Library-Doku, memory_* = Projektgedaechtnis, thinking_* = schrittweises Planen, github_* = GitHub. Vor dem Programmieren passenden Skill mit adicode_skill laden (roblox, roblox-studio, app, debug, git, cowork, blender, blender-model, blender-anim, brainstorm, plan, tdd, review, verify, finish, webapp-test, research, mcp-builder, toolbox). App-Entwicklung: brainstorm -> plan -> tdd -> review -> verify -> finish; nie fertig melden ohne verify. serena_* = semantische Code-Navigation/Refactoring, sqlite_* = lokale DB, time_* = Zeit, app_verify = Build/Lint/Tests im Hintergrund, adicode_profile = Tool-Profil (app/roblox/blender/all); Uebersicht im Skill toolbox. blender_* = Blender (MCP for Blender), blender_pro = Blender-Doctor/Setup/Python-Helfer adicode_blender; vor jeder Blender-Arbeit Skill blender laden. Co-Work: mehrere Notion-AI-Tabs arbeiten gleichzeitig an einem Projekt ueber cowork_* (start, join, claim, update, wait) - vorher Skill cowork laden. Vor dem Schreiben von Dateien erst lesen. Haengt ein Add-on: adicode_restart_server. adicode_status zeigt, was aktiv ist. Langzeit-Memory: Sobald der Nutzer ein Projekt nennt oder sagt, dass an Projekt X weitergearbeitet wird, VOR jeder Arbeit project_memory_open/search aufrufen. Nach jeder wesentlichen Aenderung und vor einem Themenwechsel project_memory_update aufrufen (summary = aktueller Stand; Architektur-Entscheidungen dauerhaft per codebase_manage_adr mode=set_sections; HANDOUT.md ist nur noch optional). Projekte strikt getrennt halten; nie auf den Chatverlauf als einziges Gedaechtnis vertrauen.";
+
+struct Skill { id: &'static str, title: &'static str, body: &'static str }
+
+const SKILLS: &[Skill] = &[
+    Skill { id: "roblox", title: "Roblox / Luau best practices", body: r#"Architecture
+- Server is authoritative. Never trust the client: validate every RemoteEvent/RemoteFunction argument (type, range, ownership, rate limit).
+- Layout: ServerScriptService (server logic), ReplicatedStorage (shared modules, Remotes folder), StarterPlayerScripts / StarterCharacterScripts (client), ServerStorage (server-only assets).
+- Prefer ModuleScripts with one responsibility each; keep Scripts/LocalScripts as thin entry points.
+- Use --!strict and type annotations in new modules. Use local variables, avoid globals (_G, shared).
+
+Luau style
+- task.wait / task.spawn / task.delay / task.defer instead of wait/spawn/delay.
+- game:GetService("X") at the top of the file. WaitForChild only for replicated instances on the client.
+- Disconnect connections (store RBXScriptConnection, or use Maid/Trove patterns) and clean up on PlayerRemoving / Destroying.
+- Avoid busy loops; use events (Changed, GetPropertyChangedSignal, Heartbeat with dt).
+
+Data
+- DataStoreService: wrap GetAsync/SetAsync/UpdateAsync in pcall with retries and backoff; prefer UpdateAsync; save on PlayerRemoving and game:BindToClose; use session locking for important data (ProfileStore pattern).
+- Never store Instances in DataStores; serialize to plain tables. Version the schema.
+
+Security & economy
+- Purchases: MarketplaceService.ProcessReceipt must be idempotent and return PurchaseGranted only after data is saved.
+- Rate-limit remotes per player; kick or ignore on abuse. Sanity-check positions/distances server-side.
+
+Performance
+- Use CollectionService tags instead of scanning the tree. Pool frequently created parts. Keep heavy work off RenderStepped.
+- StreamingEnabled for big maps; anchor static parts; reduce unions/meshes collision fidelity where possible.
+
+UI
+- ScreenGui with ResetOnSpawn=false for persistent UI; use UIScale/UIAspectRatioConstraint for mobile; TweenService for animation.
+
+Done checklist
+- No errors in Output, works with 2+ players (Test > Clients and Servers), remotes validated, data saves on leave and on shutdown."# },
+    Skill { id: "roblox-studio", title: "Working in Roblox Studio via AdiCode tools", body: r#"0. Think first: if the task is unclear or has several reasonable approaches, propose 2-3 concrete options (effort + your recommendation), ask your clarifying questions and WAIT for the answer before changing the place.
+1. Call roblox_list_roblox_studios and pick the studio_id; every roblox_* tool needs it.
+2. Explore first: get the game tree / search for scripts before editing. Read the full script source before changing it.
+3. Make small, targeted edits; keep existing style. Explain what changed and where (full instance path).
+4. Verify: run a quick check with execute_luau (e.g. require the module, print results) and read Output/log for errors.
+5. Never publish or overwrite places without explicit user confirmation.
+6. For bigger features: plan with thinking_* first, then implement module by module, testing after each step.
+7. For external code workflows prefer Rojo (default.project.json) + Git so scripts live as files in the repo."# },
+    Skill { id: "app", title: "App development workflow", body: r#"Start
+- Clarify target (web, mobile, desktop), stack and constraints. Default picks: web = Vite + React + TypeScript (or Next.js when SSR/API routes are needed); mobile = Expo (React Native) + TypeScript; backend = Node/TypeScript or Python FastAPI; DB = SQLite/Postgres (Supabase when auth+DB are needed fast).
+- Look up current APIs with context7_* before using a library; do not guess versions.
+
+Structure
+- src/ split by feature, not by file type. Keep UI, state and data access separate. Config via .env (never commit secrets; add .env to .gitignore and provide .env.example).
+- TypeScript strict mode, ESLint + Prettier. Small functions, clear names, no dead code.
+
+Loop
+1. Read the existing code and README first (files_* or pc_FileSystem).
+2. Plan the change in a few steps; implement the smallest working slice.
+3. Run it: install deps, start dev server in the background, check output; fix errors before moving on.
+4. Add/adjust tests for logic (Vitest/Jest, pytest). Run lint + tests.
+5. Commit with a clear message (git skill).
+
+Quality
+- Handle loading/error/empty states in UI. Validate input on the server. Accessibility: labels, contrast, keyboard.
+- Release: production build passes, env vars documented, version bumped, changelog updated."# },
+    Skill { id: "debug", title: "Debugging procedure", body: r#"1. Reproduce: get the exact error message, stack trace and steps. Read logs (Roblox Output, terminal, browser console via browser_*).
+2. Locate: find the failing file/line; read surrounding code and recent changes (git diff / git log).
+3. Hypothesize: list 2-3 likely causes, ordered by probability. Check the cheapest first.
+4. Verify with evidence: add temporary prints/logs or run a minimal snippet (execute_luau, node -e, python -c).
+5. Fix the root cause, not the symptom. Keep the fix minimal.
+6. Confirm: re-run the repro, run tests, remove temporary logging.
+7. Report: cause, fix, how it was verified, and any follow-ups."# },
+    Skill { id: "git", title: "Git workflow", body: r#"- Before changes: git status, git pull (or fetch) and make sure the tree is clean; work on a branch for bigger features (feature/<name>).
+- Commit small logical units; message: imperative summary <= 72 chars, optional body with the why.
+- Never commit secrets, tokens, .env, build output or node_modules; keep .gitignore up to date.
+- Before pushing: run build/tests, review git diff --staged.
+- Do not force-push shared branches or rewrite published history without explicit user confirmation.
+- Releases: bump version file, tag (vX.Y.Z), write release notes."# },
+    Skill { id: "project-memory", title: "Durable multi-project memory across long chats", body: r#"Purpose
+- A Notion chat is not infinite. Treat the chat as a temporary interface and project_memory_* plus HANDOUT.md as the durable source of truth.
+- Every project has its own namespace (for example Aurelune, PlazCode, AdiCode). Never mix decisions between projects.
+
+On project selection / switching
+1. If the user says "continue X", "work on X" or names a project: project_memory_open(name=X). If the exact name is unclear, project_memory_search/list first.
+2. Read the registered HANDOUT.md and current repository before planning. Briefly mention only missing or conflicting context.
+3. Work normally. The Main chat remains the only user interface; worker tabs receive tasks through cowork_*.
+
+After material work
+1. Update that project's HANDOUT.md: current architecture, decisions, build/release workflow, pitfalls, changelog, and next tasks. Keep it concise and factual.
+2. Call project_memory_update with the same stable project name, a compact current summary, and handout_path. The background watcher then keeps future HANDOUT changes synchronized.
+3. Before switching to another project, save the old project first. Opening another project never deletes prior memory.
+
+Context pressure
+- Do not try to retain an unlimited raw transcript. Preserve decisions, interfaces, file paths, commands, failures and next steps; omit chatter and duplicated status.
+- If a response suggests context was lost, stop and reload project_memory_open plus HANDOUT.md before continuing."# },    Skill { id: "cowork", title: "Co-Work: several Notion AI chats work on one project (no fixed roles, everybody helps)", body: r#"Co-Work lets several Notion AI chats (browser tabs) build one project in parallel via a shared board (cowork_* tools). There is no fixed main chat and there are no fixed roles: the chat the user writes in starts the project and is the only interface to the user; all other tabs join automatically and help with ALL work.
+HOW WORK IS SPLIT (automatic):
+- Every user prompt opens a "wave": cowork_start (project start) and cowork_prompt (every new user message mid-project). Each other agent first gets an assess task: evaluate the prompt (plan, files, risks, acceptance criteria, tests) and propose missing sub-tasks via cowork_update tasks=[...]. Work tasks of the wave start when all evaluations are in.
+- cowork_claim order: own evaluation -> own Arbeitspaket (lane) -> reviews -> every other free task. So nobody idles while work is open.
+- Reviews never go to the author; requested changes become fix tasks (max 2 rounds, then the starting chat decides).
+- AdiCode wakes idle chats automatically with messages starting with [AdiCode Co-Work] (they come from the system, not the user).
+STARTING CHAT (the chat the user writes in):
+1. Identify the project, project_memory_open + HANDOUT.md, inspect the current code so tasks are concrete. Small questions: just answer them yourself.
+2. cowork_start with title, goal (user request, stack, folders, conventions, interfaces) and 4-12 small PARALLEL tasks (so all agents can work at once). Each task: title, detail with acceptance criteria, area, files it touches, depends_on only for real ordering.
+3. Every further user message during the project: cowork_prompt first (the others evaluate it), then continue.
+4. Orchestrate with cowork_wait: integrate evaluations (cowork_add_tasks / cowork_message), solve blockers, and claim tasks yourself when nothing needs coordination.
+5. When all tasks are done: cowork_results, update HANDOUT.md, project_memory_update, then give ONE short optimized answer. Close the project only if the user wants.
+OTHER TABS:
+1. cowork_join (with your agent name); pass the agent name on every cowork call.
+2. Loop: cowork_claim -> load the matching skill (roblox, roblox-studio, app, debug, git) -> read files before editing -> change only the task files (lock extra files with cowork_lock) -> verify -> cowork_update status=done with a short, precise result (what, which files, how tested). Task too big: split it with tasks=[...] so others can help.
+3. Assess tasks: max ~10 lines + proposed tasks. Review tasks: read, do not rewrite; status=done (short verdict) or status=changes with numbered concrete points.
+4. No free task: cowork_wait (repeat). Problems: cowork_message to the starting chat or status=blocked with the reason. Do not ask the user.
+RULES: never edit a file locked by another agent; results are required for done/changes/blocked; do not redo tasks owned by others; do not close the project. The AdiCode desktop app shows the live status (Co-Work page and Chat tab)."# },
+    Skill { id: "blender", title: "Blender Pro: workflow, quality bar, verification loop", body: crate::notion_blender::SKILL_CORE },
+    Skill { id: "blender-model", title: "Blender modeling, materials, assets, AI meshes", body: crate::notion_blender::SKILL_MODEL },
+    Skill { id: "blender-anim", title: "Blender animation, rigging, mocap, physics, camera", body: crate::notion_blender::SKILL_ANIM },
+    Skill { id: "brainstorm", title: "Brainstorm: clarify goal, 2-3 approaches, approved design doc before code", body: crate::notion_skills_dev::BRAINSTORM },
+    Skill { id: "plan", title: "Plan: bite-sized 2-5 min tasks with files, tests, verify commands", body: crate::notion_skills_dev::PLAN },
+    Skill { id: "tdd", title: "Test-driven development: red-green-refactor", body: crate::notion_skills_dev::TDD },
+    Skill { id: "review", title: "Code review by severity (diff-based)", body: crate::notion_skills_dev::REVIEW },
+    Skill { id: "verify", title: "Verify: build/typecheck/lint/tests before claiming done", body: crate::notion_skills_dev::VERIFY },
+    Skill { id: "finish", title: "Finish a branch: verify, review, docs, merge/PR options", body: crate::notion_skills_dev::FINISH },
+    Skill { id: "webapp-test", title: "Test web apps with Playwright browser tools", body: crate::notion_skills_dev::WEBAPP_TEST },
+    Skill { id: "research", title: "Research: Context7, fetch, GitHub", body: crate::notion_skills_dev::RESEARCH },
+    Skill { id: "mcp-builder", title: "Build high-quality MCP servers/tools", body: crate::notion_skills_dev::MCP_BUILDER },
+    Skill { id: "toolbox", title: "Which AdiCode tool for what", body: crate::notion_skills_dev::TOOLBOX },
+];
+
+fn list_text() -> String {
+    let mut out = String::from("Verfuegbare Skills (adicode_skill mit name aufrufen):\n");
+    for s in SKILLS { out.push_str(&format!("- {}: {}\n", s.id, s.title)); }
+    out
+}
+
+pub(crate) fn skill_tool() -> Value {
+    let ids: Vec<&str> = SKILLS.iter().map(|s| s.id).collect();
+    let list = SKILLS.iter().map(|s| format!("{} = {}", s.id, s.title)).collect::<Vec<_>>().join("; ");
+    json!({
+        "name": "adicode_skill",
+        "description": format!("AdiCode: laedt einen eingebauten Coding-Skill (Checkliste + Best Practices). Vor dem Programmieren aufrufen. Skills: {list}. Ohne name = Liste."),
+        "inputSchema": {"type": "object", "properties": {"name": {"type": "string", "enum": ids, "description": "Skill-ID"}}},
+        "annotations": {"readOnlyHint": true}
+    })
+}
+
+pub(crate) fn skill_text(args: &Value) -> String {
+    match args["name"].as_str().map(str::trim).filter(|n| !n.is_empty()) {
+        Some(name) => match SKILLS.iter().find(|s| s.id.eq_ignore_ascii_case(name)) {
+            Some(s) => format!("# {}\n\n{}", s.title, s.body),
+            None => format!("Unbekannter Skill '{name}'.\n{}", list_text()),
+        },
+        None => list_text(),
+    }
+}
+
+pub(crate) fn restart_tool() -> Value {
+    json!({
+        "name": "adicode_restart_server",
+        "description": "AdiCode: startet ein haengendes MCP-Add-on neu (z. B. pc, browser, files, git) oder alle mit 'all'. Roblox Studio ist nicht betroffen.",
+        "inputSchema": {"type": "object", "properties": {"server": {"type": "string", "description": "Add-on-ID wie pc, browser, files, git oder 'all'"}}, "required": ["server"]}
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn skills_resolve() {
+        assert!(skill_text(&json!({"name": "roblox"})).contains("Server is authoritative"));
+        assert!(skill_text(&json!({})).contains("roblox-studio"));
+        assert!(skill_text(&json!({"name": "nope"})).contains("Unbekannter Skill"));
+        assert_eq!(skill_tool()["name"], "adicode_skill");
+    }
+}
\ No newline at end of file
