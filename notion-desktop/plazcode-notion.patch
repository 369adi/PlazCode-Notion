+fn cmd_uses(cmd: &str, dir: &str) -> bool {
+    let (cmd, dir) = (cmd.to_ascii_lowercase(), dir.to_ascii_lowercase());
+    cmd.match_indices(&dir).any(|(i, _)| !cmd[i + dir.len()..].starts_with(|c: char| c.is_ascii_digit()))
