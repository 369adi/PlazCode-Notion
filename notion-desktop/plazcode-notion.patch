+struct Project {
+    id: String,
+    title: String,
+    goal: String,
+    created: i64,
+    lead: String,
+    stale_minutes: u64,
+    agents: BTreeMap<String, Agent>,
+    tasks: Vec<Task>,
+    messages: Vec<Msg>,
+    locks: BTreeMap<String, Lock>,
+    next_task: u64,
+    next_msg: u64,
+    next_agent: u64,
+    waves: Vec<Wave>,
+}
