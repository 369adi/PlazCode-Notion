+/// `roblox_execute_luau` mit BW-Helfern und optionalen Snapshots.
+pub async fn execute_luau(state: &crate::AppState, args: &Value) -> Result<Value, String> {
+    let code = args["code"].as_str().or_else(|| args["source"].as_str()).unwrap_or("").to_string();
+    let use_helpers = args["use_helpers"].as_bool().unwrap_or(true);
+    let datamodel = args["datamodel_type"].as_str().unwrap_or("Edit").to_string();
+    let timeout = num(args, "timeout_seconds", 20).clamp(3, 180) as u64;
+    let mut snapshot = None;
+    if let Some(list) = args.get("snapshot_paths").and_then(|v| v.as_array()) {
+        if list.len() > 50 { return Err("snapshot_paths: hoechstens 50 Pfade".into()); }
+        let paths: Vec<String> = list.iter().filter_map(|p| p.as_str().map(String::from)).collect();
+        if !paths.is_empty() { snapshot = take_snapshot(state, &paths, "before raw Luau").await?["snapshotId"].as_str().map(String::from); }
+    }
+    let uses_bw = use_helpers && BW_RE.is_match(&code);
+    let full = if uses_bw { format!("{HELPERS}\n{code}") } else { code };
+    match exec_luau(state, full, timeout, &datamodel).await {
+        Ok(text) => Ok(json!({"text": short(&text, MAX_RESULT), "helpers_loaded": uses_bw, "snapshotId": snapshot})),
+        Err(e) if uses_bw => {
+            let offset = HELPERS.matches('\n').count() + 1;
+            let re = Regex::new(r#"(\]|\.luau|"|'|\w):(\d+):"#).unwrap();
+            Err(re.replace_all(&e, |c: &regex::Captures| {
+                let line: usize = c[2].parse().unwrap_or(0);
+                if line > offset { format!("{}{}:", &c[1], line - offset) } else { format!("{}BW-helper:", &c[1]) }
+            }).to_string())
+        }
+        Err(e) => Err(e),
+    }
+}
