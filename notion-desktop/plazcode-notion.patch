+# ---------------------------------------------------------------- render
+def render_settings(engine="EEVEE", samples=None, res=(1920, 1080), fps=None, motion_blur=True, denoise=True, transparent=False, quality="high"):
+    """Engine EEVEE|CYCLES|WORKBENCH with sane quality defaults (Cycles GPU + denoise)."""
+    sc = bpy.context.scene
+    r = sc.render
+    ids = {"EEVEE": ["BLENDER_EEVEE_NEXT", "BLENDER_EEVEE"], "CYCLES": ["CYCLES"], "WORKBENCH": ["BLENDER_WORKBENCH"]}[engine.upper()]
+    for i in ids:
+        try:
+            r.engine = i
+            break
+        except TypeError:
+            continue
+    r.resolution_x, r.resolution_y = res
+    r.resolution_percentage = 100
+    r.film_transparent = transparent
+    if fps:
+        r.fps = fps
+    r.use_motion_blur = motion_blur
+    if r.engine == "CYCLES":
+        gpu()
+        sc.cycles.samples = samples or {"draft": 64, "high": 256, "final": 1024}[quality]
+        sc.cycles.use_denoising = denoise
+        sc.cycles.use_adaptive_sampling = True
+    elif "EEVEE" in r.engine:
+        e = sc.eevee
+        if hasattr(e, "taa_render_samples"):
+            e.taa_render_samples = samples or {"draft": 16, "high": 64, "final": 128}[quality]
+        for attr in ("use_raytracing", "use_shadows"):
+            if hasattr(e, attr):
+                setattr(e, attr, True)
+    return {"engine": r.engine, "res": list(res), "fps": r.fps}
+
+
+def _out(name):
+    os.makedirs(OUT_DIR, exist_ok=True)
+    return name if os.path.isabs(name) else os.path.join(OUT_DIR, name)
