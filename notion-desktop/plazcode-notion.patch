+fn safe_name(s: &str) -> String {
+    let n: String = s.chars().map(|c| if c.is_alphanumeric() || ".-_ ()[]".contains(c) { c } else { '_' }).take(120).collect();
+    let n = n.trim().trim_matches('.').to_string();
+    if n.is_empty() { "datei".into() } else { n }
