+static GUARDED: Lazy<Regex> = Lazy::new(|| Regex::new(r"(?i)(create|edit|modify|delete|remove|insert|upload|generate|set_|update|clone|multi_edit|execute_luau|start_stop_play|user_keyboard_input|user_mouse_input)").unwrap());
+static BW_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"\bBW\s*[.:]").unwrap());
+static GETSERVICE: Lazy<Regex> = Lazy::new(|| Regex::new(r#"^game\s*:\s*GetService\s*\(\s*['"]([^'"]+)['"]\s*\)"#).unwrap());
+static CLASS_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"^[A-Za-z][A-Za-z0-9]*$").unwrap());
+static TARGET_VALUE: Lazy<Regex> = Lazy::new(|| Regex::new(r"^(?:game[.:]|Workspace[.\[])\S+").unwrap());
+static TARGET_KEY: Lazy<Regex> = Lazy::new(|| Regex::new(r"(?i)path|script|target|instance").unwrap());
