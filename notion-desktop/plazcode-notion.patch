+//! AdiCode 1.0.8: Roblox-Funktionen aus Secretscript (Notion Bridge) portiert.
+//!
+//! * `roblox_studio` - 23 High-Level-Aktionen (bauen, lesen, patchen, loeschen ...)
+//!   mit automatischen Snapshots vor jeder Aenderung (ServerStorage/__BrickwireSnapshots)
+//! * `roblox_workflow` - Playbooks fuer Build, Scripting, UI, VFX, Gameplay, Debug
+//! * `roblox_project_memory` - dauerhafte Notizen pro Place
+//! * BW-Helfer: `roblox_execute_luau` laedt `roblox_helpers.luau` automatisch, wenn der
+//!   Code `BW.` benutzt, und kann vorher Snapshots anlegen.
+
+use once_cell::sync::Lazy;
+use regex::Regex;
+use serde_json::{json, Map, Value};
+use std::{path::PathBuf, sync::Mutex, time::Duration};
+
+const OPEN: &str = "BWJSON<<";
+const CLOSE: &str = ">>BWJSON";
+const MAX_RESULT: usize = 20_000;
+pub const HELPERS: &str = include_str!("roblox_helpers.luau");
+
+pub const STUDIO_ACTIONS: &[&str] = &[
+    "status", "project_info", "get_game_tree", "read_instance", "create_instance", "create_part",
+    "create_instance_tree", "create_model", "create_ui", "create_vfx", "modify_instance",
+    "delete_instance", "clone_instance", "create_script", "read_script", "set_script_source",
+    "patch_script", "search_scripts", "delete_script", "take_snapshot", "list_snapshots",
+    "restore_snapshot", "get_errors",
+];
+pub const STUDIO_READS: &[&str] = &["status", "project_info", "get_game_tree", "read_instance", "read_script", "search_scripts", "list_snapshots", "get_errors"];
+
+pub const INSTRUCTIONS_EXTRA: &str = "Neu in 1.0.8 (aus Secretscript):\n\
+- roblox_studio(action, arguments): sichere High-Level-Aktionen (project_info, get_game_tree, read_instance, read_script, search_scripts, create_part/model/ui/vfx/script/instance_tree, modify_instance, clone_instance, patch_script, set_script_source, delete_*, get_errors). Jede Aenderung legt automatisch einen Snapshot an; rueckgaengig mit action=restore_snapshot.\n\
+- roblox_execute_luau laedt die BW-Helfer automatisch, sobald der Code BW.* nutzt (BW.model, BW.ui, BW.particles, BW.patch, BW.weldAll, BW.leaderstats, BW.logs ...). Optional snapshot_paths.\n\
+- roblox_workflow(category) liefert Playbooks; roblox_project_memory merkt sich wichtige Scripts/GUIs/Systeme pro Place.\n\
+- safe_read_file/safe_write_file: Dateien im Shared-Ordner mit SHA-256-Schutz (zuerst lesen, dann mit expected_sha256 schreiben).";
+
+static GUARDED: Lazy<Regex> = Lazy::new(|| Regex::new(r"(?i)(create|edit|modify|delete|remove|insert|upload|generate|set_|update|clone|multi_edit|execute_luau|start_stop_play|user_keyboard_input|user_mouse_input)").unwrap());
+static BW_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"\bBW\s*[.:]").unwrap());
+static GETSERVICE: Lazy<Regex> = Lazy::new(|| Regex::new(r#"^game\s*:\s*GetService\s*\(\s*['"]([^'"]+)['"]\s*\)"#).unwrap());
+static CLASS_RE: Lazy<Regex> = Lazy::new(|| Regex::new(r"^[A-Za-z][A-Za-z0-9]*$").unwrap());
+static TARGET_VALUE: Lazy<Regex> = Lazy::new(|| Regex::new(r"^(?:game[.:]|Workspace[.\[])\S+").unwrap());
+static TARGET_KEY: Lazy<Regex> = Lazy::new(|| Regex::new(r"(?i)path|script|target|instance").unwrap());
+
+static PROJECT: Lazy<Mutex<Option<Value>>> = Lazy::new(|| Mutex::new(None));
+static OP_LOCK: Lazy<tokio::sync::Mutex<()>> = Lazy::new(|| tokio::sync::Mutex::new(()));
+static MEMORY_LOCK: Lazy<Mutex<()>> = Lazy::new(|| Mutex::new(()));
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> { m.lock().unwrap_or_else(|e| e.into_inner()) }
+
+pub fn is_guarded(name: &str) -> bool { GUARDED.is_match(name) }
+
+// ---------------------------------------------------------------- Luau-Prelude
+
+const PRELUDE: &str = r##"local HttpService = game:GetService("HttpService")
+local ChangeHistoryService = game:GetService("ChangeHistoryService")
+local function bw_resolve(segs)
+	local cur = game
+	for i = 2, #segs do
+		local name = segs[i]
+		local nxt = cur:FindFirstChild(name)
+		if not nxt and cur == game then local ok, svc = pcall(function() return game:GetService(name) end); if ok then nxt = svc end end
+		if not nxt then return nil, "not found: " .. tostring(name) end
+		cur = nxt
+	end
+	return cur
+end
+local function bw_must(segs)
+	local inst, err = bw_resolve(segs)
+	if not inst then error(err, 0) end
+	return inst
+end
+local function bw_path(inst)
+	local parts, cur = {}, inst
+	while cur and cur ~= game do
+		table.insert(parts, 1, cur.Name)
+		cur = cur.Parent
+	end
+	return "game." .. table.concat(parts, ".")
+end
+local function bw_decode(v)
+	if type(v) ~= "table" or v["$type"] == nil then return v end
+	local kind, a = v["$type"], v.value
+	if kind == "Vector3" then return Vector3.new(a[1],a[2],a[3])
+	elseif kind == "Vector2" then return Vector2.new(a[1],a[2])
+	elseif kind == "Color3" then if type(a) == "string" then return Color3.fromHex(a) end; return Color3.fromRGB(a[1],a[2],a[3])
+	elseif kind == "UDim2" then return UDim2.new(a[1],a[2],a[3],a[4])
+	elseif kind == "UDim" then return UDim.new(a[1],a[2])
+	elseif kind == "CFrame" then return CFrame.new(table.unpack(a))
+	elseif kind == "Enum" then return Enum[v.enum][a]
+	elseif kind == "BrickColor" then return BrickColor.new(a)
+	elseif kind == "NumberRange" then return NumberRange.new(a[1],a[2] or a[1])
+	elseif kind == "Ref" then return bw_must(v.segs) end
+	error("unsupported typed value " .. tostring(kind), 0)
+end
+local function bw_enc(v)
+	local kind = typeof(v)
+	if kind == "Vector3" then return { ["$type"]="Vector3", value={v.X,v.Y,v.Z} }
+	elseif kind == "Vector2" then return { ["$type"]="Vector2", value={v.X,v.Y} }
+	elseif kind == "Color3" then return { ["$type"]="Color3", value={math.floor(v.R*255+0.5),math.floor(v.G*255+0.5),math.floor(v.B*255+0.5)} }
+	elseif kind == "UDim2" then return { ["$type"]="UDim2", value={v.X.Scale,v.X.Offset,v.Y.Scale,v.Y.Offset} }
+	elseif kind == "EnumItem" then return { ["$type"]="Enum", enum=tostring(v.EnumType), value=v.Name }
+	elseif kind == "Instance" then return { ["$type"]="Ref", path=bw_path(v) }
+	elseif kind == "BrickColor" then return { ["$type"]="BrickColor", value=v.Name }
+	elseif kind == "number" and (v ~= v or v == math.huge or v == -math.huge) then return tostring(v) end
+	return v
+end
+local function bw_coerce(inst, prop, raw)
+	local v = bw_decode(raw)
+	local ok, current = pcall(function() return inst[prop] end)
+	if ok and type(v) == "table" and typeof(v) == "table" then
+		local t = typeof(current)
+		if t == "Vector3" then return Vector3.new(v[1],v[2],v[3])
+		elseif t == "Vector2" then return Vector2.new(v[1],v[2])
+		elseif t == "Color3" then return Color3.fromRGB(v[1],v[2],v[3])
+		elseif t == "UDim2" then return UDim2.new(v[1],v[2],v[3],v[4])
+		elseif t == "CFrame" then return CFrame.new(table.unpack(v)) end
+	elseif ok and type(v) == "string" and typeof(current) == "Color3" and string.sub(v,1,1) == "#" then
+		return Color3.fromHex(v)
+	elseif ok and type(v) == "string" and typeof(current) == "BrickColor" then
+		return BrickColor.new(v)
+	end
+	return v
+end
+local function bw_apply(inst, props)
+	local errors = {}
+	for prop, raw in pairs(props or {}) do
+		if prop ~= "Parent" and prop ~= "ClassName" then
+			local ok, err = pcall(function() inst[prop] = bw_coerce(inst, prop, raw) end)
+			if not ok then table.insert(errors, {property=prop,error=tostring(err)}) end
+		end
+	end
+	return errors
+end
+local function bw_create_tree(node, parent, created, errors)
+	local inst = Instance.new(node.className)
+	if node.name ~= nil then inst.Name = node.name end
+	for _, err in ipairs(bw_apply(inst, node.properties)) do err.path = node.name or node.className; table.insert(errors, err) end
+	for k, v in pairs(node.attributes or {}) do local ok, err = pcall(function() inst:SetAttribute(k,bw_decode(v)) end); if not ok then table.insert(errors,{attribute=k,error=tostring(err)}) end end
+	if node.source ~= nil and inst:IsA("LuaSourceContainer") then inst.Source = node.source end
+	for _, child in ipairs(node.children or {}) do bw_create_tree(child, inst, created, errors) end
+	inst.Parent = parent
+	table.insert(created, bw_path(inst))
+	return inst
+end
+"##;
+
+// ---------------------------------------------------------------- Luau-Bodies
+
+const SNAP_BODY: &str = r##"local ss = game:GetService("ServerStorage")
+local store = ss:FindFirstChild("__BrickwireSnapshots")
+if not store then store = Instance.new("Folder"); store.Name = "__BrickwireSnapshots"; store.Parent = ss end
+local snap = Instance.new("Folder"); snap.Name = ARGS.id; snap:SetAttribute("Label", ARGS.label); snap:SetAttribute("CreatedAt", os.time())
+local entries = {}
+for i, segs in ipairs(ARGS.segsList) do
+	local inst = bw_resolve(segs)
+	local entry = {index=i, path=ARGS.paths[i], segs=segs, absent=inst == nil, saved=false}
+	if inst then
+		entry.parentSegs = {}; for j=1,#segs-1 do table.insert(entry.parentSegs,segs[j]) end
+		entry.name = inst.Name
+		local ok, clone = pcall(function() return inst:Clone() end)
+		if ok and clone then
+			clone.Name = tostring(i); clone:SetAttribute("BW_OriginalName", inst.Name)
+			for _, d in ipairs(clone:GetDescendants()) do if d:IsA("BaseScript") then d:SetAttribute("BW_WasDisabled",d.Disabled); d.Disabled=true end end
+			if clone:IsA("BaseScript") then clone:SetAttribute("BW_WasDisabled",clone.Disabled); clone.Disabled=true end
+			clone.Parent=snap; entry.saved=true
+		else entry.reason="not archivable" end
+	end
+	table.insert(entries,entry)
+end
+snap:SetAttribute("Entries",HttpService:JSONEncode(entries)); snap.Parent=store
+return {snapshotId=ARGS.id, label=ARGS.label, entries=entries}"##;
+
+const LOGS_BODY: &str = r##"local history=game:GetService("LogService"):GetLogHistory(); local out={}
+for i=#history,1,-1 do local e=history[i]; local n=e.messageType and e.messageType.Name or "MessageOutput"; if n=="MessageError" or n=="MessageWarning" then table.insert(out,1,"["..n.."] "..e.message); if #out>=ARGS.limit then break end end end
+return {lines=out,count=#out}"##;
+
+const LIST_SNAP_BODY: &str = r##"local store=game:GetService("ServerStorage"):FindFirstChild("__BrickwireSnapshots"); local out={}
+if store then for _,s in ipairs(store:GetChildren()) do local ok,e=pcall(function() return HttpService:JSONDecode(s:GetAttribute("Entries") or "[]") end); table.insert(out,{id=s.Name,label=s:GetAttribute("Label"),createdAt=s:GetAttribute("CreatedAt"),entries=if ok then e else {}}) end end
+return {snapshots=out}"##;
+
+const RESTORE_BODY: &str = r##"local store=game:GetService("ServerStorage"):FindFirstChild("__BrickwireSnapshots"); local snap=store and store:FindFirstChild(ARGS.id); if not snap then error("snapshot not found",0) end
+local entries=HttpService:JSONDecode(snap:GetAttribute("Entries") or "[]"); local restored,removed,failed={},{},{}
+for _,e in ipairs(entries) do local current=bw_resolve(e.segs)
+	if e.absent then if current then current:Destroy(); table.insert(removed,e.path) end
+	elseif e.saved then local saved=snap:FindFirstChild(tostring(e.index)); local parent=bw_resolve(e.parentSegs)
