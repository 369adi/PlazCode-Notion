+fn checked_files(v: &Value) -> Result<Vec<String>, String> {
+    let root = std::fs::canonicalize(uploads()).ok();
+    let mut out = Vec::new();
+    for f in v.as_array().cloned().unwrap_or_default() {
+        let p = f.as_str().ok_or("Ungueltiger Dateipfad.")?;
+        let c = std::fs::canonicalize(p).map_err(|_| format!("Datei fehlt: {p}"))?;
+        if !root.as_ref().map(|r| c.starts_with(r)).unwrap_or(false) { return Err("Nur Dateien aus dem AdiCode-Upload sind erlaubt.".into()); }
+        let s = c.display().to_string();
+        out.push(s.strip_prefix(r"\\?\").map(str::to_string).unwrap_or(s));
+    }
+    Ok(out)
+}
