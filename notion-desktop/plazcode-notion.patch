+fn workflow_text(category: &str) -> String {
+    let helpers = "BW-Helfer (in roblox_execute_luau automatisch geladen): BW.find/get/exists, BW.new/part/folder/model, BW.set, BW.weldAll, BW.tree/report/check, BW.script/source/patch/scan, BW.remote, BW.screen/ui, BW.particles/light, BW.leaderstats, BW.killPart, BW.logs.";
+    if category == "all" {
+        let mut s: Vec<String> = WORKFLOWS.iter().map(|(k, v)| format!("## {k}\n{v}")).collect();
+        s.push(helpers.into());
+        return s.join("\n\n");
+    }
+    let text = WORKFLOWS.iter().find(|(k, _)| *k == category).map(|(_, v)| *v).unwrap_or(WORKFLOWS[0].1);
+    format!("{}\n\n{text}\n\n{helpers}", WORKFLOWS[0].1)
+}
+
+fn ok_text(v: Value) -> Value {
+    let text = match v { Value::String(s) => s, other => serde_json::to_string_pretty(&other).unwrap_or_default() };
+    json!({"content": [{"type": "text", "text": short(&text, 60_000)}]})
+}
+fn err_text(e: String) -> Value { json!({"isError": true, "content": [{"type": "text", "text": e}]}) }
+
+/// Behandelt die neuen Roblox-Tools; `None` = nicht zustaendig.
+pub async fn call(state: &crate::AppState, name: &str, args: &Value) -> Option<Value> {
+    match name {
+        "roblox_workflow" => Some(ok_text(Value::String(workflow_text(args["category"].as_str().unwrap_or("general"))))),
+        "roblox_project_memory" => Some(match project_memory(state, args).await { Ok(v) => ok_text(v), Err(e) => err_text(e) }),
+        "roblox_studio" => {
+            let action = args["action"].as_str().unwrap_or("").to_string();
+            let nested = args.get("arguments").cloned().filter(|v| v.is_object()).unwrap_or_else(|| json!({}));
+            let write = !STUDIO_READS.contains(&action.as_str());
+            if write { if let Err(e) = crate::notion_web_agents::notion_write_allowed() { return Some(err_text(e)); } }
+            let timeout = num(args, "timeout_seconds", 30) as u64;
+            Some(match run_action(state, &action, &nested, timeout).await {
+                Ok(v) => {
+                    if write && STUDIO_ACTIONS.contains(&action.as_str()) {
+                        let snap = v["snapshotId"].as_str().map(String::from);
+                        record_event(state, "change", &action, &nested, "", snap.as_deref()).await;
+                    }
+                    ok_text(v)
+                }
+                Err(e) => {
+                    record_event(state, "error", &action, &nested, &e, None).await;
+                    err_text(e)
+                }
+            })
+        }
+        "roblox_execute_luau" => {
+            if let Err(e) = crate::notion_web_agents::notion_write_allowed() { return Some(err_text(e)); }
+            Some(match execute_luau(state, args).await {
+                Ok(v) => {
+                    let paths = args["snapshot_paths"].as_array().map(|l| l.iter().filter_map(|p| p.as_str()).collect::<Vec<_>>().join(",")).unwrap_or_default();
+                    record_event(state, "change", "execute_luau", &json!({"path": paths}), "Luau ausgefuehrt (Quelltext nicht gespeichert)", v["snapshotId"].as_str()).await;
+                    ok_text(v)
+                }
+                Err(e) => err_text(e),
+            })
+        }
+        _ => None,
+    }
+}
+
+/// Ergaenzt das Schema des nativen execute_luau um die neuen Optionen.
+pub fn extend_execute_luau_schema(schema: &mut Value) {
+    if let Some(props) = schema.pointer_mut("/inputSchema/properties").and_then(|p| p.as_object_mut()) {
+        props.insert("use_helpers".into(), json!({"type": "boolean", "description": "BW-Helferbibliothek automatisch laden, wenn der Code BW.* nutzt (Standard true)."}));
+        props.insert("snapshot_paths".into(), json!({"type": "array", "items": {"type": "string"}, "description": "Optionale Instanzpfade (max. 50), die vorher als Snapshot gesichert werden."}));
+        props.insert("timeout_seconds".into(), json!({"type": "integer", "minimum": 3, "maximum": 180}));
+    }
+    if let Some(d) = schema["description"].as_str() {
+        schema["description"] = Value::String(format!("{d} | AdiCode: BW-Helfer werden automatisch geladen; snapshot_paths sichert Instanzen vorher."));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn paths_and_luau() {
+        assert_eq!(path_segments("Workspace.Map").unwrap(), vec!["game", "Workspace", "Map"]);
+        assert_eq!(path_segments("game:GetService(\"ReplicatedStorage\").Remotes").unwrap(), vec!["game", "ReplicatedStorage", "Remotes"]);
+        assert_eq!(path_segments("game.Workspace[\"My Part\"]").unwrap(), vec!["game", "Workspace", "My Part"]);
+        assert!(path_segments("").is_err());
+        assert_eq!(luau_str("a\"b\n"), "\"a\\\"b\\n\"");
+        assert_eq!(to_luau(&json!({"x": [1, true, null]}), 0).unwrap(), "{[\"x\"]={1,true,nil}}");
+        let mut c = 0;
+        assert!(prep_node(&json!({"className": "Model", "name": "M", "children": [{"className": "Part"}]}), 0, &mut c).is_ok());
+        assert!(prep_node(&json!({"className": "bad name"}), 0, &mut 0).is_err());
+        assert_eq!(snapshot_targets("create_part", &json!({"tree": {"name": "P"}, "parent": "game.Workspace"})), vec!["game.Workspace.P"]);
+        assert_eq!(native_snapshot_targets(&json!({"instance_path": "game.Workspace.A", "x": "game.B"})), vec!["game.Workspace.A"]);
+        assert!(wrapped(&json!({}), "return 1").unwrap().contains("BWJSON<<"));
+    }
+}
diff --git a/agent/src/notion_safety.rs b/agent/src/notion_safety.rs
new file mode 100644
index 0000000..7b1d27f
--- /dev/null
+++ b/agent/src/notion_safety.rs
@@ -0,0 +1,227 @@
+//! AdiCode 1.0.8: Sicherheitsfunktionen aus Secretscript.
+//!
+//! * `safe_read_file` / `safe_write_file` / `safe_search_files`: Dateien im Shared-Ordner
+//!   mit SHA-256-Versionsschutz. Ueberschreiben nur, wenn sich die Datei seit dem Lesen
+//!   nicht geaendert hat (wichtig bei Co-Work mit mehreren Chats). Geheimnis-Dateien
+//!   (.env, Schluessel, credentials ...) sind gesperrt.
+//! * Sicherheitsmodus fuer die Shell (Schalter in der App, Standard aus): pc_PowerShell
+//!   nur mit erlaubten Einzelbefehlen, keine Netzwerk-/Push-Befehle, Registry und
+//!   unsicheres Browser-JS gesperrt.
+
+use once_cell::sync::Lazy;
+use regex::Regex;
+use serde_json::{json, Value};
+use sha2::Digest;
+use std::path::{Component, Path, PathBuf};
+
+const MAX_READ: u64 = 512_000;
+const MAX_WRITE: usize = 1_000_000;
+const IGNORED_DIRS: &[&str] = &[".git", ".hg", ".svn", ".venv", "venv", "node_modules", "__pycache__", ".idea", ".vscode", "dist", "build", ".next", "target"];
+const SENSITIVE_NAMES: &[&str] = &[".env", ".env.local", "id_rsa", "id_ed25519", "credentials", "credentials.json", "secrets.json", "token.json", "config.json", "plazcode-notion.json"];
+const SENSITIVE_EXT: &[&str] = &["pem", "key", "p12", "pfx", "kdbx"];
+
+static SENSITIVE_CMD: Lazy<Regex> = Lazy::new(|| Regex::new(r"(?i)(?:\.env(?:\.[a-z0-9_-]+)?\b|id_rsa|id_ed25519|credentials(?:\.json)?|secrets?\.json|plazcode-notion\.json|\.(?:pem|key|p12|pfx|kdbx)\b|GITHUB_PERSONAL_ACCESS_TOKEN)").unwrap());
+
+fn root() -> PathBuf { crate::mcp_addons::shared_dir() }
+
+fn sha(data: &[u8]) -> String { sha2::Sha256::digest(data).iter().map(|b| format!("{b:02x}")).collect() }
+
+fn is_sensitive(p: &Path) -> bool {
+    p.components().any(|c| matches!(c, Component::Normal(n) if SENSITIVE_NAMES.contains(&n.to_string_lossy().to_ascii_lowercase().as_str())))
+        || p.extension().map(|e| SENSITIVE_EXT.contains(&e.to_string_lossy().to_ascii_lowercase().as_str())).unwrap_or(false)
+}
+
+fn resolve(rel: &str) -> Result<PathBuf, String> {
+    let raw = rel.trim().replace('\\', "/");
+    let raw = if raw.is_empty() { ".".to_string() } else { raw };
+    let cand = PathBuf::from(&raw);
+    if cand.is_absolute() || raw.contains(':') || cand.components().any(|c| matches!(c, Component::ParentDir | Component::RootDir | Component::Prefix(_))) {
+        return Err("Bitte einen relativen Pfad innerhalb des Shared-Ordners verwenden".into());
+    }
+    for c in cand.components() {
+        if let Component::Normal(n) = c {
+            let n = n.to_string_lossy();
+            if n.starts_with('.') || IGNORED_DIRS.contains(&n.to_ascii_lowercase().as_str()) {
+                return Err("Versteckte, Abhaengigkeits- und Build-Ordner sind ausgeschlossen".into());
+            }
+        }
+    }
+    if is_sensitive(&cand) { return Err("Dieser Pfad ist gesperrt, weil er Zugangsdaten oder Geheimnisse enthalten kann".into()); }
+    Ok(root().join(cand))
+}
+
+fn display(p: &Path) -> String { p.strip_prefix(root()).map(|r| r.to_string_lossy().replace('\\', "/")).unwrap_or_default() }
+
+fn read_file(rel: &str) -> Result<String, String> {
+    let p = resolve(rel)?;
+    let meta = std::fs::metadata(&p).map_err(|_| format!("Datei nicht gefunden: {rel}"))?;
+    if !meta.is_file() { return Err("Der Pfad ist keine Datei".into()); }
+    if meta.len() > MAX_READ { return Err(format!("Datei ist groesser als {MAX_READ} Bytes")); }
+    let data = std::fs::read(&p).map_err(|e| e.to_string())?;
+    let text = String::from_utf8(data.clone()).map_err(|_| "Datei ist kein UTF-8-Text".to_string())?;
+    Ok(format!("sha256: {}\npath: {}\n---\n{}", sha(&data), display(&p), text))
+}
+
+fn write_file(rel: &str, content: &str, expected: &str) -> Result<String, String> {
+    let p = resolve(rel)?;
+    if p == root() { return Err("Ungueltiger Dateipfad".into()); }
+    let parent = p.parent().ok_or("Ungueltiger Dateipfad")?;
+    if !parent.is_dir() { return Err("Der Ordner der Datei muss im Shared-Ordner bereits existieren".into()); }
+    let data = content.as_bytes();
+    if data.len() > MAX_WRITE { return Err(format!("Inhalt ueberschreitet {MAX_WRITE} Bytes")); }
+    let expected = expected.trim().to_ascii_lowercase();
+    let exists = p.exists();
+    if exists {
+        if expected.is_empty() { return Err("Datei existiert bereits. Zuerst mit safe_read_file lesen und deren sha256 als expected_sha256 uebergeben.".into()); }
+        let current = std::fs::read(&p).map_err(|e| e.to_string())?;
+        if sha(&current) != expected { return Err("Datei wurde seit dem Lesen geaendert - bitte erneut lesen, bevor du sie ersetzt.".into()); }
+    } else if !expected.is_empty() {
+        return Err("Datei existiert nicht - expected_sha256 weglassen, um sie anzulegen.".into());
+    }
+    let tmp = parent.join(format!(".plazcode-write-{}.tmp", std::process::id()));
+    std::fs::write(&tmp, data).map_err(|e| e.to_string())?;
+    if exists {
+        let current = std::fs::read(&p).unwrap_or_default();
+        if sha(&current) != expected { let _ = std::fs::remove_file(&tmp); return Err("Datei wurde waehrend des Schreibens geaendert - bitte erneut lesen.".into()); }
+        if let Err(e) = std::fs::rename(&tmp, &p) { let _ = std::fs::remove_file(&tmp); return Err(e.to_string()); }
+    } else {
+        let r = std::fs::hard_link(&tmp, &p).or_else(|_| if p.exists() { Err(std::io::Error::other("exists")) } else { std::fs::copy(&tmp, &p).map(|_| ()) });
+        let _ = std::fs::remove_file(&tmp);
+        r.map_err(|_| "Datei wurde gleichzeitig von jemand anderem angelegt - bitte erneut lesen.".to_string())?;
+    }
+    Ok(format!("{} {}. Neuer sha256: {}", if exists { "Ersetzt:" } else { "Angelegt:" }, display(&p), sha(data)))
+}
+
+fn search_files(query: &str, rel: &str, max: usize) -> Result<String, String> {
+    if query.is_empty() { return Err("query darf nicht leer sein".into()); }
+    let start = resolve(rel)?;
+    if !start.is_dir() { return Err("Der Pfad ist kein Ordner".into()); }
+    let (mut hits, mut scanned, mut stack) = (Vec::new(), 0usize, vec![start]);
+    let needle = query.to_lowercase();
+    while let Some(dir) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else { continue; };
+        for e in entries.flatten() {
+            let p = e.path();
+            let name = e.file_name().to_string_lossy().to_string();
+            if name.starts_with('.') || IGNORED_DIRS.contains(&name.to_ascii_lowercase().as_str()) || is_sensitive(&p) { continue; }
+            if p.is_dir() { stack.push(p); continue; }
+            scanned += 1;
+            if scanned > 5000 || hits.len() >= max { break; }
+            if e.metadata().map(|m| m.len() > MAX_READ).unwrap_or(true) { continue; }
+            let Ok(text) = std::fs::read_to_string(&p) else { continue; };
+            for (i, line) in text.lines().enumerate() {
+                if line.to_lowercase().contains(&needle) {
+                    hits.push(format!("{}:{}: {}", display(&p), i + 1, line.trim().chars().take(240).collect::<String>()));
+                    if hits.len() >= max { break; }
+                }
+            }
+        }
+    }
+    Ok(if hits.is_empty() { "Keine Treffer.".into() } else { hits.join("\n") })
+}
+
+pub fn tools() -> Vec<Value> {
+    vec![
+        json!({"name": "safe_read_file", "description": "[Sicher] Liest eine UTF-8-Textdatei (max. 500 KB) im Shared-Ordner und liefert ihren sha256. Pfade relativ zum Shared-Ordner; Geheimnis-Dateien sind gesperrt.",
+            "inputSchema": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}}, "annotations": {"readOnlyHint": true}}),
+        json!({"name": "safe_write_file", "description": "[Sicher] Legt eine Datei an oder ersetzt sie NUR, wenn expected_sha256 noch zur aktuellen Version passt (vorher safe_read_file). Verhindert, dass parallele Chats sich gegenseitig ueberschreiben.",
+            "inputSchema": {"type": "object", "required": ["path", "content"], "properties": {"path": {"type": "string"}, "content": {"type": "string"}, "expected_sha256": {"type": "string", "description": "Pflicht beim Ersetzen, weglassen beim Anlegen."}, "agent": {"type": "string", "description": "Co-Work: dein Agent-Name (z. B. AdiCode-Coder), damit deine eigenen Datei-Locks gelten"}}},
+            "annotations": {"destructiveHint": true}}),
+        json!({"name": "safe_search_files", "description": "[Sicher] Sucht Text in den Dateien des Shared-Ordners (ohne Abhaengigkeits-/Build-Ordner und Geheimnis-Dateien).",
+            "inputSchema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}, "path": {"type": "string"}, "max_results": {"type": "integer", "minimum": 1, "maximum": 200}}},
+            "annotations": {"readOnlyHint": true}}),
+    ]
+}
+
+pub fn call(name: &str, args: &Value) -> Option<Value> {
+    let r = match name {
+        "safe_read_file" => read_file(args["path"].as_str().unwrap_or("")),
+        "safe_write_file" => {
+            let path = args["path"].as_str().unwrap_or("");
+            if let Some(owner) = crate::notion_cowork::lock_owner(path, args["agent"].as_str().unwrap_or("")) {
+                Err(format!("Datei ist im Co-Work-Board von '{owner}' gesperrt. Bist du das selbst, gib agent=<dein Agent-Name> mit; sonst warte oder stimme dich per cowork_message ab."))
+            } else {
+                write_file(path, args["content"].as_str().unwrap_or(""), args["expected_sha256"].as_str().unwrap_or(""))
+            }
+        }
+        "safe_search_files" => search_files(args["query"].as_str().unwrap_or(""), args["path"].as_str().unwrap_or("."), args["max_results"].as_u64().unwrap_or(50).clamp(1, 200) as usize),
+        _ => return None,
+    };
+    Some(match r {
+        Ok(t) => json!({"content": [{"type": "text", "text": t}]}),
+        Err(e) => json!({"isError": true, "content": [{"type": "text", "text": e}]}),
+    })
+}
+
+// ---------------------------------------------------------------- Shell-Sicherheitsmodus
+
+const PS_ALLOWED: &[&str] = &["get-childitem", "dir", "ls", "get-content", "cat", "type", "select-string", "test-path", "get-command", "get-process", "get-filehash", "get-item", "get-location", "tasklist", "netstat", "where.exe", "git", "node", "npm", "cargo", "rustc", "python", "py", "stylua", "selene", "luau-lsp", "rojo"];
+const META: &[char] = &[';', '|', '&', '<', '>', '`', '\n', '\r', '\0'];
+const GIT_BLOCKED: &[&str] = &["push", "pull", "fetch", "clone", "remote", "ls-remote", "submodule", "credential", "config"];
+const NPM_BLOCKED: &[&str] = &["install", "i", "ci", "exec", "x", "publish", "login", "adduser", "view", "init", "pack", "update"];
+
+/// Prueft einen pc_PowerShell-Befehl im Sicherheitsmodus.
+pub fn validate_shell(command: &str) -> Result<(), String> {
+    let cmd = command.trim();
+    if cmd.is_empty() || cmd.len() > 4000 { return Err("Sicherheitsmodus: genau ein Befehl mit hoechstens 4000 Zeichen".into()); }
+    if cmd.contains(META) || cmd.contains("$(") || cmd.contains("${") { return Err("Sicherheitsmodus: Pipes, Verkettung, Umleitung und Ausdruecke sind gesperrt".into()); }
+    if cmd.contains("..") { return Err("Sicherheitsmodus: '..' in Pfaden ist gesperrt".into()); }
+    if SENSITIVE_CMD.is_match(cmd) { return Err("Sicherheitsmodus: Befehle mit Geheimnis-Dateien oder Tokens sind gesperrt".into()); }
+    let parts: Vec<String> = cmd.split_whitespace().map(|p| p.trim_matches(|c| c == '"' || c == '\'').to_ascii_lowercase()).collect();
+    let exe = parts[0].trim_start_matches(".\\").trim_end_matches(".exe").trim_end_matches(".cmd").to_string();
+    let exe_full = if parts[0] == "where.exe" { "where.exe".to_string() } else { exe.clone() };
+    if !PS_ALLOWED.contains(&exe_full.as_str()) && !PS_ALLOWED.contains(&exe.as_str()) {
+        return Err(format!("Sicherheitsmodus: '{}' ist nicht erlaubt. Erlaubt: {}", parts[0], PS_ALLOWED.join(", ")));
+    }
+    let sub: Vec<&str> = parts[1..].iter().map(|s| s.as_str()).filter(|s| !s.starts_with('-')).collect();
+    if exe == "git" {
+        if let Some(s) = sub.first() { if GIT_BLOCKED.contains(s) { return Err(format!("Sicherheitsmodus: 'git {s}' ist gesperrt (Netzwerk/Konfiguration)")); } }
+        if parts.iter().any(|p| p == "-c" || p.starts_with("--exec") || p.starts_with("--upload-pack")) { return Err("Sicherheitsmodus: git -c/--exec ist gesperrt".into()); }
+    }
+    if exe == "npm" { if let Some(s) = sub.first() { if NPM_BLOCKED.contains(s) { return Err(format!("Sicherheitsmodus: 'npm {s}' bitte selbst ausfuehren")); } } }
+    if exe == "node" || exe == "python" || exe == "py" {
+        if parts.iter().any(|p| p == "-e" || p == "-c" || p == "--eval" || p == "-p" || p == "-m") { return Err("Sicherheitsmodus: Inline-Code (-e/-c/-m) ist gesperrt; nur Skript-Dateien im Projekt".into()); }
+    }
+    if exe == "cargo" { if let Some(s) = sub.first() { if ["install", "publish", "login", "owner", "yank"].contains(s) { return Err(format!("Sicherheitsmodus: 'cargo {s}' ist gesperrt")); } } }
+    Ok(())
+}
+
+/// Liefert eine Fehlermeldung, wenn der Sicherheitsmodus das Tool blockiert.
+pub fn guard_tool(exposed: &str, args: &Value) -> Option<String> {
+    if !crate::notion_mcp::safe_shell_enabled() { return None; }
+    match exposed {
+        "pc_PowerShell" => validate_shell(args["command"].as_str().unwrap_or("")).err(),
+        "pc_Registry" => Some("Sicherheitsmodus: Registry-Zugriff ist gesperrt.".into()),
+        "browser_browser_run_code_unsafe" => Some("Sicherheitsmodus: unsicheres Browser-JavaScript ist gesperrt.".into()),
+        "files_write_file" | "files_edit_file" | "files_move_file" => {
+            let p = args["path"].as_str().or_else(|| args["source"].as_str()).unwrap_or("");
+            if is_sensitive(Path::new(&p.replace('\\', "/"))) { Some("Sicherheitsmodus: Geheimnis-Dateien sind gesperrt.".into()) } else { None }
+        }
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn shell_rules() {
+        assert!(validate_shell("git status").is_ok());
+        assert!(validate_shell("Get-ChildItem src").is_ok());
+        assert!(validate_shell("git push origin main").is_err());
+        assert!(validate_shell("Remove-Item x").is_err());
+        assert!(validate_shell("git status; rm x").is_err());
+        assert!(validate_shell("Get-Content .env").is_err());
+        assert!(validate_shell("node -e 1").is_err());
+        assert!(validate_shell("npm install x").is_err());
+        assert!(validate_shell("npm test").is_ok());
+    }
+    #[test]
+    fn paths() {
+        assert!(resolve("../x").is_err());
+        assert!(resolve("C:/x").is_err());
+        assert!(resolve(".git/config").is_err());
+        assert!(resolve("a/.env").is_err());
+        assert!(resolve("src/main.rs").is_ok());
+    }
+}
diff --git a/agent/src/notion_skills.rs b/agent/src/notion_skills.rs
new file mode 100644
index 0000000..49aacb6
--- /dev/null
+++ b/agent/src/notion_skills.rs
@@ -0,0 +1,161 @@
+//! AdiCode (unofficial fork): built-in coding skills and control tools
+//! for Notion AI. Skills are short, opinionated checklists the agent loads
+//! before it writes code (Roblox/Luau and general app development).
+
+use serde_json::{json, Value};
+
+pub(crate) const INSTRUCTIONS: &str = "AdiCode verbindet Notion AI mit diesem PC. roblox_* = Roblox Studio (Skripte lesen/bearbeiten, Luau ausfuehren, Spielbaum), pc_* = Windows-Steuerung (PowerShell, Dateien, Apps), browser_* = Browser, files_* = Local files (Pfade relativ zum Shared-Ordner), git_* = Git, context7_* = aktuelle Library-Doku, memory_* = Projektgedaechtnis, thinking_* = schrittweises Planen, github_* = GitHub. Vor dem Programmieren passenden Skill mit adicode_skill laden (roblox, roblox-studio, app, debug, git, cowork). Co-Work: mehrere Notion-AI-Tabs arbeiten gleichzeitig an einem Projekt ueber cowork_* (start, join, claim, update, wait) - vorher Skill cowork laden. Vor dem Schreiben von Dateien erst lesen. Haengt ein Add-on: adicode_restart_server. adicode_status zeigt, was aktiv ist. Langzeit-Memory: Sobald der Nutzer ein Projekt nennt oder sagt, dass an Projekt X weitergearbeitet wird, VOR jeder Arbeit project_memory_open/search aufrufen. Nach jeder wesentlichen Aenderung und vor einem Themenwechsel HANDOUT.md aktualisieren und project_memory_update aufrufen. Projekte strikt getrennt halten; nie auf den Chatverlauf als einziges Gedaechtnis vertrauen.";
+
+struct Skill { id: &'static str, title: &'static str, body: &'static str }
+
+const SKILLS: &[Skill] = &[
+    Skill { id: "roblox", title: "Roblox / Luau best practices", body: r#"Architecture
+- Server is authoritative. Never trust the client: validate every RemoteEvent/RemoteFunction argument (type, range, ownership, rate limit).
+- Layout: ServerScriptService (server logic), ReplicatedStorage (shared modules, Remotes folder), StarterPlayerScripts / StarterCharacterScripts (client), ServerStorage (server-only assets).
+- Prefer ModuleScripts with one responsibility each; keep Scripts/LocalScripts as thin entry points.
+- Use --!strict and type annotations in new modules. Use local variables, avoid globals (_G, shared).
+
+Luau style
+- task.wait / task.spawn / task.delay / task.defer instead of wait/spawn/delay.
+- game:GetService("X") at the top of the file. WaitForChild only for replicated instances on the client.
+- Disconnect connections (store RBXScriptConnection, or use Maid/Trove patterns) and clean up on PlayerRemoving / Destroying.
+- Avoid busy loops; use events (Changed, GetPropertyChangedSignal, Heartbeat with dt).
+
+Data
+- DataStoreService: wrap GetAsync/SetAsync/UpdateAsync in pcall with retries and backoff; prefer UpdateAsync; save on PlayerRemoving and game:BindToClose; use session locking for important data (ProfileStore pattern).
+- Never store Instances in DataStores; serialize to plain tables. Version the schema.
+
+Security & economy
+- Purchases: MarketplaceService.ProcessReceipt must be idempotent and return PurchaseGranted only after data is saved.
+- Rate-limit remotes per player; kick or ignore on abuse. Sanity-check positions/distances server-side.
+
+Performance
+- Use CollectionService tags instead of scanning the tree. Pool frequently created parts. Keep heavy work off RenderStepped.
+- StreamingEnabled for big maps; anchor static parts; reduce unions/meshes collision fidelity where possible.
+
+UI
+- ScreenGui with ResetOnSpawn=false for persistent UI; use UIScale/UIAspectRatioConstraint for mobile; TweenService for animation.
+
+Done checklist
+- No errors in Output, works with 2+ players (Test > Clients and Servers), remotes validated, data saves on leave and on shutdown."# },
+    Skill { id: "roblox-studio", title: "Working in Roblox Studio via AdiCode tools", body: r#"1. Call roblox_list_roblox_studios and pick the studio_id; every roblox_* tool needs it.
+2. Explore first: get the game tree / search for scripts before editing. Read the full script source before changing it.
+3. Make small, targeted edits; keep existing style. Explain what changed and where (full instance path).
+4. Verify: run a quick check with execute_luau (e.g. require the module, print results) and read Output/log for errors.
+5. Never publish or overwrite places without explicit user confirmation.
+6. For bigger features: plan with thinking_* first, then implement module by module, testing after each step.
+7. For external code workflows prefer Rojo (default.project.json) + Git so scripts live as files in the repo."# },
+    Skill { id: "app", title: "App development workflow", body: r#"Start
+- Clarify target (web, mobile, desktop), stack and constraints. Default picks: web = Vite + React + TypeScript (or Next.js when SSR/API routes are needed); mobile = Expo (React Native) + TypeScript; backend = Node/TypeScript or Python FastAPI; DB = SQLite/Postgres (Supabase when auth+DB are needed fast).
+- Look up current APIs with context7_* before using a library; do not guess versions.
+
+Structure
+- src/ split by feature, not by file type. Keep UI, state and data access separate. Config via .env (never commit secrets; add .env to .gitignore and provide .env.example).
+- TypeScript strict mode, ESLint + Prettier. Small functions, clear names, no dead code.
+
+Loop
+1. Read the existing code and README first (files_* or pc_FileSystem).
+2. Plan the change in a few steps; implement the smallest working slice.
+3. Run it: install deps, start dev server in the background, check output; fix errors before moving on.
+4. Add/adjust tests for logic (Vitest/Jest, pytest). Run lint + tests.
+5. Commit with a clear message (git skill).
+
+Quality
+- Handle loading/error/empty states in UI. Validate input on the server. Accessibility: labels, contrast, keyboard.
+- Release: production build passes, env vars documented, version bumped, changelog updated."# },
+    Skill { id: "debug", title: "Debugging procedure", body: r#"1. Reproduce: get the exact error message, stack trace and steps. Read logs (Roblox Output, terminal, browser console via browser_*).
+2. Locate: find the failing file/line; read surrounding code and recent changes (git diff / git log).
+3. Hypothesize: list 2-3 likely causes, ordered by probability. Check the cheapest first.
+4. Verify with evidence: add temporary prints/logs or run a minimal snippet (execute_luau, node -e, python -c).
+5. Fix the root cause, not the symptom. Keep the fix minimal.
+6. Confirm: re-run the repro, run tests, remove temporary logging.
+7. Report: cause, fix, how it was verified, and any follow-ups."# },
+    Skill { id: "git", title: "Git workflow", body: r#"- Before changes: git status, git pull (or fetch) and make sure the tree is clean; work on a branch for bigger features (feature/<name>).
+- Commit small logical units; message: imperative summary <= 72 chars, optional body with the why.
+- Never commit secrets, tokens, .env, build output or node_modules; keep .gitignore up to date.
+- Before pushing: run build/tests, review git diff --staged.
+- Do not force-push shared branches or rewrite published history without explicit user confirmation.
+- Releases: bump version file, tag (vX.Y.Z), write release notes."# },
+    Skill { id: "project-memory", title: "Durable multi-project memory across long chats", body: r#"Purpose
+- A Notion chat is not infinite. Treat the chat as a temporary interface and project_memory_* plus HANDOUT.md as the durable source of truth.
+- Every project has its own namespace (for example Aurelune, PlazCode, AdiCode). Never mix decisions between projects.
+
+On project selection / switching
+1. If the user says "continue X", "work on X" or names a project: project_memory_open(name=X). If the exact name is unclear, project_memory_search/list first.
+2. Read the registered HANDOUT.md and current repository before planning. Briefly mention only missing or conflicting context.
+3. Work normally. The Main chat remains the only user interface; worker tabs receive tasks through cowork_*.
+
+After material work
+1. Update that project's HANDOUT.md: current architecture, decisions, build/release workflow, pitfalls, changelog, and next tasks. Keep it concise and factual.
+2. Call project_memory_update with the same stable project name, a compact current summary, and handout_path. The background watcher then keeps future HANDOUT changes synchronized.
+3. Before switching to another project, save the old project first. Opening another project never deletes prior memory.
+
+Context pressure
+- Do not try to retain an unlimited raw transcript. Preserve decisions, interfaces, file paths, commands, failures and next steps; omit chatter and duplicated status.
+- If a response suggests context was lost, stop and reload project_memory_open plus HANDOUT.md before continuing."# },    Skill { id: "cowork", title: "Co-Work: several Notion AI chats work on one project (roles = focus, everybody helps)", body: r#"Co-Work lets several Notion AI chats (browser tabs) build one project in parallel via a shared board (cowork_* tools). The MAIN CHAT is the lead and the only interface to the user. Every other tab has a ROLE = its focus and its evaluation lens, NOT a fence: it evaluates every new prompt from its role's perspective and then helps with ALL work.
+ROLES: lead = Main Chat, prompt = Prompt-Schreiber, coder = Programmierer, reviewer = Code-Bewerter, uiux = UI/UX-Kritiker, tester = Tester, roblox = Roblox-Spezialist, worker = Generalist. Custom roles are allowed. German names work too.
+HOW WORK IS SPLIT (automatic):
+- Every user prompt opens a "wave": cowork_start (project start) and cowork_prompt (every new user message mid-project). Each worker first gets an assess task: evaluate the prompt through its role lens (coder: implementation plan/files/risks, reviewer: quality risks + acceptance criteria, tester: test plan/edge cases, ...) and propose missing sub-tasks via cowork_update tasks=[...]. Work tasks of the wave start when all evaluations are in (max 150 s).
+- cowork_claim order: own evaluation -> tasks of own role -> reviews -> unassigned -> tasks of other roles whose expert is busy/offline (or that waited > 90 s). So nobody idles while work is open.
+- Reviews never go to the author; requested changes become fix tasks (max 2 rounds, then the lead decides).
+- AdiCode wakes idle chats automatically with messages starting with [AdiCode Co-Work] (they come from the system, not the user).
+LEAD (Main Chat):
+1. Identify the project, project_memory_open + HANDOUT.md, inspect the current code so tasks are concrete. Small questions: just answer them yourself.
+2. cowork_start with title, goal (user request, stack, folders, conventions, interfaces) and 4-12 small PARALLEL tasks (so all agents can work at once). Each task: title, detail with acceptance criteria, role = focus, files it touches, depends_on only for real ordering, review=reviewer for code / uiux for UI.
+3. Every further user message during the project: cowork_prompt first (workers evaluate it), then continue.
+4. Orchestrate with cowork_wait: integrate evaluations (cowork_add_tasks / cowork_message), solve blockers, and claim tasks yourself when nothing needs coordination.
+5. When all tasks are done: cowork_results, update HANDOUT.md, project_memory_update, then give ONE short optimized answer. Close the project only if the user wants.
+WORKER TAB:
+1. cowork_join with role (and agent name); pass the agent name on every cowork call.
+2. Loop: cowork_claim -> load the matching skill (roblox, roblox-studio, app, debug, git) -> read files before editing -> change only the task files (lock extra files with cowork_lock) -> verify -> cowork_update status=done with a short, precise result (what, which files, how tested). Task too big: split it with tasks=[...] so others can help.
+3. Assess tasks: max ~10 lines from your role lens + proposed tasks. Review tasks: read, do not rewrite; status=done (short verdict) or status=changes with numbered concrete points.
+4. No free task: cowork_wait (repeat). Problems: cowork_message to the lead or status=blocked with the reason. Do not ask the user.
+RULES: never edit a file locked by another agent; results are required for done/changes/blocked; do not redo tasks owned by others; do not close the project. The AdiCode desktop app shows the live status (Co-Work page and Chat tab)."# },
+];
+
+fn list_text() -> String {
+    let mut out = String::from("Verfuegbare Skills (adicode_skill mit name aufrufen):\n");
+    for s in SKILLS { out.push_str(&format!("- {}: {}\n", s.id, s.title)); }
+    out
+}
+
+pub(crate) fn skill_tool() -> Value {
