+/// Notion AI chats stop after each turn. Wake idle chats when work is waiting.
+async fn nudger(tabs:Vec<Tab>){
+    let mut last:BTreeMap<u32,(String,std::time::Instant,u32)>=BTreeMap::new();
+    let mut stuck:BTreeMap<u32,(String,std::time::Instant)>=BTreeMap::new();
+    loop{
+        tokio::time::sleep(Duration::from_secs(10)).await;
+        for(i,t)in tabs.iter().enumerate(){
+            if is_paused(t.id){stuck.remove(&t.id);continue;}
+            match gen_snapshot(cdp_port(i)).await{
+                Some(s)=>{let e=stuck.entry(t.id).or_insert((s.clone(),std::time::Instant::now()));if e.0!=s{*e=(s,std::time::Instant::now());}else if e.1.elapsed()>Duration::from_secs(STUCK_SECS){stop_generation(cdp_port(i)).await;stuck.remove(&t.id);last.remove(&t.id);tracing::warn!("Co-Work: Chat {} hing {STUCK_SECS}s ohne Fortschritt - gestoppt",t.role);}continue;}
+                None=>{stuck.remove(&t.id);}
+            }
+            let agent=if i==0{crate::notion_cowork::latest_lead()}else{format!("AdiCode-{}",t.role)};
+            let Some((sig,text))=crate::notion_cowork::nudge_for(&agent) else {continue};
+            if let Some((s,at,n))=last.get(&t.id){if *s==sig&&(sig.starts_with("done:")||*n>=3||at.elapsed()<Duration::from_secs(240)){continue;}}
+            if i>0&&user_present(cdp_port(i)).await{continue;}
+            if !chat_idle(cdp_port(i)).await{continue;}
+            tokio::time::sleep(Duration::from_secs(4)).await;
+            if !chat_idle(cdp_port(i)).await{continue;}
+            if insert_prompt(cdp_port(i),text).await.is_ok(){let n=last.get(&t.id).filter(|(s,_,_)|*s==sig).map(|x|x.2+1).unwrap_or(1);last.insert(t.id,(sig,std::time::Instant::now(),n));}
+        }
+    }
