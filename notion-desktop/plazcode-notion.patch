+pub fn clear_uploads() {
+    let Ok(rd) = std::fs::read_dir(uploads()) else { return };
+    for e in rd.flatten() { let p = e.path(); if p.is_dir() { let _ = std::fs::remove_dir_all(&p); } else { let _ = std::fs::remove_file(&p); } }
+}
+async fn delete_after_read(files: Vec<String>) {
+    let mut seen = false; let mut w = 0u64; sleep(5000).await;
+    loop {
+        let g = match Session::page().await { Ok(mut s) => s.eval(ROWS).await.ok().and_then(|v| v["gen"].as_bool()), Err(_) => None };
+        if g == Some(true) { seen = true; } else if g == Some(false) && (seen || w > 45_000) { break; }
+        if w > 900_000 { break; }
+        sleep(3000).await; w += 3000;
+    }
+    for f in files { let _ = std::fs::remove_file(f); }
+}
+#[allow(dead_code)]
+fn cleanup_uploads() {
+    let Ok(rd) = std::fs::read_dir(uploads()) else { return };
+    let limit = std::time::SystemTime::now() - Duration::from_secs(3 * 24 * 3600);
+    for e in rd.flatten() {
+        if e.metadata().and_then(|m| m.modified()).map(|m| m < limit).unwrap_or(false) { let _ = std::fs::remove_dir_all(e.path()); }
+    }
+}
+/// Rohdaten-Upload (Body = Datei), damit auch grosse Videos ohne Base64 funktionieren.
+pub async fn upload_handler(Query(q): Query<UploadQuery>, body: Bytes) -> Response {
+    if body.is_empty() { return fail("Leere Datei."); }
+    let name = safe_name(q.name.as_deref().unwrap_or("datei"));
+    let dir = uploads();
+    if let Err(e) = tokio::fs::create_dir_all(&dir).await { return fail(e.to_string()); }
+    let path = dir.join(format!("{}_{}", chrono::Utc::now().timestamp_millis(), name));
+    match tokio::fs::write(&path, &body).await {
+        Ok(_) => ok(json!({"ok": true, "path": path.display().to_string(), "name": name, "size": body.len()})),
+        Err(e) => fail(e.to_string()),
+    }
+}
