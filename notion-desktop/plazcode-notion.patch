+fn num(a: &Value, k: &str, def: i64) -> i64 {
+    a.get(k).and_then(|v| v.as_i64().or_else(|| v.as_f64().map(|f| f as i64)).or_else(|| v.as_str().and_then(|s| s.trim().parse().ok()))).unwrap_or(def)
+}
+
+fn sval(a: &Value, k: &str) -> Option<String> {
+    match a.get(k) {
+        Some(Value::String(s)) => Some(s.clone()),
+        Some(Value::Number(n)) => Some(n.to_string()),
+        Some(Value::Bool(b)) => Some(b.to_string()),
+        _ => None,
+    }
+}
+
+fn has(a: &Value, k: &str) -> bool { a.get(k).map(|v| !v.is_null()).unwrap_or(false) }
+
+fn required(a: &Value, names: &[&str]) -> Result<(), String> {
+    let missing: Vec<&str> = names.iter().copied().filter(|n| !has(a, n)).collect();
+    if missing.is_empty() { Ok(()) } else { Err(format!("Fehlende Argumente: {}", missing.join(", "))) }
+}
+
+fn hex(n: usize) -> String {
+    let mut b = vec![0u8; n];
+    let _ = getrandom::getrandom(&mut b);
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
