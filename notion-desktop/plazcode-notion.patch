+// ---------------------------------------------------------------- Luau-Prelude
+
+const PRELUDE: &str = r##"local HttpService = game:GetService("HttpService")
+local ChangeHistoryService = game:GetService("ChangeHistoryService")
+local function bw_resolve(segs)
+	local cur = game
+	for i = 2, #segs do
+		local name = segs[i]
+		local nxt = cur:FindFirstChild(name)
+		if not nxt and cur == game then local ok, svc = pcall(function() return game:GetService(name) end); if ok then nxt = svc end end
+		if not nxt then return nil, "not found: " .. tostring(name) end
+		cur = nxt
+	end
+	return cur
+end
+local function bw_must(segs)
+	local inst, err = bw_resolve(segs)
+	if not inst then error(err, 0) end
+	return inst
+end
+local function bw_path(inst)
+	local parts, cur = {}, inst
+	while cur and cur ~= game do
+		table.insert(parts, 1, cur.Name)
+		cur = cur.Parent
+	end
+	return "game." .. table.concat(parts, ".")
+end
+local function bw_decode(v)
+	if type(v) ~= "table" or v["$type"] == nil then return v end
+	local kind, a = v["$type"], v.value
+	if kind == "Vector3" then return Vector3.new(a[1],a[2],a[3])
+	elseif kind == "Vector2" then return Vector2.new(a[1],a[2])
+	elseif kind == "Color3" then if type(a) == "string" then return Color3.fromHex(a) end; return Color3.fromRGB(a[1],a[2],a[3])
+	elseif kind == "UDim2" then return UDim2.new(a[1],a[2],a[3],a[4])
+	elseif kind == "UDim" then return UDim.new(a[1],a[2])
+	elseif kind == "CFrame" then return CFrame.new(table.unpack(a))
+	elseif kind == "Enum" then return Enum[v.enum][a]
+	elseif kind == "BrickColor" then return BrickColor.new(a)
+	elseif kind == "NumberRange" then return NumberRange.new(a[1],a[2] or a[1])
+	elseif kind == "Ref" then return bw_must(v.segs) end
+	error("unsupported typed value " .. tostring(kind), 0)
+end
+local function bw_enc(v)
+	local kind = typeof(v)
+	if kind == "Vector3" then return { ["$type"]="Vector3", value={v.X,v.Y,v.Z} }
+	elseif kind == "Vector2" then return { ["$type"]="Vector2", value={v.X,v.Y} }
+	elseif kind == "Color3" then return { ["$type"]="Color3", value={math.floor(v.R*255+0.5),math.floor(v.G*255+0.5),math.floor(v.B*255+0.5)} }
+	elseif kind == "UDim2" then return { ["$type"]="UDim2", value={v.X.Scale,v.X.Offset,v.Y.Scale,v.Y.Offset} }
+	elseif kind == "EnumItem" then return { ["$type"]="Enum", enum=tostring(v.EnumType), value=v.Name }
+	elseif kind == "Instance" then return { ["$type"]="Ref", path=bw_path(v) }
+	elseif kind == "BrickColor" then return { ["$type"]="BrickColor", value=v.Name }
+	elseif kind == "number" and (v ~= v or v == math.huge or v == -math.huge) then return tostring(v) end
+	return v
+end
+local function bw_coerce(inst, prop, raw)
+	local v = bw_decode(raw)
+	local ok, current = pcall(function() return inst[prop] end)
+	if ok and type(v) == "table" and typeof(v) == "table" then
+		local t = typeof(current)
+		if t == "Vector3" then return Vector3.new(v[1],v[2],v[3])
+		elseif t == "Vector2" then return Vector2.new(v[1],v[2])
+		elseif t == "Color3" then return Color3.fromRGB(v[1],v[2],v[3])
+		elseif t == "UDim2" then return UDim2.new(v[1],v[2],v[3],v[4])
+		elseif t == "CFrame" then return CFrame.new(table.unpack(v)) end
+	elseif ok and type(v) == "string" and typeof(current) == "Color3" and string.sub(v,1,1) == "#" then
+		return Color3.fromHex(v)
+	elseif ok and type(v) == "string" and typeof(current) == "BrickColor" then
+		return BrickColor.new(v)
+	end
+	return v
+end
+local function bw_apply(inst, props)
+	local errors = {}
+	for prop, raw in pairs(props or {}) do
+		if prop ~= "Parent" and prop ~= "ClassName" then
+			local ok, err = pcall(function() inst[prop] = bw_coerce(inst, prop, raw) end)
+			if not ok then table.insert(errors, {property=prop,error=tostring(err)}) end
+		end
+	end
+	return errors
+end
+local function bw_create_tree(node, parent, created, errors)
+	local inst = Instance.new(node.className)
+	if node.name ~= nil then inst.Name = node.name end
+	for _, err in ipairs(bw_apply(inst, node.properties)) do err.path = node.name or node.className; table.insert(errors, err) end
+	for k, v in pairs(node.attributes or {}) do local ok, err = pcall(function() inst:SetAttribute(k,bw_decode(v)) end); if not ok then table.insert(errors,{attribute=k,error=tostring(err)}) end end
+	if node.source ~= nil and inst:IsA("LuaSourceContainer") then inst.Source = node.source end
+	for _, child in ipairs(node.children or {}) do bw_create_tree(child, inst, created, errors) end
+	inst.Parent = parent
+	table.insert(created, bw_path(inst))
+	return inst
+end
+"##;
