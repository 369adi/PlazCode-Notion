+
+fn luau_str(s: &str) -> String {
+    let mut out = String::with_capacity(s.len() + 2);
+    out.push('"');
+    for c in s.chars() {
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '"' => out.push_str("\\\""),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 32 || c as u32 == 127 => out.push_str(&format!("\\{:03}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+fn to_luau(v: &Value, depth: usize) -> Result<String, String> {
+    if depth > 40 { return Err("Roblox-Argumente sind zu tief verschachtelt".into()); }
+    Ok(match v {
+        Value::Null => "nil".into(),
+        Value::Bool(b) => b.to_string(),
+        Value::Number(n) => {
+            if let Some(f) = n.as_f64() { if !f.is_finite() { return Err("Roblox-Argumente duerfen keine unendlichen Zahlen enthalten".into()); } }
+            n.to_string()
+        }
+        Value::String(s) => luau_str(s),
+        Value::Array(a) => {
+            let items = a.iter().map(|x| to_luau(x, depth + 1)).collect::<Result<Vec<_>, _>>()?;
+            format!("{{{}}}", items.join(","))
+        }
+        Value::Object(m) => {
+            let mut items = Vec::with_capacity(m.len());
+            for (k, x) in m { items.push(format!("[{}]={}", luau_str(k), to_luau(x, depth + 1)?)); }
+            format!("{{{}}}", items.join(","))
+        }
+    })
+}
+
+pub fn path_segments(path: &str) -> Result<Vec<String>, String> {
+    let mut p = path.trim().to_string();
+    if p.is_empty() { return Err("path muss ein nicht-leerer Roblox-Instanzpfad sein".into()); }
+    if let Some(c) = GETSERVICE.captures(&p) {
+        let end = c.get(0).map(|m| m.end()).unwrap_or(0);
+        p = format!("game.{}{}", &c[1], &p[end..]);
+    }
+    let chars: Vec<char> = p.chars().collect();
+    let (mut parts, mut cur, mut i) = (Vec::<String>::new(), String::new(), 0usize);
+    while i < chars.len() {
+        let ch = chars[i];
+        if ch == '.' {
+            if !cur.is_empty() { parts.push(std::mem::take(&mut cur)); }
+            i += 1;
+        } else if ch == '[' {
+            if !cur.is_empty() { parts.push(std::mem::take(&mut cur)); }
+            if i + 1 >= chars.len() || !(chars[i + 1] == '"' || chars[i + 1] == '\'') {
+                return Err(format!("Ungueltiger Klammer-Pfad bei {:?}", chars[i..].iter().take(12).collect::<String>()));
+            }
+            let q = chars[i + 1];
+            let mut j = i + 2;
+            let mut s = String::new();
+            while j < chars.len() {
+                if chars[j] == '\\' && j + 1 < chars.len() { s.push(chars[j + 1]); j += 2; }
+                else if chars[j] == q { break; }
+                else { s.push(chars[j]); j += 1; }
+            }
+            if j + 1 >= chars.len() || chars[j + 1] != ']' { return Err("Nicht abgeschlossener Klammer-Pfad".into()); }
+            parts.push(s);
+            i = j + 2;
+        } else {
+            cur.push(ch);
+            i += 1;
+        }
+    }
+    if !cur.is_empty() { parts.push(cur); }
+    if parts.is_empty() { return Err("path muss eine Roblox-Instanz benennen".into()); }
+    if parts[0] != "game" { parts.insert(0, "game".into()); }
+    if parts.iter().any(|x| x.is_empty()) { return Err("path enthaelt ein leeres Segment".into()); }
+    Ok(parts)
+}
+
+fn prep_value(v: &Value) -> Result<Value, String> {
+    match v {
+        Value::Array(a) => Ok(Value::Array(a.iter().map(prep_value).collect::<Result<Vec<_>, _>>()?)),
+        Value::Object(m) => {
+            if m.get("$type").and_then(|t| t.as_str()) == Some("Ref") {
+                if let Some(p) = m.get("path").and_then(|p| p.as_str()) {
+                    return Ok(json!({"$type": "Ref", "segs": path_segments(p)?}));
+                }
+            }
+            let mut o = Map::new();
+            for (k, x) in m { o.insert(k.clone(), prep_value(x)?); }
+            Ok(Value::Object(o))
+        }
+        _ => Ok(v.clone()),
+    }
+}
+
+fn prep_node(node: &Value, depth: usize, count: &mut usize) -> Result<Value, String> {
+    if depth > 25 { return Err("Instanz-Baum ist zu tief (maximal 25 Ebenen)".into()); }
+    *count += 1;
+    if *count > 500 { return Err("Instanz-Baum ist zu gross (maximal 500 Instanzen)".into()); }
+    let Some(m) = node.as_object() else { return Err("jeder Baum-Knoten muss ein Objekt sein".into()); };
+    let cls = m.get("className").and_then(|c| c.as_str()).unwrap_or("");
+    if !CLASS_RE.is_match(cls) { return Err("jeder Baum-Knoten braucht einen gueltigen className".into()); }
+    let mut out = Map::new();
+    out.insert("className".into(), Value::String(cls.into()));
+    for k in ["name", "source"] {
+        if let Some(v) = m.get(k) {
+            if v.is_null() { continue; }
+            if !v.is_string() { return Err(format!("tree {k} muss Text sein")); }
+            out.insert(k.into(), v.clone());
+        }
+    }
+    for k in ["properties", "attributes"] {
+        if let Some(v) = m.get(k) {
+            if v.is_null() { continue; }
+            if !v.is_object() { return Err(format!("tree {k} muss ein Objekt sein")); }
+            out.insert(k.into(), prep_value(v)?);
+        }
+    }
+    let kids = match m.get("children") {
+        None | Some(Value::Null) => Vec::new(),
+        Some(Value::Array(a)) => a.clone(),
+        _ => return Err("tree children muss eine Liste sein".into()),
+    };
+    let mut c = Vec::with_capacity(kids.len());
+    for k in &kids { c.push(prep_node(k, depth + 1, count)?); }
+    out.insert("children".into(), Value::Array(c));
+    Ok(Value::Object(out))
+}
+
+fn wrapped(args: &Value, body: &str) -> Result<String, String> {
+    let a = to_luau(args, 0)?;
+    if a.len() > 2_000_000 { return Err("Roblox-Argumente ueberschreiten 2 MB".into()); }
+    Ok(format!(
+        "-- Roblox Studio MCP composite\nlocal ARGS = {a}\n{prelude}\nlocal __ok, __res = pcall(function()\n{body}\nend)\nlocal __out = if __ok then {{ok=true,result=__res}} else {{ok=false,error=tostring(__res)}}\nlocal __json = HttpService:JSONEncode(__out)\nlocal __s = \"{open}\" .. __json .. \"{close}\"\npcall(function() ChangeHistoryService:SetWaypoint(\"Roblox MCP change\") end)\nprint(__s)\nreturn __s",
+        a = a, prelude = PRELUDE, body = body, open = OPEN, close = CLOSE
+    ))
+}
