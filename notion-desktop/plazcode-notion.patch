@@ -0,0 +1,313 @@
+-- Roblox Studio helpers adapted from Brickwire's BW library.
+local BW = {}
+local function service(name)
+	return game:GetService(name)
+end
+local function fail(message)
+	error("BW: " .. message, 0)
+end
+
+function BW.find(path, root)
+	if typeof(path) == "Instance" then return path end
+	if type(path) ~= "string" then return nil end
+	local current = root or game
+	for segment in string.gmatch(path, "[^%.]+") do
+		if current == game and segment == "game" then
+			continue
+		elseif current == game and (segment == "Workspace" or segment == "workspace") then
+			current = workspace
+		else
+			local next = current:FindFirstChild(segment)
+			if not next and current == game then
+				local ok, result = pcall(function() return service(segment) end)
+				if ok then next = result end
+			end
+			if not next then return nil end
+			current = next
+		end
+	end
+	return current
+end
+
+function BW.get(path)
+	local instance = BW.find(path)
+	if not instance then fail("not found: " .. tostring(path)) end
+	return instance
+end
+function BW.exists(path) return BW.find(path) ~= nil end
+function BW.color(value)
+	if typeof(value) == "Color3" then return value end
+	if type(value) == "string" then
+		local hex = string.gsub(value, "^#", "")
+		if #hex == 6 and string.match(hex, "^%x+$") then return Color3.fromHex(hex) end
+		return BrickColor.new(value).Color
+	end
+	if type(value) == "table" then
+		local r, g, b = value[1] or value.r or 0, value[2] or value.g or 0, value[3] or value.b or 0
+		if r > 1 or g > 1 or b > 1 then return Color3.fromRGB(r, g, b) end
+		return Color3.new(r, g, b)
+	end
+	fail("cannot convert color: " .. tostring(value))
+end
+function BW.v3(value)
+	if typeof(value) == "Vector3" then return value end
+	if type(value) == "table" then return Vector3.new(value[1] or value.x or 0, value[2] or value.y or 0, value[3] or value.z or 0) end
+	fail("cannot convert Vector3: " .. tostring(value))
+end
+function BW.udim2(value)
+	if typeof(value) == "UDim2" then return value end
+	if type(value) ~= "table" then fail("cannot convert UDim2") end
+	if #value == 2 then return UDim2.fromScale(value[1], value[2]) end
+	return UDim2.new(value[1] or 0, value[2] or 0, value[3] or 0, value[4] or 0)
+end
+
+function BW.set(instance, properties)
+	local function numberSequence(value)
+		if type(value) == "number" then return NumberSequence.new(value) end
+		if type(value) == "table" and type(value[1]) == "number" and #value == 2 then
+			return NumberSequence.new({NumberSequenceKeypoint.new(0,value[1]),NumberSequenceKeypoint.new(1,value[2])})
+		end
+		return value
+	end
+	local function colorSequence(value)
+		if typeof(value) == "ColorSequence" then return value end
+		if type(value) == "table" and #value == 2 then
+			return ColorSequence.new({ColorSequenceKeypoint.new(0,BW.color(value[1])),ColorSequenceKeypoint.new(1,BW.color(value[2]))})
+		end
+		return ColorSequence.new(BW.color(value))
+	end
+	for key, value in pairs(properties or {}) do
+		if key == "Attributes" then
+			for name, attribute in pairs(value) do instance:SetAttribute(name, attribute) end
+		elseif key == "Corner" then
+			local corner = Instance.new("UICorner")
+			corner.CornerRadius = UDim.new(0, value)
+			corner.Parent = instance
+		elseif key == "Padding" then
+			local padding = Instance.new("UIPadding")
+			local u = UDim.new(0, value)
+			padding.PaddingTop, padding.PaddingBottom, padding.PaddingLeft, padding.PaddingRight = u, u, u, u
+			padding.Parent = instance
+		elseif key == "Stroke" then
+			local info = type(value) == "table" and value or {Thickness=value}
+			BW.new("UIStroke", {Color=info.Color or info[1] or "#000000", Thickness=info.Thickness or info[2] or 1, Parent=instance})
+		elseif key == "List" then
+			local info = type(value) == "table" and value or {}
+			BW.new("UIListLayout", {Padding=UDim.new(0,info.Padding or 6), FillDirection=info.Direction or "Vertical", HorizontalAlignment=info.Align or "Center", SortOrder="LayoutOrder", Parent=instance})
+		elseif key == "Aspect" then
+			BW.new("UIAspectRatioConstraint", {AspectRatio=value, Parent=instance})
+		elseif key == "Gradient" then
+			BW.new("UIGradient", {Color=colorSequence(value), Parent=instance})
+		elseif key ~= "Parent" and key ~= "Class" then
+			if instance.ClassName == "ParticleEmitter" or instance.ClassName == "Beam" or instance.ClassName == "Trail" then
+				if key == "Color" then value = colorSequence(value)
+				elseif key == "Size" or key == "Transparency" or key == "Squash" then value = numberSequence(value)
+				elseif key == "Lifetime" or key == "Speed" or key == "Rotation" or key == "RotSpeed" then value = type(value) == "number" and NumberRange.new(value) or type(value) == "table" and NumberRange.new(value[1],value[2] or value[1]) or value end
+			elseif key == "Color" or key == "Color3" or key == "BackgroundColor3" or key == "TextColor3" then value = BW.color(value)
+			elseif (key == "Size" or key == "Position") and instance:IsA("GuiObject") then value = BW.udim2(value)
+			elseif key == "Size" or key == "Position" or key == "Orientation" then
+				if instance:IsA("BasePart") then value = BW.v3(value) end
+			end
+			local ok, err = pcall(function() instance[key] = value end)
+			if not ok then fail("cannot set " .. instance.ClassName .. "." .. key .. ": " .. tostring(err)) end
+		end
+	end
+	return instance
+end
+
+function BW.new(className, properties)
+	local ok, instance = pcall(function() return Instance.new(className) end)
+	if not ok then fail("unknown class " .. tostring(className)) end
+	properties = properties or {}
+	if instance:IsA("BasePart") and properties.Anchored == nil then instance.Anchored = true end
+	if instance:IsA("GuiObject") and properties.BorderSizePixel == nil then instance.BorderSizePixel = 0 end
+	if instance:IsA("BasePart") then pcall(function() instance.TopSurface, instance.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth end) end
+	BW.set(instance, properties)
+	local parent = properties.Parent
+	if type(parent) == "string" then parent = BW.get(parent) end
+	if instance:IsA("BasePart") and parent == nil then parent = BW.defaultParent or workspace end
+	if parent then instance.Parent = parent end
+	return instance
+end
+BW.part = function(properties) return BW.new(properties.Class or "Part", properties) end
+function BW.folder(name, parent)
+	parent = type(parent) == "string" and BW.get(parent) or parent or workspace
+	local folder = parent:FindFirstChild(name)
+	if folder then return folder end
+	return BW.new("Folder", { Name = name, Parent = parent })
+end
+function BW.model(name, parent, replace)
+	parent = type(parent) == "string" and BW.get(parent) or parent or workspace
+	local old = parent:FindFirstChild(name)
+	if old then
+		if old:GetAttribute("BW_Owned") or replace then old:Destroy()
+		else fail("model already exists: " .. old:GetFullName()) end
+	end
+	local model = Instance.new("Model")
+	model.Name, model.Parent = name, parent
+	model:SetAttribute("BW_Owned", true)
+	BW.defaultParent = model
+	return model
+end
+function BW.weldAll(model, unanchor)
+	model = type(model) == "string" and BW.get(model) or model
+	local parts = {}
+	for _, item in ipairs(model:GetDescendants()) do if item:IsA("BasePart") then table.insert(parts, item) end end
+	local root = model.PrimaryPart or parts[1]
+	if not root then fail("weldAll: model has no parts") end
+	for _, part in ipairs(parts) do
+		if part ~= root then BW.new("WeldConstraint", { Part0 = root, Part1 = part, Parent = part }) end
+		if unanchor then part.Anchored = false end
+	end
+	return #parts
+end
+
+function BW.tree(target, depth)
+	local root = BW.get(target or "Workspace")
+	depth = math.max(0, math.min(6, depth or 2))
+	local lines = {}
+	local function walk(instance, level, prefix)
+		table.insert(lines, prefix .. instance.Name .. " [" .. instance.ClassName .. "]")
+		if level >= depth then return end
+		for index, child in ipairs(instance:GetChildren()) do
+			if index > 60 then table.insert(lines, prefix .. "  ... more children"); break end
+			walk(child, level + 1, prefix .. "  ")
+		end
+	end
+	walk(root, 0, "")
+	print(table.concat(lines, "\n"))
+	return lines
+end
+function BW.report(target)
+	local root, counts, parts = BW.get(target or "Workspace"), {}, 0
+	local lo, hi
+	for _, item in ipairs(root:GetDescendants()) do
+		counts[item.ClassName] = (counts[item.ClassName] or 0) + 1
+		if item:IsA("BasePart") then
+			parts += 1
+			local p, s = item.Position, item.Size
+			local a, b = {p.X-s.X/2,p.Y-s.Y/2,p.Z-s.Z/2}, {p.X+s.X/2,p.Y+s.Y/2,p.Z+s.Z/2}
+			if not lo then lo, hi = a, b else for i=1,3 do lo[i], hi[i] = math.min(lo[i],a[i]), math.max(hi[i],b[i]) end end
+		end
+	end
+	local result = { path = root:GetFullName(), descendants = #root:GetDescendants(), parts = parts, classes = counts }
+	if lo then result.bounds = { min = lo, max = hi } end
+	print("BW_REPORT " .. game:GetService("HttpService"):JSONEncode(result))
+	return result
+end
+function BW.check(condition, message)
+	print((condition and "BW_CHECK OK " or "BW_CHECK FAIL ") .. tostring(message))
+	return condition
+end
+
+local defaults = { Script = "ServerScriptService", LocalScript = "StarterPlayer.StarterPlayerScripts", ModuleScript = "ReplicatedStorage" }
+function BW.script(kind, name, parent, source)
+	if not defaults[kind] then fail("kind must be Script, LocalScript or ModuleScript") end
+	parent = BW.get(parent or defaults[kind])
+	local script = parent:FindFirstChild(name)
+	if script and script.ClassName ~= kind then fail("existing object is not a " .. kind) end
+	if not script then script = Instance.new(kind); script.Name = name; script.Parent = parent end
+	local ok, err = pcall(function() script.Source = source end)
+	if not ok then fail("cannot write script source: " .. tostring(err)) end
+	return script
+end
+function BW.source(path, fromLine, toLine)
+	local script = BW.get(path)
+	if not script:IsA("LuaSourceContainer") then fail("not a script") end
+	local lines = {}
+	for index, line in ipairs(string.split(script.Source, "\n")) do if index >= (fromLine or 1) and index <= (toLine or math.huge) then table.insert(lines, string.format("%4d| %s", index, line)) end end
+	print("BW_SOURCE " .. script:GetFullName() .. "\n" .. table.concat(lines, "\n"))
+	return script.Source
+end
+function BW.patch(path, oldText, newText, maxCount)
+	local script, source, out, count, at = BW.get(path), BW.get(path).Source, {}, 0, 1
+	while true do
+		local first, last = string.find(source, oldText, at, true)
+		if not first or (maxCount and count >= maxCount) then break end
+		table.insert(out, string.sub(source, at, first - 1)); table.insert(out, newText)
+		at, count = last + 1, count + 1
+	end
+	if count == 0 then fail("patch text not found") end
+	table.insert(out, string.sub(source, at)); script.Source = table.concat(out)
+	return count
+end
+function BW.scan(text, limit)
+	local hits, total = {}, 0
+	for _, item in ipairs(game:GetDescendants()) do
+		if item:IsA("LuaSourceContainer") then
+			local ok, source = pcall(function() return item.Source end)
+			if ok then for i, line in ipairs(string.split(source, "\n")) do if string.find(line, text, 1, true) then
+				total += 1; if #hits < (limit or 40) then table.insert(hits, {path=item:GetFullName(), line=i, text=string.sub(line,1,160)}) end
+			end end end
+		end
+	end
+	return { total = total, hits = hits }
+end
