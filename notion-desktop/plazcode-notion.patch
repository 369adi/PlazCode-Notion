+/// Wake-up text for an idle chat (AdiCode types it into the chat when the
+/// agent's Notion AI turn has ended but work is waiting). Returns (signature, text);
+/// the caller only re-sends when the signature changes or after a pause.
+pub(crate) fn nudge_for(agent: &str) -> Option<(String, String)> {
+    if agent.is_empty() { return None; }
+    let mut board = lock_board();
+    let pid = board.projects.values().filter(|p| p.agents.contains_key(agent)).max_by_key(|p| p.created)?.id.clone();
+    let p = board.projects.get_mut(&pid)?;
+    let t = now();
+    if p.lead == agent {
+        let all_done = !p.tasks.is_empty() && p.tasks.iter().all(|x| x.status == "done");
+        if all_done {
+            return Some((format!("done:{}:{}", p.id, p.tasks.len()), format!("Kurze automatische Erinnerung von AdiCode (von mir eingerichtet): Alle {} Tasks von Projekt {} sind erledigt. Rufe jetzt cowork_results (project {}, agent {agent}) auf und gib dem Nutzer EINE finale, zusammengefuehrte Antwort.", p.tasks.len(), p.id, p.id)));
+        }
+        let direct: Vec<Msg> = unread(p, agent).into_iter().filter(|m| m.to == agent).collect();
+        if let Some(last) = direct.last() {
+            let list = direct.iter().map(|m| format!("- [{}] {}", m.from, short(&m.text, 220))).collect::<Vec<_>>().join("\n");
+            return Some((format!("msg:{}", last.id), format!("Kurze automatische Erinnerung von AdiCode (von mir eingerichtet): Neues fuer dich als Lead in Projekt {}:\n{list}\nArbeite die Bewertungen/Blocker ein (cowork_board / cowork_add_tasks / cowork_message, agent {agent}) und verfolge danach mit cowork_wait den Fortschritt.", p.id)));
+        }
+        return None;
+    }
+    if !alive(p, agent) && p.agents.get(agent).map(|a| t - a.last_seen > 3 * stale(p)).unwrap_or(true) { return None; }
+    if let Some(cur) = p.tasks.iter().find(|x| x.owner == agent && x.status == "claimed") {
+        if t - cur.updated > 8 * 60 {
+            return Some((format!("stuck:{}:{}", cur.id, (t - cur.updated) / 600), format!("Kurze automatische Erinnerung von AdiCode (von mir eingerichtet): Du hast Task #{} ({}) in Projekt {} noch offen. Mach ihn fertig und melde ihn mit cowork_update (agent {agent}), danach weiter mit cowork_claim.", cur.id, short(&cur.title, 80), p.id)));
+        }
+        return None;
+    }
+    let free: Vec<u64> = p.tasks.iter().filter(|x| claimable(p, x, agent)).map(|x| x.id).collect();
+    let direct = unread(p, agent).into_iter().filter(|m| m.to == agent).count();
+    if free.is_empty() && direct == 0 { return None; }
+    let ids = free.iter().take(6).map(|i| format!("#{i}")).collect::<Vec<_>>().join(", ");
+    let what = if free.is_empty() { "neue Nachrichten fuer dich".to_string() } else { format!("{} freie Task(s) ({ids})", free.len()) };
+    Some((format!("work:{}:{}:{}", p.id, ids, p.next_msg), format!("Kurze automatische Erinnerung von AdiCode (von mir eingerichtet): In Projekt {} gibt es {what}. Arbeite weiter in Schleife: cowork_claim (project {}, agent {agent}) -> erledigen -> cowork_update -> cowork_claim ..., bis nichts mehr frei ist; dann cowork_wait.", p.id, p.id)))
+}
