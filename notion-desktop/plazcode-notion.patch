+    let ports:Vec<(usize,u16)>=tabs.iter().enumerate().filter(|(_,t)|running.contains(&t.id)).map(|(i,_)|(i,cdp_port(i))).collect();
+    for (_,p) in &ports{
+        if js_eval(*p,UPD_TYPING_JS).await.ok().and_then(|v|v.as_bool())==Some(true){return Err("In einem Notion-Chat steht noch ungesendeter Text. Erst abschicken oder l\u{f6}schen, dann nochmal auf Aktualisieren klicken.".into());}
+    }
+    let mut stopped=Vec::new();
+    for (i,p) in &ports{ if gen_snapshot(*p).await.is_some(){ let _=js_eval(*p,UPD_STOP_JS).await; stopped.push(*i); } }
+    for _ in 0..20{
+        let mut busy=false;
