+
+def contact_sheet(name="check", frames=None, scale=35):
+    """Quick review renders at several frames (default 5 evenly spaced) to judge motion/poses."""
+    sc = bpy.context.scene
+    frames = frames or [int(sc.frame_start + (sc.frame_end - sc.frame_start) * t / 4) for t in range(5)]
+    return [render(f"{name}_{f:04d}.png", f, scale) for f in frames]
+
+
+def render_video(path="anim.mp4", start=None, end=None, scale=100):
+    """Render the animation to MP4 (H.264) via FFmpeg output. Long jobs: prefer headless blender -b."""
+    sc = bpy.context.scene
+    if start:
+        sc.frame_start = start
+    if end:
+        sc.frame_end = end
+    r = sc.render
+    r.resolution_percentage = scale
+    r.filepath = _out(path)
+    try:
+        r.image_settings.media_type = "VIDEO"  # Blender 5.x
+    except Exception:
+        pass
+    try:
+        r.image_settings.file_format = "FFMPEG"
+        r.ffmpeg.format, r.ffmpeg.codec = "MPEG4", "H264"
+        r.ffmpeg.constant_rate_factor = "HIGH"
+    except Exception as e:
+        return f"ffmpeg setup failed: {e}"
+    op(bpy.ops.render.render, animation=True)
+    return r.filepath
+
+
+def export(path, fmt=None, selected=None):
+    """Export glb/gltf/fbx/obj/usd/stl (fmt from extension). Apply transforms before export."""
+    path = _out(path)
+    fmt = (fmt or os.path.splitext(path)[1][1:]).lower()
+    kw = {}
+    if selected:
+        for o in bpy.context.scene.objects:
+            o.select_set(o in selected)
+        kw["use_selection"] = True
+    if fmt in ("glb", "gltf"):
+        op(bpy.ops.export_scene.gltf, filepath=path, export_format="GLB" if fmt == "glb" else "GLTF_SEPARATE", **kw)
+    elif fmt == "fbx":
+        op(bpy.ops.export_scene.fbx, filepath=path, apply_scale_options="FBX_SCALE_ALL", bake_anim=True, **kw)
+    elif fmt == "obj":
+        op(bpy.ops.wm.obj_export, filepath=path, export_selected_objects=bool(selected))
+    elif fmt in ("usd", "usdc", "usda"):
+        op(bpy.ops.wm.usd_export, filepath=path, selected_objects_only=bool(selected))
+    elif fmt == "stl":
+        op(bpy.ops.wm.stl_export, filepath=path, export_selected_objects=bool(selected))
+    else:
+        raise ValueError(fmt)
+    return path
+
+
+def save(path=None):
+    """Save the .blend (default PlazCode-Shared/blender-out/scene.blend)."""
+    p = path or bpy.data.filepath or _out("scene.blend")
+    op(bpy.ops.wm.save_as_mainfile, filepath=p)
+    return p
+
+
+# ------------------------------------------------------ reference matching
+def _np():
+    import numpy as np
+    return np
+
+
+def _load_px(path):
+    """Image file -> float array (H, W, 4), row 0 = top."""
+    np = _np()
+    img = bpy.data.images.load(path, check_existing=False)
+    try:
+        w, h = img.size
+        a = np.empty(w * h * 4, dtype=np.float32)
+        img.pixels.foreach_get(a)
+        return a.reshape(h, w, 4)[::-1].copy()
+    finally:
+        bpy.data.images.remove(img)
+
+
+def _save_px(arr, path):
+    np = _np()
+    h, w = arr.shape[:2]
+    img = bpy.data.images.new("ADC_tmp_out", w, h, alpha=True)
+    try:
+        img.pixels.foreach_set(np.ascontiguousarray(arr[::-1], dtype=np.float32).ravel())
+        img.filepath_raw = path
+        img.file_format = "PNG"
+        img.save()
+    finally:
+        bpy.data.images.remove(img)
+    return path
+
+
+def _resize(arr, h, w):
+    np = _np()
+    ys = (np.arange(h) * arr.shape[0] / h).astype(int)
+    xs = (np.arange(w) * arr.shape[1] / w).astype(int)
+    return arr[ys][:, xs]
+
+
+def _mask(arr, tol=0.12):
+    """Foreground mask: alpha if the image has transparency, else distance to the border colour."""
+    np = _np()
+    al = arr[..., 3]
+    if al.min() < 0.5 and al.max() > 0.5:
+        return al > 0.5
+    border = np.concatenate([arr[0, :, :3], arr[-1, :, :3], arr[:, 0, :3], arr[:, -1, :3]])
+    bg = np.median(border, axis=0)
+    return np.linalg.norm(arr[..., :3] - bg, axis=-1) > tol
+
+
+def _bbox(m):
+    np = _np()
+    ys, xs = np.nonzero(m)
+    if len(xs) == 0:
+        return None
+    return int(xs.min()), int(ys.min()), int(xs.max()) + 1, int(ys.max()) + 1
+
+
+def _hex(c):
+    c = [max(0, min(255, int(round(v * 255)))) for v in c[:3]]
+    return "#%02x%02x%02x" % tuple(c)
+
+
+def _palette(px, k=5, seed=0):
+    np = _np()
+    if len(px) == 0:
+        return []
+    rng = np.random.default_rng(seed)
+    px = px[rng.choice(len(px), min(len(px), 6000), replace=False)]
+    cent = px[rng.choice(len(px), min(k, len(px)), replace=False)]
+    for _ in range(10):
+        lab = np.argmin(((px[:, None] - cent[None]) ** 2).sum(-1), 1)
+        cent = np.array([px[lab == i].mean(0) if (lab == i).any() else cent[i] for i in range(len(cent))])
+    share = np.bincount(lab, minlength=len(cent)) / len(px)
+    order = np.argsort(-share)
+    return [{"hex": _hex(cent[i]), "rgb": [round(float(v), 3) for v in cent[i]], "share": round(float(share[i]), 3)} for i in order]
+
+
+def _profile(m, box, n=10):
+    """Relative width of the silhouette at n heights (top -> bottom), 1.0 = full bbox width."""
+    x0, y0, x1, y1 = box
+    out = []
+    for i in range(n):
+        y = int(y0 + (i + 0.5) * (y1 - y0) / n)
+        row = m[y, x0:x1]
+        out.append(round(float(row.sum()) / max(1, x1 - x0), 2))
+    return out
+
+
+def measure_ref(path, tol=0.12, colors=5):
+    """Measure a reference image: silhouette bbox, aspect, width profile, dominant colours (hex). Use the numbers, don't guess."""
+    np = _np()
+    a = _load_px(path)
+    h, w = a.shape[:2]
+    m = _mask(a, tol)
+    box = _bbox(m)
+    if not box:
+        return {"error": "no foreground found; raise/lower tol", "size": [w, h]}
+    x0, y0, x1, y1 = box
+    bw, bh = x1 - x0, y1 - y0
+    return {
+        "size": [w, h],
+        "bbox_px": list(box),
+        "bbox_rel": [round(x0 / w, 3), round(y0 / h, 3), round(x1 / w, 3), round(y1 / h, 3)],
+        "aspect_w_over_h": round(bw / max(1, bh), 3),
+        "fill": round(float(m[y0:y1, x0:x1].mean()), 3),
+        "width_profile_top_to_bottom": _profile(m, box),
+        "colors": _palette(a[..., :3][m], colors),
+        "hint": "Height = 1 unit -> width = aspect_w_over_h. Pick real-world height in metres and scale all parts from these ratios.",
+    }
+
+
+def ref_camera(path, view="persp", lens=50.0, objs=None, angle=(35.0, 20.0), name="ADC_RefCam", opacity=0.5):
+    """Camera matching the reference: render aspect = image aspect, image as camera background. view=persp|front|back|side|top."""
+    sc = bpy.context.scene
+    path = os.path.abspath(path)
+    img = bpy.data.images.load(path, check_existing=True)
+    w, h = img.size
+    sc.render.resolution_x, sc.render.resolution_y = (1600, max(1, round(1600 * h / w))) if w >= h else (max(1, round(1600 * w / h)), 1600)
+    ang = {"persp": angle, "front": (0.0, 0.0), "back": (180.0, 0.0), "side": (90.0, 0.0), "top": (0.0, 89.9)}[view]
+    has_mesh = any(o.type == "MESH" for o in sc.objects)
+    cam = camera(objs if has_mesh or objs else None, lens=lens, angle=ang, name=name) if (has_mesh or objs) else None
+    if cam is None:
+        cam = bpy.data.objects.get(name) or link(bpy.data.objects.new(name, bpy.data.cameras.new(name)))
+        cam.data.lens = lens
+        cam.location = Vector((0, -6, 1)) if view != "top" else Vector((0, 0, 8))
+        look_at(cam, Vector((0, 0, 1 if view != "top" else 0)))
+        sc.camera = cam
+    cam.data.type = "PERSP" if view == "persp" else "ORTHO"
+    if view != "persp":
+        center, size = _bounds([o for o in sc.objects if o.type == "MESH"]) if has_mesh else (Vector((0, 0, 1)), 2.0)
+        cam.data.ortho_scale = size * 1.25
+    cam.data.show_background_images = True
+    bg = cam.data.background_images[0] if len(cam.data.background_images) else cam.data.background_images.new()
+    bg.image, bg.alpha, bg.display_depth, bg.frame_method = img, opacity, "FRONT", "FIT"
+    sc["adc_ref"], sc["adc_ref_view"] = path, view
+    return {"camera": cam.name, "view": view, "type": cam.data.type, "res": [sc.render.resolution_x, sc.render.resolution_y], "ref": path,
+            "next": "Block out at true scale, then A.compare() and fix what it reports. Repeat until shape_iou >= 0.85."}
+
+
+def compare(path=None, name="compare", scale=50, tol=0.12, engine=None):
+    """Render from the active camera and compare with the reference: side-by-side + overlay PNG, IoU scores, concrete fix hints."""
+    np = _np()
+    sc = bpy.context.scene
+    path = path or sc.get("adc_ref")
+    if not path:
+        return {"error": "no reference: call A.ref_camera(path) first or pass path"}
+    r = sc.render
+    old = (r.film_transparent, r.engine)
+    r.film_transparent = True
+    if engine:
+        render_settings(engine, res=(r.resolution_x, r.resolution_y), quality="draft", transparent=True)
+    try:
+        rp = render(f"{name}_render.png", scale=scale)
+    finally:
+        r.film_transparent = old[0]
+        try:
+            r.engine = old[1]
+        except Exception:
+            pass
+    ren = _load_px(rp)
+    h, w = ren.shape[:2]
+    ref = _resize(_load_px(path), h, w)
+    mr, mo = _mask(ref, tol), ren[..., 3] > 0.5
+    union = (mr | mo).sum()
+    iou = float((mr & mo).sum()) / max(1, union)
+    br, bo = _bbox(mr), _bbox(mo)
+    res = {"render": rp, "iou": round(iou, 3)}
+    hints = []
+    if not bo:
+        res["error"] = "render is empty (camera sees nothing)"
+        hints.append("Camera sees no mesh: A.ref_camera(path) again or move objects in front of it.")
+    elif br:
+        def crop(m, b):
+            return _resize(m[b[1]:b[3], b[0]:b[2]], 128, 128)
+        cr, co = crop(mr, br), crop(mo, bo)
+        res["shape_iou"] = round(float((cr & co).sum()) / max(1, (cr | co).sum()), 3)
+        ar = (br[2] - br[0]) / max(1, br[3] - br[1])
+        ao = (bo[2] - bo[0]) / max(1, bo[3] - bo[1])
+        res["aspect_ref"], res["aspect_model"] = round(ar, 3), round(ao, 3)
+        if ao > ar * 1.06:
+            hints.append(f"Model too wide/short by {round((ao / ar - 1) * 100)}%: scale width down or height up.")
+        elif ao < ar / 1.06:
+            hints.append(f"Model too narrow/tall by {round((ar / ao - 1) * 100)}%: scale width up or height down.")
+        pr, po = _profile(mr, br), _profile(mo, bo)
+        res["width_profile_ref"], res["width_profile_model"] = pr, po
+        for i, (a, b) in enumerate(zip(pr, po)):
+            if abs(a - b) > 0.12:
+                band = ["top", "upper", "middle", "lower", "bottom"][min(4, i // 2)]
+                hints.append(f"{band} band ({i * 10}-{i * 10 + 10}% from top): width ref {a} vs model {b} -> {'widen' if a > b else 'narrow'} that part.")
+        cx_r, cx_o = (br[0] + br[2]) / 2 / w, (bo[0] + bo[2]) / 2 / w
+        cy_r, cy_o = (br[1] + br[3]) / 2 / h, (bo[1] + bo[3]) / 2 / h
+        size_r, size_o = (br[3] - br[1]) / h, (bo[3] - bo[1]) / h
+        res["framing"] = {"dx": round(cx_o - cx_r, 3), "dy": round(cy_o - cy_r, 3), "size_ratio": round(size_o / max(1e-6, size_r), 3)}
+        if res["shape_iou"] > iou + 0.15:
+            hints.append("Shape fits better than placement: adjust camera/framing (dx, dy, size_ratio), not the model.")
+        pal_r = _palette(ref[..., :3][mr], 4)
+        pal_o = _palette(ren[..., :3][mo], 4)
+        res["colors_ref"], res["colors_model"] = [c["hex"] for c in pal_r], [c["hex"] for c in pal_o]
+        if pal_r and pal_o:
+            d = float(np.linalg.norm(np.array(pal_r[0]["rgb"]) - np.array(pal_o[0]["rgb"])))
+            res["main_color_diff"] = round(d, 3)
+            if d > 0.15:
+                hints.append(f"Main colour off: ref {pal_r[0]['hex']} vs model {pal_o[0]['hex']} (check material base colour and lighting).")
+    ov = np.zeros((h, w, 4), dtype=np.float32)
+    ov[..., 3] = 1.0
+    ov[mr & ~mo] = (0.9, 0.15, 0.15, 1)
+    ov[mo & ~mr] = (0.15, 0.5, 1.0, 1)
+    ov[mr & mo] = (0.95, 0.85, 0.2, 1)
+    flat = ren.copy()
+    a = flat[..., 3:4]
+    flat[..., :3] = flat[..., :3] * a + 0.12 * (1 - a)
+    flat[..., 3] = 1.0
+    refo = ref.copy()
+    refo[..., 3] = 1.0
+    gap = np.ones((h, 8, 4), dtype=np.float32)
+    comp = np.concatenate([refo, gap, flat, gap, ov], axis=1)
+    res["composite"] = _save_px(comp, _out(f"{name}.png"))
+    res["legend"] = "composite = reference | model render | overlay (yellow = match, red = missing in model, blue = extra in model)"
+    s = res.get("shape_iou", iou)
+    res["verdict"] = "good" if s >= 0.85 else ("close" if s >= 0.7 else "off")
+    res["hints"] = hints or ["Silhouette matches; refine details/materials, then compare again."]
+    return res
+
+
+def ortho_views(name="views", scale=40):
+    """Render front, side and top orthographic views (for checking proportions against multi-view references)."""
+    sc = bpy.context.scene
+    prev = sc.camera
+    out = {}
+    for v, ang in (("front", (0.0, 0.0)), ("side", (90.0, 0.0)), ("top", (0.0, 89.9))):
+        cam = camera(lens=50.0, angle=ang, name="ADC_Ortho")
+        cam.data.type = "ORTHO"
+        center, size = _bounds([o for o in sc.objects if o.type == "MESH" and not o.hide_render])
+        cam.data.ortho_scale = size * 1.1
+        out[v] = render(f"{name}_{v}.png", scale=scale)
+    sc.camera = prev or sc.camera
+    return out
