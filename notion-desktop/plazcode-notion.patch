+async fn delete_after_read(files: Vec<String>) {
+    let mut seen = false; let mut w = 0u64; sleep(5000).await;
+    loop {
+        let g = match Session::page().await { Ok(mut s) => s.eval(ROWS).await.ok().and_then(|v| v["gen"].as_bool()), Err(_) => None };
+        if g == Some(true) { seen = true; } else if g == Some(false) && (seen || w > 45_000) { break; }
+        if w > 900_000 { break; }
+        sleep(3000).await; w += 3000;
+    }
+    for f in files { let _ = std::fs::remove_file(f); }
+}
+#[allow(dead_code)]
+fn cleanup_uploads() {
+    let Ok(rd) = std::fs::read_dir(uploads()) else { return };
+    let limit = std::time::SystemTime::now() - Duration::from_secs(3 * 24 * 3600);
+    for e in rd.flatten() {
+        if e.metadata().and_then(|m| m.modified()).map(|m| m < limit).unwrap_or(false) { let _ = std::fs::remove_dir_all(e.path()); }
+    }
+}
+/// Rohdaten-Upload (Body = Datei), damit auch grosse Videos ohne Base64 funktionieren.
+pub async fn upload_handler(Query(q): Query<UploadQuery>, body: Bytes) -> Response {
+    if body.is_empty() { return fail("Leere Datei."); }
+    let name = safe_name(q.name.as_deref().unwrap_or("datei"));
+    let dir = uploads();
+    if let Err(e) = tokio::fs::create_dir_all(&dir).await { return fail(e.to_string()); }
+    let path = dir.join(format!("{}_{}", chrono::Utc::now().timestamp_millis(), name));
+    match tokio::fs::write(&path, &body).await {
+        Ok(_) => ok(json!({"ok": true, "path": path.display().to_string(), "name": name, "size": body.len()})),
+        Err(e) => fail(e.to_string()),
+    }
+}
+
+fn checked_files(v: &Value) -> Result<Vec<String>, String> {
+    let root = std::fs::canonicalize(uploads()).ok();
+    let mut out = Vec::new();
+    for f in v.as_array().cloned().unwrap_or_default() {
+        let p = f.as_str().ok_or("Ungueltiger Dateipfad.")?;
+        let c = std::fs::canonicalize(p).map_err(|_| format!("Datei fehlt: {p}"))?;
+        if !root.as_ref().map(|r| c.starts_with(r)).unwrap_or(false) { return Err("Nur Dateien aus dem AdiCode-Upload sind erlaubt.".into()); }
+        let s = c.display().to_string();
+        out.push(s.strip_prefix(r"\\?\").map(str::to_string).unwrap_or(s));
+    }
+    Ok(out)
+}
+
+async fn submit(s: &mut Session) -> Result<(), String> {
+    let before = s.eval(ROWS).await?;
+    let rows = before["rows"].as_u64().unwrap_or(0);
+    let p = s.eval(SEND_POINT).await?;
+    if p.is_null() { return Err("Senden-Knopf von Notion nicht gefunden.".into()); }
+    s.click(&p).await?;
+    for i in 0..16 {
+        sleep(250).await;
+        let v = s.eval(ROWS).await?;
+        if v["rows"].as_u64().unwrap_or(0) > rows || v["gen"].as_bool() == Some(true) { return Ok(()); }
+        if i == 7 { let _ = s.eval("const b=__q('agent-chat-send-button');if(b)b.click();return !!b;").await; }
+    }
+    let _ = s.eval("const c=__composer();if(c)c.focus();return !!c;").await;
+    for t in ["keyDown", "keyUp"] {
+        s.call("Input.dispatchKeyEvent", json!({"type": t, "key": "Enter", "code": "Enter", "windowsVirtualKeyCode": 13, "modifiers": 2}), 5).await?;
+    }
+    sleep(1200).await;
+    let v = s.eval(ROWS).await?;
+    if v["rows"].as_u64().unwrap_or(0) > rows || v["gen"].as_bool() == Some(true) { Ok(()) } else { Err("Notion hat die Nachricht nicht angenommen (Senden-Knopf gesperrt?).".into()) }
+}
+
+async fn send(text: String, files: Vec<String>) -> Result<Value, String> {
+    // Dateien (Bilder, Videos, PDFs ...) werden echt in den Notion-Chat hochgeladen, ohne Hinweistext.
+    let mut text = text; let files = files;
+    ensure_main().await?;
+    let mut s = Session::page().await?;
+    let st = s.eval(ROWS).await?;
+    if st["gen"].as_bool() == Some(true) { return Err("Notion AI antwortet noch. Warte kurz oder druecke Stopp.".into()); }
+    if s.eval("return !!__q('agent-chat-stop-recording-button');").await?.as_bool() == Some(true) {
+        let _ = s.eval("const b=__q('agent-chat-cancel-recording-button');if(b)b.click();return true;").await;
+        sleep(600).await;
+    }
+    if st["rows"].as_u64().unwrap_or(0) == 0 && !text.is_empty() { if let Some(ctx) = np::cowork_main_context() { text = format!("{ctx}\n\nMeine Aufgabe: {text}"); } }
+    s.eval(CLEAR).await?;
+    let mut warning = None;
+    if !files.is_empty() {
+        let r = s.call("Runtime.evaluate", json!({"expression": "document.querySelector('input[type=file]')"}), 10).await?;
+        let oid = r.pointer("/result/objectId").and_then(Value::as_str).ok_or("Das Datei-Feld von Notion wurde nicht gefunden.")?.to_string();
+        s.call("DOM.setFileInputFiles", json!({"files": files, "objectId": oid}), 30).await?;
+        sleep(1500).await;
+        let mut stable = 0;
+        let mut waited = 0u64;
+        loop {
+            let u = s.eval(UPLOAD_STATE).await?;
+            let busy = u["busy"].as_bool().unwrap_or(false);
+            let disabled = u["disabled"].as_bool().unwrap_or(true);
+            if !busy && !disabled { stable += 1; if stable >= 2 { break; } } else { stable = 0; }
+            if !busy && disabled && waited > 25_000 { warning = Some("Notion hat nicht alle Dateien angenommen (zu gross oder Format nicht unterstuetzt?)."); break; }
+            if waited > 300_000 { warning = Some("Upload dauert sehr lange; Nachricht wird trotzdem gesendet."); break; }
+            sleep(700).await;
+            waited += 700;
+        }
+        // Nur wenn Notion eine Datei ablehnt: kurzer Pfad-Hinweis, damit die KI sie per AdiCode lesen kann.
+        if warning.is_some() { text = format!("{}\n\n[Dateien: {}]", text, files.join(", ")).trim().to_string(); }
+    }
+    if !text.is_empty() {
+        let paste = format!("const c=__composer();if(!c)return false;c.focus();const dt=new DataTransfer();dt.setData('text/plain',{});c.dispatchEvent(new ClipboardEvent('paste',{{clipboardData:dt,bubbles:true,cancelable:true}}));await __sleep(250);return (c.innerText||'').trim().length>0;", js_str(&text));
+        if s.eval(&paste).await?.as_bool() != Some(true) {
+            let _ = s.eval("const c=__composer();if(c)c.focus();return !!c;").await;
+            s.call("Input.insertText", json!({"text": text}), 10).await?;
+        }
+        sleep(300).await;
+    }
+    submit(&mut s).await?;
+    Ok(json!({"ok": true, "warning": warning}))
+}
+
+/// Kurze Textnachricht in den Main-Chat (z. B. "weiter" nach einem Update).
+pub(crate) async fn send_text(t: &str) -> Result<Value, String> { send(t.to_string(), Vec::new()).await }
+
+pub async fn send_handler(Json(b): Json<Value>) -> Response {
+    let text = b["text"].as_str().unwrap_or("").trim_end().to_string();
+    let files = match checked_files(&b["files"]) { Ok(f) => f, Err(e) => return fail(e) };
+    if text.trim().is_empty() && files.is_empty() { return fail("Nachricht ist leer."); }
+    let del = files.clone();
+    let r = send(text, files).await;
+    // Nur AdiCode-eigene Upload-Kopien aufraeumen, und nur wenn Notion sie angenommen hat.
+    if !del.is_empty() && matches!(&r, Ok(v) if v["warning"].is_null()) { tokio::spawn(delete_after_read(del)); }
+    reply(r)
+}
+
+async fn click_testid(s: &mut Session, id: &str) -> Result<bool, String> {
+    let p = s.eval(&format!("const b=__q({});if(!b)return null;return __center(b);", js_str(id))).await?;
+    if p.is_null() { return Ok(false); }
+    s.click(&p).await?;
+    Ok(true)
+}
+
+async fn dictate(action: &str) -> Result<Value, String> {
+    match action {
+        "start" => {
+            ensure_main().await?;
+            let mut s = Session::page().await?;
+            let origin = s.eval("return location.origin;").await?.as_str().unwrap_or("https://app.notion.com").to_string();
+            if let Ok(mut b) = Session::browser().await {
+                for o in [origin.as_str(), "https://app.notion.com", "https://www.notion.so"] {
+                    let _ = b.call("Browser.grantPermissions", json!({"origin": o, "permissions": ["audioCapture"]}), 5).await;
+                }
+            }
+            if s.eval("return !!__q('agent-chat-stop-recording-button');").await?.as_bool() == Some(true) { return Ok(json!({"ok": true, "recording": true})); }
+            let _ = s.eval(CLEAR).await;
+            if !click_testid(&mut s, "agent-chat-dictation-button").await? { return Err("Diktat-Knopf von Notion nicht gefunden.".into()); }
+            for i in 0..12 {
+                sleep(250).await;
+                if s.eval("return !!__q('agent-chat-stop-recording-button');").await?.as_bool() == Some(true) { return Ok(json!({"ok": true, "recording": true})); }
+                if i == 5 { let _ = s.eval("const b=__q('agent-chat-dictation-button');if(b)b.click();return true;").await; }
+            }
+            Err("Notion hat die Aufnahme nicht gestartet (Mikrofon blockiert?).".into())
+        }
+        "stop" => {
+            let mut s = Session::page().await?;
+            if !click_testid(&mut s, "agent-chat-stop-recording-button").await? { return Ok(json!({"ok": true, "text": ""})); }
+            let mut text = String::new();
+            for i in 0..80 {
+                sleep(400).await;
+                let v = s.eval("const c=__composer();return {rec:!!__q('agent-chat-stop-recording-button'),c:!!c,t:c?(c.innerText||'').trim():''};").await?;
+                let t = v["t"].as_str().unwrap_or("").to_string();
+                if !t.is_empty() { sleep(500).await; let v2 = s.eval("const c=__composer();return c?(c.innerText||'').trim():'';").await?; text = v2.as_str().unwrap_or(&t).to_string(); break; }
+                if v["c"].as_bool() == Some(true) && v["rec"].as_bool() != Some(true) && i > 15 { break; }
+            }
+            let _ = s.eval(CLEAR).await;
+            Ok(json!({"ok": true, "text": text}))
+        }
+        "cancel" => {
+            let mut s = Session::page().await?;
+            let _ = s.eval("const b=__q('agent-chat-cancel-recording-button');if(b)b.click();return !!b;").await;
+            Ok(json!({"ok": true}))
+        }
+        _ => Err("Unbekannte Diktat-Aktion.".into()),
+    }
+}
+
+fn open_external(url: &str) -> Result<(), String> {
+    if !(url.starts_with("https://") || url.starts_with("http://")) || url.chars().any(|c| c.is_control() || c == '"') { return Err("Nur http(s)-Links.".into()); }
+    #[cfg(windows)]
+    { std::process::Command::new("rundll32").arg("url.dll,FileProtocolHandler").arg(url).spawn().map_err(|e| e.to_string())?; }
+    Ok(())
+}
+
+const ENH_RULES: &str = "Du bist ein Prompt-Enhancer. Schreibe den Prompt unten so um, dass eine KI ihn optimal versteht und das beste Ergebnis liefert: klares Ziel, wichtiger Kontext, konkrete Anforderungen und Schritte, gewuenschtes Ausgabeformat, Randbedingungen und Qualitaetskriterien. Behalte Sprache und Absicht des Nutzers bei, erfinde keine Fakten, beantworte den Prompt NICHT selbst und nutze KEINE Tools. Antworte ausschliesslich so: erste Zeile PROMPTSTART, dann nur der verbesserte Prompt, letzte Zeile PROMPTENDE.";
+fn enhance_local(t: &str) -> String {
+    format!("Ziel:\n{}\n\nAnforderungen:\n- Kläre zuerst kurz, falls etwas Wichtiges unklar ist, sonst triff sinnvolle Annahmen und nenne sie.\n- Gehe Schritt für Schritt vor und liefere ein vollständiges, direkt nutzbares Ergebnis.\n- Achte auf Qualität: prüfe dein Ergebnis selbst auf Fehler.\n\nAusgabe:\n- Klar gegliedert, auf Deutsch.\n- Zum Schluss eine kurze Zusammenfassung, was gemacht wurde und was ich prüfen soll.", t.trim())
+}
+async fn port_up(p: u16) -> bool { reqwest::Client::new().get(format!("http://127.0.0.1:{}/json/version", p)).timeout(Duration::from_millis(1200)).send().await.map(|r| r.status().is_success()).unwrap_or(false) }
+/// Prompt-Enhancer: oeffnet im Hintergrund einen neuen Notion-AI-Tab in einem Worker-Browser (nie im Main-Chat), laesst den Prompt umschreiben und schliesst den Tab wieder.
+async fn enhance_ai(text: &str) -> Result<String, String> {
+    let n = np::load().len(); let mi = np::main_index();
+    let mut port = None;
+    for i in (0..n).rev().filter(|i| *i != mi) { let p = np::cdp_port(i); if port_up(p).await { port = Some(p); break; } }
+    let p = match port { Some(p) => p, None => { let p = np::cdp_port(mi); if port_up(p).await { p } else { return Err("Kein Notion-Fenster offen \u{2013} lokale Verbesserung genutzt.".into()); } } };
+    let v: Value = reqwest::Client::new().get(format!("http://127.0.0.1:{}/json/version", p)).timeout(Duration::from_secs(3)).send().await.map_err(|e| e.to_string())?.json().await.map_err(|e| e.to_string())?;
+    let bws = v["webSocketDebuggerUrl"].as_str().ok_or("Browser-CDP fehlt")?.to_string();
+    let mut b = Session::connect(&bws).await?;
+    let r = b.call("Target.createTarget", json!({"url": "https://www.notion.so/ai", "background": true}), 10).await?;
+    let tid = r["targetId"].as_str().ok_or("Kein Tab fuer den Enhancer")?.to_string();
+    let res = enhance_in(p, &tid, text).await;
+    let _ = b.call("Target.closeTarget", json!({"targetId": tid}), 5).await;
+    res
+}
+async fn enhance_in(p: u16, tid: &str, text: &str) -> Result<String, String> {
+    let mut s = Session::connect(&format!("ws://127.0.0.1:{}/devtools/page/{}", p, tid)).await?;
+    let mut ready = false;
+    for _ in 0..50 { sleep(500).await; if s.eval("return !!__composer();").await.ok().and_then(|v| v.as_bool()) == Some(true) { ready = true; break; } }
+    if !ready { return Err("Notion-AI-Eingabe f\u{fc}r den Enhancer nicht gefunden \u{2013} lokale Verbesserung genutzt.".into()); }
+    let msg = format!("{}\n\nPrompt:\n{}", ENH_RULES, text);
+    let paste = format!("const c=__composer();if(!c)return false;c.focus();const dt=new DataTransfer();dt.setData('text/plain',{});c.dispatchEvent(new ClipboardEvent('paste',{{clipboardData:dt,bubbles:true,cancelable:true}}));await __sleep(250);return (c.innerText||'').trim().length>0;", js_str(&msg));
+    if s.eval(&paste).await?.as_bool() != Some(true) { let _ = s.eval("const c=__composer();if(c)c.focus();return !!c;").await; s.call("Input.insertText", json!({"text": msg}), 10).await?; }
+    sleep(300).await;
+    submit(&mut s).await?;
+    for _ in 0..170 {
+        sleep(700).await;
+        let v = s.eval("return {t:__rows().map(r=>r.innerText||'').join('\\n'),gen:!!__q('agent-chat-stop-button')};").await.unwrap_or(Value::Null);
+        let all = v["t"].as_str().unwrap_or("");
+        if all.matches("PROMPTSTART").count() >= 2 && v["gen"].as_bool() != Some(true) {
+            if let Some(k) = all.rfind("PROMPTSTART") { let tail = &all[k + 11..]; if let Some(e) = tail.find("PROMPTENDE") { let out = tail[..e].trim().to_string(); if !out.is_empty() { return Ok(out); } } }
+        }
+    }
+    Err("Enhancer hat zu lange gebraucht \u{2013} lokale Verbesserung genutzt.".into())
+}
+
+async fn control(b: Value) -> Result<Value, String> {
+    let op = b["op"].as_str().unwrap_or("");
+    if op == "enhance" {
+        let t = b["text"].as_str().unwrap_or("").trim().to_string();
+        if t.is_empty() { return Err("Schreib zuerst einen Prompt, den ich verbessern soll.".into()); }
+        return Ok(match enhance_ai(&t).await { Ok(x) => json!({"ok": true, "text": x, "ai": true}), Err(e) => json!({"ok": true, "text": enhance_local(&t), "ai": false, "warning": e}) });
+    }
+    match op {
+        "stop" => {
+            let mut s = Session::page().await?;
+            let done = click_testid(&mut s, "agent-chat-stop-button").await?;
+            Ok(json!({"ok": true, "stopped": done}))
+        }
+        "new" => {
+            ensure_main().await?;
+            new_own_chat("https://www.notion.so/chat").await?;
+            let mut s = Session::page().await?;
+            wait_own(&mut s).await?;
+            Ok(json!({"ok": true, "base": "", "own": true}))
+        }
+        "trim" => {
+            let keep = b["keep"].as_u64().unwrap_or(12);
+            let mut s = Session::page().await?;
+            let js = format!("const r=__rows();const n=Math.max(0,r.length-{});r.forEach((e,i)=>{{e.style.display=i<n?'none':''}});return n;", keep);
+            let v = s.eval(&js).await?;
+            Ok(json!({"ok": true, "hidden": v}))
+        }
+        "open" => {
+            let url = b["url"].as_str().unwrap_or("");
+            if !(url.starts_with("https://app.notion.com/") || url.starts_with("https://www.notion.so/")) { return Err("Nur Notion-Chats koennen geoeffnet werden.".into()); }
+            ensure_main().await?;
+            if np::chat_own().is_empty() { new_own_chat(url).await?; let mut s = Session::page().await?; wait_own(&mut s).await?; }
+            else { let mut s = Session::page().await?; let _ = s.navigate(url).await; sleep(800).await; wait_own(&mut s).await?; }
+            Ok(json!({"ok": true}))
+        }
+        "forget" => {
+            let url = b["url"].as_str().unwrap_or("");
+            let _g = HISTORY.lock().unwrap_or_else(|e| e.into_inner());
+            let list: Vec<Value> = read_history().into_iter().filter(|x| x["url"] != json!(url)).collect();
+            std::fs::write(history_file(), serde_json::to_string_pretty(&list).unwrap_or_default()).map_err(|e| e.to_string())?;
+            Ok(json!({"ok": true}))
+        }
+        "window" => {
+            let show = b["show"].as_bool().unwrap_or(true);
+            let t = main_tab()?;
+            if show && !browser_up().await { np::launch(&t, np::NOTION_URL)?; }
+            HIDE_MAIN.store(!show, Ordering::SeqCst);
+            np::windows::set_hidden(std::slice::from_ref(&t), !show);
+            if show { if let Ok(mut s) = Session::page().await { let _ = s.call("Page.bringToFront", json!({}), 5).await; } }
+            Ok(json!({"ok": true, "hidden": !show}))
+        }
+        "action" => {
+            let row = b["row"].as_str().unwrap_or("");
+            let label = b["label"].as_str().unwrap_or("");
+            let mut s = Session::page().await?;
+            let p = s.eval(&format!("const r=__rows().find((x,i)=>(x.getAttribute('data-agent-service-scroll-anchor')||('r'+i))==={});if(!r)return null;const b=[...r.querySelectorAll('button,[role=\"button\"]')].find(x=>(x.innerText||'').trim()==={});if(!b)return null;b.scrollIntoView({{block:'center'}});await __sleep(200);return __center(b);", js_str(row), js_str(label))).await?;
+            if p.is_null() { return Err("Knopf nicht mehr vorhanden.".into()); }
+            s.click(&p).await?;
+            Ok(json!({"ok": true}))
+        }
+        "dictate" => dictate(b["action"].as_str().unwrap_or("")).await,
+        "open_url" => { open_external(b["url"].as_str().unwrap_or(""))?; Ok(json!({"ok": true})) }
+        _ => Err(format!("Unbekannte Chat-Aktion: {op}")),
+    }
+}
+
+pub async fn control_handler(Json(b): Json<Value>) -> Response { reply(control(b).await) }
