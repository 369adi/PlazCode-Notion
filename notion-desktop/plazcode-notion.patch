+/// Nach einem manuellen Update: gestoppte Chats mit "weiter" fortsetzen, sobald AdiCode wieder verbunden und der Chat frei ist.
+pub(crate) fn resume_after_update(){
+    let f=update_resume_file();
+    let Ok(raw)=std::fs::read_to_string(&f) else {return};
+    let _=std::fs::remove_file(&f);
+    let ids:Vec<usize>=serde_json::from_str(&raw).unwrap_or_default();
+    if ids.is_empty(){return;}
+    tokio::spawn(async move{
+        tokio::time::sleep(Duration::from_secs(25)).await;
+        let main=main_index();
+        for i in ids{
+            let port=cdp_port(i);let mut sent=false;
+            for _ in 0..72{
+                if chat_idle(port).await{
+                    let r=if i==main{crate::notion_chat::send_text("weiter").await.map(|_|())}else{insert_prompt(port,"weiter".into()).await};
+                    tl(&format!("UPDATE-RESUME tab{i}: {:?}",r));sent=true;break;
+                }
+                tokio::time::sleep(Duration::from_secs(5)).await;
+            }
+            if !sent{tl(&format!("UPDATE-RESUME tab{i}: Chat 6 min nicht frei, kein weiter gesendet"));}
+        }
+    });
+}
+/// Nach einem AdiCode-Neustart (z. B. Update) laufen die Co-Work-Browser weiter, Keeper und Nudger aber nicht. Wieder anwerfen, wenn Co-Work-Fenster offen sind.
+pub(crate) fn resume_background(){
+    resume_after_update();
+    tokio::spawn(async{
+        ensure_monitors();
+        tokio::time::sleep(Duration::from_secs(20)).await;
+        let tabs=load();
+        let running=tokio::task::spawn_blocking({let t=tabs.clone();move||running_ids(&t)}).await.unwrap_or_default();
+        if tabs.is_empty()||running.is_empty(){return;}
+        if !KEEPER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(keep_alive(tabs.clone()));}
+        /* Co-Work-Fix: STAGE ist nach Neustart 0 - Nudger immer fortsetzen, wenn Co-Work-Fenster laufen */if !NUDGER_STARTED.swap(true,Ordering::SeqCst){tokio::spawn(nudger(tabs.clone()));}
+        tracing::info!("Co-Work: Keeper/Nudger nach Neustart fortgesetzt");
+    });
+}
