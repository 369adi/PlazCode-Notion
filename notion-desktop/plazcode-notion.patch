+fn remember(v: &Value) {
+    let url = clean_url(v["url"].as_str().unwrap_or(""));
+    if !(url.contains("/chat") && url.contains("t=")) { return; }
+    let first = v["messages"].as_array().and_then(|m| m.iter().find(|x| x["role"] == "user")).and_then(|m| m["text"].as_str()).unwrap_or("").trim().to_string();
+    let title: String = if first.is_empty() { "Chat mit Anhang".into() } else { first.chars().take(70).collect() };
+    let _g = HISTORY.lock().unwrap_or_else(|e| e.into_inner());
+    let mut list = read_history();
+    if let Some(pos) = list.iter().position(|x| x["url"] == json!(url)) {
+        if list[pos]["title"] == json!(title) && pos == 0 { return; }
+        list.remove(pos);
+    }
+    list.insert(0, json!({"url": url, "title": title, "updated": chrono::Local::now().format("%d.%m. %H:%M").to_string()}));
+    list.truncate(150);
+    let _ = std::fs::create_dir_all(data_dir());
+    let _ = std::fs::write(history_file(), serde_json::to_string_pretty(&list).unwrap_or_default());
+}
