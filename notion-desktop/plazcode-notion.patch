+async fn luau_schema(state: &crate::AppState) -> (String, bool) {
+    let tool = {
+        let mcp = state.roblox_mcp.lock().await;
+        mcp.tools.iter().find(|t| t["name"] == "execute_luau").cloned()
+    };
+    let Some(tool) = tool else { return ("code".into(), false); };
+    let props = tool["inputSchema"]["properties"].as_object().cloned().unwrap_or_default();
+    let key = ["code", "source", "luau", "script", "command"].iter().find(|k| props.contains_key(**k)).map(|k| k.to_string())
+        .or_else(|| props.iter().find(|(k, v)| v["type"] == "string" && !k.to_ascii_lowercase().contains("studio_id") && !k.to_ascii_lowercase().contains("datamodel")).map(|(k, _)| k.clone()))
+        .unwrap_or_else(|| "code".into());
+    (key, props.contains_key("datamodel_type"))
+}
+
+async fn exec_luau(state: &crate::AppState, code: String, timeout: u64, datamodel: &str) -> Result<String, String> {
+    if code.trim().is_empty() { return Err("Luau-Code darf nicht leer sein".into()); }
+    if code.len() > 1_500_000 { return Err("Luau-Code ueberschreitet 1,5 MB".into()); }
+    let (key, has_dm) = luau_schema(state).await;
+    let mut args = Map::new();
+    args.insert(key, Value::String(code));
+    if has_dm { args.insert("datamodel_type".into(), Value::String(datamodel.into())); }
+    native(state, "execute_luau", Value::Object(args), timeout).await
+}
+
+fn parse_payload(raw: &str) -> Option<Value> {
+    if let Ok(v) = serde_json::from_str::<Value>(raw) { return Some(v); }
+    // Manche Studio-Versionen liefern die Ausgabe als JSON-String mit Escapes.
+    let unescaped: String = serde_json::from_str::<String>(&format!("\"{raw}\"")).ok()?;
+    serde_json::from_str::<Value>(&unescaped).ok()
+}
+
+async fn composite(state: &crate::AppState, body: &str, args: Value, timeout: u64) -> Result<Value, String> {
+    let code = wrapped(&args, body)?;
+    let text = exec_luau(state, code, timeout, "Edit").await?;
+    let (Some(s), Some(e)) = (text.rfind(OPEN), text.rfind(CLOSE)) else {
+        return Err(format!("Studio hat kein Ergebnis geliefert (Ausgabe: {})", short(&text, 600)));
+    };
+    if e < s { return Err(format!("Studio hat kein Ergebnis geliefert (Ausgabe: {})", short(&text, 600))); }
+    let payload = parse_payload(&text[s + OPEN.len()..e]).ok_or_else(|| "Studio hat fehlerhaftes JSON geliefert".to_string())?;
+    if payload["ok"] != Value::Bool(true) {
+        return Err(payload["error"].as_str().unwrap_or("Roblox-Aktion fehlgeschlagen").to_string());
+    }
+    let result = payload.get("result").cloned().unwrap_or(Value::Null);
+    if result.get("placeName").is_some() { *lock(&PROJECT) = Some(result.clone()); }
+    Ok(result)
+}
