+// ---------------------------------------------------------------- Projekt-Gedaechtnis
+
+fn memory_file() -> PathBuf { data_dir().join("roblox-project-memory.json") }
+
+fn load_db() -> Map<String, Value> {
+    std::fs::read_to_string(memory_file()).ok()
+        .and_then(|raw| serde_json::from_str::<Value>(raw.trim_start_matches('\u{feff}')).ok())
+        .and_then(|v| v.as_object().cloned())
+        .unwrap_or_default()
+}
+
+fn save_db(db: &Map<String, Value>) {
+    let file = memory_file();
+    if let Some(p) = file.parent() { let _ = std::fs::create_dir_all(p); }
+    let tmp = file.with_extension("tmp");
+    if let Ok(data) = serde_json::to_vec_pretty(db) {
+        if std::fs::write(&tmp, data).is_ok() { let _ = std::fs::rename(&tmp, &file); }
+    }
+}
+
+async fn current_project(state: &crate::AppState) -> Result<Value, String> {
+    if let Some(p) = lock(&PROJECT).clone() { return Ok(p); }
+    composite(state, PROJECT_BODY, json!({"maxScripts": 300}), 30).await
+}
+
+fn project_key(project: &Value) -> (String, String, Value) {
+    let name = project["placeName"].as_str().unwrap_or("Untitled place").to_string();
+    let place_id = project.get("placeId").cloned().unwrap_or(Value::Null);
+    let id_text = match &place_id { Value::Number(n) => n.to_string(), Value::String(s) => s.clone(), _ => String::new() };
+    let key = if id_text.is_empty() || id_text == "0" {
+        name.chars().map(|c| if c.is_ascii_alphanumeric() || c == '_' || c == '-' { c } else { '_' }).take(60).collect()
+    } else { id_text };
+    (key, name, place_id)
+}
+
+fn with_memory<R>(project: &Value, f: impl FnOnce(&mut Map<String, Value>) -> R) -> R {
+    let _g = lock(&MEMORY_LOCK);
+    let (key, name, place_id) = project_key(project);
+    let mut db = load_db();
+    let entry = db.entry(key).or_insert_with(|| json!({}));
+    if !entry.is_object() { *entry = json!({}); }
+    let mem = entry.as_object_mut().expect("object");
+    for (field, def) in [
+        ("place", json!({})), ("scan", Value::Null), ("notes", json!([])), ("importantScripts", json!([])), ("importantGuis", json!([])),
+        ("systems", json!([])), ("dependencies", json!([])), ("preferences", json!([])), ("changes", json!([])), ("errors", json!([])), ("snapshots", json!([])),
+    ] {
+        mem.entry(field.to_string()).or_insert(def);
+    }
+    mem.insert("placeName".into(), Value::String(name));
+    mem.insert("placeId".into(), place_id);
+    let r = f(mem);
+    save_db(&db);
+    r
+}
+
+fn push_capped(mem: &mut Map<String, Value>, field: &str, item: Value, cap: usize) {
+    let list = mem.entry(field.to_string()).or_insert_with(|| json!([]));
+    if !list.is_array() { *list = json!([]); }
+    let arr = list.as_array_mut().expect("array");
+    arr.push(item);
+    if arr.len() > cap { let drop = arr.len() - cap; arr.drain(..drop); }
+}
+
+fn save_scan(project: &Value) {
+    with_memory(project, |mem| {
+        let mut place = Map::new();
+        for k in ["placeName", "placeId", "gameId", "creatorId", "services", "remotes"] { place.insert(k.into(), project.get(k).cloned().unwrap_or(Value::Null)); }
+        mem.insert("place".into(), Value::Object(place));
+        mem.insert("scan".into(), json!({"at": now_iso(), "scripts": project["scripts"].clone(), "scriptCount": project["scriptCount"].clone(), "guis": project["guis"].clone(), "remotes": project["remotes"].clone()}));
+    });
+}
+
+/// Aenderung oder Fehler im Projekt-Gedaechtnis vermerken (best effort).
+pub async fn record_event(state: &crate::AppState, kind: &str, tool: &str, args: &Value, message: &str, snapshot_id: Option<&str>) {
+    let Ok(project) = current_project(state).await else { return; };
+    let target = sval(args, "path").or_else(|| sval(args, "name")).or_else(|| sval(args, "snapshotId")).unwrap_or_default();
+    let summary: String = (if !message.is_empty() { message.to_string() } else if !target.is_empty() { target } else { tool.to_string() }).chars().take(300).collect();
+    let at = now_iso();
+    with_memory(&project, |mem| {
+        if kind == "change" {
+            push_capped(mem, "changes", json!({"at": at, "tool": tool, "summary": summary}), 300);
+            if let Some(id) = snapshot_id { push_capped(mem, "snapshots", json!({"id": id, "tool": tool, "at": at}), 60); }
+        } else {
+            let msg: String = message.chars().take(400).collect();
+            push_capped(mem, "errors", json!({"at": at, "tool": tool, "summary": summary, "message": msg}), 150);
+        }
+    });
+}
+
+async fn project_memory(state: &crate::AppState, args: &Value) -> Result<Value, String> {
+    let action = args["action"].as_str().unwrap_or("get");
+    let project = current_project(state).await?;
+    match action {
+        "get" => {}
+        "note" => {
+            let category = args["category"].as_str().unwrap_or("note");
+            let field = match category {
+                "note" => "notes", "important_script" => "importantScripts", "important_gui" => "importantGuis",
+                "system" => "systems", "dependency" => "dependencies", "preference" => "preferences",
+                _ => return Err("category muss note, important_script, important_gui, system, dependency oder preference sein".into()),
+            };
+            let text = args["text"].as_str().unwrap_or("").to_string();
+            if text.trim().is_empty() { return Err("text darf nicht leer sein".into()); }
+            let path: String = args["path"].as_str().unwrap_or("").chars().take(500).collect();
+            let entry = json!({"text": text.chars().take(2000).collect::<String>(), "path": path, "updatedAt": now_iso()});
+            with_memory(&project, |mem| {
+                let list = mem.entry(field.to_string()).or_insert_with(|| json!([]));
+                if !list.is_array() { *list = json!([]); }
+                let arr = list.as_array_mut().expect("array");
+                if let Some(existing) = arr.iter_mut().find(|i| !path.is_empty() && i["path"] == Value::String(path.clone())) { *existing = entry; } else { arr.push(entry); }
+                if arr.len() > 200 { let d = arr.len() - 200; arr.drain(..d); }
+            });
+        }
+        _ => return Err("action muss get oder note sein".into()),
+    }
+    let mem = with_memory(&project, |mem| Value::Object(mem.clone()));
+    Ok(json!({"project": project["placeName"].clone(), "memory": mem}))
+}
+
+// ---------------------------------------------------------------- roblox_studio
+
+pub async fn run_action(state: &crate::AppState, action: &str, a: &Value, timeout: u64) -> Result<Value, String> {
+    let empty = json!({});
+    let a = if a.is_object() { a } else { &empty };
+    let timeout = timeout.clamp(3, 180);
+    if action == "status" {
+        let studios = native(state, "list_roblox_studios", json!({}), 10).await;
+        let st = native(state, "get_studio_state", json!({}), 10).await;
+        return Ok(match (studios, st) {
+            (Ok(s), Ok(t)) => json!({"connected": true, "studios": s, "studio_state": t}),
+            (s, t) => json!({"connected": state.roblox_editor_connected.load(std::sync::atomic::Ordering::Relaxed), "studios": s.unwrap_or_else(|e| e), "studio_state": t.unwrap_or_else(|e| e),
+                "setup": "Place in Roblox Studio oeffnen und Studio mit AdiCode verbinden."}),
+        });
+    }
+    let _g = OP_LOCK.lock().await;
+    match action {
+        "get_errors" => {
+            let limit = num(a, "limit", 50).clamp(1, 200);
+            match native(state, "get_console_output", json!({}), timeout).await {
+                Ok(text) => {
+                    let re = Regex::new(r"(?i)error|exception|stack begin|traceback|attempt to|expected|failed|warn").unwrap();
+                    let lines: Vec<&str> = text.lines().filter(|l| re.is_match(l)).collect();
+                    let start = lines.len().saturating_sub(limit as usize);
+                    Ok(json!({"errorCount": lines.len(), "lines": lines[start..]}))
+                }
+                Err(_) => composite(state, LOGS_BODY, json!({"limit": limit}), timeout).await,
+            }
+        }
+        "list_snapshots" => composite(state, LIST_SNAP_BODY, json!({}), timeout).await,
+        "restore_snapshot" => {
+            required(a, &["snapshotId"])?;
+            composite(state, RESTORE_BODY, json!({"id": sval(a, "snapshotId").unwrap_or_default()}), timeout).await
+        }
+        "take_snapshot" => {
+            let paths: Vec<String> = a["paths"].as_array().map(|v| v.iter().filter_map(|p| p.as_str().map(String::from)).collect()).unwrap_or_default();
+            if paths.is_empty() { return Err("paths muss eine nicht-leere Liste sein".into()); }
+            if paths.len() > 50 { return Err("maximal 50 Instanzen pro Snapshot".into()); }
+            for p in &paths { if path_segments(p)?.len() < 3 { return Err("Snapshots muessen eine Instanz unterhalb eines Services treffen, nicht game oder einen Service".into()); } }
+            take_snapshot(state, &paths, &sval(a, "label").unwrap_or_else(|| "manual snapshot".into())).await
+        }
+        "project_info" => {
+            let r = composite(state, PROJECT_BODY, json!({"maxScripts": num(a, "maxScripts", 300).clamp(0, 2000)}), timeout).await?;
+            save_scan(&r);
+            Ok(r)
+        }
+        "get_game_tree" => {
+            let path = sval(a, "path").unwrap_or_else(|| "game.Workspace".into());
+            composite(state, TREE_BODY, json!({"segs": path_segments(&path)?, "depth": num(a, "depth", 2).clamp(0, 6), "maxNodes": num(a, "maxNodes", 300).clamp(1, 1500)}), timeout).await
+        }
+        "read_instance" => {
+            required(a, &["path"])?;
+            let props = match a.get("properties") {
+                None | Some(Value::Null) => Value::Null,
+                Some(Value::Array(p)) if p.len() <= 100 => Value::Array(p.clone()),
+                _ => return Err("properties muss eine Liste mit hoechstens 100 Namen sein".into()),
+            };
+            composite(state, READ_INSTANCE_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "properties": props}), timeout).await
+        }
+        "read_script" => {
+            required(a, &["path"])?;
+            composite(state, READ_SCRIPT_BODY, json!({
+                "segs": path_segments(&sval(a, "path").unwrap_or_default())?,
+                "fromLine": num(a, "fromLine", 1).max(1), "toLine": num(a, "toLine", 0).max(0),
+                "maxChars": num(a, "maxChars", MAX_RESULT as i64).clamp(1000, MAX_RESULT as i64)
+            }), timeout).await
+        }
+        "search_scripts" => {
+            let text = a["text"].as_str().unwrap_or("");
+            if text.is_empty() { return Err("text muss ein nicht-leerer String sein".into()); }
+            composite(state, SEARCH_BODY, json!({"text": text, "limit": num(a, "limit", 40).clamp(1, 200)}), timeout).await
+        }
+        "create_instance" | "create_part" | "create_instance_tree" | "create_model" | "create_ui" | "create_vfx" | "create_script" => {
+            match action {
+                "create_instance_tree" | "create_vfx" => required(a, &["parent", "tree"])?,
+                "create_model" | "create_ui" => required(a, &["tree"])?,
+                "create_script" => required(a, &["parent", "name", "source"])?,
+                "create_part" => required(a, &["name"])?,
+                _ => required(a, &["parent", "className"])?,
+            }
+            let (node, parent) = match action {
+                "create_part" => {
+                    let shape = sval(a, "shape").unwrap_or_else(|| "Block".into());
+                    if !["Block", "Ball", "Cylinder", "Wedge", "CornerWedge"].contains(&shape.as_str()) { return Err("shape muss Block, Ball, Cylinder, Wedge oder CornerWedge sein".into()); }
+                    let cls = match shape.as_str() { "Wedge" => "WedgePart", "CornerWedge" => "CornerWedgePart", _ => "Part" };
+                    let mut props = a["properties"].as_object().cloned().unwrap_or_default();
+                    props.insert("Anchored".into(), a.get("anchored").cloned().filter(|v| !v.is_null()).unwrap_or(Value::Bool(true)));
+                    if has(a, "size") { props.insert("Size".into(), json!({"$type": "Vector3", "value": a["size"]})); }
+                    if has(a, "position") { props.insert("Position".into(), json!({"$type": "Vector3", "value": a["position"]})); }
+                    if has(a, "color") { props.insert("Color".into(), json!({"$type": "Color3", "value": a["color"]})); }
+                    if has(a, "material") { props.insert("Material".into(), json!({"$type": "Enum", "enum": "Material", "value": a["material"]})); }
+                    if cls == "Part" && shape != "Block" { props.insert("Shape".into(), json!({"$type": "Enum", "enum": "PartType", "value": shape})); }
+                    (json!({"className": cls, "name": sval(a, "name"), "properties": Value::Object(props)}), sval(a, "parent").unwrap_or_else(|| "game.Workspace".into()))
+                }
+                "create_script" => {
+                    let cls = sval(a, "className").unwrap_or_else(|| "Script".into());
+                    if !["Script", "LocalScript", "ModuleScript"].contains(&cls.as_str()) { return Err("className muss Script, LocalScript oder ModuleScript sein".into()); }
+                    (json!({"className": cls, "name": sval(a, "name"), "source": sval(a, "source")}), sval(a, "parent").unwrap_or_default())
+                }
+                "create_instance" => {
+                    let mut n = Map::new();
+                    for k in ["className", "name", "properties", "attributes"] { if has(a, k) { n.insert(k.into(), a[k].clone()); } }
+                    (Value::Object(n), sval(a, "parent").unwrap_or_default())
+                }
+                _ => {
+                    let def = match action { "create_model" => "game.Workspace", "create_ui" => "game.StarterGui", _ => "" };
+                    (a["tree"].clone(), sval(a, "parent").unwrap_or_else(|| def.to_string()))
+                }
+            };
+            let mut count = 0usize;
+            let node = prep_node(&node, 0, &mut count)?;
+            let cls = node["className"].as_str().unwrap_or("");
+            const UI_ROOTS: &[&str] = &["ScreenGui", "SurfaceGui", "BillboardGui", "Frame", "ScrollingFrame", "TextLabel", "TextButton", "TextBox", "ImageLabel", "ImageButton", "CanvasGroup", "ViewportFrame", "VideoFrame"];
+            const VFX_ROOTS: &[&str] = &["ParticleEmitter", "Beam", "Trail", "Attachment", "PointLight", "SpotLight", "SurfaceLight", "Fire", "Smoke", "Sparkles", "Highlight", "Explosion", "Folder", "Part", "MeshPart"];
+            if action == "create_model" && cls != "Model" { return Err("create_model: Wurzel muss ein Model sein".into()); }
+            if action == "create_ui" && !UI_ROOTS.contains(&cls) { return Err("create_ui: Wurzel muss eine GUI-Klasse sein".into()); }
+            if action == "create_vfx" && !VFX_ROOTS.contains(&cls) { return Err("create_vfx: Wurzel-Klasse ist keine erlaubte VFX/Part-Klasse".into()); }
+            let snap_args = json!({"tree": node.clone(), "parent": parent.clone(), "name": node.get("name").cloned().unwrap_or(Value::Null)});
+            let snapshot = ensure_snapshot(state, action, &snap_args).await?;
+            let args = json!({"parentSegs": path_segments(&parent)?, "tree": node, "replace": a["replaceExisting"].as_bool().unwrap_or(false), "label": action});
+            let result = composite(state, CREATE_BODY, args, timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "modify_instance" => {
+            required(a, &["path"])?;
+            let props = a.get("properties").cloned().filter(|v| !v.is_null()).unwrap_or_else(|| json!({}));
+            let attrs = a.get("attributes").cloned().filter(|v| !v.is_null()).unwrap_or_else(|| json!({}));
+            if !props.is_object() || !attrs.is_object() { return Err("properties und attributes muessen Objekte sein".into()); }
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let result = composite(state, MODIFY_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "properties": prep_value(&props)?, "attributes": prep_value(&attrs)?, "name": a.get("name").cloned().unwrap_or(Value::Null)}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "delete_instance" | "delete_script" => {
+            required(a, &["path"])?;
+            let segs = path_segments(&sval(a, "path").unwrap_or_default())?;
+            if segs.len() < 3 { return Err("game oder ein Service wird nicht geloescht".into()); }
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let body = if action == "delete_script" { DELETE_SCRIPT_BODY } else { DELETE_BODY };
+            let result = composite(state, body, json!({"segs": segs}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "clone_instance" => {
+            required(a, &["path"])?;
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let parent_segs = match sval(a, "parent") { Some(p) if !p.is_empty() => json!(path_segments(&p)?), _ => Value::Null };
+            let result = composite(state, CLONE_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "parentSegs": parent_segs, "name": a.get("name").cloned().unwrap_or(Value::Null)}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "set_script_source" => {
+            required(a, &["path", "source"])?;
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let result = composite(state, SET_SOURCE_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "source": sval(a, "source").unwrap_or_default()}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "patch_script" => {
+            required(a, &["path", "find", "replace"])?;
+            let find = a["find"].as_str().unwrap_or("");
+            if find.is_empty() { return Err("find muss ein nicht-leerer String sein".into()); }
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let result = composite(state, PATCH_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "find": find, "replace": sval(a, "replace").unwrap_or_default(), "maxCount": num(a, "maxCount", 0).max(0)}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        other => Err(format!("Unbekannte roblox_studio-Aktion '{other}'. Erlaubt: {}", STUDIO_ACTIONS.join(", "))),
+    }
+}
+
+/// `roblox_execute_luau` mit BW-Helfern und optionalen Snapshots.
+pub async fn execute_luau(state: &crate::AppState, args: &Value) -> Result<Value, String> {
+    let code = args["code"].as_str().or_else(|| args["source"].as_str()).unwrap_or("").to_string();
+    let use_helpers = args["use_helpers"].as_bool().unwrap_or(true);
+    let datamodel = args["datamodel_type"].as_str().unwrap_or("Edit").to_string();
+    let timeout = num(args, "timeout_seconds", 20).clamp(3, 180) as u64;
+    let mut snapshot = None;
+    if let Some(list) = args.get("snapshot_paths").and_then(|v| v.as_array()) {
+        if list.len() > 50 { return Err("snapshot_paths: hoechstens 50 Pfade".into()); }
+        let paths: Vec<String> = list.iter().filter_map(|p| p.as_str().map(String::from)).collect();
+        if !paths.is_empty() { snapshot = take_snapshot(state, &paths, "before raw Luau").await?["snapshotId"].as_str().map(String::from); }
+    }
+    let uses_bw = use_helpers && BW_RE.is_match(&code);
+    let full = if uses_bw { format!("{HELPERS}\n{code}") } else { code };
+    match exec_luau(state, full, timeout, &datamodel).await {
+        Ok(text) => Ok(json!({"text": short(&text, MAX_RESULT), "helpers_loaded": uses_bw, "snapshotId": snapshot})),
+        Err(e) if uses_bw => {
+            let offset = HELPERS.matches('\n').count() + 1;
+            let re = Regex::new(r#"(\]|\.luau|"|'|\w):(\d+):"#).unwrap();
+            Err(re.replace_all(&e, |c: &regex::Captures| {
+                let line: usize = c[2].parse().unwrap_or(0);
+                if line > offset { format!("{}{}:", &c[1], line - offset) } else { format!("{}BW-helper:", &c[1]) }
+            }).to_string())
+        }
+        Err(e) => Err(e),
+    }
+}
+
+// ---------------------------------------------------------------- MCP-Tools
+
+pub fn tools() -> Vec<Value> {
+    vec![
+        json!({"name": "roblox_studio", "description": "[Roblox Studio+] Sichere High-Level-Aktionen: Projektueberblick, Baum, Eigenschaften, Scripts lesen/suchen; Parts/Models/UI/VFX/Scripts bauen; aendern, klonen, loeschen, patchen; Output-Fehler. Jede Aenderung legt vorher automatisch einen Snapshot an (restore_snapshot macht sie rueckgaengig). Beispiel: {\"action\":\"get_game_tree\",\"arguments\":{\"path\":\"game.Workspace\",\"depth\":2}}",
+            "inputSchema": {"type": "object", "required": ["action"], "properties": {
+                "action": {"type": "string", "enum": STUDIO_ACTIONS},
+                "arguments": {"type": "object", "description": "Aktionsspezifisch, z. B. path, parent, name, tree{className,name,properties,children}, properties, source, find/replace, paths, snapshotId. Typisierte Werte: {\"$type\":\"Vector3\",\"value\":[x,y,z]}, Color3 [r,g,b] oder \"#hex\", UDim2, Enum{enum,value}, Ref{path}."},
+                "timeout_seconds": {"type": "integer", "minimum": 3, "maximum": 180}
+            }},
+            "annotations": {"destructiveHint": true}}),
+        json!({"name": "roblox_workflow", "description": "[Roblox Studio+] Playbook fuer eine Aufgabenart (general, build, scripting, ui, vfx, gameplay, debug oder all) inkl. BW-Helfer-Uebersicht.",
+            "inputSchema": {"type": "object", "properties": {"category": {"type": "string", "enum": ["general", "build", "scripting", "ui", "vfx", "gameplay", "debug", "all"]}}},
+            "annotations": {"readOnlyHint": true}}),
+        json!({"name": "roblox_project_memory", "description": "[Roblox Studio+] Dauerhaftes Gedaechtnis pro Place: get (Inventar, Notizen, letzte Aenderungen, Fehler, Snapshots) oder note (category: note, important_script, important_gui, system, dependency, preference; text; optional path).",
+            "inputSchema": {"type": "object", "required": ["action"], "properties": {
+                "action": {"type": "string", "enum": ["get", "note"]},
+                "category": {"type": "string", "enum": ["note", "important_script", "important_gui", "system", "dependency", "preference"]},
+                "text": {"type": "string"}, "path": {"type": "string"}
+            }}}),
+    ]
+}
+
+fn workflow_text(category: &str) -> String {
+    let helpers = "BW-Helfer (in roblox_execute_luau automatisch geladen): BW.find/get/exists, BW.new/part/folder/model, BW.set, BW.weldAll, BW.tree/report/check, BW.script/source/patch/scan, BW.remote, BW.screen/ui, BW.particles/light, BW.leaderstats, BW.killPart, BW.logs.";
+    if category == "all" {
+        let mut s: Vec<String> = WORKFLOWS.iter().map(|(k, v)| format!("## {k}\n{v}")).collect();
+        s.push(helpers.into());
+        return s.join("\n\n");
+    }
+    let text = WORKFLOWS.iter().find(|(k, _)| *k == category).map(|(_, v)| *v).unwrap_or(WORKFLOWS[0].1);
+    format!("{}\n\n{text}\n\n{helpers}", WORKFLOWS[0].1)
+}
+
+fn ok_text(v: Value) -> Value {
+    let text = match v { Value::String(s) => s, other => serde_json::to_string_pretty(&other).unwrap_or_default() };
+    json!({"content": [{"type": "text", "text": short(&text, 60_000)}]})
+}
+fn err_text(e: String) -> Value { json!({"isError": true, "content": [{"type": "text", "text": e}]}) }
+
+/// Behandelt die neuen Roblox-Tools; `None` = nicht zustaendig.
+pub async fn call(state: &crate::AppState, name: &str, args: &Value) -> Option<Value> {
+    match name {
+        "roblox_workflow" => Some(ok_text(Value::String(workflow_text(args["category"].as_str().unwrap_or("general"))))),
+        "roblox_project_memory" => Some(match project_memory(state, args).await { Ok(v) => ok_text(v), Err(e) => err_text(e) }),
+        "roblox_studio" => {
+            let action = args["action"].as_str().unwrap_or("").to_string();
+            let nested = args.get("arguments").cloned().filter(|v| v.is_object()).unwrap_or_else(|| json!({}));
+            let write = !STUDIO_READS.contains(&action.as_str());
+            let timeout = num(args, "timeout_seconds", 30) as u64;
+            Some(match run_action(state, &action, &nested, timeout).await {
+                Ok(v) => {
+                    if write && STUDIO_ACTIONS.contains(&action.as_str()) {
+                        let snap = v["snapshotId"].as_str().map(String::from);
+                        record_event(state, "change", &action, &nested, "", snap.as_deref()).await;
+                    }
+                    ok_text(v)
+                }
+                Err(e) => {
+                    record_event(state, "error", &action, &nested, &e, None).await;
+                    err_text(e)
+                }
+            })
+        }
+        "roblox_execute_luau" => {
+            Some(match execute_luau(state, args).await {
+                Ok(v) => {
+                    let paths = args["snapshot_paths"].as_array().map(|l| l.iter().filter_map(|p| p.as_str()).collect::<Vec<_>>().join(",")).unwrap_or_default();
+                    record_event(state, "change", "execute_luau", &json!({"path": paths}), "Luau ausgefuehrt (Quelltext nicht gespeichert)", v["snapshotId"].as_str()).await;
+                    ok_text(v)
+                }
+                Err(e) => err_text(e),
+            })
+        }
+        _ => None,
+    }
+}
+
+/// Ergaenzt das Schema des nativen execute_luau um die neuen Optionen.
+pub fn extend_execute_luau_schema(schema: &mut Value) {
+    if let Some(props) = schema.pointer_mut("/inputSchema/properties").and_then(|p| p.as_object_mut()) {
+        props.insert("use_helpers".into(), json!({"type": "boolean", "description": "BW-Helferbibliothek automatisch laden, wenn der Code BW.* nutzt (Standard true)."}));
+        props.insert("snapshot_paths".into(), json!({"type": "array", "items": {"type": "string"}, "description": "Optionale Instanzpfade (max. 50), die vorher als Snapshot gesichert werden."}));
+        props.insert("timeout_seconds".into(), json!({"type": "integer", "minimum": 3, "maximum": 180}));
+    }
+    if let Some(d) = schema["description"].as_str() {
+        schema["description"] = Value::String(format!("{d} | AdiCode: BW-Helfer werden automatisch geladen; snapshot_paths sichert Instanzen vorher."));
+    }
+}
