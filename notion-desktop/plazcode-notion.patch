+fn project_key(project: &Value) -> (String, String, Value) {
+    let name = project["placeName"].as_str().unwrap_or("Untitled place").to_string();
+    let place_id = project.get("placeId").cloned().unwrap_or(Value::Null);
+    let id_text = match &place_id { Value::Number(n) => n.to_string(), Value::String(s) => s.clone(), _ => String::new() };
+    let key = if id_text.is_empty() || id_text == "0" {
+        name.chars().map(|c| if c.is_ascii_alphanumeric() || c == '_' || c == '-' { c } else { '_' }).take(60).collect()
+    } else { id_text };
+    (key, name, place_id)
+}
+
+fn with_memory<R>(project: &Value, f: impl FnOnce(&mut Map<String, Value>) -> R) -> R {
+    let _g = lock(&MEMORY_LOCK);
+    let (key, name, place_id) = project_key(project);
+    let mut db = load_db();
+    let entry = db.entry(key).or_insert_with(|| json!({}));
+    if !entry.is_object() { *entry = json!({}); }
+    let mem = entry.as_object_mut().expect("object");
+    for (field, def) in [
+        ("place", json!({})), ("scan", Value::Null), ("notes", json!([])), ("importantScripts", json!([])), ("importantGuis", json!([])),
+        ("systems", json!([])), ("dependencies", json!([])), ("preferences", json!([])), ("changes", json!([])), ("errors", json!([])), ("snapshots", json!([])),
+    ] {
+        mem.entry(field.to_string()).or_insert(def);
+    }
+    mem.insert("placeName".into(), Value::String(name));
+    mem.insert("placeId".into(), place_id);
+    let r = f(mem);
+    save_db(&db);
+    r
+}
+
+fn push_capped(mem: &mut Map<String, Value>, field: &str, item: Value, cap: usize) {
+    let list = mem.entry(field.to_string()).or_insert_with(|| json!([]));
+    if !list.is_array() { *list = json!([]); }
+    let arr = list.as_array_mut().expect("array");
+    arr.push(item);
+    if arr.len() > cap { let drop = arr.len() - cap; arr.drain(..drop); }
+}
+
+fn save_scan(project: &Value) {
+    with_memory(project, |mem| {
+        let mut place = Map::new();
+        for k in ["placeName", "placeId", "gameId", "creatorId", "services", "remotes"] { place.insert(k.into(), project.get(k).cloned().unwrap_or(Value::Null)); }
+        mem.insert("place".into(), Value::Object(place));
+        mem.insert("scan".into(), json!({"at": now_iso(), "scripts": project["scripts"].clone(), "scriptCount": project["scriptCount"].clone(), "guis": project["guis"].clone(), "remotes": project["remotes"].clone()}));
+    });
+}
+
+/// Aenderung oder Fehler im Projekt-Gedaechtnis vermerken (best effort).
+pub async fn record_event(state: &crate::AppState, kind: &str, tool: &str, args: &Value, message: &str, snapshot_id: Option<&str>) {
+    let Ok(project) = current_project(state).await else { return; };
+    let target = sval(args, "path").or_else(|| sval(args, "name")).or_else(|| sval(args, "snapshotId")).unwrap_or_default();
+    let summary: String = (if !message.is_empty() { message.to_string() } else if !target.is_empty() { target } else { tool.to_string() }).chars().take(300).collect();
+    let at = now_iso();
+    with_memory(&project, |mem| {
+        if kind == "change" {
+            push_capped(mem, "changes", json!({"at": at, "tool": tool, "summary": summary}), 300);
+            if let Some(id) = snapshot_id { push_capped(mem, "snapshots", json!({"id": id, "tool": tool, "at": at}), 60); }
+        } else {
+            let msg: String = message.chars().take(400).collect();
+            push_capped(mem, "errors", json!({"at": at, "tool": tool, "summary": summary, "message": msg}), 150);
+        }
+    });
+}
+
+async fn project_memory(state: &crate::AppState, args: &Value) -> Result<Value, String> {
+    let action = args["action"].as_str().unwrap_or("get");
+    let project = current_project(state).await?;
+    match action {
+        "get" => {}
+        "note" => {
+            let category = args["category"].as_str().unwrap_or("note");
+            let field = match category {
+                "note" => "notes", "important_script" => "importantScripts", "important_gui" => "importantGuis",
+                "system" => "systems", "dependency" => "dependencies", "preference" => "preferences",
+                _ => return Err("category muss note, important_script, important_gui, system, dependency oder preference sein".into()),
+            };
+            let text = args["text"].as_str().unwrap_or("").to_string();
+            if text.trim().is_empty() { return Err("text darf nicht leer sein".into()); }
+            let path: String = args["path"].as_str().unwrap_or("").chars().take(500).collect();
+            let entry = json!({"text": text.chars().take(2000).collect::<String>(), "path": path, "updatedAt": now_iso()});
+            with_memory(&project, |mem| {
+                let list = mem.entry(field.to_string()).or_insert_with(|| json!([]));
+                if !list.is_array() { *list = json!([]); }
+                let arr = list.as_array_mut().expect("array");
+                if let Some(existing) = arr.iter_mut().find(|i| !path.is_empty() && i["path"] == Value::String(path.clone())) { *existing = entry; } else { arr.push(entry); }
+                if arr.len() > 200 { let d = arr.len() - 200; arr.drain(..d); }
+            });
+        }
+        _ => return Err("action muss get oder note sein".into()),
+    }
+    let mem = with_memory(&project, |mem| Value::Object(mem.clone()));
+    Ok(json!({"project": project["placeName"].clone(), "memory": mem}))
+}
