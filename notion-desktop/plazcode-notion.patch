+pub async fn run_action(state: &crate::AppState, action: &str, a: &Value, timeout: u64) -> Result<Value, String> {
+    let empty = json!({});
+    let a = if a.is_object() { a } else { &empty };
+    let timeout = timeout.clamp(3, 180);
+    if action == "status" {
+        let studios = native(state, "list_roblox_studios", json!({}), 10).await;
+        let st = native(state, "get_studio_state", json!({}), 10).await;
+        return Ok(match (studios, st) {
+            (Ok(s), Ok(t)) => json!({"connected": true, "studios": s, "studio_state": t}),
+            (s, t) => json!({"connected": state.roblox_editor_connected.load(std::sync::atomic::Ordering::Relaxed), "studios": s.unwrap_or_else(|e| e), "studio_state": t.unwrap_or_else(|e| e),
+                "setup": "Place in Roblox Studio oeffnen und Studio mit AdiCode verbinden."}),
+        });
+    }
+    let _g = OP_LOCK.lock().await;
+    match action {
+        "get_errors" => {
+            let limit = num(a, "limit", 50).clamp(1, 200);
+            match native(state, "get_console_output", json!({}), timeout).await {
+                Ok(text) => {
+                    let re = Regex::new(r"(?i)error|exception|stack begin|traceback|attempt to|expected|failed|warn").unwrap();
+                    let lines: Vec<&str> = text.lines().filter(|l| re.is_match(l)).collect();
+                    let start = lines.len().saturating_sub(limit as usize);
+                    Ok(json!({"errorCount": lines.len(), "lines": lines[start..]}))
+                }
+                Err(_) => composite(state, LOGS_BODY, json!({"limit": limit}), timeout).await,
+            }
+        }
+        "list_snapshots" => composite(state, LIST_SNAP_BODY, json!({}), timeout).await,
+        "restore_snapshot" => {
+            required(a, &["snapshotId"])?;
+            composite(state, RESTORE_BODY, json!({"id": sval(a, "snapshotId").unwrap_or_default()}), timeout).await
+        }
+        "take_snapshot" => {
+            let paths: Vec<String> = a["paths"].as_array().map(|v| v.iter().filter_map(|p| p.as_str().map(String::from)).collect()).unwrap_or_default();
+            if paths.is_empty() { return Err("paths muss eine nicht-leere Liste sein".into()); }
+            if paths.len() > 50 { return Err("maximal 50 Instanzen pro Snapshot".into()); }
+            for p in &paths { if path_segments(p)?.len() < 3 { return Err("Snapshots muessen eine Instanz unterhalb eines Services treffen, nicht game oder einen Service".into()); } }
+            take_snapshot(state, &paths, &sval(a, "label").unwrap_or_else(|| "manual snapshot".into())).await
+        }
+        "project_info" => {
+            let r = composite(state, PROJECT_BODY, json!({"maxScripts": num(a, "maxScripts", 300).clamp(0, 2000)}), timeout).await?;
+            save_scan(&r);
+            Ok(r)
+        }
+        "get_game_tree" => {
+            let path = sval(a, "path").unwrap_or_else(|| "game.Workspace".into());
+            composite(state, TREE_BODY, json!({"segs": path_segments(&path)?, "depth": num(a, "depth", 2).clamp(0, 6), "maxNodes": num(a, "maxNodes", 300).clamp(1, 1500)}), timeout).await
+        }
+        "read_instance" => {
+            required(a, &["path"])?;
+            let props = match a.get("properties") {
+                None | Some(Value::Null) => Value::Null,
+                Some(Value::Array(p)) if p.len() <= 100 => Value::Array(p.clone()),
+                _ => return Err("properties muss eine Liste mit hoechstens 100 Namen sein".into()),
+            };
+            composite(state, READ_INSTANCE_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "properties": props}), timeout).await
+        }
+        "read_script" => {
+            required(a, &["path"])?;
+            composite(state, READ_SCRIPT_BODY, json!({
+                "segs": path_segments(&sval(a, "path").unwrap_or_default())?,
+                "fromLine": num(a, "fromLine", 1).max(1), "toLine": num(a, "toLine", 0).max(0),
+                "maxChars": num(a, "maxChars", MAX_RESULT as i64).clamp(1000, MAX_RESULT as i64)
+            }), timeout).await
+        }
+        "search_scripts" => {
+            let text = a["text"].as_str().unwrap_or("");
+            if text.is_empty() { return Err("text muss ein nicht-leerer String sein".into()); }
+            composite(state, SEARCH_BODY, json!({"text": text, "limit": num(a, "limit", 40).clamp(1, 200)}), timeout).await
+        }
+        "create_instance" | "create_part" | "create_instance_tree" | "create_model" | "create_ui" | "create_vfx" | "create_script" => {
+            match action {
+                "create_instance_tree" | "create_vfx" => required(a, &["parent", "tree"])?,
+                "create_model" | "create_ui" => required(a, &["tree"])?,
+                "create_script" => required(a, &["parent", "name", "source"])?,
+                "create_part" => required(a, &["name"])?,
+                _ => required(a, &["parent", "className"])?,
+            }
+            let (node, parent) = match action {
+                "create_part" => {
+                    let shape = sval(a, "shape").unwrap_or_else(|| "Block".into());
+                    if !["Block", "Ball", "Cylinder", "Wedge", "CornerWedge"].contains(&shape.as_str()) { return Err("shape muss Block, Ball, Cylinder, Wedge oder CornerWedge sein".into()); }
+                    let cls = match shape.as_str() { "Wedge" => "WedgePart", "CornerWedge" => "CornerWedgePart", _ => "Part" };
+                    let mut props = a["properties"].as_object().cloned().unwrap_or_default();
+                    props.insert("Anchored".into(), a.get("anchored").cloned().filter(|v| !v.is_null()).unwrap_or(Value::Bool(true)));
+                    if has(a, "size") { props.insert("Size".into(), json!({"$type": "Vector3", "value": a["size"]})); }
+                    if has(a, "position") { props.insert("Position".into(), json!({"$type": "Vector3", "value": a["position"]})); }
+                    if has(a, "color") { props.insert("Color".into(), json!({"$type": "Color3", "value": a["color"]})); }
+                    if has(a, "material") { props.insert("Material".into(), json!({"$type": "Enum", "enum": "Material", "value": a["material"]})); }
+                    if cls == "Part" && shape != "Block" { props.insert("Shape".into(), json!({"$type": "Enum", "enum": "PartType", "value": shape})); }
+                    (json!({"className": cls, "name": sval(a, "name"), "properties": Value::Object(props)}), sval(a, "parent").unwrap_or_else(|| "game.Workspace".into()))
+                }
+                "create_script" => {
+                    let cls = sval(a, "className").unwrap_or_else(|| "Script".into());
+                    if !["Script", "LocalScript", "ModuleScript"].contains(&cls.as_str()) { return Err("className muss Script, LocalScript oder ModuleScript sein".into()); }
+                    (json!({"className": cls, "name": sval(a, "name"), "source": sval(a, "source")}), sval(a, "parent").unwrap_or_default())
+                }
+                "create_instance" => {
+                    let mut n = Map::new();
+                    for k in ["className", "name", "properties", "attributes"] { if has(a, k) { n.insert(k.into(), a[k].clone()); } }
+                    (Value::Object(n), sval(a, "parent").unwrap_or_default())
+                }
+                _ => {
+                    let def = match action { "create_model" => "game.Workspace", "create_ui" => "game.StarterGui", _ => "" };
+                    (a["tree"].clone(), sval(a, "parent").unwrap_or_else(|| def.to_string()))
+                }
+            };
+            let mut count = 0usize;
+            let node = prep_node(&node, 0, &mut count)?;
+            let cls = node["className"].as_str().unwrap_or("");
+            const UI_ROOTS: &[&str] = &["ScreenGui", "SurfaceGui", "BillboardGui", "Frame", "ScrollingFrame", "TextLabel", "TextButton", "TextBox", "ImageLabel", "ImageButton", "CanvasGroup", "ViewportFrame", "VideoFrame"];
+            const VFX_ROOTS: &[&str] = &["ParticleEmitter", "Beam", "Trail", "Attachment", "PointLight", "SpotLight", "SurfaceLight", "Fire", "Smoke", "Sparkles", "Highlight", "Explosion", "Folder", "Part", "MeshPart"];
+            if action == "create_model" && cls != "Model" { return Err("create_model: Wurzel muss ein Model sein".into()); }
+            if action == "create_ui" && !UI_ROOTS.contains(&cls) { return Err("create_ui: Wurzel muss eine GUI-Klasse sein".into()); }
+            if action == "create_vfx" && !VFX_ROOTS.contains(&cls) { return Err("create_vfx: Wurzel-Klasse ist keine erlaubte VFX/Part-Klasse".into()); }
+            let snap_args = json!({"tree": node.clone(), "parent": parent.clone(), "name": node.get("name").cloned().unwrap_or(Value::Null)});
+            let snapshot = ensure_snapshot(state, action, &snap_args).await?;
+            let args = json!({"parentSegs": path_segments(&parent)?, "tree": node, "replace": a["replaceExisting"].as_bool().unwrap_or(false), "label": action});
+            let result = composite(state, CREATE_BODY, args, timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "modify_instance" => {
+            required(a, &["path"])?;
+            let props = a.get("properties").cloned().filter(|v| !v.is_null()).unwrap_or_else(|| json!({}));
+            let attrs = a.get("attributes").cloned().filter(|v| !v.is_null()).unwrap_or_else(|| json!({}));
+            if !props.is_object() || !attrs.is_object() { return Err("properties und attributes muessen Objekte sein".into()); }
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let result = composite(state, MODIFY_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "properties": prep_value(&props)?, "attributes": prep_value(&attrs)?, "name": a.get("name").cloned().unwrap_or(Value::Null)}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "delete_instance" | "delete_script" => {
+            required(a, &["path"])?;
+            let segs = path_segments(&sval(a, "path").unwrap_or_default())?;
+            if segs.len() < 3 { return Err("game oder ein Service wird nicht geloescht".into()); }
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let body = if action == "delete_script" { DELETE_SCRIPT_BODY } else { DELETE_BODY };
+            let result = composite(state, body, json!({"segs": segs}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "clone_instance" => {
+            required(a, &["path"])?;
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let parent_segs = match sval(a, "parent") { Some(p) if !p.is_empty() => json!(path_segments(&p)?), _ => Value::Null };
+            let result = composite(state, CLONE_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "parentSegs": parent_segs, "name": a.get("name").cloned().unwrap_or(Value::Null)}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "set_script_source" => {
+            required(a, &["path", "source"])?;
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let result = composite(state, SET_SOURCE_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "source": sval(a, "source").unwrap_or_default()}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        "patch_script" => {
+            required(a, &["path", "find", "replace"])?;
+            let find = a["find"].as_str().unwrap_or("");
+            if find.is_empty() { return Err("find muss ein nicht-leerer String sein".into()); }
+            let snapshot = ensure_snapshot(state, action, a).await?;
+            let result = composite(state, PATCH_BODY, json!({"segs": path_segments(&sval(a, "path").unwrap_or_default())?, "find": find, "replace": sval(a, "replace").unwrap_or_default(), "maxCount": num(a, "maxCount", 0).max(0)}), timeout).await?;
+            Ok(json!({"snapshotId": snapshot, "result": result}))
+        }
+        other => Err(format!("Unbekannte roblox_studio-Aktion '{other}'. Erlaubt: {}", STUDIO_ACTIONS.join(", "))),
+    }
+}
