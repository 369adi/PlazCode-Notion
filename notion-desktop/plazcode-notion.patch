+pub async fn take_snapshot(state: &crate::AppState, paths: &[String], label: &str) -> Result<Value, String> {
+    let id = format!("snap_{}_{}", chrono::Local::now().format("%Y%m%d_%H%M%S"), hex(3));
+    let paths: Vec<String> = paths.iter().take(50).cloned().collect();
+    let segs = paths.iter().map(|p| path_segments(p).map(|s| json!(s))).collect::<Result<Vec<_>, _>>()?;
+    let label: String = label.chars().take(120).collect();
+    composite(state, SNAP_BODY, json!({"id": id, "label": label, "paths": paths, "segsList": segs}), 30).await
+}
+
+fn snapshot_targets(action: &str, a: &Value) -> Vec<String> {
+    let path = sval(a, "path");
+    match action {
+        "modify_instance" | "delete_instance" | "delete_script" | "set_script_source" | "patch_script" => path.into_iter().collect(),
+        "create_script" | "create_part" | "create_instance" | "create_instance_tree" | "create_model" | "create_ui" | "create_vfx" => {
+            let default_parent = match action { "create_part" | "create_model" => "game.Workspace", "create_ui" => "game.StarterGui", _ => "" };
+            let parent = sval(a, "parent").unwrap_or_else(|| default_parent.to_string());
+            let node = if has(a, "tree") { &a["tree"] } else { a };
+            match (node.get("name").and_then(|n| n.as_str()), parent.is_empty()) {
+                (Some(name), false) => vec![format!("{}.{}", parent.trim_end_matches('.'), name)],
+                _ => Vec::new(),
+            }
+        }
+        "clone_instance" => match (sval(a, "name"), sval(a, "parent")) {
+            (Some(n), Some(p)) => vec![format!("{}.{}", p.trim_end_matches('.'), n)],
+            _ => Vec::new(),
+        },
+        _ => Vec::new(),
+    }
+}
+
+async fn ensure_snapshot(state: &crate::AppState, action: &str, a: &Value) -> Result<Option<String>, String> {
+    let targets = snapshot_targets(action, a);
+    if targets.is_empty() { return Ok(None); }
+    let snap = take_snapshot(state, &targets, &format!("auto before {action}")).await?;
+    Ok(snap["snapshotId"].as_str().map(String::from))
+}
+
+/// Zielpfade in Argumenten nativer Studio-Tools (fuer automatische Snapshots).
+pub fn native_snapshot_targets(args: &Value) -> Vec<String> {
+    fn visit(v: &Value, key: &str, out: &mut Vec<String>) {
+        match v {
+            Value::Object(m) => for (k, x) in m { visit(x, k, out); },
+            Value::Array(a) => for x in a { visit(x, key, out); },
+            Value::String(s) => if TARGET_KEY.is_match(key) && TARGET_VALUE.is_match(s) { out.push(s.clone()); },
+            _ => {}
+        }
+    }
+    let mut out = Vec::new();
+    visit(args, "", &mut out);
+    if out.is_empty() {
+        if let (Some(p), Some(n)) = (sval(args, "parent"), sval(args, "name")) {
+            if TARGET_VALUE.is_match(&p) { out.push(format!("{}.{}", p.trim_end_matches('.'), n)); }
+        }
+    }
+    let mut seen = std::collections::HashSet::new();
+    out.retain(|x| seen.insert(x.clone()));
+    out.truncate(50);
+    out
+}
+
+/// Vor einem schreibenden nativen Studio-Tool automatisch einen Snapshot anlegen.
+pub async fn before_native_write(state: &crate::AppState, internal: &str, args: &Value) -> Option<String> {
+    if internal == "execute_luau" || !is_guarded(internal) { return None; }
+    let targets = native_snapshot_targets(args);
+    if targets.is_empty() { return None; }
+    match take_snapshot(state, &targets, &format!("auto before {internal}")).await {
+        Ok(v) => v["snapshotId"].as_str().map(String::from),
+        Err(e) => { tracing::warn!("[notion] Snapshot vor {internal} fehlgeschlagen: {e}"); None }
+    }
+}
