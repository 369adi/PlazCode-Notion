+//! AdiCode Chat: ChatGPT-aehnliche Chatbox direkt in AdiCode.
+//! Sie steuert den Co-Work-Main-Tab (Notion AI, CDP-Port 9301): Text, Fotos, Videos und
+//! Dateien, Notion-Diktat (Sprechbox), Stopp, neuer Chat, Verlauf und Freigabe-Knoepfe.
+//! Weil der Main-Tab mit dem AdiCode-MCP verbunden ist, laeuft Co-Work direkt aus dem Chat.
+use crate::notion_profiles as np;
+use axum::{body::Bytes, extract::Query, http::StatusCode, response::{IntoResponse, Response}, Json};
+use futures::{SinkExt, StreamExt};
+use once_cell::sync::Lazy;
+use serde_json::{json, Value};
+use std::{path::PathBuf, sync::{atomic::{AtomicBool, Ordering}, Mutex}, time::Duration};
+use tokio_tungstenite::tungstenite::Message;
+
+/// Wird gesetzt, sobald die Chat-Seite benutzt wurde; Co-Work versteckt dann auch Main.
+pub static CHAT_USED: AtomicBool = AtomicBool::new(false);
+static HIDE_MAIN: AtomicBool = AtomicBool::new(true);
+static MCP_CHECKED: AtomicBool = AtomicBool::new(false);
+static ENSURE: Lazy<tokio::sync::Mutex<()>> = Lazy::new(|| tokio::sync::Mutex::new(()));
+static HISTORY: Lazy<Mutex<()>> = Lazy::new(|| Mutex::new(()));
+pub const MAX_UPLOAD: usize = 512 * 1024 * 1024;
+
+fn port() -> u16 { np::cdp_port(0) }
+fn data_dir() -> PathBuf { std::env::var_os("LOCALAPPDATA").map(PathBuf::from).unwrap_or_else(std::env::temp_dir).join("PlazCodeNotion") }
+fn uploads() -> PathBuf { let _ = &data_dir(); PathBuf::from(std::env::var("USERPROFILE").unwrap_or_else(|_| "C:\\Users\\liket".into())).join("Pictures").join("Screenshots") }
+fn history_file() -> PathBuf { data_dir().join("chat-history.json") }
+fn ok(v: Value) -> Response { Json(v).into_response() }
+fn fail(msg: impl Into<String>) -> Response { (StatusCode::BAD_REQUEST, Json(json!({"ok": false, "error": msg.into()}))).into_response() }
+fn reply(r: Result<Value, String>) -> Response { match r { Ok(v) => ok(v), Err(e) => fail(e) } }
+async fn sleep(ms: u64) { tokio::time::sleep(Duration::from_millis(ms)).await }
+
+type Ws = tokio_tungstenite::WebSocketStream<tokio_tungstenite::MaybeTlsStream<tokio::net::TcpStream>>;
+struct Session { ws: Ws, id: u64 }
+impl Session {
+    async fn connect(url: &str) -> Result<Self, String> {
+        let (ws, _) = tokio::time::timeout(Duration::from_secs(5), tokio_tungstenite::connect_async(url)).await
+            .map_err(|_| "CDP-Verbindung: Zeitueberschreitung".to_string())?.map_err(|e| e.to_string())?;
+        Ok(Self { ws, id: 0 })
+    }
+    async fn page() -> Result<Self, String> { let url = np::target(port()).await?; Self::connect(&url).await }
+    async fn browser() -> Result<Self, String> {
