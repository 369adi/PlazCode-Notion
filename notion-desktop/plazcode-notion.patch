+pub async fn send_handler(Json(b): Json<Value>) -> Response {
+    let text = b["text"].as_str().unwrap_or("").trim_end().to_string();
+    let files = match checked_files(&b["files"]) { Ok(f) => f, Err(e) => return fail(e) };
+    if text.trim().is_empty() && files.is_empty() { return fail("Nachricht ist leer."); }
+    let del = files.clone();
+    let r = send(text, files).await;
+    if r.is_ok() && !del.is_empty() { tokio::spawn(delete_after_read(del)); }
+    reply(r)
+}
