+def render(path="still.png", frame=None, scale=100):
+    """Render the active camera to a PNG (default folder PlazCode-Shared/blender-out). Returns path."""
+    sc = bpy.context.scene
+    if frame is not None:
+        sc.frame_set(frame)
+    if not sc.camera:
+        camera()
+    old = sc.render.resolution_percentage
+    sc.render.resolution_percentage = scale
+    sc.render.image_settings.file_format = "PNG"
+    sc.render.filepath = _out(path)
+    op(bpy.ops.render.render, write_still=True)
+    sc.render.resolution_percentage = old
+    return sc.render.filepath
