+fn clean_url(u: &str) -> String {
+    let u = u.split('#').next().unwrap_or(u);
+    match u.split_once('?') {
+        Some((base, q)) => {
+            let keep: Vec<&str> = q.split('&').filter(|p| p.starts_with("t=")).collect();
+            if keep.is_empty() { base.to_string() } else { format!("{base}?{}", keep.join("&")) }
+        }
+        None => u.to_string(),
+    }
