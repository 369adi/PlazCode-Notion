 const CREATE_NO_WINDOW: u32 = 0x0800_0000;
 
+/// Serena oeffnet sonst bei jedem Start ein Dashboard im Browser bzw. ein Log-Fenster.
+/// Der Server laeuft unsichtbar weiter; Dashboard bei Bedarf: http://localhost:24282/dashboard/
+pub(crate) fn serena_quiet() {
+    let Some(home) = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME")) else { return };
+    let path = std::path::Path::new(&home).join(".serena").join("serena_config.yml");
+    let Ok(text) = std::fs::read_to_string(&path) else { return };
+    let out = quiet_yaml(&text);
+    if out != text { let _ = std::fs::write(&path, out); }
+}
+
+fn quiet_yaml(text: &str) -> String {
+    let mut out: Vec<String> = text.lines().map(|l| {
+        let k = l.split(':').next().unwrap_or("").trim_end();
+        if !l.starts_with(' ') && (k == "web_dashboard_open_on_launch" || k == "gui_log_window") { format!("{k}: false") } else { l.to_string() }
+    }).collect();
+    if !out.iter().any(|l| l.starts_with("web_dashboard_open_on_launch:")) { out.push("web_dashboard_open_on_launch: false".into()); }
+    let mut s = out.join("\n");
+    if text.ends_with('\n') { s.push('\n'); }
+    s
+}
+
+#[cfg(test)]
+mod serena_quiet_tests {
+    #[test]
+    fn quiet() {
+        let y = "gui_log_window: true\nweb_dashboard: true\nweb_dashboard_open_on_launch: true\n# web_dashboard_open_on_launch: true\n";
+        let q = super::quiet_yaml(y);
+        assert!(q.contains("\nweb_dashboard_open_on_launch: false\n"));
+        assert!(q.starts_with("gui_log_window: false"));
+        assert!(q.contains("web_dashboard: true"));
+        assert!(q.contains("# web_dashboard_open_on_launch: true"));
+        assert_eq!(super::quiet_yaml("a: 1"), "a: 1\nweb_dashboard_open_on_launch: false");
+    }
+}
