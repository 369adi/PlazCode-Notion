+/* Cards (Notion/Co-Work pages) */
+.notion-card{padding:20px 22px!important;margin-bottom:14px}
+.notion-card h3{margin:0 0 6px!important;font-size:16px!important}
+.notion-card p{margin:4px 0 12px!important;font-size:13.5px;line-height:1.55}
+.nrow{display:flex;align-items:center;gap:8px;margin:8px 0;flex-wrap:wrap}
+.nlabel{width:120px;color:var(--muted);font-size:13px;flex:none}
+.nvalue{flex:1;min-width:220px;font-family:var(--mono);font-size:12.5px;background:#0d1017;border:1px solid var(--bd);border-radius:9px;padding:8px 11px;color:#dfe3ee;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;user-select:all}
+.nbadge{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:600;background:rgba(255,255,255,.06);color:#c9cfe0;border:1px solid rgba(255,255,255,.06)}
+.nbadge.ok{background:rgba(52,211,153,.12);color:#6ee7b7;border-color:rgba(52,211,153,.25)}.nbadge.err{background:rgba(248,113,113,.12);color:#fca5a5;border-color:rgba(248,113,113,.25)}.nbadge.warn{background:rgba(251,191,36,.12);color:#fcd34d;border-color:rgba(251,191,36,.25)}
+.nbadge::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor}
+.nsteps{margin:6px 0 0;padding-left:20px;color:#dfe3ee;font-size:13.5px;line-height:1.85}
+.nsteps b{font-weight:600}
+.nhint{font-size:12.5px;color:var(--muted);margin-top:6px;line-height:1.55}
+.nerr{color:#fca5a5;font-size:13px;margin:6px 0 0}
+.ntools{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}.ntools span{font-family:var(--mono);font-size:11.5px;background:#0d1017;border:1px solid var(--bd);border-radius:6px;padding:3px 7px;color:#c9cfe0}
+.notion-callout{display:flex;gap:12px;align-items:flex-start;background:var(--grad-soft);border:1px solid rgba(124,92,255,.25);border-radius:12px;padding:14px 16px;margin-bottom:14px;font-size:13.5px;color:#dfe3ee}
+.notion-callout .ico{font-size:18px;line-height:1.2}
+.notion-home{display:flex;align-items:center;gap:16px;justify-content:space-between}
+.notion-home .nleft{display:flex;align-items:center;gap:14px}
+.notion-logo{width:38px;height:38px;flex:none}.notion-logo,.notion-logo *{stroke:#b9a8ff!important}
+.cwtable th{color:var(--muted)!important;font-size:11.5px!important;letter-spacing:.04em;text-transform:uppercase;font-weight:650!important}
+.cwtable td{border-top:1px solid var(--bd)!important}
+.cwtable tr:hover td{background:rgba(255,255,255,.02)}
+.ureleases .urel{border-top:1px solid var(--bd)!important}
+.adi-gpl{font-size:11px;color:#545c71;padding:8px 12px 0}
+</style>
