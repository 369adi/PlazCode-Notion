diff --git a/agent/src/blender_headless.py b/agent/src/blender_headless.py
new file mode 100644
index 0000000..1219710
--- /dev/null
+++ b/agent/src/blender_headless.py
@@ -0,0 +1,241 @@
+# AdiCode Headless Blender: Blender ohne Fenster, spricht das blender-mcp-Protokoll (Port 9876).
+import bpy, sys, os, json, socket, select, time, io, math, traceback, contextlib, tempfile
+from mathutils import Vector
+
+VERSION = "1.0"
+argv = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else []
+def arg(name, default):
+    return argv[argv.index(name) + 1] if name in argv else default
+PORT = int(arg("--port", "9876"))
+OUT = arg("--out", os.path.join(tempfile.gettempdir(), "adicode_capture"))
+AUTOSAVE = arg("--autosave", "")
+os.makedirs(OUT, exist_ok=True)
+NS = {"bpy": bpy}
+
+VIEWS = {  # Richtung VOM Objekt ZUR Kamera
+    "front": (0, -1, 0), "back": (0, 1, 0), "left": (-1, 0, 0), "right": (1, 0, 0),
+    "top": (0, 0, 1), "bottom": (0, 0, -1), "persp": (1, -1.25, 0.8), "iso": (1, -1, 1),
+    "persp_back": (-1, 1.25, 0.8),
+}
+
+def _bounds(names=None):
+    objs = [o for o in bpy.context.scene.objects if o.visible_get() and o.type in {"MESH", "CURVE", "SURFACE", "META", "FONT", "GPENCIL", "GREASEPENCIL", "VOLUME", "POINTCLOUD", "CURVES"}]
+    if names:
+        objs = [o for o in objs if o.name in names]
+    if not objs:
+        return Vector((0, 0, 0)), 1.0
+    lo = Vector((1e18,) * 3); hi = Vector((-1e18,) * 3)
+    for o in objs:
+        for c in o.bound_box:
+            w = o.matrix_world @ Vector(c)
+            lo = Vector(map(min, lo, w)); hi = Vector(map(max, hi, w))
+    return (lo + hi) / 2, max((hi - lo).length / 2, 1e-3)
+
+def capture(views=("persp",), size=768, engine="EEVEE", samples=16, objects=None, use_scene_camera=False,
+            ortho=None, filepath=None, grid=True, shading="auto", margin=1.15, preview_px=800):
+    """Rendert die Szene ohne sichtbares Fenster. views: front/back/left/right/top/bottom/persp/iso/camera.
+    Gibt Pfade zurueck; bei mehreren Ansichten zusaetzlich ein Raster-Bild (grid)."""
+    sc = bpy.context.scene
+    r = sc.render
+    saved = dict(engine=r.engine, rx=r.resolution_x, ry=r.resolution_y, pct=r.resolution_percentage,
+                 cam=sc.camera, fp=r.filepath, fmt=r.image_settings.file_format, film=r.film_transparent)
+    eng = {"EEVEE": "BLENDER_EEVEE", "WORKBENCH": "BLENDER_WORKBENCH", "CYCLES": "CYCLES"}.get(engine.upper(), engine)
+    tmp = []
+    try:
+        r.engine = eng
+        r.resolution_x = r.resolution_y = int(size); r.resolution_percentage = 100
+        r.image_settings.file_format = "PNG"
+        if eng == "BLENDER_EEVEE":
+            sc.eevee.taa_render_samples = int(samples)
+        elif eng == "CYCLES":
+            sc.cycles.samples = int(samples)
+            try:
+                p = bpy.context.preferences.addons["cycles"].preferences
+                for t in ("OPTIX", "CUDA"):
+                    try:
+                        p.compute_device_type = t; p.get_devices(); break
+                    except Exception:
+                        pass
+                for dv in p.devices:
+                    dv.use = True
+                sc.cycles.device = "GPU"
+            except Exception:
+                pass
+        elif eng == "BLENDER_WORKBENCH":
+            sc.display.shading.light = "STUDIO"; sc.display.shading.color_type = "MATERIAL"
+            sc.display.shading.show_cavity = True
+        # Licht/Welt ergaenzen, wenn die Szene keins hat (sonst schwarzes Bild)
+        has_light = any(o.type == "LIGHT" and o.visible_get() for o in sc.objects)
+        if sc.world is None:
+            w = bpy.data.worlds.new("AdiCodeWorld"); sc.world = w; tmp.append(("world", w))
+        if not has_light and eng != "BLENDER_WORKBENCH":
+            for nm, rot, en in (("Key", (50, 0, 35), 4.0), ("Fill", (60, 0, -140), 1.5)):
+                ld = bpy.data.lights.new("AdiCode" + nm, "SUN"); ld.energy = en
+                lo = bpy.data.objects.new("AdiCode" + nm, ld); sc.collection.objects.link(lo)
+                lo.rotation_euler = [math.radians(a) for a in rot]; tmp.append(("obj", lo)); tmp.append(("light", ld))
+        center, radius = _bounds(objects)
+        paths = []
+        for v in views:
+            path = os.path.join(OUT, "view_%s.png" % v) if not filepath or len(views) > 1 else filepath
+            if v == "camera" or (use_scene_camera and sc.camera and len(views) == 1):
+                if not saved["cam"]:
+                    continue
+                sc.camera = saved["cam"]
+            else:
+                cd = bpy.data.cameras.new("AdiCodeCam"); co = bpy.data.objects.new("AdiCodeCam", cd)
+                sc.collection.objects.link(co); tmp.append(("obj", co)); tmp.append(("cam", cd))
+                d = Vector(VIEWS.get(v, VIEWS["persp"])).normalized()
+                is_ortho = (v in ("front", "back", "left", "right", "top", "bottom")) if ortho is None else ortho
+                if is_ortho:
+                    cd.type = "ORTHO"; cd.ortho_scale = radius * 2 * margin; dist = radius * 4
+                else:
+                    cd.lens = 50; fov = 2 * math.atan(18 / 50); dist = radius * margin / math.sin(fov / 2)
+                cd.clip_start = max(dist - radius * 3, 0.001); cd.clip_end = dist + radius * 3
+                co.location = center + d * dist
+                up = Vector((0, 1, 0)) if abs(d.z) > 0.99 else Vector((0, 0, 1))
+                co.rotation_euler = (-d).to_track_quat("-Z", "Y" if abs(d.z) > 0.99 else "Y").to_euler()
+                sc.camera = co
+            r.filepath = path
+            bpy.ops.render.render(write_still=True)
+            paths.append(path)
+        result = {"paths": paths, "views": list(views), "size": int(size), "engine": eng}
+        if grid and len(paths) > 1:
+            result["grid"] = _grid(paths, filepath or os.path.join(OUT, "grid.png"))
+        src = result.get("grid") or (paths[0] if paths else None)
+        if src and preview_px:
+            result["preview"] = _preview(src, os.path.join(OUT, "preview.jpg"), int(preview_px))
+        return result
+    finally:
+        for kind, d in reversed(tmp):
+            try:
+                if kind == "obj": bpy.data.objects.remove(d, do_unlink=True)
+                elif kind == "cam": bpy.data.cameras.remove(d)
+                elif kind == "light": bpy.data.lights.remove(d)
+                elif kind == "world": sc.world = None; bpy.data.worlds.remove(d)
+            except Exception:
+                pass
+        sc.camera = saved["cam"]; r.engine = saved["engine"]; r.resolution_x = saved["rx"]; r.resolution_y = saved["ry"]
+        r.resolution_percentage = saved["pct"]; r.filepath = saved["fp"]; r.image_settings.file_format = saved["fmt"]
+
+def _grid(paths, out):
+    import numpy as np
+    imgs = [bpy.data.images.load(p, check_existing=False) for p in paths]
+    try:
+        w, h = imgs[0].size; n = len(imgs); cols = 2 if n <= 4 else 3; rows = math.ceil(n / cols)
+        canvas = np.ones((rows * h, cols * w, 4), dtype=np.float32) * 0.15
+        for i, im in enumerate(imgs):
+            a = np.empty(w * h * 4, dtype=np.float32); im.pixels.foreach_get(a)
+            a = a.reshape(h, w, 4); rr = rows - 1 - i // cols; cc = i % cols
+            canvas[rr * h:(rr + 1) * h, cc * w:(cc + 1) * w] = a
+        g = bpy.data.images.new("AdiCodeGrid", cols * w, rows * h, alpha=True)
+        g.pixels.foreach_set(canvas.ravel()); g.filepath_raw = out; g.file_format = "PNG"; g.save()
+        bpy.data.images.remove(g)
+        return out
+    finally:
+        for im in imgs:
+            bpy.data.images.remove(im)
+
+def _preview(src, out, px, quality=82):
+    im = bpy.data.images.load(src, check_existing=False)
+    try:
+        w, h = im.size; s = min(1.0, px / float(max(w, h)))
+        if s < 1.0:
+            im.scale(max(1, int(w * s)), max(1, int(h * s)))
+        im.file_format = "JPEG"; im.filepath_raw = out
+        try:
+            im.save(filepath=out, quality=quality)
+        except TypeError:
+            im.save()
+        return out
+    finally:
+        bpy.data.images.remove(im)
+
+NS["capture"] = capture
+
+def scene_info():
+    sc = bpy.context.scene
+    return {"name": sc.name, "headless": True, "object_count": len(sc.objects),
+            "objects": [{"name": o.name, "type": o.type, "location": [round(x, 3) for x in o.location]} for o in list(sc.objects)[:50]],
+            "materials_count": len(bpy.data.materials), "file": bpy.data.filepath}
+
+def handle(cmd):
+    t = cmd.get("type"); p = cmd.get("params", {}) or {}
+    if t == "ping":
+        return {"pong": True, "headless": True}
+    if t == "get_scene_info":
+        return scene_info()
+    if t == "execute_code":
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            exec(p.get("code", ""), NS)
+        return {"executed": True, "result": buf.getvalue()}
+    if t == "get_object_info":
+        o = bpy.data.objects.get(p.get("name") or p.get("object_name", ""))
+        if not o:
+            raise ValueError("Object not found")
+        return {"name": o.name, "type": o.type, "location": list(o.location), "rotation": list(o.rotation_euler),
+                "scale": list(o.scale), "dimensions": list(o.dimensions), "materials": [m.name for m in getattr(o.data, "materials", []) if m]}
+    if t == "get_viewport_screenshot":
+        size = int(p.get("max_size", 800)); fp = p.get("filepath") or os.path.join(OUT, "viewport.png")
+        res = capture(views=(p.get("view", "persp"),), size=size, filepath=fp, use_scene_camera=False)
+        return {"success": True, "width": size, "height": size, "filepath": res["paths"][0]}
+    if t == "capture":
+        return capture(**{k: (tuple(v) if k == "views" else v) for k, v in p.items()})
+    if t == "save":
+        fp = p.get("filepath") or AUTOSAVE
+        bpy.ops.wm.save_as_mainfile(filepath=fp, copy=bool(p.get("copy", False)))
+        return {"saved": fp}
+    if t == "open":
+        bpy.ops.wm.open_mainfile(filepath=p["filepath"]); NS.clear(); NS.update({"bpy": bpy, "capture": capture})
+        return scene_info()
+    if t == "get_addon_info":
+        return {"headless": True, "version": VERSION, "blender": bpy.app.version_string}
+    if t == "shutdown":
+        raise SystemExit
+    raise ValueError("Unknown command type in headless mode: %s" % t)
+
+def serve():
+    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 0)
+    srv.bind(("127.0.0.1", PORT)); srv.listen(8); srv.setblocking(False)
+    print("ADICODE_HEADLESS_READY port=%d out=%s" % (PORT, OUT), flush=True)
+    clients = {}; last_save = time.time(); dirty = False
+    while True:
+        rl, _, _ = select.select([srv] + list(clients), [], [], 1.0)
+        for s in rl:
+            if s is srv:
+                c, _ = srv.accept(); c.setblocking(True); c.settimeout(None); clients[c] = b""; continue
+            try:
+                data = s.recv(65536)
+            except Exception:
+                data = b""
+            if not data:
+                clients.pop(s, None); s.close(); continue
+            clients[s] += data
+            try:
+                cmd = json.loads(clients[s].decode("utf-8"))
+            except (ValueError, UnicodeDecodeError):
+                continue
+            clients[s] = b""
+            try:
+                resp = {"status": "success", "result": handle(cmd)}
+                dirty = dirty or cmd.get("type") == "execute_code"
+            except SystemExit:
+                s.sendall(json.dumps({"status": "success", "result": {"bye": True}}).encode()); return
+            except Exception as e:
+                resp = {"status": "error", "message": "%s: %s" % (type(e).__name__, e), "trace": traceback.format_exc()[-1500:]}
+            try:
+                s.sendall(json.dumps(resp, default=str).encode("utf-8"))
+            except Exception:
+                clients.pop(s, None)
+        if AUTOSAVE and dirty and time.time() - last_save > 20:
+            try:
+                bpy.ops.wm.save_as_mainfile(filepath=AUTOSAVE, copy=True)
+            except Exception as e:
+                print("autosave failed", e)
+            last_save = time.time(); dirty = False
+
+if __name__ == "__main__":
+    if AUTOSAVE and os.path.exists(AUTOSAVE) and "--fresh" not in argv:
+        bpy.ops.wm.open_mainfile(filepath=AUTOSAVE)
+    serve()
diff --git a/agent/src/blender_helpers.py b/agent/src/blender_helpers.py
new file mode 100644
index 0000000..b7385a5
--- /dev/null
+++ b/agent/src/blender_helpers.py
@@ -0,0 +1,1097 @@
+"""AdiCode Blender helpers (adicode_blender).
+
+Loaded inside a running Blender (MCP execute_blender_code) or headless
+(blender -b --python). Usage:
+
+    import adicode_blender as A, importlib; importlib.reload(A)
+    A.help()
+
+Every helper uses the data API where possible and wraps unavoidable
+operators in a proper context override, so it works from MCP timers and
+headless runs. Functions return plain dicts/strings that are easy to print.
+"""
+import bpy
+import bmesh
+import math
+import os
+from mathutils import Vector
+
+VERSION = "1.3"
+OUT_DIR = os.path.join(os.environ.get("USERPROFILE", os.path.expanduser("~")), "PlazCode-Shared", "blender-out")
+
+
+# ----------------------------------------------------------------- basics
+def help():
+    names = [n for n, v in globals().items() if callable(v) and not n.startswith("_") and getattr(v, "__module__", "") == __name__]
+    lines = []
+    for n in sorted(names):
+        doc = (globals()[n].__doc__ or "").strip().splitlines()
+        lines.append(f"{n}: {doc[0] if doc else ''}")
+    return "adicode_blender " + VERSION + "\n" + "\n".join(lines)
+
+
+def _ctx():
+    """Context override with a 3D view if a UI exists (empty dict headless)."""
+    wm = bpy.context.window_manager
+    for win in getattr(wm, "windows", []):
+        for area in win.screen.areas:
+            if area.type == "VIEW_3D":
+                region = next((r for r in area.regions if r.type == "WINDOW"), None)
+                return {"window": win, "screen": win.screen, "area": area, "region": region}
+    return {}
+
+
+def op(fn, *args, objects=None, active=None, **kw):
+    """Run a bpy.ops call safely: op(bpy.ops.object.shade_smooth, objects=[o])."""
+    over = _ctx()
+    if objects is not None:
+        objs = list(objects)
+        over["selected_objects"] = objs
+        over["selected_editable_objects"] = objs
+        over["active_object"] = active or (objs[0] if objs else None)
+        over["object"] = over["active_object"]
+    with bpy.context.temp_override(**over):
+        return fn(*args, **kw)
+
+
+def info():
+    """Short scene report: version, engine, fps, frames, object stats."""
+    sc = bpy.context.scene
+    meshes = [o for o in sc.objects if o.type == "MESH"]
+    tris = sum(sum(len(p.vertices) - 2 for p in o.data.polygons) for o in meshes)
+    return {
+        "blender": bpy.app.version_string, "helpers": VERSION, "file": bpy.data.filepath or "(unsaved)",
+        "engine": sc.render.engine, "fps": sc.render.fps, "frames": [sc.frame_start, sc.frame_end],
+        "resolution": [sc.render.resolution_x, sc.render.resolution_y],
+        "objects": len(sc.objects), "meshes": len(meshes), "tris": tris,
+        "armatures": [o.name for o in sc.objects if o.type == "ARMATURE"],
+        "cameras": [o.name for o in sc.objects if o.type == "CAMERA"], "active_camera": sc.camera.name if sc.camera else None,
+        "actions": [a.name for a in bpy.data.actions][:30],
+    }
+
+
+def gpu(prefer=("OPTIX", "CUDA", "HIP", "ONEAPI", "METAL")):
+    """Enable GPU rendering for Cycles (OptiX on RTX) and set scene device to GPU."""
+    try:
+        cp = bpy.context.preferences.addons["cycles"].preferences
+    except KeyError:
+        return "cycles addon missing"
+    chosen = None
+    for t in prefer:
+        try:
+            cp.compute_device_type = t
+            cp.refresh_devices()
+            if any(d.type == t for d in cp.devices):
+                chosen = t
+                break
+        except Exception:
+            continue
+    for d in cp.devices:
+        d.use = (d.type != "CPU") if chosen else True
+    for sc in bpy.data.scenes:
+        if chosen:
+            sc.cycles.device = "GPU"
+    return {"compute": chosen or "CPU", "devices": [(d.name, d.type, d.use) for d in cp.devices]}
+
+
+def clean_scene(keep=()):
+    """Delete all objects (except names in keep) and purge orphan data."""
+    for o in list(bpy.data.objects):
+        if o.name not in keep:
+            bpy.data.objects.remove(o, do_unlink=True)
+    for coll in (bpy.data.meshes, bpy.data.materials, bpy.data.lights, bpy.data.cameras, bpy.data.curves, bpy.data.armatures, bpy.data.actions, bpy.data.node_groups, bpy.data.images):
+        for d in list(coll):
+            if d.users == 0:
+                coll.remove(d)
+    return "clean"
+
+
+def collection(name, parent=None):
+    """Get or create a collection linked to the scene (or to parent)."""
+    c = bpy.data.collections.get(name) or bpy.data.collections.new(name)
+    host = parent or bpy.context.scene.collection
+    if c.name not in host.children:
+        host.children.link(c)
+    return c
+
+
+def link(obj, coll=None):
+    (coll or bpy.context.scene.collection).objects.link(obj)
+    return obj
+
+
+# -------------------------------------------------------------- geometry
+def bm_object(name, build, coll=None):
+    """Create a mesh object from a bmesh builder: build(bm) adds geometry."""
+    me = bpy.data.meshes.new(name)
+    bm = bmesh.new()
+    build(bm)
+    bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=1e-5)
+    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
+    bm.to_mesh(me)
+    bm.free()
+    return link(bpy.data.objects.new(name, me), coll)
+
+
+def primitive(kind="cube", name=None, size=1.0, location=(0, 0, 0), segments=32, coll=None, radius=None, depth=None, radius2=None):
+    """Data-API primitive: cube|sphere|ico|cylinder|cone|plane. size = edge/diameter; optional radius, depth (cylinder/cone height), radius2 (cone tip radius)."""
+    r1 = radius if radius is not None else size / 2
+    h = depth if depth is not None else size
+
+    def build(bm):
+        if kind == "cube":
+            bmesh.ops.create_cube(bm, size=size)
+        elif kind == "sphere":
+            bmesh.ops.create_uvsphere(bm, u_segments=segments, v_segments=max(8, segments // 2), radius=r1)
+        elif kind == "ico":
+            bmesh.ops.create_icosphere(bm, subdivisions=3, radius=r1)
+        elif kind == "cylinder":
+            bmesh.ops.create_cone(bm, cap_ends=True, segments=segments, radius1=r1, radius2=r1, depth=h)
+        elif kind == "cone":
+            bmesh.ops.create_cone(bm, cap_ends=True, segments=segments, radius1=r1, radius2=radius2 or 0, depth=h)
+        elif kind == "plane":
+            bmesh.ops.create_grid(bm, x_segments=1, y_segments=1, size=size / 2)
+        else:
+            raise ValueError(kind)
+    o = bm_object(name or kind.title(), build, coll)
+    o.location = location
+    return o
+
+
+def apply_transforms(obj, loc=False, rot=True, scale=True):
+    """Apply rotation/scale (keeps modifiers, bevels and physics correct)."""
+    op(bpy.ops.object.transform_apply, objects=[obj], location=loc, rotation=rot, scale=scale)
+    return obj
+
+
+def smooth(obj, angle=30.0):
+    """Smooth shading with angle-based sharp edges (Blender 4.1+ safe)."""
+    try:
+        op(bpy.ops.object.shade_smooth_by_angle, objects=[obj], angle=math.radians(angle))
+    except Exception:
+        obj.data.polygons.foreach_set("use_smooth", [True] * len(obj.data.polygons))
+        obj.data.update()
+    return obj
+
+
+def hard_surface(obj, width=0.02, segments=3, angle=30.0, weighted=True):
+    """Hard-surface finish: angle bevel + weighted normals + smooth. Apply scale first."""
+    m = obj.modifiers.new("Bevel", "BEVEL")
+    m.width, m.segments, m.limit_method, m.angle_limit = width, segments, "ANGLE", math.radians(angle)
+    m.harden_normals = True
+    if weighted:
+        w = obj.modifiers.new("WeightedNormal", "WEIGHTED_NORMAL")
+        w.keep_sharp = True
+    smooth(obj, angle)
+    return obj
+
+
+def organic(obj, levels=2, render_levels=3):
+    """Organic finish: subdivision surface + smooth shading."""
+    m = obj.modifiers.new("Subsurf", "SUBSURF")
+    m.levels, m.render_levels = levels, render_levels
+    obj.data.polygons.foreach_set("use_smooth", [True] * len(obj.data.polygons))
+    obj.data.update()
+    return obj
+
+
+def mirror(obj, axis="X", clip=True):
+    m = obj.modifiers.new("Mirror", "MIRROR")
+    m.use_axis = [axis == "X", axis == "Y", axis == "Z"]
+    m.use_clip = clip
+    return obj
+
+
+def cleanup(obj, merge=1e-4):
+    """Merge doubles, recalc normals, delete loose geometry. Returns quality report."""
+    bm = bmesh.new()
+    bm.from_mesh(obj.data)
+    bmesh.ops.remove_doubles(bm, verts=bm.verts, dist=merge)
+    loose = [v for v in bm.verts if not v.link_edges]
+    bmesh.ops.delete(bm, geom=loose, context="VERTS")
+    bmesh.ops.recalc_face_normals(bm, faces=bm.faces)
+    bm.to_mesh(obj.data)
+    bm.free()
+    obj.data.update()
+    return quality(obj)
+
+
+def quality(obj=None):
+    """Mesh QA: tris/quads/ngons, non-manifold, loose, unapplied scale, UVs, materials."""
+    objs = [obj] if obj else [o for o in bpy.context.scene.objects if o.type == "MESH"]
+    out = []
+    for o in objs:
+        bm = bmesh.new()
+        bm.from_mesh(o.data)
+        sides = [len(f.verts) for f in bm.faces]
+        out.append({
+            "name": o.name, "verts": len(bm.verts), "faces": len(sides),
+            "tris": sides.count(3), "quads": sides.count(4), "ngons": sum(1 for s in sides if s > 4),
+            "non_manifold_edges": sum(1 for e in bm.edges if not e.is_manifold),
+            "loose_verts": sum(1 for v in bm.verts if not v.link_edges),
+            "zero_faces": sum(1 for f in bm.faces if f.calc_area() < 1e-9),
+            "scale_applied": all(abs(s - 1) < 1e-4 for s in o.scale),
+            "uv": len(o.data.uv_layers) > 0, "materials": [m.name for m in o.data.materials if m],
+            "modifiers": [m.type for m in o.modifiers],
+            "dimensions_m": [round(x, 3) for x in o.dimensions],
+        })
+        bm.free()
+    return out
+
+
+def uv_unwrap(obj, method="smart", angle=66.0, margin=0.02):
+    """UV unwrap a mesh (smart project or cube) without manual edit-mode work."""
+    over = _ctx()
+    over.update({"active_object": obj, "object": obj, "selected_objects": [obj], "edit_object": obj})
+    with bpy.context.temp_override(**over):
+        bpy.context.view_layer.objects.active = obj
+        bpy.ops.object.mode_set(mode="EDIT")
+        bpy.ops.mesh.select_all(action="SELECT")
+        if method == "cube":
+            bpy.ops.uv.cube_project()
+        else:
+            bpy.ops.uv.smart_project(angle_limit=math.radians(angle), island_margin=margin)
+        bpy.ops.object.mode_set(mode="OBJECT")
+    return obj
+
+
+def scatter(target, instance, density=10.0, seed=0, scale=(0.8, 1.2), align=True):
+    """Geometry-nodes scatter of `instance` object on `target` surface (non-destructive)."""
+    ng = bpy.data.node_groups.new("ADC_Scatter", "GeometryNodeTree")
+    ng.interface.new_socket("Geometry", in_out="INPUT", socket_type="NodeSocketGeometry")
+    ng.interface.new_socket("Geometry", in_out="OUTPUT", socket_type="NodeSocketGeometry")
+    n = ng.nodes
+    gi, go = n.new("NodeGroupInput"), n.new("NodeGroupOutput")
+    dist = n.new("GeometryNodeDistributePointsOnFaces")
+    dist.inputs["Density"].default_value = density
+    dist.inputs["Seed"].default_value = seed
+    inst = n.new("GeometryNodeInstanceOnPoints")
+    info_n = n.new("GeometryNodeObjectInfo")
+    info_n.inputs[0].default_value = instance
+    info_n.transform_space = "RELATIVE"
+    rnd = n.new("FunctionNodeRandomValue")
+    rnd.data_type = "FLOAT"
+    fl = [s for s in rnd.inputs if s.type == "VALUE"]
+    fl[0].default_value, fl[1].default_value = scale
+    join = n.new("GeometryNodeJoinGeometry")
+    L = ng.links
+    L.new(gi.outputs[0], dist.inputs["Mesh"])
+    L.new(dist.outputs["Points"], inst.inputs["Points"])
+    L.new(info_n.outputs["Geometry"], inst.inputs["Instance"])
+    L.new(next(s for s in rnd.outputs if s.type == "VALUE"), inst.inputs["Scale"])
+    if align:
+        L.new(dist.outputs["Rotation"], inst.inputs["Rotation"])
+    L.new(gi.outputs[0], join.inputs[0])
+    L.new(inst.outputs[0], join.inputs[0])
+    L.new(join.outputs[0], go.inputs[0])
+    m = target.modifiers.new("Scatter", "NODES")
+    m.node_group = ng
+    instance.hide_render = True
+    instance.hide_viewport = True
+    return m
+
+
+# ------------------------------------------------------------- materials
+def _bsdf(mat):
+    return next(n for n in mat.node_tree.nodes if n.type == "BSDF_PRINCIPLED")
+
+
+def material(name, color=(0.8, 0.8, 0.8), metallic=0.0, roughness=0.5, emission=None, strength=5.0, alpha=1.0, coat=0.0, transmission=0.0, sss=0.0):
+    """Principled BSDF material (Blender 4/5 socket names). color = linear RGB 0..1."""
+    m = bpy.data.materials.get(name) or bpy.data.materials.new(name)
+    m.use_nodes = True
+    b = _bsdf(m)
+    def s(key, val):
+        if key in b.inputs:
+            b.inputs[key].default_value = val
+    s("Base Color", (*color[:3], 1.0))
+    s("Metallic", metallic)
+    s("Roughness", roughness)
+    s("Alpha", alpha)
+    s("Coat Weight", coat)
+    s("Transmission Weight", transmission)
+    s("Subsurface Weight", sss)
+    if emission:
+        s("Emission Color", (*emission[:3], 1.0))
+        s("Emission Strength", strength)
+    return m
+
+
+def procedural(name, color_a=(0.05, 0.05, 0.05), color_b=(0.6, 0.6, 0.6), scale=6.0, detail=8.0, metallic=0.0, rough=(0.35, 0.8), bump=0.25, kind="noise"):
+    """Procedural PBR: noise/voronoi/wave/wood -> color ramp (color + roughness) + bump. kind=noise|voronoi|wave|wood (wood = tree rings + grain, defaults to brown)."""
+    if kind == "wood":
+        if color_a == (0.05, 0.05, 0.05) and color_b == (0.6, 0.6, 0.6):
+            color_a, color_b = (0.10, 0.042, 0.015), (0.36, 0.17, 0.065)
+        if rough == (0.35, 0.8):
+            rough = (0.45, 0.65)
+        if bump == 0.25:
+            bump = 0.08
+        if scale == 6.0:
+            scale = 3.0
+    m = bpy.data.materials.get(name)
+    if m:
+        bpy.data.materials.remove(m)
+    m = material(name, color_b, metallic, rough[0])
+    nt, b = m.node_tree, _bsdf(m)
+    N, L = nt.nodes, nt.links
+    coord, mapping = N.new("ShaderNodeTexCoord"), N.new("ShaderNodeMapping")
+    L.new(coord.outputs["Object"], mapping.inputs["Vector"])
+    tex = N.new({"noise": "ShaderNodeTexNoise", "voronoi": "ShaderNodeTexVoronoi", "wave": "ShaderNodeTexWave", "wood": "ShaderNodeTexWave"}[kind])
+    tex.inputs["Scale"].default_value = scale
+    if kind == "wood":
+        # rings around the X axis, stretched along X = long grain; noise distortion breaks up the rings
+        tex.wave_type = "RINGS"
+        tex.rings_direction = "X"
+        mapping.inputs["Scale"].default_value = (0.15, 1.0, 1.0)
+        tex.inputs["Distortion"].default_value = 6.0
+        tex.inputs["Detail"].default_value = 4.0
+        if "Detail Scale" in tex.inputs:
+            tex.inputs["Detail Scale"].default_value = 1.5
+    elif "Detail" in tex.inputs:
+        tex.inputs["Detail"].default_value = detail
+    L.new(mapping.outputs["Vector"], tex.inputs["Vector"])
+    fac = tex.outputs["Fac"] if "Fac" in tex.outputs else tex.outputs["Distance"]
+    ramp = N.new("ShaderNodeValToRGB")
+    ramp.color_ramp.elements[0].color = (*color_a, 1)
+    ramp.color_ramp.elements[1].color = (*color_b, 1)
+    L.new(fac, ramp.inputs["Fac"])
+    L.new(ramp.outputs["Color"], b.inputs["Base Color"])
+    rmap = N.new("ShaderNodeMapRange")
+    rmap.inputs[3].default_value, rmap.inputs[4].default_value = rough
+    L.new(fac, rmap.inputs[0])
+    L.new(rmap.outputs[0], b.inputs["Roughness"])
+    bn = N.new("ShaderNodeBump")
+    bn.inputs["Strength"].default_value = bump
+    L.new(fac, bn.inputs["Height"])
+    L.new(bn.outputs["Normal"], b.inputs["Normal"])
+    return m
+
+
+def pbr_textures(name, folder):
+    """Material from a texture folder (Poly Haven/ambientCG naming: diff/albedo, rough, nor_gl, disp, metal, ao)."""
+    m = material(name)
+    nt, b = m.node_tree, _bsdf(m)
+    N, L = nt.nodes, nt.links
+    files = {f.lower(): os.path.join(folder, f) for f in os.listdir(folder)}
+    def find(*keys):
+        for k, p in files.items():
+            if any(x in k for x in keys):
+                return p
+    def img(path, non_color):
+        t = N.new("ShaderNodeTexImage")
+        t.image = bpy.data.images.load(path, check_existing=True)
+        t.image.colorspace_settings.name = "Non-Color" if non_color else "sRGB"
+        return t
+    p = find("diff", "albedo", "basecolor", "color")
+    if p:
+        L.new(img(p, False).outputs["Color"], b.inputs["Base Color"])
+    p = find("rough")
+    if p:
+        L.new(img(p, True).outputs["Color"], b.inputs["Roughness"])
+    p = find("metal")
+    if p:
+        L.new(img(p, True).outputs["Color"], b.inputs["Metallic"])
+    p = find("nor_gl", "normal_gl", "normal", "nor")
+    if p:
+        nm = N.new("ShaderNodeNormalMap")
+        L.new(img(p, True).outputs["Color"], nm.inputs["Color"])
+        L.new(nm.outputs["Normal"], b.inputs["Normal"])
+    return m
+
+
+def preset(kind="steel", name=None, color=None, roughness=None):
+    """Material preset: brass|gold|copper|steel|chrome|aluminum|iron|glass|frosted_glass|tinted_glass|plastic|rubber|ceramic|wood|dark_wood|fabric|concrete. Optional color/roughness override."""
+    P = {
+        "brass": dict(color=(0.89, 0.66, 0.30), metallic=1.0, roughness=0.25),
+        "gold": dict(color=(1.0, 0.77, 0.34), metallic=1.0, roughness=0.2),
+        "copper": dict(color=(0.95, 0.64, 0.54), metallic=1.0, roughness=0.25),
+        "steel": dict(color=(0.56, 0.57, 0.58), metallic=1.0, roughness=0.3),
+        "chrome": dict(color=(0.55, 0.56, 0.55), metallic=1.0, roughness=0.05),
+        "aluminum": dict(color=(0.91, 0.92, 0.92), metallic=1.0, roughness=0.35),
+        "iron": dict(color=(0.20, 0.20, 0.21), metallic=1.0, roughness=0.6),
+        "glass": dict(color=(1.0, 1.0, 1.0), roughness=0.0, transmission=1.0),
+        "frosted_glass": dict(color=(1.0, 1.0, 1.0), roughness=0.35, transmission=1.0),
+        "tinted_glass": dict(color=(0.05, 0.45, 0.15), roughness=0.05, transmission=1.0),
+        "plastic": dict(color=(0.6, 0.05, 0.05), roughness=0.35),
+        "rubber": dict(color=(0.02, 0.02, 0.02), roughness=0.9),
+        "ceramic": dict(color=(0.85, 0.85, 0.82), roughness=0.15, coat=0.6),
+        "fabric": dict(color=(0.3, 0.3, 0.35), roughness=1.0, sss=0.05),
+        "concrete": dict(color=(0.35, 0.34, 0.32), roughness=0.9),
+    }
+    nm = name or "ADC_" + kind
+    if kind in ("wood", "dark_wood"):
+        a, b = ((0.10, 0.042, 0.015), (0.36, 0.17, 0.065)) if kind == "wood" else ((0.025, 0.010, 0.004), (0.12, 0.05, 0.018))
+        if color:
+            b = tuple(color[:3])
+            a = tuple(c * 0.3 for c in b)
+        return procedural(nm, a, b, kind="wood", rough=(roughness or 0.45, (roughness or 0.45) + 0.2))
+    if kind not in P:
+        raise ValueError("preset kind: " + "|".join(sorted(list(P) + ["wood", "dark_wood"])))
+    kw = dict(P[kind])
+    if color is not None:
+        kw["color"] = tuple(color[:3])
+    if roughness is not None:
+        kw["roughness"] = roughness
+    m = material(nm, **kw)
+    if kw.get("transmission"):
+        b = _bsdf(m)
+        if "IOR" in b.inputs:
+            b.inputs["IOR"].default_value = 1.45
+    return m
+
+
+def assign(obj, mat, slot=None):
+    """Put mat on obj: slot=None replaces all materials, slot=i sets material slot i."""
+    if slot is None:
+        obj.data.materials.clear()
+        obj.data.materials.append(mat)
+    else:
+        obj.data.materials[slot] = mat
+    return obj
+
+
+# ------------------------------------------------------- light & camera
+def look_at(obj, target):
+    """Rotate obj (camera/light) to point at target (object or vector)."""
+    # matrix_world is stale right after setting .location -> refresh first (fixes cameras/lights pointing up)
+    bpy.context.view_layer.update()
+    t = target.matrix_world.translation.copy() if hasattr(target, "matrix_world") else Vector(target)
+    src = obj.matrix_world.translation.copy() if obj.parent else obj.location.copy()
+    d = t - src
+    if d.length < 1e-9:
+        return obj
+    obj.rotation_euler = d.to_track_quat("-Z", "Y").to_euler()
+    return obj
+
+
+_GROUND = ("ADC_Floor", "ADC_Ground", "ADC_Backdrop", "ADC_Studio")
+
+
+def _subjects():
+    """Visible meshes without floor/backdrop (they would blow up framing + light power)."""
+    return [o for o in bpy.context.scene.objects if o.type == "MESH" and not o.hide_render
+            and not o.name.startswith(_GROUND) and not o.get("adc_ground")]
+
+
+def _bounds(objs):
+    pts = [o.matrix_world @ Vector(c) for o in objs for c in o.bound_box]
+    if not pts:
+        return Vector((0, 0, 0)), 1.0
+    lo = Vector((min(p.x for p in pts), min(p.y for p in pts), min(p.z for p in pts)))
+    hi = Vector((max(p.x for p in pts), max(p.y for p in pts), max(p.z for p in pts)))
+    return (lo + hi) / 2, max((hi - lo).length, 0.01)
+
+
+def _fit_dist(cam, size, margin):
+    """Distance so a bounding sphere (diameter size) fits the SMALLER image side of the render aspect."""
+    r = bpy.context.scene.render
+    aspect = (r.resolution_x * r.pixel_aspect_x) / max(1e-6, r.resolution_y * r.pixel_aspect_y)
+    cam.data.sensor_fit = "AUTO"  # sensor_width spans the larger side
+    half = math.atan(cam.data.sensor_width / (2 * cam.data.lens))
+    small = math.atan(math.tan(half) / aspect) if aspect >= 1 else math.atan(math.tan(half) * aspect)
+    return (size / 2) * margin / math.sin(min(half, small))
+
+
+def camera(objs=None, lens=50.0, angle=(35.0, 20.0), margin=1.1, name="ADC_Camera"):
+    """Create/reuse a camera that frames objs fully (default: all meshes, respects render aspect). angle=(azimuth, elevation) degrees."""
+    objs = objs or _subjects()
+    center, size = _bounds(objs)
+    cam = bpy.data.objects.get(name)
+    if not cam:
+        cam = link(bpy.data.objects.new(name, bpy.data.cameras.new(name)))
+    cam.data.lens = lens
+    dist = _fit_dist(cam, size, margin)
+    az, el = math.radians(angle[0]), math.radians(angle[1])
+    cam.location = center + Vector((math.sin(az) * math.cos(el), -math.cos(az) * math.cos(el), math.sin(el))) * dist
+    look_at(cam, center)
+    cam.data.clip_end = max(1000, dist * 10)
+    bpy.context.scene.camera = cam
+    return cam
+
+
+def studio(target=None, strength=1.0, style="three_point", world=0.05, hdri=None):
+    """Lighting: three_point | rim | soft. Physically scaled area lights, AgX view, optional HDRI path."""
+    objs = [target] if target else _subjects()
+    center, size = _bounds(objs)
+    coll = collection("ADC_Lights")
+    for o in list(coll.objects):
+        bpy.data.objects.remove(o, do_unlink=True)
+    rigs = {
+        "three_point": [("Key", (45, 35), 1000, 1.0), ("Fill", (-60, 20), 300, 2.0), ("Rim", (170, 45), 800, 0.6)],
+        "rim": [("Key", (30, 25), 600, 1.0), ("RimL", (150, 30), 1200, 0.4), ("RimR", (-150, 30), 1200, 0.4)],
+        "soft": [("Top", (0, 80), 800, 3.0), ("Front", (20, 15), 300, 3.0)],
+    }[style]
+    r = size * 2.2
+    for name, (az, el), watts, sz in rigs:
+        ld = bpy.data.lights.new("ADC_" + name, "AREA")
+        ld.energy = watts * strength * (size / 2) ** 2
+        ld.size = size * sz
+        lo = bpy.data.objects.new("ADC_" + name, ld)
+        coll.objects.link(lo)
+        a, e = math.radians(az), math.radians(el)
+        lo.location = center + Vector((math.sin(a) * math.cos(e), -math.cos(a) * math.cos(e), math.sin(e))) * r
+        look_at(lo, center)
+    w = bpy.context.scene.world or bpy.data.worlds.new("World")
+    bpy.context.scene.world = w
+    w.use_nodes = True
+    nt = w.node_tree
+    bg = next(n for n in nt.nodes if n.type == "BACKGROUND")
+    if hdri and os.path.exists(hdri):
+        env = nt.nodes.new("ShaderNodeTexEnvironment")
+        env.image = bpy.data.images.load(hdri, check_existing=True)
+        nt.links.new(env.outputs["Color"], bg.inputs["Color"])
+        bg.inputs["Strength"].default_value = 1.0
+    else:
+        bg.inputs["Color"].default_value = (world, world, world * 1.1, 1)
+        bg.inputs["Strength"].default_value = 1.0
+    vs = bpy.context.scene.view_settings
+    for t in ("AgX", "Filmic"):
+        try:
+            vs.view_transform = t
+            break
+        except TypeError:
+            pass
+    return [o.name for o in coll.objects]
+
+
+def floor(size=40.0, color=(0.18, 0.18, 0.18), shadow_catcher=False):
+    """Ground plane under all meshes (optionally Cycles shadow catcher)."""
+    meshes = [o for o in bpy.context.scene.objects if o.type == "MESH" and o.name != "ADC_Floor"]
+    z = min((min((o.matrix_world @ Vector(c)).z for c in o.bound_box) for o in meshes), default=0.0)
+    o = bpy.data.objects.get("ADC_Floor") or primitive("plane", "ADC_Floor", size)
+    o.location.z = z
+    assign(o, material("ADC_Floor", color, 0.0, 0.6))
+    o.is_shadow_catcher = shadow_catcher
+    return o
+
+
+# ------------------------------------------------------------ animation
+def key(obj, frame, data_path=None, interp="BEZIER", easing="AUTO", **values):
+    """Set values and keyframe them: key(o, 1, location=(0,0,0), rotation_euler=(0,0,0))."""
+    for path, val in values.items():
+        setattr(obj, path, val)
+        obj.keyframe_insert(path, frame=frame)
+    if data_path:
+        obj.keyframe_insert(data_path, frame=frame)
+    set_interp(obj, interp, easing, frames=(frame,))
+    return obj
+
+
+def _fcurves(id_data):
+    ad = getattr(id_data, "animation_data", None)
+    act = ad.action if ad else None
+    if not act:
+        return []
+    if hasattr(act, "fcurves") and len(getattr(act, "fcurves", [])):
+        return list(act.fcurves)
+    out = []  # Blender 4.4+/5.x layered actions
+    for layer in getattr(act, "layers", []):
+        for strip in layer.strips:
+            for bag in getattr(strip, "channelbags", []):
+                out.extend(bag.fcurves)
+    return out
+
+
+def set_interp(obj, interp="BEZIER", easing="AUTO", frames=None, handle="AUTO_CLAMPED"):
+    """Interpolation for keys (BEZIER/LINEAR/CONSTANT/BACK/ELASTIC/BOUNCE...), easing EASE_IN/OUT/IN_OUT."""
+    for fc in _fcurves(obj):
+        for kp in fc.keyframe_points:
+            if frames is None or int(round(kp.co.x)) in frames:
+                kp.interpolation = interp
+                kp.easing = easing
+                if interp == "BEZIER":
+                    kp.handle_left_type = kp.handle_right_type = handle
+    return obj
+
+
+def loop(obj, mode="REPEAT"):
+    """Endless loop: Cycles F-curve modifier on every channel (idle, walk cycles, rotors)."""
+    for fc in _fcurves(obj):
+        if not any(m.type == "CYCLES" for m in fc.modifiers):
+            m = fc.modifiers.new("CYCLES")
+            m.mode_before = m.mode_after = mode
+    return obj
+
+
+def shake(obj, path="location", strength=0.05, scale=12.0, axes=(0, 1, 2), seed=0):
+    """Organic noise (camera shake, hover, breathing) via Noise F-modifier; keys path first if needed."""
+    if not any(fc.data_path == path for fc in _fcurves(obj)):
+        obj.keyframe_insert(path, frame=bpy.context.scene.frame_start)
+    for fc in _fcurves(obj):
+        if fc.data_path == path and fc.array_index in axes:
+            m = fc.modifiers.new("NOISE")
+            m.strength, m.scale, m.phase = strength, scale, seed * 7.3 + fc.array_index * 13.1
+    return obj
+
+
+def orbit(target=None, frames=120, turns=1.0, elevation=20.0, lens=50.0, margin=1.4):
+    """Turntable camera: empty at target center rotates linearly; camera parented and framed."""
+    objs = [target] if target else None
+    cam = camera(objs, lens, (0, elevation), margin)
+    center, _ = _bounds(objs or _subjects())
+    piv = bpy.data.objects.get("ADC_Orbit") or link(bpy.data.objects.new("ADC_Orbit", None))
+    piv.location = center
+    cam.parent = piv
+    cam.matrix_parent_inverse = piv.matrix_world.inverted()
+    sc = bpy.context.scene
+    sc.frame_start, sc.frame_end = 1, frames
+    key(piv, 1, interp="LINEAR", rotation_euler=(0, 0, 0))
+    key(piv, frames + 1, interp="LINEAR", rotation_euler=(0, 0, math.tau * turns))
+    return cam
+
+
+def follow_path(obj, points, frames=(1, 120), cyclic=False, follow=True):
+    """Move obj along a smooth NURBS path through points over frames."""
+    cu = bpy.data.curves.new("ADC_Path", "CURVE")
+    cu.dimensions = "3D"
+    sp = cu.splines.new("NURBS")
+    sp.points.add(len(points) - 1)
+    for p, co in zip(sp.points, points):
+        p.co = (*co, 1)
+    sp.use_endpoint_u, sp.use_cyclic_u, sp.order_u = True, cyclic, min(4, len(points))
+    cu.path_duration = frames[1] - frames[0]
+    path = link(bpy.data.objects.new("ADC_Path", cu))
+    c = obj.constraints.new("FOLLOW_PATH")
+    c.target, c.use_curve_follow, c.forward_axis = path, follow, "FORWARD_Y"
+    c.offset_factor = 0.0
+    c.use_fixed_location = True
+    obj.keyframe_insert('constraints["%s"].offset_factor' % c.name, frame=frames[0])
+    c.offset_factor = 1.0
+    obj.keyframe_insert('constraints["%s"].offset_factor' % c.name, frame=frames[1])
+    return path
+
+
+def bounce(obj, height=2.0, start=1, period=24, count=4, squash=0.25):
+    """Classic bouncing with decay plus squash & stretch on contact (12 principles)."""
+    z0 = obj.location.z
+    f = start
+    for i in range(count):
+        h = height * (0.6 ** i)
+        key(obj, f, location=(obj.location.x, obj.location.y, z0), scale=(1 + squash, 1 + squash, 1 - squash))
+        key(obj, f + 2, scale=(1, 1, 1))
+        key(obj, f + period // 2, location=(obj.location.x, obj.location.y, z0 + h), scale=(1 - squash / 3, 1 - squash / 3, 1 + squash / 3))
+        f += period
+        period = max(8, int(period * 0.8))
+    key(obj, f, location=(obj.location.x, obj.location.y, z0), scale=(1, 1, 1))
+    return f
+
+
+def human_rig(name="ADC_Rig", location=(0, 0, 0), generate=True):
