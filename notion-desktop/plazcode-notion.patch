+    return Call("/api/notion/action", { action: Action, value: Value === undefined ? null : Value }).then(function (R) { Msg(R.message || "OK"); Poll(); }).catch(function (E) { Msg(E.message || String(E)); });
+  }
+  function Wire() {
+    document.querySelectorAll("[data-ncopy]").forEach(function (B) { B.onclick = function () { if (Last) Copy(Last[B.getAttribute("data-ncopy")]); }; });
+    var On = function (Id, Fn) { var El = $(Id); if (El) El.onclick = Fn; };
+    On("nShowToken", function () { ShowToken = !ShowToken; $("nShowToken").textContent = ShowToken ? "Verbergen" : "Anzeigen"; if (Last) Render(Last); });
+    On("nRestart", function () { Act("restart_ngrok"); });
+    On("nRefreshTools", function () { Act("refresh_tools"); });
+    On("nNewToken", function () { if (confirm("Neuen Token erstellen? Die bestehende Verbindung in Notion muss danach mit dem neuen Token aktualisiert werden.")) Act("regenerate_token"); });
+    On("nSaveDomain", function () { Act("set_domain", $("nDomain").value); });
+    On("nSavePath", function () { Act("set_ngrok_path", $("nNgrokPath").value); });
+    var C = $("nEnabled"); if (C) C.onchange = function () { Act("toggle_ngrok", C.checked); };
+    Poll();
+    setInterval(function () {
+      var Visible = document.querySelector("#page-notion.active, #page-home.active");
+      if (Visible || !Last) Poll();
+    }, 2500);
+  }
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", Wire); else Wire();
+}());
+</script>
+
 </body>
 </html>
