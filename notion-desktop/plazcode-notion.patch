+    let tgt=open_target(port,&url).await?;
+    let ws=match target_ws_by_id(port,&tgt,20).await{Ok(w)=>w,Err(e)=>{close_target(port,&tgt).await;return Err(e);}};
+    if let Some(th)=&thread{for _ in 0..20{if url_tid(ws_eval(&ws,"location.href").await.ok().and_then(|v|v.as_str().map(String::from)).unwrap_or_default().as_str())==*th{break;}tokio::time::sleep(Duration::from_millis(500)).await;}}
+    if let Err(e)=ws_send_prompt(&ws,thread.as_deref(),&prompt_for_slot(&t,k)).await{close_target(port,&tgt).await;return Err(e);}
+    let mut tid=thread.clone().unwrap_or_default();
+    for _ in 0..40{if !tid.is_empty(){break;}tid=url_tid(ws_eval(&ws,"location.href").await.ok().and_then(|v|v.as_str().map(String::from)).unwrap_or_default().as_str());if tid.is_empty(){tokio::time::sleep(Duration::from_millis(500)).await;}}
+    if tid.is_empty(){close_target(port,&tgt).await;return Err("Notion hat dem neuen Chat keine ID gegeben.".into());}
