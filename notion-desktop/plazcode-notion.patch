+async fn send(text: String, files: Vec<String>) -> Result<Value, String> {
+    let mut text = text; let mut files = files;
+    if !files.is_empty() { text = format!("{}\n\n[Anhang von AdiCode] Die Datei(en) liegen auf dem PC in {}:\n{}\nGreife per AdiCode (files_*/pc_*-Tools) auf diese Pfade zu, um die Bilder oder Videos anzusehen.", text, uploads().display(), files.join("\n")); files.clear(); }
+    ensure_main().await?;
+    let mut s = Session::page().await?;
+    let st = s.eval(ROWS).await?;
+    if st["gen"].as_bool() == Some(true) { return Err("Notion AI antwortet noch. Warte kurz oder druecke Stopp.".into()); }
+    if s.eval("return !!__q('agent-chat-stop-recording-button');").await?.as_bool() == Some(true) {
+        let _ = s.eval("const b=__q('agent-chat-cancel-recording-button');if(b)b.click();return true;").await;
+        sleep(600).await;
+    }
+    s.eval(CLEAR).await?;
+    let mut warning = None;
+    if !files.is_empty() {
+        let r = s.call("Runtime.evaluate", json!({"expression": "document.querySelector('input[type=file]')"}), 10).await?;
+        let oid = r.pointer("/result/objectId").and_then(Value::as_str).ok_or("Das Datei-Feld von Notion wurde nicht gefunden.")?.to_string();
+        s.call("DOM.setFileInputFiles", json!({"files": files, "objectId": oid}), 30).await?;
+        sleep(1500).await;
+        let mut stable = 0;
+        let mut waited = 0u64;
+        loop {
+            let u = s.eval(UPLOAD_STATE).await?;
+            let busy = u["busy"].as_bool().unwrap_or(false);
+            let disabled = u["disabled"].as_bool().unwrap_or(true);
+            if !busy && !disabled { stable += 1; if stable >= 2 { break; } } else { stable = 0; }
+            if !busy && disabled && waited > 25_000 { warning = Some("Notion hat nicht alle Dateien angenommen (zu gross oder Format nicht unterstuetzt?)."); break; }
+            if waited > 300_000 { warning = Some("Upload dauert sehr lange; Nachricht wird trotzdem gesendet."); break; }
+            sleep(700).await;
+            waited += 700;
+        }
+    }
+    if !text.is_empty() {
+        let paste = format!("const c=__composer();if(!c)return false;c.focus();const dt=new DataTransfer();dt.setData('text/plain',{});c.dispatchEvent(new ClipboardEvent('paste',{{clipboardData:dt,bubbles:true,cancelable:true}}));await __sleep(250);return (c.innerText||'').trim().length>0;", js_str(&text));
+        if s.eval(&paste).await?.as_bool() != Some(true) {
+            let _ = s.eval("const c=__composer();if(c)c.focus();return !!c;").await;
+            s.call("Input.insertText", json!({"text": text}), 10).await?;
+        }
+        sleep(300).await;
+    }
+    submit(&mut s).await?;
+    Ok(json!({"ok": true, "warning": warning}))
+}
