--- /dev/null
+++ b/agent/src/notion_release.rs
@@ -0,0 +1,110 @@
+//! Release-Zug: Chats haengen fertige, getestete Aenderungen an das naechste Release eines anderen Chats an.
+//! Duenne Huelle um work\release-queue.ps1 (eine Quelle der Wahrheit fuer Skripte und Tool).
+use serde_json::{json, Value};
+use std::path::PathBuf;
+
+fn text(s: String) -> Value { json!({"content":[{"type":"text","text":s}]}) }
+fn err(s: String) -> Value { json!({"isError":true,"content":[{"type":"text","text":s}]}) }
+
+fn script() -> PathBuf {
+    if let Some(p) = std::env::var_os("ADICODE_RELEASE_QUEUE") { return PathBuf::from(p); }
+    let home = std::env::var_os("USERPROFILE").map(PathBuf::from).unwrap_or_default();
+    home.join("PlazCode-Shared").join("work").join("release-queue.ps1")
+}
+
+fn s<'a>(a: &'a Value, k: &str) -> &'a str { a[k].as_str().unwrap_or("").trim() }
+
+fn files(a: &Value) -> String {
+    match &a["files"] {
+        Value::Array(v) => v.iter().filter_map(|x| x.as_str()).map(|x| x.trim()).filter(|x| !x.is_empty()).collect::<Vec<_>>().join(","),
+        Value::String(t) => t.split(|c| c == ',' || c == ';' || c == '\n').map(|x| x.trim()).filter(|x| !x.is_empty()).collect::<Vec<_>>().join(","),
+        _ => String::new(),
+    }
+}
+
+/// Baut die Skript-Argumente; Fehlertext, wenn Pflichtfelder fehlen.
+pub(crate) fn build_args(a: &Value) -> Result<Vec<String>, String> {
+    let act = { let x = s(a, "action"); if x.is_empty() { "list" } else { x } };
+    let agent = s(a, "agent");
+    let mut v: Vec<String> = Vec::new();
+    let mut push = |k: &str, val: &str| { v.push(k.to_string()); v.push(val.to_string()); };
+    match act {
+        "list" => { return Ok(vec!["-List".into()]); }
+        "submit" => {
+            let (t, f, test) = (s(a, "title"), files(a), s(a, "test"));
+            if agent.is_empty() { return Err("agent fehlt (dein Chat-Name, z. B. Main1)".into()); }
+            if t.is_empty() || f.is_empty() { return Err("title und files angeben (files relativ zu build-src\\PlazCode, z. B. agent/src/notion_blender.rs)".into()); }
+            if test.is_empty() { return Err("test fehlt: nur GETESTETE Aenderungen einreichen (womit getestet + Ergebnis, z. B. 'cargo test --release notion_blender: 12 ok')".into()); }
+            push("-Agent", agent); push("-Title", t); push("-Files", &f); push("-Test", test);
+            let from = s(a, "from"); if !from.is_empty() { push("-From", from); }
+            let notes = s(a, "notes"); if !notes.is_empty() { push("-Notes", notes); }
+            v.insert(0, "-Submit".into());
+        }
+        "apply" => { if agent.is_empty() { return Err("agent fehlt (wer releast)".into()); } push("-Agent", agent); v.insert(0, "-Apply".into()); }
+        "released" => { let ver = s(a, "version"); if ver.is_empty() { return Err("version fehlt".into()); } push("-Version", ver); if !agent.is_empty() { push("-Agent", agent); } v.insert(0, "-Released".into()); }
+        "reject" | "withdraw" => {
+            let id = s(a, "id"); if id.is_empty() { return Err("id fehlt (z. B. q3, siehe action=list)".into()); }
+            push("-Id", id); push("-Reason", { let r = s(a, "reason"); if r.is_empty() { "ohne Angabe" } else { r } });
+            v.insert(0, if act == "reject" { "-Reject".into() } else { "-Withdraw".into() });
+        }
+        other => return Err(format!("Unbekannte action '{other}' (list, submit, apply, released, reject, withdraw)")),
+    }
+    Ok(v)
+}
+
+fn run(args: Vec<String>) -> Value {
+    let sc = script();
+    if !sc.exists() { return err(format!("Release-Zug-Skript fehlt: {}", sc.display())); }
+    let mut c = std::process::Command::new("powershell");
+    c.args(["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File"]).arg(&sc).args(&args);
+    #[cfg(windows)] { use std::os::windows::process::CommandExt; c.creation_flags(0x0800_0000); }
+    match c.output() {
+        Ok(o) => {
+            let mut out = String::from_utf8_lossy(&o.stdout).trim().to_string();
+            let e = String::from_utf8_lossy(&o.stderr).trim().to_string();
+            if !e.is_empty() { if !out.is_empty() { out.push('\n'); } out.push_str(&e); }
+            if out.is_empty() { out = "(keine Ausgabe)".into(); }
+            if o.status.success() && e.is_empty() { text(out) } else { err(out) }
+        }
+        Err(e) => err(format!("powershell konnte nicht gestartet werden: {e}")),
+    }
+}
+
+pub(crate) fn tools() -> Vec<Value> { vec![json!({
+    "name": "release_queue",
+    "description": "Release-Zug fuer mehrere Chats/Tabs. Du hast fertige, GETESTETE Aenderungen, aber ein anderer Chat baut gerade/ist mit dem Release dran (siehe [AdiCode-Release]-Hinweis bzw. adicode_status -> release)? Dann NICHT parallel releasen, sondern action=submit (Dateien werden eingefroren und mit dem naechsten Release mitgenommen, danach cowork_message an den Release-Chat). Wer releast: VOR dem Patch action=apply (uebernimmt alles nach build-src + git add, erkennt Konflikte), dann bauen/testen, Changelog-Zeilen uebernehmen; bei rotem Test action=reject. release-status.ps1 -Check stoppt jeden Release, solange Beitraege warten. action=list zeigt den Zug.",
+    "inputSchema": {"type":"object","properties":{
+        "action":{"type":"string","enum":["list","submit","apply","released","reject","withdraw"]},
+        "agent":{"type":"string","description":"Dein Chat-Name (z. B. Main1)"},
+        "title":{"type":"string"},
+        "files":{"type":"array","items":{"type":"string"},"description":"Pfade relativ zu build-src\\PlazCode, z. B. agent/src/notion_blender.rs"},
+        "from":{"type":"string","description":"Ordner mit den fertigen Dateien (gleiche Dateinamen). Leer = aktuelle build-src-Dateien einfrieren"},
+        "test":{"type":"string","description":"Pflicht bei submit: womit getestet + Ergebnis"},
+        "notes":{"type":"string","description":"Changelog-Zeile(n) fuer README/HANDOUT"},
+        "version":{"type":"string"},"id":{"type":"string"},"reason":{"type":"string"}
+    }}
+})] }
+
+pub(crate) fn call(name: &str, args: &Value) -> Option<Value> {
+    if name != "release_queue" { return None; }
+    Some(match build_args(args) { Ok(v) => run(v), Err(e) => err(e) })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn list_default() { assert_eq!(build_args(&json!({})).unwrap(), vec!["-List"]); }
+    #[test] fn submit_needs_test() { assert!(build_args(&json!({"action":"submit","agent":"A","title":"t","files":["x.rs"]})).unwrap_err().contains("test")); }
+    #[test] fn submit_needs_agent() { assert!(build_args(&json!({"action":"submit","title":"t","files":["x.rs"],"test":"ok"})).is_err()); }
+    #[test] fn submit_args() {
+        let v = build_args(&json!({"action":"submit","agent":"A","title":"T","files":["a.rs"," b.py "],"test":"ok","from":"C:\\w"})).unwrap();
+        assert_eq!(v, vec!["-Submit","-Agent","A","-Title","T","-Files","a.rs,b.py","-Test","ok","-From","C:\\w"]);
+    }
+    #[test] fn files_string() { assert_eq!(files(&json!({"files":"a.rs; b.rs"})), "a.rs,b.rs"); }
+    #[test] fn reject_and_unknown() {
+        assert_eq!(build_args(&json!({"action":"reject","id":"q2","reason":"rot"})).unwrap(), vec!["-Reject","-Id","q2","-Reason","rot"]);
+        assert!(build_args(&json!({"action":"boom"})).is_err());
+        assert!(build_args(&json!({"action":"apply"})).is_err());
+    }
+    #[test] fn tool_listed() { assert_eq!(tools()[0]["name"], "release_queue"); assert!(call("x", &json!({})).is_none()); }
+}
