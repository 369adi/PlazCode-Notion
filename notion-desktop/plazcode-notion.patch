@@ -0,0 +1,93 @@
+//! AdiCode: development-methodology skills (brainstorm -> plan -> tdd -> review -> finish),
+//! plus verify, webapp-test, research, mcp-builder and toolbox. Inspired by obra/superpowers (MIT)
+//! and anthropics/skills (webapp-testing, mcp-builder); condensed and rewritten for AdiCode tools.
+
+pub(crate) const BRAINSTORM: &str = r#"Use BEFORE writing any code for a new feature/app or a vague request.
+1. Restate the goal in 1-2 sentences. Read project_memory_open + HANDOUT.md and the existing code first.
+2. Ask only the questions that change the design (target platform, users, data, constraints, must-haves). Max 3-5, one batch.
+3. Propose 2-3 approaches with effort, risks and your recommendation. YAGNI: cut everything not needed for the first working version.
+4. Present the design in short sections (architecture, data model, UI flow, interfaces, error handling, testing). Get explicit OK per section for big work.
+5. Save the approved design as docs/design/<date>-<topic>.md in the repo and note it in HANDOUT.md. Then load skill plan."#;
+
+pub(crate) const PLAN: &str = r#"Use with an approved design. Output a plan a junior dev with zero context could follow.
+- Split into bite-sized tasks (2-5 minutes each). Each task: exact file paths, what to change (code sketch or full code), the test to write first, the command to verify, expected result.
+- Order: walking skeleton first (build runs, app starts), then vertical slices. Mark real dependencies only.
+- Every task ends green: build + tests + lint pass, then a small commit (skill git).
+- Save as docs/plans/<date>-<topic>.md. For Co-Work: each task maps 1:1 to a cowork task (role, files, review).
+- Execute task by task; after each task re-read the plan, tick it off, and stop to ask if reality diverges from the plan."#;
+
+pub(crate) const TDD: &str = r#"RED-GREEN-REFACTOR, strictly.
+1. RED: write ONE failing test for the next behaviour. Run it and SEE it fail for the right reason (not a typo/import error).
+2. GREEN: write the minimal code to pass. Run the test, see it pass. Run the whole suite.
+3. REFACTOR: clean names/duplication with tests green. Commit.
+Rules
+- No production code without a failing test first (exception: pure UI layout, config, spikes - delete spikes afterwards).
+- Test behaviour through public interfaces, not internals. One assertion idea per test; descriptive names.
+- Mocks only at boundaries (network, time, filesystem, randomness). Prefer real objects and in-memory fakes.
+- A bug fix starts with a test that reproduces the bug.
+Runners: Vitest/Jest (JS/TS), pytest (Python), cargo test (Rust), TestEZ/execute_luau checks (Roblox). Run via pc_PowerShell with a timeout; long runs in the background with a log file."#;
+
+pub(crate) const REVIEW: &str = r#"Code review between tasks and before finishing. Review the diff (git_git_diff / git diff main...HEAD), not your memory.
+Check in this order and report by severity (CRITICAL blocks progress, IMPORTANT fix now, MINOR optional):
+1. Correctness vs plan/acceptance criteria; edge cases (empty, null, huge, concurrent, offline).
+2. Security: input validation, auth checks, secrets in code/logs, injection (SQL/shell/HTML), unsafe deserialization.
+3. Tests: does every new behaviour have a test? Do tests actually fail without the change?
+4. Design: single responsibility, naming, duplication, dead code, error handling, no silent catch.
+5. Performance hot spots, resource leaks (listeners, connections, timers).
+6. UX: loading/error/empty states, accessibility, copy.
+Output: numbered findings with file:line, why it matters, concrete fix. Then verdict: approve / changes required. When receiving review: verify each point technically before applying; push back with reasons if a point is wrong."#;
+
+pub(crate) const FINISH: &str = r#"When all plan tasks are done.
+1. Run skill verify (build, typecheck, lint, tests, production build). Everything must be green - do not claim done otherwise.
+2. Self-review the full branch diff with skill review.
+3. Update README/CHANGELOG/version, .env.example, HANDOUT.md; project_memory_update.
+4. Offer the user the options: merge into main locally, push + open a PR (github_create_pull_request), keep the branch, or discard. Never force-push or delete without explicit OK.
+5. Clean up: stop background dev servers, remove temp files/worktrees."#;
+
+pub(crate) const VERIFY: &str = r#"Evidence before claims: never say fixed/done/works without running the checks in THIS turn and quoting the result.
+Fastest: app_verify {action:"start", path:"work/<project>"} then app_verify {action:"status"} until FERTIG. Manual fallback:
+Detect the stack, then run (pc_PowerShell, cwd = project root, timeout 300; long jobs in background with log):
+- Node/TS: npm ci (if node_modules missing) ; npx tsc --noEmit ; npm run lint ; npm test -- --run ; npm run build
+- Python: python -m ruff check . ; python -m mypy . (if configured) ; python -m pytest -q
+- Rust: cargo fmt --check ; cargo clippy --all-targets -- -D warnings ; cargo test ; cargo build --release
+- Roblox: robloxstudio_get_script_analysis + get_output_log after a playtest
+- Web UI: skill webapp-test (screenshot + console errors)
+Report a compact table: check | result | first error. Fix failures one by one (skill debug), re-run only what failed, then everything once more."#;
+
+pub(crate) const WEBAPP_TEST: &str = r#"Test web apps for real with the browser_* (Playwright) tools.
+1. Start the dev server in the background (pc_PowerShell: Start-Process with output to a log), wait until the port answers.
+2. browser_browser_navigate to the URL; wait for network idle / browser_browser_wait_for a key text BEFORE inspecting.
+3. Reconnaissance first: browser_browser_snapshot (accessibility tree) to find real selectors/roles; take a screenshot.
+4. Act with role/text based targets (click, type, fill_form), then verify the expected text/state appears.
+5. Always read browser_browser_console_messages and browser_browser_network_requests: any error or 4xx/5xx = bug.
+6. Check mobile width (browser_browser_resize 390x844) and the empty/error/loading states.
+7. For repeatable tests write Playwright test files (npx playwright test) into the repo. Stop the dev server at the end."#;
+
+pub(crate) const RESEARCH: &str = r#"Look things up instead of guessing.
+- Library/framework APIs: context7_resolve-library-id then context7_query-docs (current versions!).
+- Web pages: fetch_fetch the best 2-3 known URLs (docs, release notes, issues) and read them; for JS/login pages use browser_*.
+- GitHub: github_search_code / github_search_issues for real-world usage and known bugs.
+- Prefer official docs, release notes and recent issues; note the date/version of what you read. Cite the URL in your answer."#;
+
+pub(crate) const MCP_BUILDER: &str = r#"Build a high-quality MCP server/tool (also for new AdiCode tools).
+1. Design for agents, not for APIs: few high-level, task-shaped tools (e.g. create_issue_with_labels) instead of 1:1 endpoint wrappers.
+2. Names: verb_noun, prefixed by service. Descriptions: what, when to use, what it returns, limits. Input schema with types, enums, defaults, examples.
+3. Outputs: concise, relevant fields only; pagination + a response size cap; human-readable text plus structured content.
+4. Errors: actionable messages that tell the agent what to do next ("file changed, read it again and pass expected_sha256").
+5. Annotations: readOnlyHint / destructiveHint / idempotentHint correctly set. Destructive actions need confirmation or snapshots.
+6. SDKs: TypeScript @modelcontextprotocol/sdk or Python FastMCP; stdio transport for local add-ons.
+7. Test with the MCP Inspector (npx @modelcontextprotocol/inspector) and write 5-10 realistic eval questions that require several tool calls.
+8. Register it in AdiCode: catalog entry in mcp_addons.rs or via add_server (command, args, env)."#;
+
+pub(crate) const TOOLBOX: &str = r#"Which AdiCode tool for what (pick the most precise one):
+- Understand code: serena_* (symbols, references, rename, symbol-level edits; activate the project first) > codebase_* (architecture graph, trace paths) > safe_search_files.
+- Read/write files: safe_read_file + safe_write_file (sha256-protected) or serena edits; files_* for directories.
+- Run things: pc_PowerShell (builds, tests, servers in background with logs). Checks: app_verify (background, status table).
+- Less context: adicode_profile app|roblox|blender|all hides unrelated tools.
+- Errors in production: sentry_* ; Postgres: postgres_* (read-only).
+- Docs/research: context7_*, fetch_fetch, github_search_*.
+- Data: sqlite_* (local SQLite DB in the shared folder: schema, queries).
+- UI checks: browser_* (skill webapp-test). Time zones/dates: time_*.
+- Planning: thinking_sequentialthinking for hard problems; skills brainstorm -> plan -> tdd -> review -> verify -> finish.
+- Memory: project_memory_* + HANDOUT.md (durable), memory_* (graph notes).
+If an add-on is missing: tell the user to enable it in the AdiCode app (Add-ons) and which key it needs."#;
diff --git a/agent/src/notion_updates.rs b/agent/src/notion_updates.rs
new file mode 100644
index 0000000..23ccabf
--- /dev/null
+++ b/agent/src/notion_updates.rs
@@ -0,0 +1,251 @@
+//! AdiCode: Update-Anzeige (GitHub-Releases des Forks) und ngrok-Ersteinrichtung.
+//! Installiert werden Updates vom Launcher (PlazCode-Notion.exe); die App zeigt sie nur an
+//! und kann per Datei `update-now` eine sofortige Pruefung anstossen.
+use axum::{extract::Query, response::IntoResponse, Json};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+const REPO: &str = "369adi/PlazCode-Notion";
+const TAG_PREFIX: &str = "notion-desktop-v";
+const NGROK_ZIP: &str = "https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-windows-amd64.zip";
+const CACHE_SECS: u64 = 600;
+
+static CACHE: Mutex<Option<(Instant, Value)>> = Mutex::new(None);
+
+fn cache() -> std::sync::MutexGuard<'static, Option<(Instant, Value)>> { CACHE.lock().unwrap_or_else(|e| e.into_inner()) }
+
+pub fn base_dir() -> PathBuf {
+    std::env::var_os("LOCALAPPDATA").map(PathBuf::from).unwrap_or_else(std::env::temp_dir).join("PlazCodeNotion")
+}
+
+pub fn current_version() -> String {
+    std::env::current_exe().ok()
+        .and_then(|e| e.parent().map(|d| d.join(".version")))
+        .and_then(|p| std::fs::read_to_string(p).ok())
+        .map(|s| s.trim().to_string())
+        .filter(|s| !s.is_empty())
+        .unwrap_or_else(|| "dev".into())
+}
+
+fn parse_ver(s: &str) -> Option<(u32, u32, u32)> {
+    let p = s.trim().split('.').map(|x| x.parse::<u32>().ok()).collect::<Option<Vec<u32>>>()?;
+    if p.is_empty() || p.len() > 4 { return None; }
+    Some((p[0], *p.get(1).unwrap_or(&0), *p.get(2).unwrap_or(&0)))
+}
+
+/// Abschnitt "## Neu in <version>" aus den Release-Notes (README) herausschneiden.
+fn notes_for(body: &str, version: &str) -> String {
+    let body = body.replace("\r\n", "\n");
+    let head = format!("## Neu in {version}");
+    let Some(rest) = body.match_indices(&head).map(|(i, _)| &body[i + head.len()..]).find(|r| !r.starts_with(|c: char| c.is_ascii_digit() || c == '.')) else { return String::new() };
+    let end = rest.find("\n## ").unwrap_or(rest.len());
+    rest[..end].trim().trim_start_matches(':').trim().to_string()
+}
+
+fn log_tail() -> String {
+    let raw = std::fs::read_to_string(base_dir().join("logs").join("launcher.log")).unwrap_or_default();
+    let lines: Vec<&str> = raw.lines().collect();
+    lines[lines.len().saturating_sub(8)..].join("\n")
+}
+
+fn client(secs: u64) -> Result<reqwest::Client, String> {
+    reqwest::Client::builder().timeout(Duration::from_secs(secs)).user_agent("PlazCode-Notion").build().map_err(|e| e.to_string())
+}
+
+async fn fetch_releases() -> Result<Vec<Value>, String> {
+    let r = client(15)?
+        .get(format!("https://api.github.com/repos/{REPO}/releases?per_page=15"))
+        .header("Accept", "application/vnd.github+json")
+        .send().await.map_err(|e| format!("GitHub nicht erreichbar: {e}"))?;
+    if !r.status().is_success() { return Err(format!("GitHub antwortet mit HTTP {}", r.status())); }
+    let list: Vec<Value> = r.json().await.map_err(|e| e.to_string())?;
+    let mut out: Vec<((u32, u32, u32), Value)> = list.into_iter().filter_map(|rel| {
+        if rel.get("draft").and_then(Value::as_bool).unwrap_or(false) { return None; }
+        let ver = rel.get("tag_name")?.as_str()?.strip_prefix(TAG_PREFIX)?.to_string();
+        let key = parse_ver(&ver)?;
+        let body = rel.get("body").and_then(Value::as_str).unwrap_or("");
+        let date = rel.get("published_at").and_then(Value::as_str).and_then(|d| d.get(..10)).unwrap_or("").to_string();
+        Some((key, json!({"version": ver, "date": date, "url": rel.get("html_url").cloned().unwrap_or(Value::Null), "notes": notes_for(body, &ver)})))
+    }).collect();
+    out.sort_by(|a, b| b.0.cmp(&a.0));
+    Ok(out.into_iter().map(|(_, v)| v).collect())
+}
+
+pub async fn info(force: bool) -> Value {
+    let current = current_version();
+    let cached = cache().as_ref().filter(|(t, _)| !force && t.elapsed().as_secs() < CACHE_SECS).map(|(_, v)| v.clone());
+    let mut v = match cached {
+        Some(v) => v,
+        None => match fetch_releases().await {
+            Ok(releases) => {
+                let latest = releases.first().and_then(|r| r["version"].as_str()).unwrap_or("").to_string();
+                let v = json!({"releases": releases, "latest": latest, "checked": chrono::Local::now().format("%H:%M:%S").to_string()});
+                *cache() = Some((Instant::now(), v.clone()));
+                v
+            }
+            Err(e) => { let mut old = cache().as_ref().map(|(_, v)| v.clone()).unwrap_or_else(|| json!({"releases": [], "latest": ""})); old["error"] = json!(e); old }
+        },
+    };
+    let available = match (parse_ver(v["latest"].as_str().unwrap_or("")), parse_ver(&current)) { (Some(l), Some(c)) => l > c, _ => false };
+    v["ok"] = json!(true);
+    v["current"] = json!(current);
+    v["update_available"] = json!(available);
+    v["log"] = json!(log_tail());
+    v
+}
+
+#[derive(Deserialize)]
+pub struct UpdatesQuery { #[serde(default)] force: Option<u8> }
+
+pub async fn updates_handler(Query(q): Query<UpdatesQuery>) -> impl IntoResponse {
+    Json(info(q.force.unwrap_or(0) == 1).await)
+}
+
+// ---------- ngrok-Ersteinrichtung ----------
+
+/// Liegt die ngrok.yml nur virtualisiert beim Store-ngrok, in %LOCALAPPDATA%\ngrok kopieren (sonst fehlt dem eigenen ngrok der Token).
+pub fn ensure_real_ngrok_config() {
+    let Some(la) = std::env::var_os("LOCALAPPDATA").map(PathBuf::from) else { return };
+    let real = la.join("ngrok").join("ngrok.yml");
+    if real.is_file() { return; }
+    if let Ok(rd) = std::fs::read_dir(la.join("Packages")) {
+        for e in rd.flatten() {
+            if !e.file_name().to_string_lossy().to_ascii_lowercase().starts_with("ngrok") { continue; }
+            let f = e.path().join("LocalCache").join("Local").join("ngrok").join("ngrok.yml");
+            if f.is_file() { let _ = std::fs::create_dir_all(la.join("ngrok")); let _ = std::fs::copy(&f, &real); return; }
+        }
+    }
+}
+
+pub fn has_authtoken() -> bool { !authtoken_mask().is_empty() }
+
+/// Gespeicherter Authtoken maskiert (z. B. "2abc...wxyz"), leer = keiner.
+pub fn authtoken_mask() -> String {
+    let env = |k: &str| std::env::var_os(k).map(PathBuf::from);
+    let mut files = Vec::new();
+    if let Some(la) = env("LOCALAPPDATA") {
+        files.push(la.join("ngrok").join("ngrok.yml"));
+        if let Ok(rd) = std::fs::read_dir(la.join("Packages")) {
+            for e in rd.flatten() { if e.file_name().to_string_lossy().to_ascii_lowercase().starts_with("ngrok") { files.push(e.path().join("LocalCache").join("Local").join("ngrok").join("ngrok.yml")); } }
+        }
+    }
+    if let Some(up) = env("USERPROFILE") {
+        files.push(up.join(".config").join("ngrok").join("ngrok.yml"));
+        files.push(up.join(".ngrok2").join("ngrok.yml"));
+    }
+    if let Some(ad) = env("APPDATA") { files.push(ad.join("ngrok").join("ngrok.yml")); }
+    for f in &files {
+        if let Ok(t) = std::fs::read_to_string(f) {
+            for l in t.lines() {
+                if let Some(v) = l.trim_start().strip_prefix("authtoken:") {
+                    let v = v.trim().trim_matches(|c| c == '"' || c == '\'');
+                    if v.len() > 15 && v.is_ascii() { return format!("{}…{}", &v[..4], &v[v.len() - 4..]); }
+                }
+            }
+        }
+    }
+    String::new()
+}
+
+fn hidden(cmd: &mut tokio::process::Command) -> &mut tokio::process::Command {
+    #[cfg(windows)]
+    { cmd.creation_flags(0x0800_0000); }
+    cmd
+}
+
+pub(crate) async fn install_ngrok() -> Result<String, String> {
+    let dir = base_dir();
+    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+    let zip = dir.join("ngrok-download.zip");
+    let bytes = client(240)?.get(NGROK_ZIP).send().await.map_err(|e| format!("Download fehlgeschlagen: {e}"))?
+        .error_for_status().map_err(|e| format!("Download fehlgeschlagen: {e}"))?
+        .bytes().await.map_err(|e| format!("Download fehlgeschlagen: {e}"))?;
+    if bytes.len() < 1_000_000 { return Err("Download unvollständig. Bitte nochmal versuchen.".into()); }
+    tokio::fs::write(&zip, &bytes).await.map_err(|e| e.to_string())?;
+    let tar = std::env::var_os("SystemRoot").map(|r| PathBuf::from(r).join("System32").join("tar.exe")).filter(|p| p.is_file()).unwrap_or_else(|| PathBuf::from("tar"));
+    let _ = tokio::task::spawn_blocking(crate::notion_mcp::stop_all_ngrok).await;
+    tokio::time::sleep(std::time::Duration::from_millis(700)).await;
+    let _ = std::fs::remove_file(dir.join("ngrok.exe"));
+    let mut cmd = tokio::process::Command::new(tar);
+    let st = hidden(cmd.arg("-xf").arg(&zip).arg("-C").arg(&dir)).status().await.map_err(|e| format!("Entpacken fehlgeschlagen: {e}"))?;
+    let _ = tokio::fs::remove_file(&zip).await;
+    let exe = dir.join("ngrok.exe");
+    if !st.success() || !exe.is_file() { return Err("ngrok konnte nicht entpackt werden.".into()); }
+    ensure_real_ngrok_config();
+    crate::notion_mcp::use_ngrok_exe(&exe);
+    crate::notion_mcp::restart_tunnel();
+    Ok(format!("ngrok installiert ({}). Jetzt den Authtoken eintragen.", exe.display()))
+}
+
+pub(crate) async fn set_authtoken(raw: &str) -> Result<String, String> {
+    let tok: String = raw.trim().chars().filter(|c| c.is_ascii_alphanumeric() || *c == '_' || *c == '-').collect();
+    if tok.len() < 20 { return Err("Das sieht nicht nach einem ngrok-Authtoken aus (dashboard.ngrok.com → Your Authtoken).".into()); }
+    let exe = crate::notion_mcp::ngrok_exe().ok_or("ngrok.exe fehlt – klicke zuerst auf „ngrok installieren“.")?;
+    let mut cmd = tokio::process::Command::new(exe);
+    let out = hidden(cmd.args(["config", "add-authtoken", tok.as_str()])).output().await.map_err(|e| e.to_string())?;
+    if !out.status.success() {
+        let err = String::from_utf8_lossy(&out.stderr).trim().chars().take(300).collect::<String>();
+        return Err(format!("ngrok meldet: {err}"));
+    }
+    crate::notion_mcp::restart_tunnel();
+    Ok("Authtoken gespeichert. Der Tunnel startet neu.".into())
+}
+
+/// Nur manuell (Knopf in AdiCode): sofort installieren. Laufende Notion-Chats werden nicht angefasst.
+async fn update_now() -> Result<String, String> {
+    let mut v = info(false).await;
+    if !v["update_available"].as_bool().unwrap_or(false) { v = info(true).await; }
+    if !v["update_available"].as_bool().unwrap_or(false) { return Ok(format!("Kein neues Update ({} ist aktuell).", current_version())); }
+    std::fs::create_dir_all(base_dir()).map_err(|e| e.to_string())?;
+    let trig = base_dir().join("update-now");
+    std::fs::write(&trig, "1").map_err(|e| e.to_string())?;
+    *cache() = None;
+    // Sofort-Update: der Launcher holt den Trigger binnen 1 s ab. Liegt er nach 4 s noch da
+    // (Launcher laeuft nicht), installiert die App das neue Release selbst.
+    tokio::spawn(async move {
+        tokio::time::sleep(Duration::from_secs(4)).await;
+        if !trig.is_file() { return; }
+        let _ = std::fs::remove_file(&trig);
+        if let Err(e) = direct_install().await { eprintln!("[updates] Direkt-Update: {e}"); }
+    });
+    Ok(format!("Update auf {} startet sofort - AdiCode schliesst sich und startet gleich neu.", v["latest"].as_str().unwrap_or("?")))
+}
+
+async fn direct_install() -> Result<(), String> {
+    let v = info(true).await;
+    if !v["update_available"].as_bool().unwrap_or(false) { return Err("kein neueres Release".into()); }
+    let url = format!("https://github.com/{}/releases/latest/download/PlazCode-Notion.exe", REPO);
+    let bytes = client(180)?.get(url).send().await.map_err(|e| e.to_string())?.error_for_status().map_err(|e| e.to_string())?.bytes().await.map_err(|e| e.to_string())?;
+    if bytes.len() < 1_000_000 || &bytes[..2] != b"MZ" { return Err("Download ist keine gueltige exe".into()); }
+    let p = std::env::temp_dir().join("AdiCode-update.exe");
+    std::fs::write(&p, &bytes).map_err(|e| e.to_string())?;
+    std::process::Command::new(&p).spawn().map_err(|e| e.to_string())?;
+    Ok(())
+}
+
+/// Aktionen der Notion-AI-/Updates-Seite. `None` = nicht zustaendig.
+pub async fn action(name: &str, v: &Value) -> Option<Result<String, String>> {
+    Some(match name {
+        "update_now" => update_now().await,
+        "install_ngrok" => install_ngrok().await,
+        "set_ngrok_authtoken" => set_authtoken(v.as_str().unwrap_or("")).await,
+        _ => return None,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn versions_and_notes() {
+        assert!(parse_ver("1.0.10") > parse_ver("1.0.9"));
+        assert_eq!(parse_ver("x"), None);
+        let body = "# T\r\n## Neu in 1.0.10: Updates\r\n- a\r\n## Neu in 1.0.1\r\n- b\r\n## Start\r\n";
+        assert_eq!(notes_for(body, "1.0.10"), "Updates\n- a");
+        assert_eq!(notes_for(body, "1.0.1"), "- b");
+        assert_eq!(notes_for(body, "1.0.2"), "");
+    }
+}
diff --git a/agent/src/roblox_helpers.luau b/agent/src/roblox_helpers.luau
new file mode 100644
index 0000000..a9fbbb6
--- /dev/null
+++ b/agent/src/roblox_helpers.luau
@@ -0,0 +1,313 @@
+-- Roblox Studio helpers adapted from Brickwire's BW library.
+local BW = {}
+local function service(name)
+	return game:GetService(name)
+end
+local function fail(message)
+	error("BW: " .. message, 0)
+end
+
+function BW.find(path, root)
+	if typeof(path) == "Instance" then return path end
+	if type(path) ~= "string" then return nil end
+	local current = root or game
+	for segment in string.gmatch(path, "[^%.]+") do
+		if current == game and segment == "game" then
+			continue
+		elseif current == game and (segment == "Workspace" or segment == "workspace") then
+			current = workspace
+		else
+			local next = current:FindFirstChild(segment)
+			if not next and current == game then
+				local ok, result = pcall(function() return service(segment) end)
+				if ok then next = result end
+			end
+			if not next then return nil end
+			current = next
+		end
+	end
+	return current
+end
+
+function BW.get(path)
+	local instance = BW.find(path)
+	if not instance then fail("not found: " .. tostring(path)) end
+	return instance
+end
+function BW.exists(path) return BW.find(path) ~= nil end
+function BW.color(value)
+	if typeof(value) == "Color3" then return value end
+	if type(value) == "string" then
+		local hex = string.gsub(value, "^#", "")
+		if #hex == 6 and string.match(hex, "^%x+$") then return Color3.fromHex(hex) end
+		return BrickColor.new(value).Color
+	end
+	if type(value) == "table" then
+		local r, g, b = value[1] or value.r or 0, value[2] or value.g or 0, value[3] or value.b or 0
+		if r > 1 or g > 1 or b > 1 then return Color3.fromRGB(r, g, b) end
+		return Color3.new(r, g, b)
+	end
+	fail("cannot convert color: " .. tostring(value))
+end
+function BW.v3(value)
+	if typeof(value) == "Vector3" then return value end
+	if type(value) == "table" then return Vector3.new(value[1] or value.x or 0, value[2] or value.y or 0, value[3] or value.z or 0) end
+	fail("cannot convert Vector3: " .. tostring(value))
+end
+function BW.udim2(value)
+	if typeof(value) == "UDim2" then return value end
+	if type(value) ~= "table" then fail("cannot convert UDim2") end
+	if #value == 2 then return UDim2.fromScale(value[1], value[2]) end
+	return UDim2.new(value[1] or 0, value[2] or 0, value[3] or 0, value[4] or 0)
+end
+
+function BW.set(instance, properties)
+	local function numberSequence(value)
+		if type(value) == "number" then return NumberSequence.new(value) end
+		if type(value) == "table" and type(value[1]) == "number" and #value == 2 then
