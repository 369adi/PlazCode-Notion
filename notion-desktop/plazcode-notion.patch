+function BW.leaderstats(stats)
+	local source = {"local Players=game:GetService(\"Players\")","Players.PlayerAdded:Connect(function(player)","\tlocal ls=Instance.new(\"Folder\"); ls.Name=\"leaderstats\"; ls.Parent=player"}
+	for key,value in pairs(stats) do
+		local name,start = if type(key)=="number" then tostring(value) else tostring(key), if type(key)=="number" then 0 else tonumber(value) or 0
+		table.insert(source,"\tlocal v=Instance.new(\"IntValue\"); v.Name="..string.format("%q",name).."; v.Value="..tostring(start).."; v.Parent=ls")
+	end
+	table.insert(source,"end)")
+	return BW.script("Script","Leaderstats","ServerScriptService",table.concat(source,"\n"))
+end
+function BW.killPart(part, damage)
+	part = type(part)=="string" and BW.get(part) or part
+	local value = damage or "math.huge"
+	local source = "local part=script.Parent\nlocal DAMAGE="..tostring(value).."\nlocal debounce={}\npart.Touched:Connect(function(hit)\n local hum=hit.Parent and hit.Parent:FindFirstChildOfClass(\"Humanoid\")\n if hum and not debounce[hum] then debounce[hum]=true; hum:TakeDamage(DAMAGE); task.wait(0.5); debounce[hum]=nil end\nend)"
