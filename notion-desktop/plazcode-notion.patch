+/// Erkennt die Studio-Meldung, dass der MCP-Helfer nach einem Studio-Update veraltet ist (Brickwire 1.8.1).
+fn proxy_out_of_date(text: &str) -> bool {
+    let t = text.to_ascii_lowercase();
+    t.contains("proxy is out of date") || t.contains("restart to update") || (t.contains("proxy") && t.contains("outdated"))
