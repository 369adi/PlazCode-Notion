@@ -0,0 +1,134 @@
+/* PlazCode Notion: live Co-Work panel (roles, agents, task status). */
+(function () {
+  try {
+    if (window.__PLAZCODE_COWORK_UI__) return;
+    window.__PLAZCODE_COWORK_UI__ = true;
+  } catch (e) { return; }
+
+  var LABEL = {
+    open: ["Offen", "#6b7280"], claimed: ["L\u00e4uft", "#2563eb"], review: ["In Pr\u00fcfung", "#7c3aed"],
+    done: ["Fertig", "#16a34a"], blocked: ["Blockiert", "#dc2626"], stale: ["H\u00e4ngt", "#ea580c"]
+  };
+  var open = false, timer = null, btn, panel, body, lastErr = "";
+
+  function esc(v) {
+    return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
+      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
+    });
+  }
+  function chip(phase) {
+    var l = LABEL[phase] || [phase, "#6b7280"];
+    return '<span class="pcw-chip" style="background:' + l[1] + '1f;color:' + l[1] + ';border-color:' + l[1] + '55">' + esc(l[0]) + "</span>";
+  }
+  function kindTag(k) { return k === "review" ? '<span class="pcw-kind">Review</span>' : k === "fix" ? '<span class="pcw-kind pcw-fix">Fix</span>' : ""; }
+
+  function render(data) {
+    var projects = (data && data.projects) || [];
+    var active = 0;
+    projects.forEach(function (p) { p.agents.forEach(function (a) { if (a.alive) active++; }); });
+    btn.querySelector(".pcw-badge").textContent = projects.length ? String(active) : "";
+    btn.classList.toggle("pcw-live", active > 0);
+    if (!open) return;
+    if (!projects.length) {
+      body.innerHTML = '<div class="pcw-empty"><b>Kein Co-Work-Projekt aktiv.</b><br>Im Main Chat schreiben: <code>Starte ein Co-Work-Projekt: &lt;Beschreibung&gt;</code><br>In weiteren Tabs: <code>Tritt Co-Work-Projekt p1 bei als Programmierer</code> (oder Code-Bewerter, UI/UX-Kritiker, Prompt-Schreiber, Tester, Roblox-Spezialist).</div>';
+      return;
+    }
+    var h = "";
+    projects.forEach(function (p) {
+      var pct = p.total ? Math.round((p.done / p.total) * 100) : 0;
+      h += '<section class="pcw-proj"><div class="pcw-ph"><div><b>' + esc(p.title) + '</b> <span class="pcw-id">' + esc(p.id) + "</span></div><div>" + p.done + "/" + p.total + " fertig</div></div>";
+      h += '<div class="pcw-bar"><i style="width:' + pct + '%"></i></div>';
+      if (p.goal) h += '<div class="pcw-goal">' + esc(p.goal) + "</div>";
+      if (p.missing_roles && p.missing_roles.length) h += '<div class="pcw-warn">Unbesetzte Rollen: ' + esc(p.missing_roles.join(", ")) + " &ndash; Tab mit dieser Rolle \u00f6ffnen (sonst springen andere ein).</div>";
+      h += '<div class="pcw-agents">';
+      p.agents.forEach(function (a) {
+        h += '<div class="pcw-agent' + (a.alive ? "" : " pcw-off") + '"><div><span class="pcw-dot"></span><b>' + esc(a.name) + "</b>" + (a.lead ? ' <span class="pcw-kind">Main</span>' : "") + '</div><div class="pcw-role">' + esc(a.role_title) + '</div><div class="pcw-cur">' + (a.task ? "#" + a.task.id + " " + esc(a.task.title) : a.alive ? "wartet" : "inaktiv") + "</div></div>";
+      });
+      h += "</div><table class=\"pcw-t\"><thead><tr><th>#</th><th>Task</th><th>Rolle</th><th>Status</th><th>Agent</th></tr></thead><tbody>";
+      p.tasks.forEach(function (t) {
+        h += '<tr title="' + esc(t.result) + '"><td>' + t.id + "</td><td>" + kindTag(t.kind) + esc(t.title) + (t.result ? '<div class="pcw-res">' + esc(t.result) + "</div>" : "") + "</td><td>" + esc(t.role_title || "\u2013") + "</td><td>" + chip(t.phase) + "</td><td>" + esc(t.owner || "\u2013") + "</td></tr>";
+      });
+      h += "</tbody></table></section>";
+    });
+    body.innerHTML = h;
+  }
+
+  function load() {
+    var b = window.__PLAZCODE_BOOT__;
+    if (!b) return;
+    var ctl = new AbortController();
+    var to = setTimeout(function () { ctl.abort(); }, 8000);
+    fetch(b.apiUrl + "/api/cowork", { headers: { Authorization: "Bearer " + b.key }, cache: "no-store", signal: ctl.signal })
+      .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
+      .then(function (d) { lastErr = ""; render(d); })
+      .catch(function (e) {
+        lastErr = (e && e.name === "AbortError") ? "Zeit\u00fcberschreitung" : String((e && e.message) || e);
+        if (open) body.innerHTML = '<div class="pcw-warn">Co-Work-Status nicht erreichbar: ' + esc(lastErr) + "</div>";
+      })
+      .then(function () { clearTimeout(to); });
+  }
+
+  function schedule() {
+    if (timer) clearInterval(timer);
+    timer = setInterval(load, open ? 1500 : 6000);
+  }
+
+  function toggle(force) {
+    open = typeof force === "boolean" ? force : !open;
+    panel.style.display = open ? "flex" : "none";
+    if (open) { body.innerHTML = '<div class="pcw-empty">Lade\u2026</div>'; load(); }
+    schedule();
+  }
+
+  function start() {
+    try {
+      var b = window.__PLAZCODE_BOOT__;
+      if (!b || !b.apiUrl || !b.key || document.getElementById("pcw-btn")) return;
+      var css = document.createElement("style");
+      css.textContent = [
+        "#pcw-btn{position:fixed;right:18px;bottom:18px;z-index:2147483000;display:flex;gap:7px;align-items:center;padding:9px 14px;border-radius:999px;border:1px solid #ffffff22;background:#1f2937;color:#fff;font:600 13px system-ui,Segoe UI,sans-serif;cursor:pointer;box-shadow:0 6px 20px #0006}",
+        "#pcw-btn.pcw-live{background:#4f46e5}",
+        "#pcw-btn .pcw-badge{min-width:18px;padding:0 5px;border-radius:9px;background:#ffffff33;font-size:11px;text-align:center}",
+        "#pcw-btn .pcw-badge:empty{display:none}",
+        "#pcw-panel{position:fixed;right:18px;bottom:66px;z-index:2147483000;width:min(760px,calc(100vw - 36px));max-height:calc(100vh - 110px);display:none;flex-direction:column;border-radius:14px;background:#111827;color:#e5e7eb;border:1px solid #374151;box-shadow:0 18px 50px #000a;font:13px system-ui,Segoe UI,sans-serif}",
+        "#pcw-panel header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:1px solid #374151;font-weight:700;font-size:14px}",
+        "#pcw-panel header button{background:none;border:0;color:#9ca3af;font-size:18px;cursor:pointer}",
+        "#pcw-body{overflow:auto;padding:12px 16px 16px}",
+        ".pcw-proj{margin-bottom:18px}.pcw-ph{display:flex;justify-content:space-between;gap:10px;margin-bottom:6px}",
+        ".pcw-id{color:#9ca3af;font-size:11px}.pcw-goal{color:#9ca3af;margin:6px 0}",
+        ".pcw-bar{height:6px;border-radius:3px;background:#374151;overflow:hidden}.pcw-bar i{display:block;height:100%;background:linear-gradient(90deg,#6366f1,#22c55e)}",
+        ".pcw-warn{margin:8px 0;padding:8px 10px;border-radius:8px;background:#7c2d1233;border:1px solid #ea580c66;color:#fdba74}",
+        ".pcw-agents{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin:10px 0}",
+        ".pcw-agent{padding:8px 10px;border-radius:10px;background:#1f2937;border:1px solid #374151}.pcw-off{opacity:.5}",
+        ".pcw-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e;margin-right:6px}.pcw-off .pcw-dot{background:#6b7280}",
+        ".pcw-role{color:#a5b4fc;font-size:12px;margin-top:2px}.pcw-cur{color:#9ca3af;font-size:12px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
+        ".pcw-t{width:100%;border-collapse:collapse}.pcw-t th{text-align:left;color:#9ca3af;font-weight:600;padding:6px;border-bottom:1px solid #374151}",
+        ".pcw-t td{padding:6px;border-bottom:1px solid #1f2937;vertical-align:top}",
+        ".pcw-res{color:#9ca3af;font-size:11px;margin-top:2px;max-width:340px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
+        ".pcw-chip{display:inline-block;padding:2px 8px;border-radius:999px;border:1px solid;font-size:11px;font-weight:600;white-space:nowrap}",
+        ".pcw-kind{display:inline-block;margin-right:5px;padding:0 5px;border-radius:4px;background:#7c3aed33;color:#c4b5fd;font-size:10px;font-weight:700}.pcw-fix{background:#ea580c33;color:#fdba74}",
+        ".pcw-empty{color:#9ca3af;line-height:1.7}.pcw-empty code{background:#1f2937;padding:1px 5px;border-radius:4px;color:#e5e7eb}"
+      ].join("\n");
+      document.head.appendChild(css);
+      btn = document.createElement("button");
+      btn.id = "pcw-btn";
+      btn.type = "button";
+      btn.innerHTML = 'Co-Work <span class="pcw-badge"></span>';
+      btn.addEventListener("click", function () { toggle(); });
+      panel = document.createElement("div");
+      panel.id = "pcw-panel";
+      panel.innerHTML = '<header><span>Co-Work &ndash; Live-Status</span><button type="button" aria-label="Schlie\u00dfen">\u00d7</button></header><div id="pcw-body"></div>';
+      panel.querySelector("header button").addEventListener("click", function () { toggle(false); });
+      body = panel.querySelector("#pcw-body");
+      document.body.appendChild(panel);
+      document.body.appendChild(btn);
+      load();
+      schedule();
+    } catch (e) {
+      try { console.warn("PlazCode Co-Work panel:", e); } catch (_) {}
+    }
+  }
+
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
+  else start();
+})();
