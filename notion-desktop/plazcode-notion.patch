+/// Startet bei Bedarf den Main-Tab (Konto 1 aus Co-Work), wartet auf Notion AI und
+/// verbindet einmalig den AdiCode-MCP, damit Co-Work-Tools im Chat verfuegbar sind.
+async fn ensure_main() -> Result<(), String> {
+    CHAT_USED.store(true, Ordering::SeqCst);
+    let _guard = ENSURE.lock().await;
+    let t = main_tab()?;
+    let mut launched = false;
+    if !browser_up().await {
+        np::launch(&t, np::NOTION_URL)?;
+        launched = true;
+        let mut up = false;
+        for _ in 0..60 { sleep(500).await; if browser_up().await { up = true; break; } }
+        if !up { return Err("Das Main-Fenster startet nicht (kein CDP auf Port 9301).".into()); }
+    }
+    let mut page = None;
+    for _ in 0..40 { if let Ok(s) = Session::page().await { page = Some(s); break; } sleep(500).await; }
+    let mut s = match page {
+        Some(s) => s,
+        None => {
+            np::windows::set_hidden(std::slice::from_ref(&t), false);
+            return Err("Im Main-Fenster ist keine Notion-Seite offen (Login?). Bitte dort bei Notion anmelden.".into());
