+
+/// Writes adicode_blender.py into every Blender user scripts/modules folder
+/// (importable as `import adicode_blender`) plus a copy under LOCALAPPDATA.
+pub(crate) fn install_helpers() -> Vec<String> {
+    let mut done = Vec::new();
+    let mut targets: Vec<PathBuf> = user_versions().into_iter().map(|v| v.join("scripts").join("modules")).collect();
+    targets.push(local());
+    for dir in targets {
+        let file = dir.join("adicode_blender.py");
+        if std::fs::read_to_string(&file).map(|s| s == HELPERS).unwrap_or(false) { done.push(file.display().to_string()); continue; }
+        if std::fs::create_dir_all(&dir).is_ok() && std::fs::write(&file, HELPERS).is_ok() { done.push(file.display().to_string()); }
+    }
+    done
+}
+
+fn port_open(port: u16) -> bool {
+    std::net::TcpStream::connect_timeout(&std::net::SocketAddr::from(([127, 0, 0, 1], port)), Duration::from_millis(400)).is_ok()
+}
+
+fn list_names(dir: &Path) -> Vec<String> {
+    let mut v: Vec<String> = std::fs::read_dir(dir).map(|rd| rd.flatten().map(|e| e.file_name().to_string_lossy().to_string()).filter(|n| !n.starts_with("__") && !n.starts_with('.')).collect()).unwrap_or_default();
+    v.sort();
+    v
+}
+
+fn doctor() -> String {
+    let mut s = String::from("Blender-Doctor (AdiCode)\n");
+    let exes = blender_exes();
+    if exes.is_empty() { s.push_str("- Blender: NICHT gefunden (blender.org/download, 5.2 LTS empfohlen)\n"); }
+    for e in &exes { s.push_str(&format!("- Blender: {}\n", e.display())); }
+    let running = hidden(Command::new("tasklist").args(["/FI", "IMAGENAME eq blender.exe", "/NH"])).output().map(|o| String::from_utf8_lossy(&o.stdout).to_ascii_lowercase().contains("blender.exe")).unwrap_or(false);
+    s.push_str(&format!("- Blender laeuft: {}\n", if running { "ja" } else { "nein" }));
+    s.push_str(&format!("- MCP-Addon-Port 9876: {}\n", if port_open(9876) { "offen (verbunden)" } else { "zu -> in Blender N-Panel 'MCP for Blender' Server starten" }));
+    for v in user_versions() {
+        let ver = v.file_name().map(|x| x.to_string_lossy().to_string()).unwrap_or_default();
+        let addons = list_names(&v.join("scripts").join("addons"));
+        let ext = list_names(&v.join("extensions").join("blender_org"));
+        let helper = v.join("scripts").join("modules").join("adicode_blender.py").is_file();
+        s.push_str(&format!("- Profil {ver}: addons={:?} extensions={:?} adicode_blender={}\n", addons, ext, if helper { "ok" } else { "fehlt" }));
+    }
+    let uvx = std::env::var_os("USERPROFILE").map(|p| PathBuf::from(p).join(".local").join("bin").join("uvx.exe")).filter(|p| p.is_file());
+    s.push_str(&format!("- uvx: {}\n", uvx.map(|p| p.display().to_string()).unwrap_or_else(|| "nicht im Standardpfad (uv installieren)".into())));
+    let gpu = hidden(Command::new("nvidia-smi").args(["--query-gpu=name,memory.total,driver_version", "--format=csv,noheader"])).output().ok().filter(|o| o.status.success()).map(|o| String::from_utf8_lossy(&o.stdout).trim().to_string());
+    s.push_str(&format!("- GPU: {}\n", gpu.unwrap_or_else(|| "keine NVIDIA-GPU erkannt".into())));
+    s.push_str(&format!("- ComfyUI (Port 8188): {}\n", if port_open(8188) { "laeuft" } else { "aus (fuer lokale Texturen/Image-to-3D comfyui_* nutzen)" }));
+    let log = local().join("setup.log");
+    if let Ok(t) = std::fs::read_to_string(&log) {
+        let tail: Vec<&str> = t.lines().filter(|l| l.contains("ENABLED") || l.contains("FAIL") || l.contains("COMPUTE") || l.contains("PREFS") || l.contains("Installed") || l.contains("STEP")).collect();
+        s.push_str(&format!("- Letztes Setup ({}):\n  {}\n", log.display(), tail.join("\n  ")));
+    }
+    s.push_str("Naechste Schritte: blender_pro action=setup (Extensions + GPU + Helfer), dann adicode_skill blender.");
+    s
+}
+
+fn setup() -> String {
+    let helpers = install_helpers();
+    let Some(exe) = blender_exes().last().cloned() else { return "Blender nicht gefunden. Erst Blender installieren.".into() };
+    let dir = local();
+    let _ = std::fs::create_dir_all(&dir);
+    let py = dir.join("setup_prefs.py");
+    let _ = std::fs::write(&py, SETUP_PY);
+    let log = dir.join("setup.log");
+    let exe2 = exe.clone();
+    std::thread::spawn(move || {
+        let mut out = String::new();
+        for name in user_versions() {
+            let e = name.join("extensions");
+            let _ = std::fs::create_dir_all(e.join("blender_org"));
+            let _ = std::fs::create_dir_all(e.join("user_default"));
+        }
+        out.push_str("STEP extensions\n");
+        if let Ok(o) = hidden(Command::new(&exe2).args(["--online-mode", "--command", "extension", "install", "-s", "-e", EXTENSIONS])).output() {
+            out.push_str(&String::from_utf8_lossy(&o.stdout)); out.push_str(&String::from_utf8_lossy(&o.stderr));
+        }
+        out.push_str("\nSTEP prefs\n");
+        if let Ok(o) = hidden(Command::new(&exe2).args(["-b", "--python"]).arg(&py)).output() {
+            out.push_str(&String::from_utf8_lossy(&o.stdout)); out.push_str(&String::from_utf8_lossy(&o.stderr));
+        }
+        out.push_str("\nSTEP done\n");
+        let _ = std::fs::write(&log, out);
+    });
+    format!("Setup laeuft im Hintergrund mit {} (Extensions {EXTENSIONS}; Rigify, Node Wrangler, FBX/glTF/BVH aktiv; Cycles-GPU OptiX/CUDA; 64 Undo-Schritte). Helfer installiert: {}. In ~1-2 min blender_pro action=doctor pruefen. Hinweis: Laeuft Blender gerade, Blender danach neu starten (sonst ueberschreibt es die Einstellungen beim Beenden).", exe.display(), helpers.join(", "))
+}
+
+fn helpers_doc() -> String {
+    let mut lines = Vec::new();
+    let mut it = HELPERS.lines().peekable();
+    while let Some(l) = it.next() {
+        if let Some(rest) = l.strip_prefix("def ") {
+            if rest.starts_with('_') { continue; }
+            let sig = rest.trim_end_matches(':');
+            let doc = it.peek().map(|d| d.trim().trim_matches('"').to_string()).filter(|d| !d.is_empty() && !d.starts_with("for ") && !d.contains('=')).unwrap_or_default();
+            lines.push(format!("- A.{sig}  {doc}"));
+        }
+    }
+    format!("In execute_blender_code zuerst:\nimport adicode_blender as A, importlib; importlib.reload(A)\n(Fehlt das Modul: blender_pro action=install_helpers. Fallback: import sys; sys.path.insert(0, r'{}'); import adicode_blender as A)\nAusgaben landen in %USERPROFILE%\\PlazCode-Shared\\blender-out.\n\nFunktionen:\n{}", local().display(), lines.join("\n"))
+}
+
+// ---------------------------------------------------------------- capture
+// blender_capture: renders views of the scene offscreen. Uses the running
+// GUI Blender (blender-mcp on 9876, window may be minimised/hidden) or a
+// hidden background Blender (-b) on 9877 - no window ever needed.
+pub(crate) const HEADLESS: &str = include_str!("blender_headless.py");
+const GUI_PORT: u16 = 9876;
+const HL_PORT: u16 = 9877;
+
+fn capture_dir() -> PathBuf {
+    std::env::var_os("USERPROFILE").map(PathBuf::from).unwrap_or_else(std::env::temp_dir).join("PlazCode-Shared").join("blender-out").join("captures")
+}
+
+fn b64(data: &[u8]) -> String {
+    const T: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut o = String::with_capacity((data.len() + 2) / 3 * 4);
+    for c in data.chunks(3) {
+        let n = ((c[0] as u32) << 16) | ((*c.get(1).unwrap_or(&0) as u32) << 8) | *c.get(2).unwrap_or(&0) as u32;
+        o.push(T[(n >> 18 & 63) as usize] as char);
+        o.push(T[(n >> 12 & 63) as usize] as char);
+        o.push(if c.len() > 1 { T[(n >> 6 & 63) as usize] as char } else { '=' });
+        o.push(if c.len() > 2 { T[(n & 63) as usize] as char } else { '=' });
+    }
+    o
+}
+
+fn bl_send(port: u16, cmd: &Value, secs: u64) -> Result<Value, String> {
+    use std::io::{Read, Write};
+    let addr = std::net::SocketAddr::from(([127, 0, 0, 1], port));
+    let mut s = std::net::TcpStream::connect_timeout(&addr, Duration::from_secs(2)).map_err(|e| format!("Blender auf Port {port} nicht erreichbar: {e}"))?;
+    let _ = s.set_read_timeout(Some(Duration::from_secs(secs)));
+    s.write_all(cmd.to_string().as_bytes()).map_err(|e| e.to_string())?;
+    let mut buf = Vec::new();
+    let mut chunk = [0u8; 65536];
+    loop {
+        let n = s.read(&mut chunk).map_err(|e| format!("Blender antwortet nicht ({e})"))?;
+        if n == 0 { break; }
+        buf.extend_from_slice(&chunk[..n]);
+        if let Ok(v) = serde_json::from_slice::<Value>(&buf) { return Ok(v); }
+    }
+    serde_json::from_slice(&buf).map_err(|e| format!("Ungueltige Blender-Antwort: {e}"))
+}
+
+/// Starts a hidden background Blender (no window) on HL_PORT if needed.
+pub(crate) fn ensure_headless() -> Result<String, String> {
+    if port_open(HL_PORT) { return Ok("laeuft bereits".into()); }
+    let exe = blender_exes().pop().ok_or("Blender nicht gefunden (installieren: blender.org)")?;
+    let dir = local();
+    let _ = std::fs::create_dir_all(&dir);
+    let _ = std::fs::create_dir_all(capture_dir());
+    let script = dir.join("adicode_headless.py");
+    std::fs::write(&script, HEADLESS).map_err(|e| e.to_string())?;
+    let log = std::fs::File::create(dir.join("headless.log")).map_err(|e| e.to_string())?;
+    let err = log.try_clone().map_err(|e| e.to_string())?;
+    let mut cmd = Command::new(&exe);
+    cmd.args(["-b", "--factory-startup", "--python"]).arg(&script)
+        .args(["--", "--port", &HL_PORT.to_string(), "--out"]).arg(capture_dir())
+        .arg("--autosave").arg(dir.join("headless.blend"))
+        .stdout(log).stderr(err).stdin(std::process::Stdio::null());
+    hidden(&mut cmd).spawn().map_err(|e| format!("Start fehlgeschlagen: {e}"))?;
+    for _ in 0..80 {
+        std::thread::sleep(Duration::from_millis(250));
+        if port_open(HL_PORT) { return Ok(format!("gestartet ({})", exe.display())); }
+    }
+    Err(format!("Hintergrund-Blender startet nicht - Log: {}", dir.join("headless.log").display()))
+}
+
+fn capture_params(args: &Value) -> Value {
+    let views = match &args["views"] {
+        Value::Array(a) if !a.is_empty() => Value::Array(a.clone()),
+        Value::String(s) if !s.is_empty() => Value::Array(s.split(',').map(|x| json!(x.trim())).collect()),
+        _ => json!(["persp", "front", "right", "top"]),
+    };
+    let mut p = json!({
+        "views": views,
+        "size": args["size"].as_u64().unwrap_or(512).clamp(64, 4096),
+        "engine": args["engine"].as_str().unwrap_or("EEVEE"),
+        "samples": args["samples"].as_u64().unwrap_or(16).clamp(1, 4096),
+        "preview_px": args["preview_px"].as_u64().unwrap_or(768).clamp(128, 2048),
+        "use_scene_camera": args["use_scene_camera"].as_bool().unwrap_or(false),
+    });
+    if let Some(o) = args["objects"].as_array() { p["objects"] = Value::Array(o.clone()); }
+    p
+}
+
+fn capture(args: &Value) -> Value {
+    let err = |m: String| json!({"isError": true, "content": [{"type": "text", "text": m}]});
+    match args["action"].as_str().unwrap_or("capture") {
+        "stop" => {
+            let r = bl_send(HL_PORT, &json!({"type": "shutdown"}), 5);
+            return json!({"content": [{"type": "text", "text": if r.is_ok() { "Hintergrund-Blender beendet (Szene gespeichert)." } else { "Kein Hintergrund-Blender aktiv." }}]});
+        }
+        "start" => return match ensure_headless() { Ok(m) => json!({"content": [{"type": "text", "text": format!("Hintergrund-Blender {m} - Port {HL_PORT}, kein Fenster.")}]}), Err(e) => err(e) },
+        _ => {}
+    }
+    let target = args["target"].as_str().unwrap_or("auto");
+    let gui = target == "gui" || (target == "auto" && port_open(GUI_PORT) && args["file"].is_null());
+    let port = if gui { GUI_PORT } else {
+        if let Err(e) = ensure_headless() { return err(e); }
+        if let Some(file) = args["file"].as_str() {
+            if let Err(e) = bl_send(HL_PORT, &json!({"type": "open", "params": {"filepath": file}}), 30) { return err(e); }
+        }
+        HL_PORT
+    };
+    let out = capture_dir();
+    let _ = std::fs::create_dir_all(&out);
+    let code = format!("{HEADLESS}\nOUT = r'{}'\nos.makedirs(OUT, exist_ok=True)\nimport json as _j\nprint('ADICODE_CAPTURE' + _j.dumps(capture(**_j.loads(r'''{}'''))))\n", out.display(), capture_params(args));
+    let t0 = std::time::Instant::now();
+    let resp = match bl_send(port, &json!({"type": "execute_code", "params": {"code": code}}), 55) { Ok(v) => v, Err(e) => return err(e) };
+    if resp["status"] != "success" {
+        return err(format!("Capture-Fehler: {}", resp["message"].as_str().unwrap_or(&resp.to_string())));
+    }
+    let stdout = resp["result"]["result"].as_str().or(resp["result"]["stdout"].as_str()).unwrap_or("").to_string();
+    let info: Value = stdout.lines().find_map(|l| l.split_once("ADICODE_CAPTURE").and_then(|(_, j)| serde_json::from_str(j).ok())).unwrap_or(Value::Null);
+    if info.is_null() { return err(format!("Capture lieferte kein Ergebnis: {}", stdout.chars().take(800).collect::<String>())); }
+    let backend = if gui { "laufendes Blender (offscreen, Fenster egal)" } else { "Hintergrund-Blender ohne Fenster" };
+    let mut content = vec![json!({"type": "text", "text": format!("Capture ok in {:.1}s via {backend}.\n{}", t0.elapsed().as_secs_f32(), serde_json::to_string_pretty(&info).unwrap_or_default())})];
+    if args["return_image"].as_bool().unwrap_or(true) {
+        if let Some(p) = info["preview"].as_str() {
+            if let Ok(bytes) = std::fs::read(p) { content.push(json!({"type": "image", "data": b64(&bytes), "mimeType": "image/jpeg"})); }
+        }
+    }
+    json!({"content": content})
+}
+
+fn capture_tool() -> Value {
+    json!({
+        "name": "blender_capture",
+        "description": "Bilder der Blender-Szene OHNE sichtbares Fenster: rendert offscreen mehrere Ansichten (persp, front, back, left, right, top, bottom, iso, camera) mit Auto-Kamera-Fit und Kontaktbogen, gibt eine Vorschau als Bild zurueck (PNG-Pfade im Text). target=auto nutzt das laufende Blender (auch minimiert) oder startet automatisch einen versteckten Hintergrund-Blender (kein Fenster, Szene wird autosaved). action=start/stop steuert den Hintergrund-Blender; file=.blend oeffnet eine Datei headless. Fuer Referenzvergleich statt get_viewport_screenshot verwenden.",
+        "inputSchema": {"type": "object", "properties": {
+            "action": {"type": "string", "enum": ["capture", "start", "stop"]},
+            "views": {"type": "array", "items": {"type": "string", "enum": ["persp", "front", "back", "left", "right", "top", "bottom", "iso", "persp_back", "camera"]}},
+            "size": {"type": "integer", "description": "Pixel pro Ansicht (Standard 512)"},
+            "engine": {"type": "string", "enum": ["EEVEE", "CYCLES", "WORKBENCH"]},
+            "samples": {"type": "integer"},
+            "objects": {"type": "array", "items": {"type": "string"}, "description": "Nur diese Objekte einrahmen"},
+            "target": {"type": "string", "enum": ["auto", "gui", "headless"]},
+            "file": {"type": "string", "description": ".blend headless oeffnen"},
+            "use_scene_camera": {"type": "boolean"},
+            "preview_px": {"type": "integer", "description": "Groesse des zurueckgegebenen Vorschaubilds (Standard 768)"},
+            "return_image": {"type": "boolean"}
+        }}
+    })
+}
+pub(crate) fn tools() -> Vec<Value> {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| { std::thread::spawn(|| { let _ = install_helpers(); }); });
+    vec![json!({
+        "name": "blender_pro",
+        "description": "AdiCode Blender Pro: doctor = Blender/Addon/Port/GPU/Extensions pruefen; setup = Extensions (LoopTools, Bool Tool, Extra Objects), Rigify, Node Wrangler, Importer, Cycles-GPU einrichten (Hintergrund); install_helpers = Python-Helfer adicode_blender in Blender installieren; helpers = Funktionsliste der Helfer (A.studio, A.camera, A.hard_surface, A.procedural, A.bounce, A.human_rig, A.render_video ...). Vor Blender-Arbeit adicode_skill blender laden.",
+        "inputSchema": {"type": "object", "properties": {"action": {"type": "string", "enum": ["doctor", "setup", "install_helpers", "helpers"]}}, "required": ["action"]}
+    }), capture_tool()]
+}
+
+pub(crate) fn call(name: &str, args: &Value) -> Option<Value> {
+    if name == "blender_capture" { return Some(capture(args)); }
+    if name != "blender_pro" { return None; }
+    let text = match args["action"].as_str().unwrap_or("doctor") {
+        "setup" => setup(),
+        "install_helpers" => { let v = install_helpers(); if v.is_empty() { "Kein Blender-Profil gefunden (Blender einmal starten).".into() } else { format!("adicode_blender installiert:\n{}", v.join("\n")) } }
+        "helpers" => helpers_doc(),
+        _ => doctor(),
+    };
+    Some(json!({"content": [{"type": "text", "text": text}]}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn blender_pro_basics() {
+        assert!(HELPERS.contains("def studio"));
+        assert!(helpers_doc().contains("A.render_video"));
+        assert_eq!(tools()[0]["name"], "blender_pro");
+        assert!(call("x", &json!({})).is_none());
+        assert_eq!(tools()[1]["name"], "blender_capture");
+        assert!(HEADLESS.contains("def capture") && HEADLESS.contains("_preview"));
+        assert_eq!(b64(b"Man"), "TWFu"); assert_eq!(b64(b"Ma"), "TWE="); assert_eq!(b64(b"M"), "TQ==");
+        let p = capture_params(&json!({"views": "front, top", "size": 10}));
+        assert_eq!(p["views"], json!(["front", "top"])); assert_eq!(p["size"], 64);
+    }
+}
