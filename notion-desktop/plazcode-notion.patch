+            let mut s = Session::page().await?;
+            if !click_testid(&mut s, "agent-chat-stop-recording-button").await? { return Ok(json!({"ok": true, "text": ""})); }
+            let mut text = String::new();
+            for i in 0..80 {
+                sleep(400).await;
+                let v = s.eval("const c=__composer();return {rec:!!__q('agent-chat-stop-recording-button'),c:!!c,t:c?(c.innerText||'').trim():''};").await?;
+                let t = v["t"].as_str().unwrap_or("").to_string();
+                if !t.is_empty() { sleep(500).await; let v2 = s.eval("const c=__composer();return c?(c.innerText||'').trim():'';").await?; text = v2.as_str().unwrap_or(&t).to_string(); break; }
+                if v["c"].as_bool() == Some(true) && v["rec"].as_bool() != Some(true) && i > 15 { break; }
+            }
+            let _ = s.eval(CLEAR).await;
+            Ok(json!({"ok": true, "text": text}))
+        }
+        "cancel" => {
+            let mut s = Session::page().await?;
+            let _ = s.eval("const b=__q('agent-chat-cancel-recording-button');if(b)b.click();return !!b;").await;
+            Ok(json!({"ok": true}))
+        }
+        _ => Err("Unbekannte Diktat-Aktion.".into()),
+    }
+}
+
+fn open_external(url: &str) -> Result<(), String> {
+    if !(url.starts_with("https://") || url.starts_with("http://")) || url.chars().any(|c| c.is_control() || c == '"') { return Err("Nur http(s)-Links.".into()); }
+    #[cfg(windows)]
+    { std::process::Command::new("rundll32").arg("url.dll,FileProtocolHandler").arg(url).spawn().map_err(|e| e.to_string())?; }
+    Ok(())
+}
+
+async fn control(b: Value) -> Result<Value, String> {
+    let op = b["op"].as_str().unwrap_or("");
+    match op {
+        "stop" => {
+            let mut s = Session::page().await?;
+            let done = click_testid(&mut s, "agent-chat-stop-button").await?;
+            Ok(json!({"ok": true, "stopped": done}))
+        }
+        "new" => {
+            ensure_main().await?;
+            let t = main_tab()?;
+            let mut s = Session::page().await?;
+            s.navigate(np::NOTION_URL).await?;
+            sleep(1200).await;
+            wait_composer(&mut s, &t).await?;
+            Ok(json!({"ok": true}))
+        }
+        "trim" => {
+            let keep = b["keep"].as_u64().unwrap_or(12);
+            let mut s = Session::page().await?;
+            let js = format!("const r=[...document.querySelectorAll('[data-agent-service-find-row]')];const n=Math.max(0,r.length-{});r.forEach((e,i)=>{{e.style.display=i<n?'none':''}});return n;", keep);
+            let v = s.eval(&js).await?;
+            Ok(json!({"ok": true, "hidden": v}))
+        }
+        "open" => {
+            let url = b["url"].as_str().unwrap_or("");
+            if !(url.starts_with("https://app.notion.com/") || url.starts_with("https://www.notion.so/")) { return Err("Nur Notion-Chats koennen geoeffnet werden.".into()); }
+            ensure_main().await?;
+            let t = main_tab()?;
+            let mut s = Session::page().await?;
+            s.navigate(url).await?;
+            sleep(1500).await;
+            wait_composer(&mut s, &t).await?;
+            Ok(json!({"ok": true}))
+        }
+        "forget" => {
+            let url = b["url"].as_str().unwrap_or("");
+            let _g = HISTORY.lock().unwrap_or_else(|e| e.into_inner());
+            let list: Vec<Value> = read_history().into_iter().filter(|x| x["url"] != json!(url)).collect();
+            std::fs::write(history_file(), serde_json::to_string_pretty(&list).unwrap_or_default()).map_err(|e| e.to_string())?;
+            Ok(json!({"ok": true}))
+        }
+        "window" => {
+            let show = b["show"].as_bool().unwrap_or(true);
+            let t = main_tab()?;
+            if show && !browser_up().await { np::launch(&t, np::NOTION_URL)?; }
+            HIDE_MAIN.store(!show, Ordering::SeqCst);
+            np::windows::set_hidden(std::slice::from_ref(&t), !show);
+            if show { if let Ok(mut s) = Session::page().await { let _ = s.call("Page.bringToFront", json!({}), 5).await; } }
+            Ok(json!({"ok": true, "hidden": !show}))
+        }
+        "action" => {
+            let row = b["row"].as_str().unwrap_or("");
+            let label = b["label"].as_str().unwrap_or("");
+            let mut s = Session::page().await?;
+            let p = s.eval(&format!("const r=[...document.querySelectorAll('[data-agent-service-find-row]')].find(x=>x.getAttribute('data-agent-service-scroll-anchor')==={});if(!r)return null;const b=[...r.querySelectorAll('button,[role=\"button\"]')].find(x=>(x.innerText||'').trim()==={});if(!b)return null;b.scrollIntoView({{block:'center'}});await __sleep(200);return __center(b);", js_str(row), js_str(label))).await?;
+            if p.is_null() { return Err("Knopf nicht mehr vorhanden.".into()); }
+            s.click(&p).await?;
+            Ok(json!({"ok": true}))
+        }
+        "dictate" => dictate(b["action"].as_str().unwrap_or("")).await,
+        "open_url" => { open_external(b["url"].as_str().unwrap_or(""))?; Ok(json!({"ok": true})) }
+        _ => Err(format!("Unbekannte Chat-Aktion: {op}")),
+    }
+}
+
+pub async fn control_handler(Json(b): Json<Value>) -> Response { reply(control(b).await) }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn chat_urls_keep_only_thread_id() {
+        assert_eq!(clean_url("https://app.notion.com/chat?t=abc&wfv=chat"), "https://app.notion.com/chat?t=abc");
+        assert_eq!(clean_url("https://app.notion.com/ai"), "https://app.notion.com/ai");
+    }
+    #[test]
+    fn upload_names_are_safe() {
+        assert_eq!(safe_name("..\\..\\evil.png"), "_.._evil.png");
+        assert_eq!(safe_name("Foto 1.jpg"), "Foto 1.jpg");
+        assert_eq!(safe_name(""), "datei");
+    }
+    #[test]
+    fn chat_ui_is_embedded() {
+        let ui = include_str!("notion_chat_ui.html");
+        assert!(ui.contains("id=\"page-chat\"") && ui.contains("/api/notion/chat/send"));
+        assert!(include_str!("desktop.html").contains("__ADICODE_CHAT_UI__") && include_str!("desktop.html").contains("data-page=\"chat\""));
+    }
+}
