+async fn submit(s: &mut Session) -> Result<(), String> {
+    let before = s.eval(ROWS).await?;
+    let rows = before["rows"].as_u64().unwrap_or(0);
+    let p = s.eval(SEND_POINT).await?;
+    if p.is_null() { return Err("Senden-Knopf von Notion nicht gefunden.".into()); }
+    s.click(&p).await?;
+    for i in 0..16 {
+        sleep(250).await;
+        let v = s.eval(ROWS).await?;
+        if v["rows"].as_u64().unwrap_or(0) > rows || v["gen"].as_bool() == Some(true) { return Ok(()); }
+        if i == 7 { let _ = s.eval("const b=__q('agent-chat-send-button');if(b)b.click();return !!b;").await; }
+    }
+    let _ = s.eval("const c=__composer();if(c)c.focus();return !!c;").await;
+    for t in ["keyDown", "keyUp"] {
+        s.call("Input.dispatchKeyEvent", json!({"type": t, "key": "Enter", "code": "Enter", "windowsVirtualKeyCode": 13, "modifiers": 2}), 5).await?;
+    }
+    sleep(1200).await;
+    let v = s.eval(ROWS).await?;
+    if v["rows"].as_u64().unwrap_or(0) > rows || v["gen"].as_bool() == Some(true) { Ok(()) } else { Err("Notion hat die Nachricht nicht angenommen (Senden-Knopf gesperrt?).".into()) }
