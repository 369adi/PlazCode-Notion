+		magic={Color=ColorSequence.new(Color3.fromRGB(180,108,255),Color3.fromRGB(60,200,255)),Rate=30,Speed=NumberRange.new(.5,1.5),Lifetime=NumberRange.new(1,1.6),LightEmission=1},
