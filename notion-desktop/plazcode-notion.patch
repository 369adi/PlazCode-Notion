+//! AdiCode Co-Work 2.0: four isolated Notion profiles with automatic roles and CDP kickoff.
+use axum::{response::IntoResponse, Json};
+use futures::{SinkExt, StreamExt};
+use once_cell::sync::Lazy;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{collections::{BTreeMap, HashSet}, path::PathBuf, sync::{atomic::{AtomicBool, Ordering}, Mutex}, time::Duration};
+
