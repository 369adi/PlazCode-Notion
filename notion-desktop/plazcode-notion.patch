+        "assignee": {"type": "string", "description": "Optional: Agent-Name, der den Task machen soll"}
+    }, "required": ["title"]}});
+    let project = json!({"type": "string", "description": "Projekt-ID (z. B. p1) oder Titel; optional, wenn nur ein Projekt existiert"});
+    let agent = json!({"type": "string", "description": "Dein Agent-Name aus cowork_join/cowork_start"});
+    vec![
+        json!({"name": "cowork_start", "description": "AdiCode Co-Work: startet im Main Chat ein Projekt, an dem mehrere Notion-AI-Chats (Browser-Tabs) gleichzeitig arbeiten. Der Aufrufer wird Lead. Das GANZE Projekt nach Funktionsbereichen in 4-15 Tasks zerlegen: jeder Task bekommt area (Bereich) und files (Dateien, die er aendert). AdiCode bildet daraus Arbeitspakete - Tasks mit gleichem Bereich oder gemeinsamen Dateien landen im selben Paket - und gibt jedem Tab ein eigenes Paket, damit alle gleichzeitig an verschiedenen Teilen derselben App arbeiten, ohne sich Dateien kaputt zu machen. role (Schwerpunkt) ist optional; fuer Code/UI review setzen. Rollen sind Schwerpunkte, keine Grenzen: jeder Worker bewertet den Auftrag zuerst aus seiner Rollen-Sicht und hilft danach bei allen Tasks. Vorher adicode_skill name=cowork lesen.", "inputSchema": {"type": "object", "properties": {"title": {"type": "string"}, "goal": {"type": "string", "description": "Gesamtziel inkl. Nutzer-Auftrag, Tech-Stack, Ordner, Konventionen, Schnittstellen"}, "assess": {"type": "boolean", "description": "Rollen-Bewertung durch alle Worker vor dem Start (Standard true; nur fuer winzige Auftraege false)"}, "agent": {"type": "string", "description": "Name des Leads (optional)"}, "stale_minutes": {"type": "integer", "minimum": 1, "maximum": 240, "description": "Nach so vielen Minuten Inaktivitaet werden Tasks eines Agents wieder frei (Standard 20)"}, "tasks": tasks.clone()}, "required": ["title", "goal"]}}),
+        json!({"name": "cowork_join", "description": format!("AdiCode Co-Work: diesen Chat mit einer Rolle (Schwerpunkt + Bewertungs-Sicht, hilft aber bei allem) einem Co-Work-Projekt beitreten. Liefert Agent-Namen, Rollen-Anleitung, Ablauf und Board. Danach cowork_claim. Rollen: {role_list} (eigene Rollen erlaubt)."), "inputSchema": {"type": "object", "properties": {"project": project.clone(), "agent": {"type": "string", "description": "Wunschname (optional, sonst <rolle>-N)"}, "role": {"type": "string", "description": "Rolle dieses Chats, z. B. coder, reviewer, uiux, prompt, tester, roblox"}}}}),
+        json!({"name": "cowork_board", "description": "AdiCode Co-Work: zeigt Tasks (mit Rolle und Phase), Agents, unbesetzte Rollen, Datei-Locks und neue Nachrichten. Ohne project: Liste aller Projekte.", "inputSchema": {"type": "object", "properties": {"project": project.clone(), "agent": agent.clone()}}, "annotations": {"readOnlyHint": true}}),
+        json!({"name": "cowork_claim", "description": "AdiCode Co-Work: uebernimmt atomar den naechsten passenden Task (zuerst eigene Bewertungen, dann eigene Rolle, dann Reviews, dann ohne Rolle, dann Tasks beschaeftigter oder fehlender Experten; Abhaengigkeiten erledigt, Dateien frei) oder task_id und sperrt seine Dateien. Liefert Details und Ergebnisse der Vorgaenger.", "inputSchema": {"type": "object", "properties": {"project": project.clone(), "agent": agent.clone(), "task_id": {"type": "integer"}}, "required": ["agent"]}}),
