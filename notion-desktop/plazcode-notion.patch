+fn load_db() -> Map<String, Value> {
+    std::fs::read_to_string(memory_file()).ok()
+        .and_then(|raw| serde_json::from_str::<Value>(raw.trim_start_matches('\u{feff}')).ok())
+        .and_then(|v| v.as_object().cloned())
+        .unwrap_or_default()
